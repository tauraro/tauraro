extern "C":
    def _tr_is_windows() -> bool
    def _tr_file_delete(path: str) -> int
    def _tr_getenv(name: str) -> str
    def _tr_setenv(name: str, value: str) -> int   # set an env var for THIS process + its children (used to put bundled zig on PATH)
    def _tr_exe_dir() -> str   # absolute dir of the running compiler exe (OS-level; reliable even when invoked by bare name via PATH)
    def _tr_print_raw(s: str)  # print without trailing newline (for `tauraroc fmt` stdout output)
    # Stage 2: in-process LLVM `.ll` -> `.o` via libLLVM (runtime/tauraro_llvm.c). Returns 0 on
    # success, >0 on an LLVM error, -1 when not compiled in (weak stub) -> caller falls back to
    # the bundled-llc subprocess (Stage 1). Keeps the textual .ll (differential oracle intact).
    def _tr_llvm_emit_object(ll_path: str, out_path: str, triple: str) -> int
    # Binary-safe file read (SPIR-V modules contain NULs) for --gpu-embed.
    def _tr_gpu_read_file(path: str) -> Pointer[char]
    def _tr_gpu_read_file_len() -> int

# --- Helpers ------------------------------------------------------------------

# Read a compiled GPU module (PTX/SPIR-V) and emit a C file that embeds it as a
# byte array with STRONG accessors that override the runtime's weak defaults, so
# std.gpu's Module.embedded() loads it at runtime. Returns "" if the file is empty.
pub def gpu_blob_c(bin_path: str) -> str:
    mut data = _tr_gpu_read_file(bin_path)
    mut n = _tr_gpu_read_file_len()
    if (data as usize) == (0 as usize) or n <= 0:
        return ""
    mut sb = StringBuilder.init(n * 5 + 256)
    sb.append("/* auto-generated by --gpu-embed: embedded GPU kernel module */\n")
    sb.append("static const unsigned char _tr_gpu_blob_data[] = {")
    mut i = 0
    while i < n:
        mut b = 0
        unsafe:
            b = data.offset(i).read() as int
        b = b & 255
        if (i % 20) == 0:
            sb.append("\n  ")
        sb.append_int(b)
        sb.append(",")
        i = i + 1
    sb.append("\n};\n")
    sb.append("char* _tr_gpu_embedded_blob(void){ return (char*)(void*)_tr_gpu_blob_data; }\n")
    sb.append("long long _tr_gpu_embedded_len(void){ return (long long)sizeof(_tr_gpu_blob_data); }\n")
    return sb.to_owned()

pub def print_version():
    print("tauraroc v0.0.8")

pub def print_usage():
    print("Usage: tauraroc <file.tr> [options]")
    print("       tauraroc fmt [-w] <file.tr>   Format source (stdout, or -w in place)")
    print("       tauraroc lint <file.tr>       Analyze and report warnings/errors")
    print("       tauraroc bindgen <hdr.h>      Generate FFI bindings from a C header (-o out.tr)")
    print("       tauraroc bindgen <hdr.hpp> -h cpp  Bind a C++ header (auto C++->C shim via libclang)")
    print("       tauraroc bindgen <hdr> --pkg <name>  Auto-discover include/link flags via pkg-config")
    print("Options:")
    print("  --version         Print version and exit")
    print("  --emit c          Emit generated C code to build/")
    print("  --emit ast        Emit AST representation and stop")
    print("  --emit mir        Emit MIR basic blocks and stop")
    print("  --run             Compile and immediately execute")
    print("  --check           Run semantic analysis only (no codegen)")
    print("  --verbose         Show all pipeline stages")
    print("  --backend <b>     Code generator: c (default, C->gcc/clang), llvm (LLVM IR),")
    print("                      native (x86-64->ELF, under construction)")
    print("  -o <path>         Exact output path (its directory is honored; overrides -d)")
    print("  -d <dir>          Output directory for the executable (default: current dir)")
    print("  --lib             Build a shared library (.so/.dll) of `export def`s + a C header")
    print("  --export-cpp      Also emit an ergonomic C++ header to call Tauraro from C++ (implies --lib)")
    print("  -O0/-O1/-O2/-O3  Optimization level (default: -O2)")
    print("  -Os               Optimize for size")
    print("  --link <path>     Link a file by path (.c .o .a .dll .lib .so)")
    print("  -l<name>          Link a library by name (e.g. -luser32, -lgdi32)")
    print("  -l <name>         Same as -l<name> with a space")
    print("  --static          Statically link the output binary")
    print("  --target <name>   Cross-compile for a target platform (C and LLVM backends):")
    print("                      android-arm64, android-arm32, android-x86_64, android-x86")
    print("                      ios, ios-sim")
    print("                      linux-arm64, linux-arm32, linux-x86_64, linux-riscv64")
    print("                      windows-x64, windows-arm64")
    print("                      macos-arm64, macos-x86_64")
    print("                      embedded-arm, embedded-arm64, embedded-riscv32, embedded-riscv64")
    print("                      uefi-x64 (turnkey .efi; pair with --freestanding, no --emit-ld)")
    print("                      wasm, wasm-wasi")
    print("                    Or pass a raw LLVM triple (e.g. aarch64-linux-gnu)")
    print("  --sysroot <path>  Override sysroot for the cross-compiler")
    print("  --debug           Compile with ASAN and bounds-check assertions")
    print("  --strict          Treat alloc/dealloc outside 'unsafe:' as a hard error [U-1]")
    print("  --no-heap         Reject heap types (List/Dict/Set/heap class/dynamic str) [H-1] — structurally")
    print("                    zero-heap for bare metal; value-types/fixed-arrays/pointers/StrView only")

pub def str_ends_with_dot_tr(path: str) -> bool:
    mut p = path as Pointer[char]
    mut len = 0
    while p.offset(len).read() as int != 0:
        len = len + 1
    if len < 3: return false
    if p.offset(len - 3).read() as int != 46: return false   # '.'
    if p.offset(len - 2).read() as int != 116: return false  # 't'
    if p.offset(len - 1).read() as int != 114: return false  # 'r'
    return true

pub def strip_extension(path: str) -> str:
    mut p = path as Pointer[char]
    mut len = 0
    while p.offset(len).read() as int != 0:
        len = len + 1
    mut end = len
    while end > 0:
        if p.offset(end - 1).read() as int == 46:
            return path.slice(0, end - 1)
        end = end - 1
    return path

pub def str_starts_with(s: str, prefix: str) -> bool:
    mut sp = s as Pointer[char]
    mut pp = prefix as Pointer[char]
    mut i = 0
    while True:
        mut pc = pp.offset(i).read() as int
        if pc == 0: return true
        mut sc = sp.offset(i).read() as int
        if sc != pc: return false
        i = i + 1
    return true

pub def detect_c_compiler() -> str:
    mut null_dev = "/dev/null"
    if _tr_is_windows():
        null_dev = "nul"
    if _tr_system("gcc --version >" + null_dev + " 2>&1") == 0: return "gcc"
    if _tr_system("clang --version >" + null_dev + " 2>&1") == 0: return "clang"
    if _tr_system("cc --version >" + null_dev + " 2>&1") == 0: return "cc"
    # No system C compiler: fall back to the bundled `zig cc` (activate_bundled_zig
    # put it on PATH). This makes tauraro self-contained — it can compile with NOTHING
    # else installed. Preferred only as a fallback for host builds because a system
    # gcc/clang is faster (zig cc compiles its libc from source on first use).
    if _tr_system("zig version >" + null_dev + " 2>&1") == 0: return "zig cc"
    return "gcc"

# True when `cc` is Clang (clang or apple clang).  Used to gate Clang-only flags.
pub def is_clang_compiler(cc: str) -> bool:
    mut null_dev = "/dev/null"
    if _tr_is_windows(): null_dev = "nul"
    if _tr_str_contains(cc, "clang"): return true
    if _tr_str_contains(cc, "zig"): return true   # `zig cc` is clang under the hood
    # 'cc' on macOS is Apple Clang - check its --version output
    if _tr_str_eq(cc, "cc"):
        return _tr_system(cc + " --version 2>&1 | grep -qi clang") == 0
    return false

# ── Library flag discovery (`tauraroc bindgen --pkg <name>`) ──────────────────
# Query pkg-config for a library's compile (`--cflags`) or link (`--libs`) flags so a
# binding needs no hand-passed -I/-D/-l. Returns "" if pkg-config or the package is absent.
pub def pkg_config_query(name: str, kind: str) -> str:
    mut null_dev = "/dev/null"
    if _tr_is_windows(): null_dev = "nul"
    mut tmp = "_tr_pkgcfg.txt"
    mut rc = _tr_system("pkg-config " + kind + " " + name + " > \"" + tmp + "\" 2>" + null_dev)
    if rc != 0: return ""
    if not file_exists(tmp): return ""
    mut out = read_file(tmp).trim()
    return out

# ── C++ interop: auto-build + zero-cost linking of bindgen shims ──────────────
# A C++ binding generated by `tauraroc bindgen -h cpp` ships a `<name>_shim.cpp`
# (extern-"C" wrappers around the real C++ API) and records it in the binding
# module via `# tauraro-cpp-*` header pragmas. The C++ shim (and the final link
# when one is present) must go through the C++ front-end so libstdc++ / the
# exception personality are linked — map the C driver to its C++ sibling.
pub def cxx_of(cc: str) -> str:
    if _tr_str_eq(cc, "gcc"): return "g++"
    if _tr_str_eq(cc, "clang"): return "clang++"
    if _tr_str_eq(cc, "zig cc"): return "zig c++"
    return "c++"

# LTO across the C/C++ boundary inlines the extern-"C" shim wrapper away, so a
# call into C++ costs exactly what the C++ method costs — zero shim overhead.
# gcc carries a built-in LTO linker plugin and `zig cc` bundles lld — both link
# bitcode in place. A bare system clang here may lack lld/LLVMgold, so its LTO
# link would fail; fall back to plain auto-link (still no manual build step, just
# an un-inlined wrapper call). Cross builds skip LTO to stay simple and robust.
pub def cpp_lto_ok(cc: str, target: str) -> bool:
    if target != "": return false
    if _tr_str_contains(cc, "gcc"): return true
    if _tr_str_contains(cc, "zig"): return true
    return false

# Scan every loaded binding module for `# tauraro-cpp-*` pragmas, compile each
# referenced shim once (cached by source content), and append it plus its
# libraries to the link line. Returns true if any C++ shim was linked → the final
# link must then use the C++ driver (and, when `lto`, was compiled as bitcode).
pub def auto_link_cpp_shims(mod_file_paths: Vec[str], build_dir: str, cc: str,
                            opt_level: str, link_paths: Vec[str], lib_flags: Vec[str],
                            verbose: bool, lto: bool) -> bool:
    mut any = false
    mut seen: Map[str, bool] = Map[str, bool].init(8)
    mut cxx = cxx_of(cc)
    mut mi = 0
    while mi < mod_file_paths.len:
        mut trpath = mod_file_paths.get(mi)
        mi = mi + 1
        if not file_exists(trpath): continue
        mut src = read_file(trpath)
        mut lines = src.split("\n")
        mut shim = ""
        mut cflags = ""
        mut linkflags = ""
        mut libs = Vec[str].init(2)
        mut li = 0
        while li < lines.len:
            mut ln = lines.get(li)
            li = li + 1
            if str_starts_with(ln, "# tauraro-cpp-shim:"):
                shim = ln.slice(19, ln.len()).trim()
            elif str_starts_with(ln, "# tauraro-cpp-cflags:"):
                cflags = ln.slice(21, ln.len()).trim()
            elif str_starts_with(ln, "# tauraro-cpp-linkflags:"):
                linkflags = ln.slice(24, ln.len()).trim()      # --pkg link flags, appended verbatim
            elif str_starts_with(ln, "# tauraro-cpp-lib:"):
                libs.push(ln.slice(18, ln.len()).trim())
            elif ln.len() > 0 and not str_starts_with(ln, "#"):
                break    # the pragma block is the header — stop at the first real line
        # A binding with neither a shim nor link flags contributes nothing.
        if shim == "" and linkflags == "": continue
        # C++ bindings carry a shim to compile + link; a C binding (or --pkg) may carry only link flags.
        if shim != "":
            # resolve the shim path relative to the binding module's own directory
            mut shim_src = shim
            if not file_exists(shim_src):
                mut cand = dir_of_path(trpath) + shim
                if file_exists(cand):
                    shim_src = cand
                else:
                    print(c_yellow("warning") + ": shim '" + shim + "' referenced by " + trpath + " not found; link it manually with --link")
                    continue
            mut shim_txt = read_file(shim_src)
            # A plain C source (`.c` WITHOUT an UNCONDITIONAL `extern "C"`) is a
            # hand-vendored C library dropped next to the bindings — compile it
            # with the C driver so its functions keep their unmangled C-ABI names.
            # A `.c` that DOES contain an unconditional `extern "C"` is a generated
            # shim meant for C++ (the `--macros` shim always emits one, unguarded —
            # see `_gen_macro_shims` in bindgen.tr), and `.cpp`/`.cc`/`.cxx` are C++;
            # both of those go through the C++ driver.
            #
            # Real-world vendored C libraries (e.g. SQLite's amalgamation) commonly
            # wrap their own `extern "C" { ... }` in `#ifdef __cplusplus` so the same
            # file compiles standalone under a C++ consumer too — that guarded form
            # is NOT a signal the shim itself requires a C++ compiler; compiling such
            # a file with g++ instead of gcc trips real errors deep in unrelated code
            # (C's implicit `void*` conversions are invalid in C++). Treat a file as
            # C++-required only when `extern "C"` appears with no `__cplusplus` guard
            # anywhere in the file.
            mut is_c_only = shim_src.ends_with(".c") and (not shim_txt.contains("extern \"C\"") or shim_txt.contains("__cplusplus"))
            if not seen.contains(shim_src):
                seen.insert(shim_src, true)
                # compile once, cached by shim source content (build/<base>.o + .src sidecar)
                mut oname = build_dir + get_filename(shim_src) + ".o"
                mut sidecar = oname + ".src"
                # Cache key = driver kind + source, so a change in EITHER the shim
                # content or the C/C++ driver choice re-triggers compilation.
                mut cache_key = "CXX\n" + shim_txt
                if is_c_only: cache_key = "C\n" + shim_txt
                mut need = true
                if file_exists(oname) and file_exists(sidecar):
                    if read_file(sidecar) == cache_key: need = false
                if need:
                    mut ccmd = ""
                    if is_c_only:
                        # Plain C: C driver, no C++ std / LTO bitcode (links as a normal object).
                        ccmd = cc + " -O" + opt_level + " -c \"" + shim_src + "\" " + cflags + " -o \"" + oname + "\""
                        if verbose: print("  [C shim] " + shim_src)
                    else:
                        mut stdflag = ""
                        if not cflags.contains("-std"): stdflag = " -std=c++17"
                        mut ltof = ""
                        if lto: ltof = " -flto"
                        ccmd = cxx + " -O" + opt_level + ltof + stdflag + " -c \"" + shim_src + "\" " + cflags + " -o \"" + oname + "\""
                        if verbose: print("  [CXX shim] " + shim_src)
                    mut rc = _tr_system(ccmd)
                    if rc != 0:
                        print(c_red("error") + ": compiling shim " + shim_src + " failed (exit code " + str(rc) + ")")
                        _tr_exit(rc)
                    write_file(sidecar, cache_key)
                link_paths.push(oname)
                mut bi = 0
                while bi < libs.len:
                    lib_flags.push("-l" + libs.get(bi))
                    bi = bi + 1
            # Only a C++ shim forces the final link through the C++ driver; a pure
            # C shim's object links fine with the C driver (no libstdc++ needed).
            if not is_c_only: any = true
        if linkflags != "":
            lib_flags.push(linkflags)     # pkg-config -L/-l flags, verbatim
            any = true
    return any

# Expand friendly target shorthands to LLVM target triples.
# Raw triples (containing '-') are passed through unchanged.
pub def resolve_target_triple(target: str) -> str:
    if target == "android-arm64":    return "aarch64-linux-android34"
    if target == "android-arm32":    return "armv7a-linux-androideabi34"
    if target == "android-x86_64":   return "x86_64-linux-android34"
    if target == "android-x86":      return "i686-linux-android34"
    if target == "ios":              return "aarch64-apple-ios"
    if target == "ios-sim":          return "aarch64-apple-ios-simulator"
    if target == "linux-arm64":      return "aarch64-linux-gnu"
    if target == "linux-arm32":      return "armv7-linux-gnueabihf"
    if target == "linux-x86_64":     return "x86_64-linux-gnu"
    if target == "linux-riscv64":    return "riscv64-linux-gnu"
    if target == "windows-x64":      return "x86_64-w64-mingw32"
    if target == "windows-arm64":    return "aarch64-w64-mingw32"
    if target == "macos-arm64":      return "aarch64-apple-macosx12.0"
    if target == "macos-x86_64":     return "x86_64-apple-macosx12.0"
    if target == "embedded-arm":     return "arm-none-eabi"
    if target == "embedded-arm64":   return "aarch64-none-elf"
    if target == "embedded-riscv32": return "riscv32-unknown-elf"
    if target == "embedded-riscv64": return "riscv64-unknown-elf"
    if target == "uefi-x64":         return "x86_64-unknown-uefi"
    if target == "wasm":             return "wasm32-unknown-unknown"
    if target == "wasm-wasi":        return "wasm32-wasi"
    return target  # already a raw triple

# Cortex-M (mps2-an385) linker script for a --freestanding @entry build. Its
# symbols match the compiler-emitted reset trampoline (_tr_reset, _stack_top,
# __bss_start__/__bss_end__, _sidata/_sdata/_edata) so the user writes no .ld.
pub def linker_script_cortex_m() -> str:
    mut s = "/* Generated by tauraroc --emit-ld : Cortex-M (mps2-an385) memory map. */\n"
    s = s + "ENTRY(_tr_reset)\n"
    s = s + "MEMORY {\n"
    s = s + "  FLASH (rx)  : ORIGIN = 0x00000000, LENGTH = 4M\n"
    s = s + "  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 4M\n"
    s = s + "}\n"
    s = s + "SECTIONS {\n"
    s = s + "  .isr_vector : { KEEP(*(.isr_vector)) } > FLASH\n"
    s = s + "  .text : { *(.text*) *(.rodata*) } > FLASH\n"
    s = s + "  _sidata = LOADADDR(.data);\n"
    s = s + "  .data : { _sdata = .; *(.data*) _edata = .; } > RAM AT > FLASH\n"
    s = s + "  .bss  : { __bss_start__ = .; *(.bss* COMMON) __bss_end__ = .; } > RAM\n"
    s = s + "  . = ALIGN(8);\n"
    s = s + "  . = . + 0x8000;\n"
    s = s + "  _stack_top = ORIGIN(RAM) + LENGTH(RAM);\n"
    s = s + "}\n"
    return s

# RISC-V linker script for a --freestanding @entry build on qemu 'virt'. Everything
# lives in RAM at 0x80000000 (where qemu loads the ELF), so there's no separate flash
# load region: .data is already resident and only .bss is zeroed by the boot code. The
# symbols match the emitted RISC-V boot glue (_start, _stack_top, __bss_start/end__).
pub def linker_script_riscv() -> str:
    mut s = "/* Generated by tauraroc --emit-ld : RISC-V (qemu virt) memory map. */\n"
    s = s + "ENTRY(_start)\n"
    s = s + "MEMORY {\n"
    s = s + "  RAM (rwx) : ORIGIN = 0x80000000, LENGTH = 128M\n"
    s = s + "}\n"
    s = s + "SECTIONS {\n"
    s = s + "  .text : { KEEP(*(.text.init)) *(.text*) *(.rodata*) } > RAM\n"
    s = s + "  .data : { *(.data*) *(.sdata*) } > RAM\n"
    s = s + "  .bss  : { __bss_start__ = .; *(.bss* .sbss* COMMON) __bss_end__ = .; } > RAM\n"
    s = s + "  . = ALIGN(16);\n"
    s = s + "  . = . + 0x8000;\n"
    s = s + "  _stack_top = .;\n"
    s = s + "}\n"
    return s

# True if `prog`'s top-level functions include one named `name` marked
# `export` (a `pub export def`). Used by the UEFI turnkey link (below) to find
# the well-known-named entry points a hand-written zig stub would otherwise
# need to know about, instead of requiring one.
def hir_has_export_fn(prog: HirProgram, name: str) -> bool:
    mut i = 0
    while i < prog.functions.len:
        mut f = prog.functions.get(i)
        if f.is_export and f.name == name: return true
        i = i + 1
    return false

# Generated zig UEFI boot stub for a --target uefi-x64 --freestanding build.
# UEFI firmware IS the boot glue (reset vectors, memory setup, and the boot
# menu all already happened before anything here runs) -- unlike Cortex-M/
# RISC-V, so this is a THIN caller, not a reset vector: it locates the GOP
# framebuffer, optionally seeds a heap pool via UEFI's own AllocatePool, and
# calls the program's well-known-named entry point. Tauraro's codegen doesn't
# know the PE/COFF UEFI ABI or protocol tables, so this stays hand-emitted
# zig text rather than lowered from Tauraro source -- mirrors the shape of
# nebula's hand-written examples/uefi_demo/boot.zig, which this replaces.
def uefi_zig_stub(entry_name: str, has_heap_init: bool, heap_size_mb: int) -> str:
    mut s = "// Generated by tauraroc --target uefi-x64 : UEFI boot glue.\n"
    s = s + "const std = @import(\"std\");\n"
    s = s + "const uefi = std.os.uefi;\n\n"
    if has_heap_init:
        s = s + "extern fn tauraro_heap_init(base: [*]u8, size: usize) void;\n"
    s = s + "extern fn " + entry_name + "(fb: [*]u32, width: c_longlong, height: c_longlong, pitch: c_longlong) void;\n\n"
    s = s + "const HEAP_SIZE: usize = " + str(heap_size_mb) + " * 1024 * 1024;\n\n"
    s = s + "pub fn main() void {\n"
    s = s + "    const bs = uefi.system_table.boot_services.?;\n\n"
    if has_heap_init:
        s = s + "    const heap_bytes = bs.allocatePool(.loader_data, HEAP_SIZE) catch return;\n"
        s = s + "    tauraro_heap_init(heap_bytes.ptr, HEAP_SIZE);\n\n"
    s = s + "    const gop = (bs.locateProtocol(uefi.protocol.GraphicsOutput, null) catch return) orelse return;\n"
    s = s + "    const mode = gop.mode;\n"
    s = s + "    const fb: [*]u32 = @ptrFromInt(mode.frame_buffer_base);\n\n"
    s = s + "    " + entry_name + "(\n"
    s = s + "        fb,\n"
    s = s + "        @intCast(mode.info.horizontal_resolution),\n"
    s = s + "        @intCast(mode.info.vertical_resolution),\n"
    s = s + "        @intCast(mode.info.pixels_per_scan_line),\n"
    s = s + "    );\n\n"
    s = s + "    while (true) {\n"
    s = s + "        asm volatile (\"hlt\");\n"
    s = s + "    }\n"
    s = s + "}\n"
    return s

# Interactive variant of uefi_zig_stub: instead of one paint-then-halt call,
# polls a mouse and a keyboard each iteration and calls the program's
# well-known-named entry every frame with the current input state, like a
# tiny event loop. Used when the program exports `tauraro_uefi_frame` (its
# presence is what selects this generator over the one-shot uefi_zig_stub;
# both remain supported, so existing one-shot programs need no changes).
def uefi_zig_stub_frame(entry_name: str, has_heap_init: bool, heap_size_mb: int) -> str:
    mut s = "// Generated by tauraroc --target uefi-x64 : UEFI boot glue (interactive).\n"
    s = s + "const std = @import(\"std\");\n"
    s = s + "const uefi = std.os.uefi;\n\n"
    if has_heap_init:
        s = s + "extern fn tauraro_heap_init(base: [*]u8, size: usize) void;\n"
    s = s + "extern fn " + entry_name + "(fb: [*]u32, width: c_longlong, height: c_longlong, pitch: c_longlong, mouse_x: c_longlong, mouse_y: c_longlong, mouse_down: bool, has_key: bool, key_code: c_longlong) bool;\n\n"
    s = s + "const HEAP_SIZE: usize = " + str(heap_size_mb) + " * 1024 * 1024;\n\n"
    s = s + "pub fn main() void {\n"
    s = s + "    const bs = uefi.system_table.boot_services.?;\n\n"
    if has_heap_init:
        s = s + "    const heap_bytes = bs.allocatePool(.loader_data, HEAP_SIZE) catch return;\n"
        s = s + "    tauraro_heap_init(heap_bytes.ptr, HEAP_SIZE);\n\n"
    s = s + "    const gop = (bs.locateProtocol(uefi.protocol.GraphicsOutput, null) catch return) orelse return;\n"
    s = s + "    const mode = gop.mode;\n"
    s = s + "    const fb: [*]u32 = @ptrFromInt(mode.frame_buffer_base);\n"
    s = s + "    const width: i64 = @intCast(mode.info.horizontal_resolution);\n"
    s = s + "    const height: i64 = @intCast(mode.info.vertical_resolution);\n"
    s = s + "    const pitch: i64 = @intCast(mode.info.pixels_per_scan_line);\n\n"
    # A mouse is optional -- not every UEFI environment has a pointer device;
    # locateProtocol returning an error/null just means no clicks ever fire,
    # not a fatal boot error. Position accumulates from RELATIVE deltas
    # (EFI_SIMPLE_POINTER_PROTOCOL reports movement, not absolute coordinates
    # -- unlike a USB tablet's EFI_ABSOLUTE_POINTER_PROTOCOL, deliberately not
    # used here to stay zero-config: plain PS/2 relative pointer is what a
    # bare `-M q35` already provides with no extra qemu flags), starting
    # centered and clamped to the framebuffer so a long delta stream can't
    # walk the cursor off-canvas.
    s = s + "    const pointer = bs.locateProtocol(uefi.protocol.SimplePointer, null) catch null;\n"
    s = s + "    var mouse_x: i64 = @divTrunc(width, 2);\n"
    s = s + "    var mouse_y: i64 = @divTrunc(height, 2);\n\n"
    s = s + "    while (true) {\n"
    s = s + "        var mouse_down = false;\n"
    s = s + "        if (pointer) |ptr| {\n"
    s = s + "            if (ptr.getState()) |st| {\n"
    s = s + "                mouse_x += st.relative_movement_x;\n"
    s = s + "                mouse_y += st.relative_movement_y;\n"
    s = s + "                if (mouse_x < 0) mouse_x = 0;\n"
    s = s + "                if (mouse_y < 0) mouse_y = 0;\n"
    s = s + "                if (mouse_x >= width) mouse_x = width - 1;\n"
    s = s + "                if (mouse_y >= height) mouse_y = height - 1;\n"
    s = s + "                mouse_down = st.left_button;\n"
    s = s + "            } else |_| {}\n"
    s = s + "        }\n\n"
    # SimpleTextInput.readKeyStroke() already only succeeds once per genuinely
    # new keystroke (NotReady otherwise) -- an inherent edge, not a
    # continuous "key currently held" state, so no extra debouncing is
    # needed here the way mouse_down's rising edge needs handling Tauraro-side.
    s = s + "        var has_key = false;\n"
    s = s + "        var key_code: i64 = 0;\n"
    s = s + "        if (uefi.system_table.con_in) |con_in| {\n"
    s = s + "            if (con_in.readKeyStroke()) |k| {\n"
    s = s + "                has_key = true;\n"
    s = s + "                key_code = k.unicode_char;\n"
    s = s + "            } else |_| {}\n"
    s = s + "        }\n\n"
    s = s + "        const keep_going = " + entry_name + "(fb, width, height, pitch, mouse_x, mouse_y, mouse_down, has_key, key_code);\n"
    s = s + "        if (!keep_going) break;\n\n"
    s = s + "        bs.stall(16_000) catch {};\n"
    s = s + "    }\n"
    s = s + "    while (true) {\n"
    s = s + "        asm volatile (\"hlt\");\n"
    s = s + "    }\n"
    s = s + "}\n"
    return s

# Extra C compiler flags required for a given target triple.
pub def target_extra_flags(triple: str) -> str:
    # Bare-metal / freestanding: no OS, no libc
    if _tr_str_contains(triple, "none-eabi"):
        return " -nostdlib -freestanding -ffreestanding -DTAURARO_NO_OS=1"
    if _tr_str_contains(triple, "none-elf"):
        return " -nostdlib -freestanding -ffreestanding -DTAURARO_NO_OS=1"
    if _tr_str_contains(triple, "unknown-elf"):
        return " -nostdlib -freestanding -ffreestanding -DTAURARO_NO_OS=1"
    # WebAssembly bare (no WASI): no OS services
    if _tr_str_contains(triple, "wasm32-unknown-unknown"):
        return " -nostdlib --no-standard-libraries -DTAURARO_WASM=1 -DTAURARO_NO_OS=1"
    # WebAssembly with WASI: filesystem + clock available
    if _tr_str_contains(triple, "wasm32-wasi"):
        return " -DTAURARO_WASM=1"
    # Windows cross (MinGW): statically link runtime so no DLL deps
    if _tr_str_contains(triple, "mingw"): return " -static"
    return ""

# Detect the best compiler for cross-compilation to a given triple.
# Prefers clang (universal --target support) then NDK wrappers for Android.
pub def detect_cross_compiler(triple: str) -> str:
    mut null_dev = "/dev/null"
    if _tr_is_windows(): null_dev = "nul"
    # Android: check for NDK clang wrapper first
    if _tr_str_contains(triple, "android"):
        mut ndk = _tr_getenv("ANDROID_NDK_ROOT")
        if ndk == "": ndk = _tr_getenv("ANDROID_NDK_HOME")
        if ndk == "": ndk = _tr_getenv("NDK_HOME")
        if ndk != "":
            mut wrapper = ndk + "/toolchains/llvm/prebuilt/linux-x86_64/bin/" + triple + "-clang"
            if _tr_system("\"" + wrapper + "\" --version >" + null_dev + " 2>&1") == 0:
                return wrapper
    # Universal: clang supports --target natively on all platforms
    if _tr_system("clang --version >" + null_dev + " 2>&1") == 0: return "clang"
    return detect_c_compiler()

# LLD is the universal cross-linker: one linker that targets every architecture,
# so cross-compiling never needs a per-target GNU `ld`. Prefer the copy bundled
# beside the compiler (<exe_dir>/llvm/ld.lld), then any lld on PATH; return a clang
# `-fuse-ld=` flag, or "" to fall back to clang's default linker for the target.
# Absolute path to a zig bundled beside the compiler (<exe_dir>/zig/zig[.exe]), or
# "" if none is shipped. A bundled zig makes tauraro fully self-contained: `zig cc`
# provides clang codegen + lld + a libc for EVERY target, so no system C compiler or
# per-target sysroot is ever required — host and cross alike.
pub def detect_bundled_zig() -> str:
    mut ext = ""
    if _tr_is_windows(): ext = ".exe"
    mut z = _tr_exe_dir() + "/zig/zig" + ext
    if _tr_is_windows(): z = path_to_native(z)
    # Detect by file existence, not by executing zig: running a quoted absolute path
    # via _tr_system hits cmd.exe leading-quote-stripping edge cases on Windows and
    # pays zig's slow startup. Existence is enough — activate_bundled_zig then puts
    # the dir on PATH so `zig` resolves by bare name everywhere.
    if file_exists(z): return z
    return ""

# If a zig is bundled at <exe_dir>/zig/, prepend that directory to PATH so `zig` and
# `zig cc` resolve by BARE NAME for the rest of this process (and its child compiler
# invocations). Bare-name resolution sidesteps the cmd.exe leading-quote-strip issue
# and lets every existing `zig`/`zig cc` code path pick up the bundled toolchain with
# no change. Returns true if a bundled zig was activated. Idempotent-ish (only the
# PATH grows). Call once at startup, before any compilation.
pub def activate_bundled_zig() -> bool:
    mut zbin = detect_bundled_zig()
    if zbin == "": return false
    mut zdir = _tr_exe_dir() + "/zig"
    if _tr_is_windows(): zdir = path_to_native(zdir)
    mut sep = ":"
    if _tr_is_windows(): sep = ";"
    mut cur = _tr_getenv("PATH")
    _tr_setenv("PATH", zdir + sep + cur)
    return true

pub def detect_lld_flag() -> str:
    mut null_dev = "/dev/null"
    if _tr_is_windows(): null_dev = "nul"
    mut ext = ""
    if _tr_is_windows(): ext = ".exe"
    mut bundled = _tr_exe_dir() + "/llvm/ld.lld" + ext
    if _tr_is_windows(): bundled = path_to_native(bundled)
    if _tr_system("\"" + bundled + "\" --version >" + null_dev + " 2>&1") == 0:
        return " -fuse-ld=\"" + bundled + "\""
    if _tr_system("ld.lld --version >" + null_dev + " 2>&1") == 0: return " -fuse-ld=lld"
    if _tr_system("lld --version >" + null_dev + " 2>&1") == 0:    return " -fuse-ld=lld"
    return ""

# Map an LLVM target triple to the equivalent `zig cc -target` string. `zig cc` is
# clang plus BUNDLED libc (glibc/musl for Linux, wasi-libc for WASI, its own for
# Windows/macOS) for dozens of targets — so it cross-compiles with NO user sysroot.
# zig uses arch-os-abi like LLVM, but spells a few things differently (mingw ->
# windows-gnu, bare-metal -> freestanding). Returns "" if we have no mapping.
pub def zig_target_of(triple: str) -> str:
    # Windows (MinGW): zig calls it <arch>-windows-gnu.
    if _tr_str_contains(triple, "mingw") or _tr_str_contains(triple, "windows-gnu"):
        if _tr_str_contains(triple, "aarch64"): return "aarch64-windows-gnu"
        return "x86_64-windows-gnu"
    # WebAssembly: WASI (bundled wasi-libc) vs bare freestanding.
    if _tr_str_contains(triple, "wasm32-wasi") or _tr_str_contains(triple, "wasm32-wasip"): return "wasm32-wasi"
    if _tr_str_contains(triple, "wasm"): return "wasm32-freestanding"
    # Apple: zig targets macOS as <arch>-macos-none (linking frameworks still needs an SDK).
    if _tr_str_contains(triple, "apple") or _tr_str_contains(triple, "macos") or _tr_str_contains(triple, "darwin"):
        if _tr_str_contains(triple, "aarch64") or _tr_str_contains(triple, "arm64"): return "aarch64-macos-none"
        return "x86_64-macos-none"
    # UEFI: zig spells it x86_64-uefi (no vendor/abi component).
    if _tr_str_contains(triple, "uefi"): return "x86_64-uefi"
    # Bare-metal: zig 'freestanding' OS.
    if _tr_str_contains(triple, "none-eabi") or _tr_str_contains(triple, "none-elf") or _tr_str_contains(triple, "unknown-elf"):
        if _tr_str_contains(triple, "aarch64"): return "aarch64-freestanding-none"
        if _tr_str_contains(triple, "riscv64"): return "riscv64-freestanding-none"
        if _tr_str_contains(triple, "riscv32"): return "riscv32-freestanding-none"
        # "arm" (A32/ARM-mode) here, NOT "thumb": the turnkey bare-metal link
        # (below) always builds Cortex-M with `-mthumb`, and zig's prebuilt
        # compiler_rt for the "arm-freestanding-eabi" target ships inline asm
        # with predicated (conditional, non-IT-wrapped) instructions that are
        # valid A32 but rejected by a Thumb-2-only assembler ("<inline
        # asm>:14:2: predicated instructions must be in IT block") -- the
        # "thumb-freestanding-eabi" target's compiler_rt doesn't have this
        # problem, confirmed by linking+running examples/freestanding/mps2_pure.tr
        # under qemu (both the plain-hello and a 200-element List-growth stress
        # test) with the "thumb-" target and NOT with "arm-".
        if _tr_str_contains(triple, "arm"):     return "thumb-freestanding-eabi"
        return ""
    # Android and hosted Linux triples pass through — zig understands e.g.
    # aarch64-linux-gnu, x86_64-linux-musl, aarch64-linux-android.
    if _tr_str_contains(triple, "android"): return triple
    if _tr_str_contains(triple, "linux"):
        # zig spells 32-bit ARM as 'arm', not 'armv7'.
        if _tr_str_contains(triple, "armv7"): return "arm" + slice_after_arch(triple)
        return triple
    return triple

# Given a triple like "armv7-linux-gnueabihf", return the substring from the first
# '-' onward ("-linux-gnueabihf") so a caller can swap the arch token.
pub def slice_after_arch(triple: str) -> str:
    mut p = triple as Pointer[char]
    mut i = 0
    while True:
        mut c = p.offset(i).read() as int
        if c == 0: return ""
        if c == 45: return triple.slice(i, str_len_of(triple))   # '-'
        i = i + 1
    return ""

# True if a build's OUTPUT targets Windows (needs Winsock2 / -mconsole): the host
# OS for a native build, or the TARGET triple when cross-compiling. Keying Windows
# link libs on the host is wrong when cross-compiling FROM Windows TO Linux/wasm.
pub def out_is_windows(target: str, triple: str) -> bool:
    if target == "": return _tr_is_windows()
    return _tr_str_contains(triple, "windows") or _tr_str_contains(triple, "mingw")

# Length of a NUL-terminated string.
pub def str_len_of(s: str) -> int:
    mut p = s as Pointer[char]
    mut n = 0
    while p.offset(n).read() as int != 0: n = n + 1
    return n

# Resolve a cross-compilation C driver for `triple`, returning the compiler PLUS its
# target-select flag, ready to prepend to the compile/link flags. Shared by both the
# C and LLVM backends so cross behaves identically. `zig cc` (if installed) is
# preferred — it bundles a libc for the target, so NO sysroot is needed; otherwise
# this reproduces the existing NDK -> clang behavior exactly (purely additive).
pub def resolve_cross_driver(triple: str) -> str:
    mut null_dev = "/dev/null"
    if _tr_is_windows(): null_dev = "nul"
    if _tr_system("zig version >" + null_dev + " 2>&1") == 0:
        mut zt = zig_target_of(triple)
        if zt != "": return "zig cc -target " + zt
    return detect_cross_compiler(triple) + " --target=" + triple

pub def dir_of_path(path: str) -> str:
    mut p = path as Pointer[char]
    mut len = 0
    while p.offset(len).read() as int != 0: len = len + 1
    mut end = len
    while end > 0:
        mut c = p.offset(end - 1).read() as int
        if c == 47 or c == 92: return path.slice(0, end)
        end = end - 1
    return "./"

pub def strip_trailing_sep_inline(s: str) -> str:
    mut n = 0
    mut p = s as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    if n == 0: return s
    mut last = p.offset(n - 1).read() as int
    if last == 47 or last == 92: return s.slice(0, n - 1)
    return s

# Locate runtime/native_abi.c for the LLVM/native link step (same search order as the
# runtime header: repo layout, beside the binary, beside the input, CWD). Returns "".
pub def find_native_abi_c(input_path: str) -> str:
    if file_exists("tauraro/runtime/native_abi.c"): return "tauraro/runtime/native_abi.c"
    mut bin_dir = _tr_exe_dir() + "/"
    if file_exists(bin_dir + "native_abi.c"): return bin_dir + "native_abi.c"
    if file_exists(bin_dir + "runtime/native_abi.c"): return bin_dir + "runtime/native_abi.c"
    if input_path != "":
        mut src_dir = dir_of_path(input_path)
        if file_exists(src_dir + "native_abi.c"): return src_dir + "native_abi.c"
        mut parent = dir_of_path(strip_trailing_sep_inline(src_dir))
        if file_exists(parent + "runtime/native_abi.c"): return parent + "runtime/native_abi.c"
        mut gp = dir_of_path(strip_trailing_sep_inline(parent))
        if file_exists(gp + "runtime/native_abi.c"): return gp + "runtime/native_abi.c"
    if file_exists("runtime/native_abi.c"): return "runtime/native_abi.c"
    return ""

pub def read_runtime_header(bin_path: str, input_path: str) -> str:
    # 1. Canonical repo location relative to CWD.
    if file_exists("tauraro/runtime/tauraro_rt.h"): return read_file("tauraro/runtime/tauraro_rt.h")
    # 2. Next to the compiler binary (flat install: binary beside tauraro_rt.h).
    #    Use the OS-reported exe dir, not argv[0]: when the compiler is invoked
    #    by bare name via PATH (e.g. by taupkg), argv[0] has no directory.
    mut bin_dir = _tr_exe_dir() + "/"
    mut src1 = bin_dir + "tauraro_rt.h"
    if file_exists(src1): return read_file(src1)
    # 2b. runtime/ subfolder beside the binary (structured install: binary in
    #     tauraroc-{platform}/, runtime header in tauraroc-{platform}/runtime/).
    #     This is the layout used by taupkg install-tauraro and CI release zips.
    mut src1b = bin_dir + "runtime/tauraro_rt.h"
    if file_exists(src1b): return read_file(src1b)
    # 3. Relative to the input source file - works even when the binary is moved.
    #    Walk up: src_dir -> parent -> grandparent, checking for runtime/tauraro_rt.h at each level.
    if input_path != "":
        mut src_dir = dir_of_path(input_path)
        if file_exists(src_dir + "tauraro_rt.h"): return read_file(src_dir + "tauraro_rt.h")
        mut parent = dir_of_path(strip_trailing_sep_inline(src_dir))
        if file_exists(parent + "runtime/tauraro_rt.h"): return read_file(parent + "runtime/tauraro_rt.h")
        if file_exists(parent + "tauraro_rt.h"): return read_file(parent + "tauraro_rt.h")
        mut gp = dir_of_path(strip_trailing_sep_inline(parent))
        if file_exists(gp + "runtime/tauraro_rt.h"): return read_file(gp + "runtime/tauraro_rt.h")
        if file_exists(gp + "tauraro_rt.h"): return read_file(gp + "tauraro_rt.h")
    # 4. Last resort relative to CWD.
    if file_exists("runtime/tauraro_rt.h"): return read_file("runtime/tauraro_rt.h")
    return ""

pub def ensure_runtime_header(out_dir: str, bin_path: str, input_path: str):
    mut dest = out_dir + "tauraro_rt.h"
    if file_exists(dest): return
    mut content = read_runtime_header(bin_path, input_path)
    if content != "":
        write_file(dest, content)

pub def sync_headers_to_runtime(rt_content: str, types_content: str):
    # tauraro/runtime/tauraro_rt.h is the canonical hand-written runtime - keep it in sync.
    # tauraro_types.h is program-specific and generated fresh each compilation; don't sync it.
    write_file("tauraro/runtime/tauraro_rt.h", rt_content)

pub def strip_trailing_sep(s: str) -> str:
    mut n = 0
    mut p = s as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    if n == 0: return s
    mut last = p.offset(n - 1).read() as int
    if last == 47 or last == 92: return s.slice(0, n - 1)
    return s

# Walk a PATH-style env-var string and call add_fn for each non-empty entry.
# Uses ';' as separator on Windows, ':' on POSIX.
# Returns the number of paths found.
pub def count_path_env_entries(s: str) -> int:
    mut sep = 58  # ':' on POSIX
    if _tr_is_windows(): sep = 59  # ';' on Windows
    mut p = s as Pointer[char]
    mut n = 0
    while p.offset(n).read() as int != 0: n = n + 1
    mut count = 0
    mut start = 0
    mut i = 0
    while i <= n:
        mut c = 0
        if i < n: c = p.offset(i).read() as int
        if c == sep or i == n:
            if i > start: count = count + 1
            start = i + 1
        i = i + 1
    return count

# Return the idx-th entry (0-based) from a PATH-style env-var string, or "" if out of range.
pub def get_path_env_entry(s: str, idx: int) -> str:
    mut sep = 58  # ':' on POSIX
    if _tr_is_windows(): sep = 59  # ';' on Windows
    mut p = s as Pointer[char]
    mut n = 0
    while p.offset(n).read() as int != 0: n = n + 1
    mut cur = 0
    mut start = 0
    mut i = 0
    while i <= n:
        mut c = 0
        if i < n: c = p.offset(i).read() as int
        if c == sep or i == n:
            if i > start:
                if cur == idx: return s.slice(start, i)
                cur = cur + 1
            start = i + 1
        i = i + 1
    return ""

# Make a path runnable via system(): bare filenames (no directory component)
# are not found by cmd.exe's command search on Windows, so prefix them with
# "./" (converted to ".\\" by path_to_native) when no separator is present.
pub def to_runnable_path(s: str) -> str:
    if s.contains("/") or s.contains("\\"):
        return s
    return "./" + s

pub def path_to_native(s: str) -> str:
    mut n = 0
    mut p = s as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    mut buf = s.slice(0, n)
    mut bp = buf as Pointer[char]
    mut j = 0
    while j < n:
        if bp.offset(j).read() as int == 47:
            unsafe: bp.offset(j).write(92 as char)
        j = j + 1
    return buf

# Convert backslashes to forward slashes, for embedding a path in a C string
# literal (e.g. a `#line N "path"` directive). GCC/Clang accept forward slashes
# on every platform, and forward slashes need no escaping inside a C string.
pub def to_fwd_slashes(s: str) -> str:
    mut n = 0
    mut p = s as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    mut buf = s.slice(0, n)
    mut bp = buf as Pointer[char]
    mut j = 0
    while j < n:
        if bp.offset(j).read() as int == 92:
            unsafe: bp.offset(j).write(47 as char)  # '\' -> '/'
        j = j + 1
    return buf

# Replace '.' with '_' in a dotted module path.
pub def dot_to_safe(s: str) -> str:
    mut n = 0
    mut p = s as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    mut buf = s.slice(0, n)
    mut bp = buf as Pointer[char]
    mut j = 0
    while j < n:
        if bp.offset(j).read() as int == 46:
            unsafe: bp.offset(j).write(95 as char)  # '.' -> '_'
        j = j + 1
    return buf

# Last segment of a dotted path: "a.b.c" -> "c"
pub def dot_last_seg(s: str) -> str:
    mut n = 0
    mut p = s as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    mut last_dot = -1
    mut j = 0
    while j < n:
        if p.offset(j).read() as int == 46: last_dot = j
        j = j + 1
    if last_dot < 0: return s
    return s.slice(last_dot + 1, n)

# Filename without directory: "dir/foo.tr" -> "foo.tr"
pub def get_filename(path: str) -> str:
    mut n = 0
    mut p = path as Pointer[char]
    while p.offset(n).read() as int != 0: n = n + 1
    mut last_sep = -1
    mut j = 0
    while j < n:
        mut c = p.offset(j).read() as int
        if c == 47 or c == 92: last_sep = j
        j = j + 1
    if last_sep < 0: return path
    return path.slice(last_sep + 1, n)

# True if `path` contains a directory separator ('/' or '\').
pub def has_path_sep(path: str) -> bool:
    mut p = path as Pointer[char]
    mut i = 0
    while True:
        mut c = p.offset(i).read() as int
        if c == 0: return false
        if c == 47 or c == 92: return true   # '/' or '\'
        i = i + 1
    return false

# Normalize a -d output-directory value to a prefix ending in exactly one
# separator (e.g. "out" -> "out/"), or "" for the current working directory.
# Creates the directory so the subsequent write/link succeeds.
pub def out_dir_prefix(out_dir: str) -> str:
    if out_dir == "": return ""
    mut d = out_dir
    if not (d.ends_with("/") or d.ends_with("\\")):
        d = d + "/"
    make_dir(d)
    return d

# Unified output-path resolver shared by ALL backends (C / LLVM / native) so that
# `-o` / `-d` / the default behave identically regardless of --backend. Returns
# the path WITHOUT the artifact extension; the caller appends its own (.exe / ""
# / .o / .dll) via ensure_ext.
#   * -o <path> containing a separator (or absolute) -> respected verbatim; -d ignored.
#   * -o <bare-name>                                 -> placed in the -d dir, else CWD.
#   * no -o                                          -> input file's stem, in the -d dir else CWD.
# Note the default is the CURRENT WORKING DIRECTORY (not the input file's dir and
# not ./build) — the executable lands where the command is run.
pub def resolve_output_stem(input_path: str, output_path: str, out_dir: str) -> str:
    if output_path != "" and has_path_sep(output_path):
        make_dir(dir_of_path(output_path))       # create the -o directory if absent
        return output_path                       # explicit path wins; honor its dir
    mut pref = out_dir_prefix(out_dir)           # "" (CWD) or "<dir>/"
    if output_path != "":
        return pref + output_path                # bare -o name in the target dir
    return pref + strip_extension(get_filename(input_path))   # default: input stem

# ASCII-only lowercase (extensions are always ASCII -- .exe/.efi/.dll/.so/...
# -- so this needn't handle Unicode case folding).
def ascii_lower(s: str) -> str:
    unsafe:
        mut p = s as Pointer[char]
        mut n = 0
        while p.offset(n).read() as int != 0: n = n + 1
        mut buf = alloc[char](n + 1)
        mut i = 0
        while i < n:
            mut c = p.offset(i).read() as int
            if c >= 65 and c <= 90: c = c + 32   # 'A'-'Z' -> 'a'-'z'
            buf.offset(i).write(c as char)
            i = i + 1
        buf.offset(n).write(0 as char)
        return buf as str

# Append `ext` unless `path` already ends with it (idempotent, so `-o foo.exe`
# does not become foo.exe.exe; case-insensitive so `-o App.EFI` isn't seen as
# missing its own `.efi` suffix and doubled to "App.EFI.efi" -- Windows/FAT/
# UEFI filenames are conventionally case-insensitive). Empty ext is a no-op
# (Unix executables).
pub def ensure_ext(path: str, ext: str) -> str:
    if ext == "": return path
    if ascii_lower(path).ends_with(ascii_lower(ext)): return path
    return path + ext

# Count dots to get depth
pub def get_dot_depth(dot_path: str) -> int:
    mut p = dot_path as Pointer[char]
    mut dots = 0
    mut i = 0
    while True:
        mut c = p.offset(i).read() as int
        if c == 0: break
        if c == 46: dots = dots + 1
        i = i + 1
    return dots + 1

# Create standard package directories under build/include/ recursively
pub def ensure_builtin_dirs(build_dir: str, dot_path: str) -> str:
    mut current = build_dir + "include/"
    make_dir(current)
    
    # Split by '.'
    mut p = dot_path as Pointer[char]
    mut start = 0
    mut i = 0
    while True:
        mut c = p.offset(i).read() as int
        if c == 0:
            # Last segment is the file name
            mut last_seg = dot_path.slice(start, i)
            return current + last_seg + ".c"
        if c == 46: # '.'
            mut seg = dot_path.slice(start, i)
            current = current + seg + "/"
            make_dir(current)
            start = i + 1
        i = i + 1
    return ""

# True if dotted path starts with "core" or "std"
pub def is_builtin_mod(dot_path: str) -> bool:
    mut p = dot_path as Pointer[char]
    
    # Check "core"
    mut is_core = true
    if p.offset(0).read() as int != 99: is_core = false   # 'c'
    if p.offset(1).read() as int != 111: is_core = false  # 'o'
    if p.offset(2).read() as int != 114: is_core = false  # 'r'
    if p.offset(3).read() as int != 101: is_core = false  # 'e'
    if is_core:
        mut c5 = p.offset(4).read() as int
        if c5 == 0 or c5 == 46: return true
        
    # Check "std"
    mut is_std = true
    if p.offset(0).read() as int != 115: is_std = false   # 's'
    if p.offset(1).read() as int != 116: is_std = false   # 't'
    if p.offset(2).read() as int != 100: is_std = false   # 'd'
    if is_std:
        mut c4 = p.offset(3).read() as int
        if c4 == 0 or c4 == 46: return true
        
    return false

# Create a directory; cross-platform via _tr_mkdir (single level) or shell fallback.
pub def make_dir(path: str):
    if _tr_is_windows():
        _tr_system("mkdir \"" + path_to_native(path) + "\" 2>nul >nul")
    else:
        _tr_system("mkdir -p \"" + path + "\" 2>/dev/null")

# Compile a list of C files into a single exe.
# link_paths: path-based files (.c/.o/.a/.dll/.lib) - quoted in the command.
# lib_flags:  -l<name> library flags - appended verbatim after all file args.
pub def compile_all_c(c_files: Vec[str], exe_path: str, inc_dir: str,
                      link_paths: Vec[str], lib_flags: Vec[str],
                      opt_level: str, verbose: bool, static_link: bool,
                      target: str, sysroot: str, debug_mode: bool) -> int:
    mut cc = detect_c_compiler()
    mut triple = ""
    mut cross_flags = ""
    if target != "":
        triple = resolve_target_triple(target)
        cc = resolve_cross_driver(triple)              # compiler + target-select flag (zig cc if installed)
        cross_flags = target_extra_flags(triple)
        if sysroot != "":
            cross_flags = cross_flags + " --sysroot=\"" + sysroot + "\""
    mut static_flag = ""
    if static_link: static_flag = " -static"
    # Flags valid on both GCC and Clang.
    mut warn_flags = " -Wno-string-compare -Wno-comment -Wno-attributes -Wno-unused-value"
    # Clang-only: suppress warnings that are Clang-specific or have no GCC equivalent.
    if is_clang_compiler(cc):
        warn_flags = warn_flags + " -Wno-unknown-attributes -Wno-parentheses-equality"
    mut native_flags = ""
    if target == "" and opt_level == "3":
        native_flags = " -march=native -funroll-loops"
    # -ftrapv: make signed integer overflow a runtime trap (defined behavior) instead of UB.
    # Disabled at O3/Os where the user explicitly prioritises speed over safety checks.
    mut overflow_flag = ""
    if opt_level != "3" and opt_level != "s":
        overflow_flag = " -ftrapv"
    mut cmd = cc + " -O" + opt_level + overflow_flag + static_flag + native_flags + cross_flags + warn_flags + " -DTAURARO_NO_RT_HELPERS \"-I" + inc_dir + "\" -o \"" + exe_path + "\""
    mut i = 0
    while i < c_files.len:
        cmd = cmd + " \"" + c_files.get(i) + "\""
        i = i + 1
    i = 0
    while i < link_paths.len:
        cmd = cmd + " \"" + link_paths.get(i) + "\""
        i = i + 1
    i = 0
    while i < lib_flags.len:
        cmd = cmd + " " + lib_flags.get(i)
        i = i + 1
    cmd = cmd + " -lm"
    if debug_mode:
        cmd = cmd + " -fsanitize=address,undefined -g"
    # Windows OUTPUT: link Winsock2 when any networking module is present.
    # Target-gated so a Windows->Linux/wasm cross does not request ws2_32.
    if out_is_windows(target, triple):
        mut need_wsa: bool = false
        mut wi = 0
        while wi < c_files.len:
            mut cf = c_files.get(wi)
            if _tr_str_contains(cf, "tcp.c") or _tr_str_contains(cf, "/net/"):
                need_wsa = true
            wi = wi + 1
        if need_wsa:
            cmd = cmd + " -lws2_32 -lbcrypt -mconsole"
    if verbose: print("  [CC] " + cmd)
    return _tr_system(cmd)

# Map a generated C file path to its object-file path (foo.c -> foo.o).
pub def obj_path_for(c_path: str) -> str:
    mut n = c_path.len()
    if n > 2:
        mut tail = c_path.slice(n - 2, n)
        if tail == ".c":
            return c_path.slice(0, n - 2) + ".o"
    return c_path + ".o"

# Incremental compile + link.
#
# Each module's C is compiled to its own .o with `gcc -c`; modules whose
# generated .c was unchanged since the previous build (needs[i]==false) and
# whose .o still exists are NOT recompiled - their cached .o is reused. All
# .o files are then linked into the final executable. A global change to the
# shared headers or compile flags forces `needs[i]=true` for every module
# upstream in the caller, so header/flag changes invalidate the whole cache.
#
# This is correctness-preserving: identical .c + identical flags produce an
# identical .o, so reusing it yields the same program as a from-scratch build.
pub def compile_all_c_incremental(c_files: Vec[str], needs: Vec[bool], exe_path: str, inc_dir: str,
                      link_paths: Vec[str], lib_flags: Vec[str],
                      opt_level: str, verbose: bool, static_link: bool,
                      target: str, sysroot: str, debug_mode: bool, build_shared: bool,
                      link_cxx: bool, use_lto: bool) -> int:
    mut cc = detect_c_compiler()
    mut triple = ""
    mut cross_flags = ""
    if target != "":
        triple = resolve_target_triple(target)
        cc = resolve_cross_driver(triple)              # compiler + target-select flag (zig cc if installed)
        cross_flags = target_extra_flags(triple)
        if sysroot != "":
            cross_flags = cross_flags + " --sysroot=\"" + sysroot + "\""
    mut static_flag = ""
    if static_link: static_flag = " -static"
    mut warn_flags = " -Wno-string-compare -Wno-comment -Wno-attributes -Wno-unused-value"
    if is_clang_compiler(cc):
        warn_flags = warn_flags + " -Wno-unknown-attributes -Wno-parentheses-equality"
    mut native_flags = ""
    if target == "" and opt_level == "3":
        native_flags = " -march=native -funroll-loops"
    mut overflow_flag = ""
    if opt_level != "3" and opt_level != "s":
        overflow_flag = " -ftrapv"
    mut dbg = ""
    if debug_mode:
        dbg = " -fsanitize=address,undefined -g"
    # Shared-library builds need position-independent code in every object.
    mut pic = ""
    if build_shared: pic = " -fPIC"
    # Zero-cost C++ interop: with a linked C++ shim, compile every Tauraro object as
    # LTO bitcode too so the final LTO link inlines the extern-"C" wrapper away.
    mut lto_flag = ""
    if use_lto: lto_flag = " -flto"
    # Flags common to both per-module `-c` compiles and the final link.
    mut common = " -O" + opt_level + overflow_flag + static_flag + native_flags + cross_flags + warn_flags + dbg + pic + lto_flag + " -DTAURARO_NO_RT_HELPERS \"-I" + inc_dir + "\""

    # -- 1. Compile each changed module to its .o ------------------------------
    mut o_files = Vec[str].init(c_files.len)
    mut i = 0
    mut compiled = 0
    while i < c_files.len:
        mut cpath = c_files.get(i)
        mut opath = obj_path_for(cpath)
        o_files.push(opath)
        if needs.get(i) or not file_exists(opath):
            mut ccmd = cc + common + " -c \"" + cpath + "\" -o \"" + opath + "\""
            if verbose: print("  [CC -c] " + cpath)
            mut crc = _tr_system(ccmd)
            if crc != 0:
                print(c_red("error") + ": compiling " + cpath + " failed (exit code " + str(crc) + ")")
                return crc
        else:
            compiled = compiled + 1
        i = i + 1
    if verbose: print("  [incremental] reused " + str(compiled) + " of " + str(c_files.len) + " cached object(s)")

    # -- 2. Link all .o into the output executable (or shared library) ---------
    mut shared_flag = ""
    if build_shared: shared_flag = " -shared"
    # A linked C++ shim needs the C++ driver so libstdc++ and the exception
    # personality are pulled in (and, under LTO, so bitcode objects link in place).
    mut link_driver = cc
    if link_cxx: link_driver = cxx_of(cc)
    mut cmd = link_driver + common + shared_flag + " -o \"" + exe_path + "\""
    i = 0
    while i < o_files.len:
        cmd = cmd + " \"" + o_files.get(i) + "\""
        i = i + 1
    i = 0
    while i < link_paths.len:
        cmd = cmd + " \"" + link_paths.get(i) + "\""
        i = i + 1
    i = 0
    while i < lib_flags.len:
        cmd = cmd + " " + lib_flags.get(i)
        i = i + 1
    cmd = cmd + " -lm"
    if out_is_windows(target, triple):
        # ws2_32 is needed for sockets AND for the async scheduler's reactor
        # (select/FD_ISSET on Windows). It is a standard system import library,
        # so always link it; -mconsole keeps console apps as console subsystem.
        # Gated on the TARGET, not the host — a Windows->Linux cross has no ws2_32.
        cmd = cmd + " -lws2_32 -lbcrypt -mconsole"
    if verbose: print("  [LINK] " + cmd)
    return _tr_system(cmd)

pub def compile_c_to_exe(c_path: str, exe_path: str, opt_level: str, verbose: bool) -> int:
    mut cc = detect_c_compiler()
    mut opt_flag = "-O" + opt_level
    mut out_dir = strip_trailing_sep(dir_of_path(c_path))
    mut warn_flags = " -Wno-string-compare -Wno-comment -Wno-attributes -Wno-unused-value"
    if is_clang_compiler(cc):
        warn_flags = warn_flags + " -Wno-unknown-attributes -Wno-parentheses-equality"
    mut cmd = cc + " " + opt_flag + warn_flags + " -DTAURARO_NO_RT_HELPERS \"-I" + out_dir + "\" -o \"" + exe_path + "\" \"" + c_path + "\" -lm"
    if verbose: print("  [CC] " + cmd)
    return _tr_system(cmd)

# --- Build cleanup ------------------------------------------------------------
# -- Error/warning formatting --------------------------------------------------
# Print a compiler diagnostic in a clean, human-readable format:
#   file.tr:42: error [M-1]: Use after move ...
#              ^^^ FIX: Copy the value before moving ...
#
# Input `msg` has the form the sema produces:
#   "file:line: [CODE] main message. FIX: hint."   (with file)
#   "line: [CODE] main message. FIX: hint."         (no file)
#   "[CODE] main message. FIX: hint."               (no line)
pub def _print_diag(level: str, msg: str):
    # Separate the "FIX:" hint from the message body.
    mut fix_part  = ""
    mut main_part = msg
    mut fix_idx = msg.index_of("FIX:")
    if fix_idx >= 0:
        main_part = msg.slice(0, fix_idx).trim()
        fix_part  = msg.slice(fix_idx + 4, msg.len()).trim()
    # Peel off a leading "file:line: " location (first ": " past the prefix; the
    # last ':' in the head splits file from line, so Windows C:\ paths survive).
    mut loc_str   = ""
    mut file_path = ""
    mut line_no   = 0
    mut body      = main_part
    mut pe = main_part.index_of(": ")
    if pe > 0:
        mut head = main_part.slice(0, pe)
        mut ln   = loc_line(head)
        if ln > 0:                       # guards against a body that merely has ": "
            loc_str   = head
            file_path = loc_file(head)
            line_no   = ln
            body      = main_part.slice(pe + 2, main_part.len())
    # Header line: colored severity + bold message.
    mut lvl = c_red(level)
    if level == "warning":
        lvl = c_yellow(level)
    print(lvl + ": " + c_bold(body))
    if loc_str.len() > 0:
        print("  " + c_cyan("-->") + " " + loc_str)
        # Source excerpt + caret under the first quoted identifier (semantic
        # diagnostics carry no column, so we locate the name in the line text).
        mut src = ""
        if file_path.len() > 0:
            src = read_file(file_path)
        if src.len() > 0:
            mut srcline = _nth_source_line(src, line_no)
            if srcline.len() > 0:
                mut gnum = "   " + str(line_no) + " | "
                mut gbar = spaces(gnum.len() - 2) + "| "
                print(c_dim(gnum) + srcline)
                mut name = first_quoted(msg)
                mut col  = col_of(srcline, name)
                if col > 0:
                    mut underline = repeat_char("^", name.len())
                    mut caret = c_red(underline)
                    if level == "warning":
                        caret = c_yellow(underline)
                    print(c_dim(gbar) + spaces(col - 1) + caret)
    if fix_part.len() > 0:
        print("  " + c_green("= help") + ": " + fix_part)


# Called when -o is given: removes all intermediate files from build_dir,
# leaving the directory empty so rmdir can remove it.
# Deletes: *.c files, tauraro_types.h, tauraro_rt.h, include/ tree, then build/ itself.

pub def cleanup_build(build_dir: str, all_c_files: Vec[str]):
    mut di = 0
    while di < all_c_files.len:
        if _tr_is_windows():
            _tr_system("del /Q \"" + path_to_native(all_c_files.get(di)) + "\" 2>nul >nul")
        else:
            _tr_system("rm -f \"" + all_c_files.get(di) + "\"")
        di = di + 1
    if _tr_is_windows():
        _tr_system("del /Q \""   + path_to_native(build_dir + "tauraro_types.h") + "\" 2>nul >nul")
        _tr_system("del /Q \""   + path_to_native(build_dir + "tauraro_rt.h")    + "\" 2>nul >nul")
        _tr_system("rmdir /S /Q \"" + path_to_native(build_dir + "include")       + "\" 2>nul >nul")
        _tr_system("rmdir \""    + path_to_native(build_dir)                      + "\" 2>nul >nul")
    else:
        _tr_system("rm -f \""   + build_dir + "tauraro_types.h\"")
        _tr_system("rm -f \""   + build_dir + "tauraro_rt.h\"")
        _tr_system("rm -rf \""  + build_dir + "include\"")
        _tr_system("rmdir \""   + build_dir + "\" 2>/dev/null")

# --- `tauraroc fmt` -----------------------------------------------------------
# Parse a single source file (no module resolution) and re-emit it in canonical
# form, preserving comments. Prints to stdout, or rewrites the file with -w.
pub def run_fmt(path0: str, write_in_place: bool):
    mut path = path0
    if not file_exists(path) and not str_ends_with_dot_tr(path):
        path = path + ".tr"
    mut source = read_file(path)
    if source == "":
        print("error: cannot read " + path)
        _tr_exit(1)
    mut lexer = Lexer.init(source)
    lexer.record_comments = true
    mut tokens = lexer.tokenize()
    mut parser = Parser.init(tokens, lexer.token_lines)
    parser.current_file = path
    parser.cols = lexer.token_cols
    parser.src_text = source
    mut prog = parser.parse_program()
    if parser.error_count > 0:
        print("error: " + parser.error_count.to_str() + " parse error(s); not formatting " + path)
        _tr_exit(1)
    mut f = Formatter.init(lexer.comment_lines, lexer.comment_texts, lexer.comment_trailing)
    mut formatted = f.format_program(prog)
    if f.unsupported:
        print("error: " + path + " uses a construct the formatter does not yet support; leaving it unchanged")
        _tr_exit(1)
    if write_in_place:
        write_file(path, formatted)
        print("formatted " + path)
    else:
        # Avoid print()'s extra newline (formatted already ends in one).
        _tr_print_raw(formatted)

# --- Main entry point ---------------------------------------------------------

pub def main(args: Vec[str]):
    # If a zig is bundled beside the compiler, put it on PATH first so every
    # `zig`/`zig cc` toolchain lookup (host fallback + all cross targets) finds it —
    # making tauraro a self-contained toolchain with no external downloads.
    activate_bundled_zig()

    if args.len < 2:
        print_usage()
        _tr_exit(1)

    if args.len == 2 and args.get(1) == "--version":
        print_version()
        _tr_exit(0)

    # Subcommands: `tauraroc fmt [-w] <file>`, `tauraroc lint <file>`, `tauraroc bindgen <hdr>`.
    mut subcmd = ""
    if args.len >= 2:
        mut a1 = args.get(1)
        if a1 == "fmt" or a1 == "lint" or a1 == "bindgen": subcmd = a1
    if subcmd == "bindgen":
        # tauraroc bindgen <header.h> [-o out.tr] [--cc <compiler>] [-h cpp]  -> FFI bindings.
        # Default binds a C header; `-h cpp` binds a C++ header (auto-generates a C++->C shim
        # via libclang — required only for C++, detected at use time).
        mut bg_header = ""
        mut bg_out    = "bindings.tr"
        mut bg_cc     = detect_c_compiler()
        mut bg_cpp    = false
        mut bg_extra  = ""    # -h cpp: clang passthrough flags (-I / -D / -std= / -isystem)
        mut bg_pkglibs = ""   # --pkg <name>: link flags discovered via pkg-config (-L / -l)
        mut bg_macros = false # --macros: also bind function-like C macros via a compile-verified shim
        mut bk = 2
        while bk < args.len:
            mut ba = args.get(bk)
            if ba == "--pkg" and bk + 1 < args.len:
                # Auto-discover a library's flags: cflags feed parsing + the shim compile, libs are
                # recorded in the binding so `tauraroc` auto-links them (no manual -I/-D/-l).
                mut pkgname = args.get(bk + 1)
                bk = bk + 1
                mut pkgcf = pkg_config_query(pkgname, "--cflags")
                mut pkglf = pkg_config_query(pkgname, "--libs")
                if pkgcf == "" and pkglf == "":
                    print(c_yellow("warning") + ": pkg-config found no package '" + pkgname + "' — pass -I/-D/-l manually")
                if pkgcf != "": bg_extra = bg_extra + " " + pkgcf
                if pkglf != "": bg_pkglibs = bg_pkglibs + " " + pkglf
            elif ba == "-o" and bk + 1 < args.len:
                bg_out = args.get(bk + 1)
                bk = bk + 1
            elif ba == "--cc" and bk + 1 < args.len:
                bg_cc = args.get(bk + 1)
                bk = bk + 1
            elif ba == "-h" and bk + 1 < args.len:
                if args.get(bk + 1) == "cpp": bg_cpp = true
                bk = bk + 1
            elif ba == "--cpp":
                bg_cpp = true
            elif ba == "--macros":
                bg_macros = true
            elif ba == "-I" and bk + 1 < args.len:
                bg_extra = bg_extra + " -I\"" + args.get(bk + 1) + "\""
                bk = bk + 1
            elif ba == "-D" and bk + 1 < args.len:
                bg_extra = bg_extra + " -D" + args.get(bk + 1)
                bk = bk + 1
            elif ba == "-isystem" and bk + 1 < args.len:
                bg_extra = bg_extra + " -isystem \"" + args.get(bk + 1) + "\""
                bk = bk + 1
            elif str_starts_with(ba, "-I") or str_starts_with(ba, "-D") or str_starts_with(ba, "-std=") or str_starts_with(ba, "-f"):
                bg_extra = bg_extra + " " + ba
            elif not str_starts_with(ba, "-"):
                if bg_header == "": bg_header = ba
            bk = bk + 1
        if bg_header == "":
            print("error: bindgen requires a header: tauraroc bindgen <header.h> [-o out.tr] [--cc <compiler>] [-h cpp] [-I<dir>] [-D<macro>]")
            _tr_exit(1)
        if bg_cpp:
            run_bindgen_cpp(bg_header, bg_out, bg_cc, bg_extra, bg_pkglibs)
        else:
            run_bindgen(bg_header, bg_out, bg_cc, bg_extra, bg_pkglibs, bg_macros)
        _tr_exit(0)
    if subcmd == "fmt":
        mut write_in_place = false
        mut fpath = ""
        mut fk = 2
        while fk < args.len:
            mut fa = args.get(fk)
            if fa == "-w" or fa == "--write": write_in_place = true
            elif not str_starts_with(fa, "-"):
                if fpath == "": fpath = fa
            fk = fk + 1
        if fpath == "":
            print("error: fmt requires a file: tauraroc fmt [-w] <file.tr>")
            _tr_exit(1)
        run_fmt(fpath, write_in_place)
        _tr_exit(0)

    mut input_path  = ""
    mut output_path = ""             # -o <path> : exact output path (dir honored)
    mut out_dir     = ""             # -d <dir>  : output DIRECTORY (default: CWD)
    mut backend     = "c"
    mut emit_mode   = "exe"   # "exe" | "c" | "ast" | "mir" | "gpu"
    mut gpu_target  = "spirv" # --gpu-target <spirv|nvptx> : GPU kernel IR flavor for --emit gpu
    mut gpu_embed   = ""      # --gpu-embed <spirv|nvptx>  : auto-compile @kernel fns via llc and embed the module (Module.embedded())
    mut emit_ld     = ""      # --emit-ld PATH : also write a Cortex-M linker script (bare-metal @entry builds)
    mut run_after   = false
    mut check_only  = false
    mut verbose     = false
    mut opt_level   = "2"
    mut link_paths  = Vec[str].init(8)   # --link <path>  : quoted file paths
    mut lib_flags   = Vec[str].init(8)   # -l<name>       : verbatim -l flags
    mut static_link = false              # --static        : pass -static to GCC
    mut target      = ""                 # --target <name> : cross-compilation target
    mut sysroot     = ""                 # --sysroot <path>: explicit sysroot
    mut debug_mode  = false              # --debug         : ASAN + assertions
    mut strict_mode = false              # --strict        : alloc outside unsafe -> hard error
    mut no_elide    = false              # --no-elide      : disable zero-copy borrow elision -> pure ARC (differential-soundness oracle)
    mut no_heap     = false              # --no-heap       : reject heap-allocating types (List/Dict/Set/heap class/dynamic str) -> structurally zero-heap for bare metal
    mut tier_define = ""                 # --freestanding=>TAURARO_KERNEL (no libc), --no-std=>TAURARO_NO_OS (no OS); auto-emitted so the bare-metal build needs no hand-passed -D
    mut lib_mode    = false              # --lib           : build a shared library (.so/.dll) of `export def`s + a header
    mut no_auto_cpp = false              # --no-auto-cpp    : don't auto-compile/link bindgen C++ shims (link them manually with --link)
    mut export_cpp  = false              # --export-cpp     : also emit an ergonomic C++ header (call Tauraro from C++); implies --lib

    # `tauraroc lint <file>` runs resolution + semantic analysis and reports
    # warnings/errors without producing an executable (like --check, but framed
    # as linting). Skip the leading "lint" token in the arg scan below.
    mut i = 1
    if subcmd == "lint":
        check_only = true
        i = 2
    while i < args.len:
        mut arg = args.get(i)
        if arg == "--version":
            print_version()
            _tr_exit(0)
        elif arg == "--run":
            run_after = true
        elif arg == "--check":
            check_only = true
        elif arg == "--verbose":
            verbose = true
        elif arg == "--emit" and i + 1 < args.len:
            i = i + 1
            emit_mode = args.get(i)
        elif arg == "--emit-ld" and i + 1 < args.len:
            i = i + 1
            emit_ld = args.get(i)
        elif arg == "--gpu-target" and i + 1 < args.len:
            i = i + 1
            gpu_target = args.get(i)
        elif arg == "--gpu-embed" and i + 1 < args.len:
            i = i + 1
            gpu_embed = args.get(i)
        elif arg == "--backend" and i + 1 < args.len:
            i = i + 1
            backend = args.get(i)
        elif arg == "-o" and i + 1 < args.len:
            i = i + 1
            output_path = args.get(i)
        elif (arg == "-d" or arg == "--dir") and i + 1 < args.len:
            i = i + 1
            out_dir = args.get(i)             # drop the executable in this directory
        elif arg == "--link" and i + 1 < args.len:
            i = i + 1
            link_paths.push(args.get(i))
        elif arg == "-l" and i + 1 < args.len:
            i = i + 1
            lib_flags.push("-l" + args.get(i))
        elif str_starts_with(arg, "-l") and arg != "-l":
            lib_flags.push(arg)
        elif arg == "-O0": opt_level = "0"
        elif arg == "-O1": opt_level = "1"
        elif arg == "-O2": opt_level = "2"
        elif arg == "-O3": opt_level = "3"
        elif arg == "-Os": opt_level = "s"
        elif arg == "--static": static_link = true
        elif arg == "--target" and i + 1 < args.len:
            i = i + 1
            target = args.get(i)
        elif arg == "--sysroot" and i + 1 < args.len:
            i = i + 1
            sysroot = args.get(i)
        elif arg == "--debug":
            debug_mode = true
        elif arg == "--strict":
            strict_mode = true
        elif arg == "--no-elide":
            no_elide = true
        elif arg == "--no-auto-cpp":
            no_auto_cpp = true
        elif arg == "--export-cpp":
            export_cpp = true
            lib_mode = true              # a C++ header is only useful with a linkable library
        elif arg == "--no-heap":
            no_heap = true                   # [H-1] reject heap-allocating types (str-alloc/List/Dict/Set/heap class)
        elif arg == "--freestanding":
            tier_define = "TAURARO_KERNEL"   # bare-metal core tier: no libc, pluggable allocator
        elif arg == "--no-std":
            tier_define = "TAURARO_NO_OS"    # alloc tier: no OS services, libc allocator ok
        elif arg == "--lib":
            lib_mode = true
        elif not str_starts_with(arg, "-"):
            if input_path == "":
                input_path = arg
        i = i + 1

    if input_path == "":
        print(c_red("error") + ": no input file specified")
        print_usage()
        _tr_exit(1)

    if not file_exists(input_path) and not str_ends_with_dot_tr(input_path):
        input_path = input_path + ".tr"

    if not file_exists(input_path):
        print(c_red("error") + ": cannot read " + input_path + ": no such file")
        _tr_exit(1)

    if verbose: print("[1/5] Resolving modules: " + input_path)

    mut resolver = ModuleResolver.init()
    # Binary-relative search paths: core/ (bootstrap stdlib), std/ (OOP stdlib),
    # packages/ (future third-party packages). All resolved relative to the binary's
    # own directory so the distribution works regardless of CWD.
    mut bin_dir = strip_trailing_sep_inline(_tr_exe_dir())
    # Paths relative to the compiler binary (distribution layout):
    #   <bin>/std/          - standard library
    #   <bin>/packages/     - installed third-party packages (root)
    #   <bin>/packages/sites/ - site-specific installs (mirrors pip's site-packages)
    resolver.add_search_path(bin_dir)
    resolver.add_search_path(bin_dir + "/std")
    resolver.add_search_path(bin_dir + "/packages")
    resolver.add_search_path(bin_dir + "/packages/sites")
    # CWD-relative fallbacks - allow project-local package trees that travel with the source.
    resolver.add_search_path("packages")
    resolver.add_search_path("packages/sites")
    # TAURARO_PATH - user-specified extra search paths, split on ':' (POSIX) or ';' (Windows).
    # Works like Python's PYTHONPATH: set it in the shell before running tauraroc.
    mut tauraro_path_env = _tr_getenv("TAURARO_PATH")
    if tauraro_path_env != "":
        mut ep_count = count_path_env_entries(tauraro_path_env)
        mut epi = 0
        while epi < ep_count:
            resolver.add_search_path(get_path_env_entry(tauraro_path_env, epi))
            epi = epi + 1
    mut prog = resolver.resolve_main(input_path)
    # Parser errors are fatal: a malformed parse cannot be safely compiled.
    if resolver.parse_errors > 0:
        print(c_red("error") + ": " + resolver.parse_errors.to_str() + " parse error(s); aborting compilation.")
        _tr_exit(1)

    # Compile-time macro expansion: run `macro def`s over their `@`-decorated
    # targets, splice the generated decls into the program, and drop the macro
    # defs — all BEFORE sema, so generated code is type/borrow-checked normally
    # and macro bodies (which use the `item` reflection) never reach sema.
    mut macro_errs = expand_macros(prog)
    if macro_errs > 0:
        print(c_red("error") + ": " + macro_errs.to_str() + " macro error(s); aborting compilation.")
        _tr_exit(1)

    if emit_mode == "ast":
        print("[AST] Declarations found: " + str(prog.decls.len))
        return

    if verbose: print("[2/5] Semantic analysis...")

    mut sema = Sema.init()
    sema.strict_mode = strict_mode
    sema.no_heap = no_heap
    # The C backend keeps tuples/enums as stack value structs; the LLVM and native backends
    # heap-box them. Under --no-heap the latter must reject those constructs to keep the
    # zero-heap guarantee honest (see [H-1] in sema.check_no_heap / the ETuple case).
    sema.heap_boxes_tuples = (backend != "c")
    sema.current_file = input_path   # track source file for error messages
    mut hir = sema.analyze(prog)

    if sema.warnings.len > 0:
        mut wk = 0
        while wk < sema.warnings.len:
            _print_diag("warning", sema.warnings.get(wk))
            wk = wk + 1

    if sema.errors.len > 0:
        mut k = 0
        while k < sema.errors.len:
            _print_diag("error", sema.errors.get(k))
            k = k + 1
        _tr_exit(1)

    if check_only:
        print("Check passed: no errors found.")
        return

    if emit_mode == "mir":
        mut mir_prog = lower_program(hir)
        print(dump_mir(mir_prog))
        return

    if emit_mode == "gpu":
        # GPU kernel backend (Route B): @kernel functions -> LLVM IR for NVPTX/SPIR-V.
        # `llc`/`clang` then lowers the printed .ll to a PTX/SPIR-V module that std.gpu
        # loads via Module.load_ptx / Module.load_il.
        mut gpu_gen = GpuGenerator.init()
        mut gpu_ir = gpu_gen.emit(hir, gpu_target)
        if not gpu_gen.ok:
            _print_diag("error", "[GPU] " + gpu_gen.fail_note)
            _tr_exit(1)
        print(gpu_ir)
        return

    if verbose: print("[3/5] Code generation (backend=" + backend + ")...")

    if backend == "llvm":
        # LLVM backend (Path A): lowered IR (src/taumir) -> textual LLVM IR. `llc` compiles
        # the .ll to an object; link with runtime.o to get an executable (see scripts/
        # llvm_run.sh / llvm_diff.sh). Coverage == native's (same LIR): unsupported programs
        # leave ok=false and we fall back to the C backend, never emit something wrong.
        mut llvm_gen = LlvmGenerator.init()
        mut llvm_ir = llvm_gen.generate_nh(hir, no_heap)
        if not llvm_gen.ok:
            print(c_red("error") + ": the LLVM backend can't lower this program yet")
            if llvm_gen.fail_note != "": print("       reason: " + llvm_gen.fail_note)
            print("       (it shares the native backend's feature subset). Use --backend c (default).")
            _tr_exit(2)
        # IR-only mode: an explicit `-o <name>.ll` writes the textual IR and stops
        # (used by scripts/llvm_{run,diff}.sh and for inspection).
        if output_path.ends_with(".ll"):
            write_file(output_path, llvm_ir)
            if verbose: print("[4/5] LLVM IR written to " + output_path)
            return
        # EXECUTABLE mode (default): IR -> clang (or llc + cc) -> link with the native
        # runtime -> executable, exactly like the C backend produces one end-to-end.
        # --- Cross-compilation target. Empty target = host build. ---
        # `--target <t>` threads through the LLVM backend just like the C backend:
        # clang (multi-target) lowers the target-neutral .ll for the triple and LLD
        # links it. The host-only bundled llc can't retarget, so cross uses clang.
        mut lx_triple = ""
        mut lx_is_cross = false
        if target != "":
            lx_triple = resolve_target_triple(target)
            lx_is_cross = true
        mut lx_tflags = ""
        if lx_is_cross: lx_tflags = target_extra_flags(lx_triple)
        # Cross driver: the LLVM backend emits .ll, so the cross compiler must be
        # clang-family. Prefer `zig cc` (clang + BUNDLED libc → no sysroot for hosted
        # and wasi targets), else plain clang (needs a sysroot for hosted libc). This
        # ONE driver does the runtime compile, IR codegen, and the link.
        mut lx_xcc = ""
        mut lx_via_zig = false
        if lx_is_cross:
            mut lx_xnull = "/dev/null"
            if _tr_is_windows(): lx_xnull = "nul"
            if _tr_system("zig version >" + lx_xnull + " 2>&1") == 0:
                mut lx_zt = zig_target_of(lx_triple)
                if lx_zt != "":
                    lx_xcc = "zig cc -target " + lx_zt
                    lx_via_zig = true
            if lx_xcc == "" and _tr_system("clang --version >" + lx_xnull + " 2>&1") == 0:
                lx_xcc = "clang --target=" + lx_triple
            if lx_xcc == "":
                print(c_red("error") + ": cross-compiling --backend llvm to " + lx_triple + " needs a clang-family driver")
                print("       install 'zig' (recommended — zig cc bundles libc, no sysroot) or clang >= 15.")
                _tr_exit(1)
            if verbose: print("[llvm] cross driver: " + lx_xcc)
        # Output extension follows the TARGET when cross-compiling: .wasm for
        # WebAssembly, .exe for Windows/MinGW, bare for ELF/Mach-O/embedded.
        mut lx_ext = ""
        if lx_is_cross:
            if _tr_str_contains(lx_triple, "wasm"): lx_ext = ".wasm"
            elif _tr_str_contains(lx_triple, "windows") or _tr_str_contains(lx_triple, "mingw"): lx_ext = ".exe"
        elif _tr_is_windows():
            lx_ext = ".exe"
        # Unified -o/-d/CWD placement (see resolve_output_stem): default is the
        # current working directory, -d redirects, -o wins with its own dir.
        mut lx_exe = ensure_ext(resolve_output_stem(input_path, output_path, out_dir), lx_ext)
        make_dir("build")
        mut lx_ll = "build/llvm_out.ll"
        # WASM/WASI entry glue: the wasi crt's `_start` calls `__main_void`. Clang
        # emits `@__main_void = hidden alias i32(), ptr @main` to wire that to the
        # program's main; our target-neutral IR omits it, so without it the linker
        # leaves __main_void -> main unresolved and the module traps `unreachable`
        # at entry. Add the alias for wasm targets when a @main exists (harmless on
        # other targets, so it is only appended for wasm to keep IR target-neutral).
        if lx_is_cross and _tr_str_contains(lx_triple, "wasm") and _tr_str_contains(llvm_ir, "define i32 @main()"):
            llvm_ir = llvm_ir + "\n@__main_void = hidden alias i32 (), ptr @main\n"
        write_file(lx_ll, llvm_ir)
        if verbose: print("[4/5] LLVM IR written to " + lx_ll)
        # Runtime: compile runtime/native_abi.c once into build/ (the extern _tr_rt_*
        # entry points the emitted IR calls).
        mut lx_abi = find_native_abi_c(input_path)
        if lx_abi == "":
            print(c_red("error") + ": runtime/native_abi.c not found (needed to link --backend llvm output)")
            print("       looked beside the compiler binary, the input file, and ./runtime/")
            _tr_exit(1)
        # Cross builds compile the runtime FOR THE TARGET (clang --target= + the same
        # freestanding/wasm flags the C cross path uses); host builds use the host cc.
        mut lx_cc = detect_c_compiler()
        mut lx_xflags = ""
        if lx_is_cross:
            lx_cc = lx_xcc                    # zig cc -target X / clang --target=X (target flag already included)
            lx_xflags = lx_tflags
            if sysroot != "": lx_xflags = lx_xflags + " --sysroot=\"" + sysroot + "\""
        mut lx_rto = "build/llvm_runtime.o"
        mut lx_rc = _tr_system(lx_cc + lx_xflags + " -O2 -w -c \"-I" + dir_of_path(lx_abi) + "\" \"" + lx_abi + "\" -o " + lx_rto)
        if lx_rc != 0:
            print(c_red("error") + ": failed to compile the native runtime (" + lx_abi + ")")
            if lx_is_cross:
                print("       target " + lx_triple + " needs its libc headers/sysroot.")
                print("       fix: pass --sysroot <path>, or install 'zig' (zig cc bundles libc); freestanding")
                print("       freestanding targets (embedded-*, wasm) need no sysroot.")
            _tr_exit(1)
        # Toolchain: prefer clang (compiles .ll directly, applies -O); fall back to
        # llc + cc. An old clang (< LLVM 15, no opaque pointers) fails the compile and
        # falls through to llc automatically.
        mut lx_null = "/dev/null"
        if _tr_is_windows(): lx_null = "nul"
        # ws2_32 (Windows) is needed by the runtime's async scheduler reactor (WSAPoll),
        # now that runtime.o always EXPORTS the coroutine entry points; -lm always.
        # ucrtbase (Windows) provides __intrinsic_setjmpex, which the try/except runtime
        # (_tr_rt_try_catch's setjmp) references — clang's default link misses it (gcc
        # resolves it natively, so the C backend never needed it).
        mut lx_libs = " -lm"
        # GCC-linked variant (the llc paths): mingw gcc defaults to msvcrt and resolves
        # __intrinsic_setjmpex natively, so it needs NO -lucrtbase — and forcing it would mix
        # two C runtimes (msvcrt startup + ucrtbase) and crash. Only clang (whose default link
        # misses setjmpex) gets -lucrtbase.
        mut lx_libs_gcc = " -lm"
        if _tr_is_windows():
            lx_libs = lx_libs + " -lws2_32 -lbcrypt -lucrtbase -mconsole"
            lx_libs_gcc = lx_libs_gcc + " -lws2_32 -lbcrypt"
        mut lx_built = false
        # ================= CROSS-COMPILE PATH =================
        # For a non-host target, clang is the multi-target code generator (lowers the
        # target-neutral .ll straight to a target object) and LLD the universal cross
        # linker. The host-only bundled llc below cannot retarget, so cross skips it.
        if lx_is_cross:
            mut lx_xobj = "build/llvm_out.o"
            # 1) IR -> target object, via the resolved clang-family driver (zig cc/clang).
            mut lx_cg = lx_xcc + " -O" + opt_level + lx_tflags
            if sysroot != "": lx_cg = lx_cg + " --sysroot=\"" + sysroot + "\""
            if _tr_system(lx_cg + " -c \"" + lx_ll + "\" -o " + lx_xobj + " 2>build/llvm_link.log") != 0:
                print(c_red("error") + ": LLVM cross code generation failed for " + lx_triple + " (see build/llvm_link.log)")
                _tr_exit(1)
            if verbose: print("[4/5] target object -> " + lx_xobj + " (" + lx_triple + ")")
            # 2) Link object + runtime. zig cc bundles its own LLD; plain clang uses LLD
            #    when present. Freestanding/wasm carry -nostdlib via lx_tflags (no libs);
            #    hosted targets get -lm; Windows adds the sockets lib the reactor needs.
            mut lx_xlibs = " -lm"
            if _tr_str_contains(lx_triple, "wasm") or _tr_str_contains(lx_tflags, "nostdlib"): lx_xlibs = ""
            elif _tr_str_contains(lx_triple, "windows") or _tr_str_contains(lx_triple, "mingw"): lx_xlibs = " -lm -lws2_32 -lbcrypt -mconsole"
            mut lx_xld = ""
            if not _tr_str_contains(lx_triple, "wasm") and not lx_via_zig: lx_xld = detect_lld_flag()
            mut lx_xlink = lx_xcc + lx_tflags
            if sysroot != "": lx_xlink = lx_xlink + " --sysroot=\"" + sysroot + "\""
            lx_xlink = lx_xlink + " " + lx_xobj + " " + lx_rto + lx_xlibs + lx_xld + " -o \"" + lx_exe + "\" 2>>build/llvm_link.log"
            if _tr_system(lx_xlink) == 0:
                lx_built = true
            if not lx_built:
                print(c_red("error") + ": cross-link to " + lx_triple + " failed (see build/llvm_link.log)")
                print("       install 'zig' (bundles libc+lld, no sysroot), or LLD + a " + lx_triple + " sysroot (--sysroot).")
                _tr_exit(1)
            if verbose: print("[5/5] cross LLVM executable -> " + lx_exe + " (" + lx_triple + ")")
            return
        # ===============================================================
        # -1. IN-PROCESS libLLVM (Stage 2) — when the compiler was built with the tauraro_llvm.c
        #     shim + libLLVM, emit the object directly through the llvm-c API (no subprocess).
        #     Returns -1 when not compiled in (weak stub) → fall through to the bundled llc.
        mut lx_tri = ""
        if _tr_is_windows(): lx_tri = "x86_64-pc-windows-gnu"
        mut lx_inproc = _tr_llvm_emit_object(lx_ll, "build/llvm_out.o", lx_tri)
        if lx_inproc == 0:
            if _tr_system(lx_cc + " build/llvm_out.o " + lx_rto + lx_libs_gcc + " -o \"" + lx_exe + "\" 2>build/llvm_link.log") == 0:
                lx_built = true
        # NOTE: the old bundled `<exe_dir>/llvm/llc` path is gone — the SDK now bundles
        # ZIG instead, and `zig cc` IS clang (it compiles the .ll directly) plus lld, so
        # it supersedes a separate llc/lld bundle. The clang / llc / zig-cc fallbacks
        # below cover, in order of speed, a system LLVM then the self-contained zig.
        if not lx_built and _tr_system("clang --version >" + lx_null + " 2>&1") == 0:
            mut lx_cmd = "clang -O" + opt_level + " \"" + lx_ll + "\" " + lx_rto + lx_libs + " -o \"" + lx_exe + "\" 2>build/llvm_link.log"
            if _tr_system(lx_cmd) == 0: lx_built = true
        if not lx_built and _tr_system("llc --version >" + lx_null + " 2>&1") == 0:
            # Pin the GNU triple on Windows: a rustup-shipped llc defaults to the MSVC
            # target, but we link with gcc/mingw.
            mut lx_llc_tri = ""
            if _tr_is_windows(): lx_llc_tri = " -mtriple=x86_64-pc-windows-gnu"
            if _tr_system("llc -O2 -filetype=obj" + lx_llc_tri + " \"" + lx_ll + "\" -o build/llvm_out.o 2>build/llvm_link.log") == 0:
                if _tr_system(lx_cc + " build/llvm_out.o " + lx_rto + lx_libs_gcc + " -o \"" + lx_exe + "\" 2>>build/llvm_link.log") == 0:
                    lx_built = true
        # BUNDLED/PATH zig cc — the self-contained fallback (activate_bundled_zig put a
        # bundled zig on PATH). `zig cc` compiles the .ll directly and links via its own
        # lld, one step, needing no system LLVM. Last because zig compiles its libc from
        # source on first use (slow once, then cached); a system clang/llc above is faster.
        # The runtime is RE-compiled with zig cc here so its libc/ABI matches the zig-
        # linked program object — a system-gcc(mingw) runtime.o + zig-cc link mismatches
        # on Windows (different mingw), which is why this must not reuse lx_rto.
        if not lx_built and _tr_system("zig version >" + lx_null + " 2>&1") == 0:
            mut lx_zrto = "build/llvm_runtime_zig.o"
            if _tr_system("zig cc -O2 -w -c \"-I" + dir_of_path(lx_abi) + "\" \"" + lx_abi + "\" -o " + lx_zrto + " 2>build/llvm_link.log") == 0:
                if _tr_system("zig cc -O" + opt_level + " \"" + lx_ll + "\" " + lx_zrto + lx_libs_gcc + " -o \"" + lx_exe + "\" 2>>build/llvm_link.log") == 0:
                    lx_built = true
        if not lx_built:
            print(c_red("error") + ": could not compile the LLVM IR to an executable")
            print("       need clang (LLVM >= 15) / llc on PATH, or a bundled/installed zig;")
            print("       see build/llvm_link.log")
            _tr_exit(1)
        if verbose: print("[5/5] executable written to " + lx_exe)
        if run_after:
            mut lx_run = to_runnable_path(lx_exe)
            if _tr_is_windows(): lx_run = path_to_native(lx_run)
            _tr_exit(_tr_system("\"" + lx_run + "\""))
        return

    if backend == "native":
        # Native backend (Path B): lowered IR -> x86-64 -> ELF -> link with runtime.o.
        # emit_object lowers the supported language (incl. the object model); if it hits a
        # construct it can't lower yet it returns false + fail_note and we fall back cleanly.
        mut nat_gen = NativeGenerator.init()
        # Same -o/-d/CWD rule as the other backends; native emits a .o artifact.
        mut nat_out = ensure_ext(resolve_output_stem(input_path, output_path, out_dir), ".o")
        if not nat_gen.emit_object(hir, nat_out):
            print(c_red("error") + ": this program uses a construct the native backend can't lower yet")
            if nat_gen.fail_note != "": print("       reason: " + nat_gen.fail_note)
            print("       use --backend c (default) or --backend llvm for the full language.")
            _tr_exit(2)
        if verbose: print("[4/5] native object written to " + nat_out)
        return

    # -- C backend - modular output into build/ --------------------------------
    mut c_gen  = CGenerator.init()
    # --debug: emit `#line N "src.tr"` directives so GCC/GDB diagnostics and
    # backtraces map generated C back to the original Tauraro source.
    c_gen.emit_line_info = debug_mode
    # --no-elide: force pure ARC (no zero-copy borrow elision). Used by the
    # differential-soundness oracle: an elided build and a --no-elide build must
    # produce identical observable output; any divergence is an unsound elision.
    c_gen.no_elide = no_elide
    c_gen.tier_define = tier_define
    # Bare-metal boot architecture: a RISC-V cross target selects the RISC-V @entry
    # boot glue + linker script; everything else defaults to Cortex-M.
    if _tr_str_contains(target, "riscv"):
        c_gen.bare_arch = "riscv"
    mut rt_h   = read_runtime_header(args.get(0), input_path)

    c_gen.register_program(hir)
    c_gen.scan_mono_prog(hir)

    # build_dir is always relative to the process CWD - "build/" resolves to ./build/
    # regardless of where the source file lives. No runtime CWD call needed.
    mut build_dir = "build/"
    make_dir(build_dir)

    # -- Incremental-build invalidation ---------------------------------------
    # The shared headers (tauraro_rt.h, tauraro_types.h) and the compile flags
    # are inputs to EVERY module's object file. If any of them changed since
    # the previous build, all cached .o files are stale and must be rebuilt.
    # force_all carries that decision into the per-module needs_recompile flags.
    mut types_h = c_gen.generate_types_header(hir)
    types_h = types_h + c_gen.generate_module_compat(resolver.all_decl_modules, resolver.all_decls)
    mut force_all = false
    mut types_path = build_dir + "tauraro_types.h"
    if file_exists(types_path):
        if read_file(types_path) != types_h: force_all = true
    else:
        force_all = true
    if rt_h != "":
        mut rt_path = build_dir + "tauraro_rt.h"
        if file_exists(rt_path):
            if read_file(rt_path) != rt_h: force_all = true
        else:
            force_all = true
    # Compile-flag signature: any change invalidates every object file.
    mut flags_sig = "opt=" + opt_level + ";tgt=" + target
    if static_link: flags_sig = flags_sig + ";static"
    if debug_mode:  flags_sig = flags_sig + ";debug"
    if sysroot != "": flags_sig = flags_sig + ";sysroot=" + sysroot
    mut flags_path = build_dir + ".build_flags"
    if file_exists(flags_path):
        if read_file(flags_path) != flags_sig: force_all = true
    else:
        force_all = true
    write_file(flags_path, flags_sig)

    # Write runtime headers to build/ and sync to runtime/.
    if rt_h != "":
        write_file(build_dir + "tauraro_rt.h", rt_h)
    write_file(types_path, types_h)
    if rt_h != "":
        sync_headers_to_runtime(rt_h, types_h)

    # -- Per-module C files ----------------------------------------------------
    # all_c_files / needs_recompile stay parallel: needs_recompile[i] is true
    # when module i's generated C changed (or force_all), so compile_all_c_-
    # incremental knows which .o to rebuild vs reuse from the cache.
    mut all_c_files = Vec[str].init(32)
    mut needs_recompile = Vec[bool].init(32)

    mut mi = 0
    while mi < resolver.mod_dot_paths.len:
        mut dot_path = resolver.mod_dot_paths.get(mi)

        # Collect class/fn names belonging to this module.
        mut class_set = Map[str, bool].init(16)
        mut fn_set    = Map[str, bool].init(32)
        mut k = 0
        while k < resolver.all_decl_modules.len:
            if resolver.all_decl_modules.get(k) == dot_path:
                match resolver.all_decls.get(k).read():
                    case Decl.DClass(c):
                        class_set.insert(c.name, true)
                    case Decl.DFunction(f):
                        fn_set.insert(f.name, true)
                    case Decl.DEnum(e):
                        class_set.insert(e.name, true)
                    case Decl.DInterface(iface):
                        class_set.insert(iface.name, true)
                    case Decl.DExtend(target, methods):
                        class_set.insert(target, true)
                    case _: pass
            k = k + 1

        mut c_path = ""
        mut depth  = 0
        if is_builtin_mod(dot_path):
            c_path = ensure_builtin_dirs(build_dir, dot_path)
            depth  = get_dot_depth(dot_path)
        else:
            c_path = build_dir + "module_" + dot_to_safe(dot_path) + ".c"
            depth  = 0

        # Source file for this module's #line directives (parallel array).
        if c_gen.emit_line_info and mi < resolver.mod_file_paths.len:
            c_gen.cur_src_file = to_fwd_slashes(resolver.mod_file_paths.get(mi))
        mut mod_c = c_gen.generate_module_c(hir, class_set, fn_set, depth)
        mut mod_changed = true
        if not force_all:
            if file_exists(c_path):
                if read_file(c_path) == mod_c: mod_changed = false
        if mod_changed: write_file(c_path, mod_c)
        all_c_files.push(c_path)
        needs_recompile.push(mod_changed)
        mi = mi + 1

    # -- Main module C file (main.c) -------------------------------------------
    mut main_class_set = Map[str, bool].init(32)
    mut main_fn_set    = Map[str, bool].init(64)
    mut k2 = 0
    while k2 < resolver.all_decl_modules.len:
        if resolver.all_decl_modules.get(k2) == "":
            match resolver.all_decls.get(k2).read():
                case Decl.DClass(c):
                    main_class_set.insert(c.name, true)
                case Decl.DFunction(f):
                    main_fn_set.insert(f.name, true)
                case Decl.DEnum(e):
                    main_class_set.insert(e.name, true)
                case Decl.DInterface(iface):
                    main_class_set.insert(iface.name, true)
                case Decl.DExtend(target, methods):
                    main_class_set.insert(target, true)
                case _: pass
        k2 = k2 + 1

    # Java-style nested class/def/enum/interface declarations inside main() are
    # hoisted into hir.classes/functions/enums/interfaces by sema, but they have
    # no entry in resolver.all_decls (they were never top-level), so the loop
    # above never adds them to main_class_set/main_fn_set. Add them explicitly
    # so generate_main_c emits their bodies.
    mut nci = 0
    while nci < sema.nested_classes.len:
        main_class_set.insert(sema.nested_classes.get(nci).name, true)
        nci = nci + 1
    mut nfi = 0
    while nfi < sema.nested_functions.len:
        main_fn_set.insert(sema.nested_functions.get(nfi).name, true)
        nfi = nfi + 1
    mut nei = 0
    while nei < sema.nested_enums.len:
        main_class_set.insert(sema.nested_enums.get(nei).name, true)
        nei = nei + 1
    mut nii = 0
    while nii < sema.nested_interfaces.len:
        main_class_set.insert(sema.nested_interfaces.get(nii).name, true)
        nii = nii + 1

    if c_gen.emit_line_info:
        c_gen.cur_src_file = to_fwd_slashes(input_path)
    mut main_c      = c_gen.generate_main_c(hir, main_class_set, main_fn_set)
    # --export-cpp: append the stable extern-"C" bridges the generated C++ header binds to.
    mut cpp_exporter = CppExporter.init(c_gen)
    if export_cpp:
        main_c = main_c + cpp_exporter.generate_cpp_class_bridges(hir)
    mut main_c_path = build_dir + "main.c"
    mut main_changed = true
    if not force_all:
        if file_exists(main_c_path):
            if read_file(main_c_path) == main_c: main_changed = false
    if main_changed: write_file(main_c_path, main_c)
    all_c_files.push(main_c_path)
    needs_recompile.push(main_changed)

    if emit_ld != "":
        if _tr_str_contains(target, "riscv"):
            write_file(emit_ld, linker_script_riscv())
        else:
            write_file(emit_ld, linker_script_cortex_m())
        print("Linker script written to: " + emit_ld)

    if emit_mode == "c":
        print("Modular C output written to: " + build_dir)
        print("  tauraro_types.h  - shared type definitions + all function prototypes")
        print("  tauraro_rt.h     - runtime header")
        print("  main.c           - program entry")
        mut pi = 0
        while pi < all_c_files.len - 1:
            print("  " + get_filename(all_c_files.get(pi)))
            pi = pi + 1
        return

    # -- Compile all C files into the output executable ------------------------
    # Unified placement: -o exact path, else -d dir, else the CWD (NOT ./build).
    # Intermediate .c/.o still live in build_dir; only the final artifact moves.
    mut exe_name = resolve_output_stem(input_path, output_path, out_dir)
    if exe_name == "": exe_name = "a"

    # Strip .exe suffix so we append the correct platform extension ourselves
    mut en_len = 0
    mut en_p = exe_name as Pointer[char]
    while en_p.offset(en_len).read() as int != 0: en_len = en_len + 1
    if en_len > 4:
        if en_p.offset(en_len - 4).read() as int == 46:
            if en_p.offset(en_len - 3).read() as int == 101:
                if en_p.offset(en_len - 2).read() as int == 120:
                    if en_p.offset(en_len - 1).read() as int == 101:
                        exe_name = exe_name.slice(0, en_len - 4)

    # Output extension follows the OUTPUT target (host for a native build, the
    # --target triple when cross-compiling): .dll/.so for --lib, .exe for Windows,
    # .wasm for WebAssembly, bare for ELF/Mach-O. Keying on the host would wrongly
    # append .exe to a Windows->Linux cross artifact.
    mut tgt_triple = ""
    if target != "": tgt_triple = resolve_target_triple(target)
    mut out_win = out_is_windows(target, tgt_triple)
    mut exe_ext = ""
    if lib_mode:
        if out_win: exe_ext = ".dll"
        else: exe_ext = ".so"
    elif out_win:
        exe_ext = ".exe"
    elif target != "" and _tr_str_contains(tgt_triple, "wasm"):
        exe_ext = ".wasm"
    # exe_name already carries the resolved directory (CWD / -d dir / -o path),
    # so the artifact path is just the stem + platform extension.
    mut exe_path = exe_name + exe_ext

    # --lib: emit a C header declaring the `export def` functions, next to the
    # library, so C/Rust/etc. consumers can link against it.
    if lib_mode:
        mut hdr = c_gen.generate_export_header(hir)
        # Header sits next to the library (exe_name already holds the resolved dir).
        mut hdr_path = exe_name + ".h"
        write_file(hdr_path, hdr)
        if verbose: print("[lib] header: " + hdr_path)
        # --export-cpp: also emit an ergonomic C++ header so C++ can CALL Tauraro
        # (the reverse of `bindgen`). Namespace = the library's base name.
        if export_cpp:
            mut ns = get_filename(exe_name)
            if ns == "": ns = "tauraro"
            mut cpp_hdr = cpp_exporter.generate_export_cpp_header(hir, ns)
            mut cpp_hdr_path = exe_name + ".hpp"
            write_file(cpp_hdr_path, cpp_hdr)
            print("[export-cpp] C++ header: " + cpp_hdr_path + "  (namespace " + ns + ")")

    # -- Turnkey bare-metal link (--freestanding @entry builds) ---------------
    # When a linker script was generated (--emit-ld), the program has an @entry boot
    # image: link the emitted C into a freestanding ELF here, in one command, with the
    # generated linker script + the arch's boot flags (mirrors scripts/bare_run.sh) —
    # instead of the normal hosted link. The bundled `zig cc` handles freestanding
    # ARM/RISC-V, so no separate arm-none-eabi/riscv64 toolchain is required (an
    # installed cross-gcc is used if present). Gated on emit_ld, so no other path is
    # affected. Produces `<name>.elf`; feed it to qemu / a flasher.
    if emit_ld != "" and not lib_mode:
        mut bm_elf = exe_name + ".elf"
        mut bm_cc = detect_c_compiler()
        if target != "": bm_cc = resolve_cross_driver(resolve_target_triple(target))
        mut bm_is_zig = _tr_str_contains(bm_cc, "zig")
        # zig's target parser wants the CPU name with an UNDERSCORE (cortex_m3);
        # a real gcc/clang cross driver wants the usual hyphenated spelling
        # (cortex-m3) -- passing the wrong one to either fails to parse the CPU
        # at all ("info: available CPUs for architecture 'arm': ...").
        mut bm_arch = " -mcpu=cortex-m3 -mthumb"
        if bm_is_zig: bm_arch = " -mcpu=cortex_m3 -mthumb"
        if _tr_str_contains(target, "riscv"): bm_arch = " -march=rv64imac -mabi=lp64 -mcmodel=medany"
        # A bare-metal cross link needs a MULTI-TARGET linker: the system `ld` is
        # host-only ("unrecognised emulation mode: elf64lriscv"). zig cc has lld
        # built in; a clang driver needs -fuse-ld=lld (added when lld is present).
        mut bm_lld = ""
        if not bm_is_zig: bm_lld = detect_lld_flag()
        # zig cc enables UBSan by default (nothing freestanding provides its
        # handlers) and its own `-nostdlib` also drops compiler_rt (the
        # soft-float/64-bit helpers a Cortex-M3 lacks in hardware) -- so a zig
        # link needs `-nostartfiles` (keeps compiler_rt, still skips the hosted
        # C startup files) + `-fno-sanitize=undefined` instead of plain
        # `-nostdlib`. A real arm-none-eabi-gcc driver keeps `-nostdlib` but
        # then needs `-lgcc` at the link line's end for the same helpers.
        mut bm_nostdlib = " -nostdlib"
        mut bm_ubsan = ""
        mut bm_libgcc = " -lgcc"
        if bm_is_zig:
            bm_nostdlib = " -nostartfiles"
            bm_ubsan = " -fno-sanitize=undefined"
            bm_libgcc = ""
        mut bm_cmd = bm_cc + " -O" + opt_level + bm_arch + " -ffreestanding" + bm_nostdlib + " -fno-builtin" + bm_ubsan + bm_lld
        bm_cmd = bm_cmd + " -T \"" + emit_ld + "\" \"-I" + build_dir + "include\" \"-I" + build_dir + "\""
        mut bmi = 0
        while bmi < all_c_files.len:
            bm_cmd = bm_cmd + " \"" + all_c_files.get(bmi) + "\""
            bmi = bmi + 1
        bm_cmd = bm_cmd + bm_libgcc + " -o \"" + bm_elf + "\" 2>build/bare_link.log"
        if verbose: print("[5/5] bare-metal link -> " + bm_elf + "  (" + bm_cc + ")")
        if _tr_system(bm_cmd) == 0:
            print("Bare-metal ELF written to: " + bm_elf)
            return
        print(c_red("error") + ": bare-metal link failed (see build/bare_link.log)")
        print("       need a freestanding toolchain — the bundled zig, or arm-none-eabi / riscv64 gcc.")
        _tr_exit(1)

    # -- Turnkey UEFI link (--target uefi-x64 --freestanding builds) ----------
    # UEFI firmware IS the boot glue (reset vectors, memory setup, and the boot
    # menu all already happened before anything here runs) -- so unlike the
    # Cortex-M/RISC-V path above, no linker script and no @entry reset vector
    # are involved (no --emit-ld either; this block is independent of emit_ld).
    # Instead: generate a small zig stub that locates the GOP framebuffer,
    # optionally seeds a heap pool via AllocatePool, and calls a well-known-
    # named `pub export def` the program provides -- then drive
    # `zig build-exe -target x86_64-uefi` directly. No hand-written .zig file
    # needed (this replaces exactly what nebula's examples/uefi_demo/boot.zig
    # + scripts/build-uefi.ps1 did by hand).
    if target == "uefi-x64" and not lib_mode:
        # `tauraro_uefi_frame` (interactive: polled mouse+keyboard, called
        # every frame) takes priority over the one-shot entries -- a program
        # exporting it wants the event-loop stub, not a single paint-then-halt.
        mut uefi_is_frame = hir_has_export_fn(hir, "tauraro_uefi_frame")
        mut uefi_entry = ""
        if uefi_is_frame: uefi_entry = "tauraro_uefi_frame"
        elif hir_has_export_fn(hir, "tauraro_uefi_main"): uefi_entry = "tauraro_uefi_main"
        elif hir_has_export_fn(hir, "tauraro_ui_render"): uefi_entry = "tauraro_ui_render"
        if uefi_entry == "":
            print(c_red("error") + ": --target uefi-x64 needs a `pub export def` entry point")
            print("       either tauraro_uefi_frame(fb, width, height, pitch, mouse_x, mouse_y,")
            print("       mouse_down, has_key, key_code) -> bool, called every frame with polled")
            print("       input (return false to halt), or the one-shot tauraro_uefi_main /")
            print("       tauraro_ui_render(fb, width, height, pitch) -> void, called once.")
            _tr_exit(1)
        mut uefi_has_heap_init = hir_has_export_fn(hir, "tauraro_heap_init")

        mut uefi_stub_path = build_dir + "_tr_uefi_stub.zig"
        mut uefi_stub_src = ""
        # Interactive (frame-loop) programs get a bigger default heap: interp.tr's
        # render() rebuilds its LayoutBox tree from scratch every repaint (no
        # incremental relayout, no meaningful free() anywhere in a typical UI
        # toolkit yet), so a real event loop accumulates real, never-reclaimed
        # heap over a session in a way a single one-shot paint never does.
        if uefi_is_frame: uefi_stub_src = uefi_zig_stub_frame(uefi_entry, uefi_has_heap_init, 64)
        else: uefi_stub_src = uefi_zig_stub(uefi_entry, uefi_has_heap_init, 16)
        write_file(uefi_stub_path, uefi_stub_src)

        mut uefi_efi = ensure_ext(exe_name, ".efi")
        mut uefi_cmd = "zig build-exe -target x86_64-uefi -mcpu baseline"
        uefi_cmd = uefi_cmd + " -I \"" + build_dir + "\" -I \"" + build_dir + "include\""
        # UEFI genuinely shares the Microsoft x64 ABI/PE format, so zig's
        # x86_64-uefi target predefines _WIN32/_WIN64/_MSC_VER; undefine them
        # for the C sources so tauraro_rt.h doesn't take the hosted-Windows
        # branch (windows.h/psapi/bcrypt) -- it already gates that on
        # !TAURARO_BARE, and --freestanding implies TAURARO_BARE, but a stale
        # runtime header without that gate would otherwise fail to compile.
        uefi_cmd = uefi_cmd + " -cflags -U_WIN32 -U_WIN64 -U_MSC_VER -- "
        mut uci = 0
        while uci < all_c_files.len:
            uefi_cmd = uefi_cmd + "\"" + all_c_files.get(uci) + "\" "
            uci = uci + 1
        uefi_cmd = uefi_cmd + "\"" + uefi_stub_path + "\""
        uefi_cmd = uefi_cmd + " -fno-strip -femit-bin=\"" + uefi_efi + "\" 2>build/uefi_link.log"
        if verbose: print("[5/5] uefi link -> " + uefi_efi)
        if _tr_system(uefi_cmd) == 0:
            print("UEFI application written to: " + uefi_efi)
            print("  entry: " + uefi_entry)
            print("  place it at EFI/BOOT/BOOTX64.EFI on a FAT ESP (USB/qemu OVMF) to boot it")
            return
        print(c_red("error") + ": uefi link failed (see build/uefi_link.log)")
        print("       needs the bundled zig (ships with the compiler SDK) on PATH.")
        _tr_exit(1)

    # Zero-cost C++ interop: auto-discover `# tauraro-cpp-*` pragmas in the imported
    # binding modules, compile each shim, and add it (+ its libs) to the link line —
    # no manual `clang++ -c` / `--link -lstdc++`. Under LTO the wrapper is inlined away.
    mut has_cpp = false
    mut use_lto = false
    if not no_auto_cpp:
        mut cc0 = detect_c_compiler()
        if target != "": cc0 = resolve_cross_driver(resolve_target_triple(target))
        use_lto = cpp_lto_ok(cc0, target)
        has_cpp = auto_link_cpp_shims(resolver.mod_file_paths, build_dir, cc0, opt_level, link_paths, lib_flags, verbose, use_lto)
    if not has_cpp: use_lto = false

    # --gpu-embed: auto-compile every @kernel function to a GPU module and embed it
    # so std.gpu's Module.embedded() loads it at runtime — no separate `llc` step or
    # `.spv`/`.ptx` file. Runs GpuGenerator -> llc -> byte-array C, linked in below.
    if gpu_embed != "":
        mut gpu_gen = GpuGenerator.init()
        mut gpu_ir = gpu_gen.emit(hir, gpu_embed)
        if gpu_gen.ok and gpu_gen.n_kernels > 0:
            mut ll_path = build_dir + "_tr_gpu_kernels.ll"
            write_file(ll_path, gpu_ir)
            mut gbin = build_dir + "_tr_gpu_kernels.gpubin"
            mut llc_cmd = ""
            if gpu_embed == "nvptx":
                llc_cmd = "llc -mtriple=nvptx64-nvidia-cuda -mcpu=sm_50 \"" + ll_path + "\" -o \"" + gbin + "\""
            else:
                llc_cmd = "llc -mtriple=spirv64-unknown-unknown -filetype=obj \"" + ll_path + "\" -o \"" + gbin + "\""
            if _tr_system(llc_cmd) != 0:
                print(c_red("error") + ": [GPU] llc failed compiling embedded kernels (" + gpu_embed + ")")
                _tr_exit(1)
            mut blob_c = gpu_blob_c(gbin)
            if blob_c != "":
                mut blob_path = build_dir + "_tr_gpu_blob.c"
                write_file(blob_path, blob_c)
                all_c_files.push(blob_path)
                needs_recompile.push(true)
                if verbose: print("  [gpu-embed] embedded " + str(gpu_gen.n_kernels) + " kernel(s) as " + gpu_embed)
        elif not gpu_gen.ok:
            print(c_red("error") + ": [GPU] " + gpu_gen.fail_note)
            _tr_exit(1)

    if verbose: print("[5/5] Compiling + linking " + str(all_c_files.len) + " modules -> " + exe_path)
    # Incremental compile + link: per-module .o with cache reuse for
    # unchanged modules, then a single link. build/ is intentionally kept
    # populated (.c + .o + headers) so the next build can reuse cached objects.
    mut rc = compile_all_c_incremental(all_c_files, needs_recompile, exe_path, build_dir, link_paths, lib_flags, opt_level, verbose, static_link, target, sysroot, debug_mode, lib_mode, has_cpp, use_lto)
    if rc != 0:
        print(c_red("error") + ": compilation failed (exit code " + str(rc) + ")")
        _tr_exit(rc)

    if verbose: print("Done: " + exe_path)

    if run_after:
        mut run_path = to_runnable_path(exe_path)
        if _tr_is_windows(): run_path = path_to_native(run_path)
        mut run_rc = _tr_system("\"" + run_path + "\"")
        _tr_exit(run_rc)
