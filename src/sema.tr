                                                else: _mf_mangled = _mf_mangled + "_" + _mf_names.get(_mf_ji)
                                                _mf_ji = _mf_ji + 1
                                            mut fret2 = AstType.init("void")
                                            if self.fn_defs.contains(gn):
                                                mut _mf_fd = self.fn_defs.get(gn)
                                                if _mf_fd.ret_ty as usize != 0 as usize: fret2 = _mf_fd.ret_ty.read()
                                                mut _mf_gi = 0
                                                while _mf_gi < _mf_fd.generics.len:
                                                    if _mf_fd.generics.get(_mf_gi) == fret2.name and _mf_gi < _mf_names.len:
                                                        fret2 = AstType.init(_mf_names.get(_mf_gi))
                                                    _mf_gi = _mf_gi + 1
                                            ret_ty = fret2
                                            hcallee = box_hirexpr(HirExpr.EIdent(_mf_mangled, fret2, false))
                                        case _: pass
                            case _: pass
                    case Expr.EPropAccess(obj, variant):
                        match obj.read():
                            case Expr.EIdent(type_name):
                                if self.enums.contains(type_name):
                                    ret_ty = AstType.init(type_name)
                                # Built-in concurrency statics: Thread.spawn -> Thread, ThreadPool.new -> ThreadPool
                                elif (type_name == "Thread" or type_name == "ThreadPool" or type_name == "Atomic" or type_name == "ThreadLocal") and (variant == "spawn" or variant == "new" or variant == "init"):
                                    ret_ty = AstType.init(type_name)
                                elif variant == "init" or variant == "new":
                                    if type_name == "Pointer" or type_name == "List" or type_name == "Vec" or type_name == "Map" or type_name == "Dict":
                                        ret_ty = AstType.init(type_name)
                                    elif self.classes.contains(type_name):
                                        ret_ty = AstType.init(type_name)
                            case Expr.EIndex(base2, idx2):
                                if variant == "init" or variant == "new":
                                    match base2.read():
                                        case Expr.EIdent(gn2):
                                            if gn2 == "Pointer" or gn2 == "List" or gn2 == "Vec" or gn2 == "Map" or gn2 == "Dict":
                                                match idx2.read():
                                                    case Expr.EIdent(tn2):
                                                        ret_ty = AstType.init(gn2)
                                                        ret_ty.args.push(box_asttype(AstType.init(tn2)))
                                                    case _:
                                                        ret_ty = AstType.init(gn2)
                                            elif self.classes.contains(gn2):
                                                ret_ty = AstType.init(gn2)
                                                match idx2.read():
                                                    case Expr.EIdent(targ_cb): ret_ty.args.push(box_asttype(AstType.init(targ_cb)))
