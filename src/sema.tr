                # `Coro.spawn` (the low-level green-thread primitive that takes
                # raw Pointer args in unsafe blocks), which must NOT be checked.
                mut _recv_name = ""
                mut _recv_is_shared = false
                match obj.read():
                    case Expr.EIdent(_rn):
                        _recv_name = _rn
                        mut _rsym = self.resolve(_rn)
                        if _rsym.name != "" and _rsym.is_shared: _recv_is_shared = true
                    case _: pass
                # [E-1] Method call on an UNDEFINED receiver: `Foo.bar(...)` where the
                # bare identifier `Foo` resolves to NOTHING (not a local/param/global/
                # function, not an imported symbol, not any known type). Without this the
                # codegen silently emits a bogus free `bar(Foo, ...)` call -> invalid C —
                # the exact failure of a renamed/removed std type used as a static
                # receiver, e.g. `JsonValue.init_object()` after json.tr dropped it.
                # NB: builtin module statics (`OS`/`Process`/`Env`/…) are imported `pub
                # class`es that resolve to a symbol even when the def isn't in
                # self.classes for this unit — so keying on `resolve(...)=="" ` (truly
                # unresolved), not on the symbol KIND, avoids false-flagging them.
                if _recv_name != "" and not self.is_local_var(_recv_name) and not self._is_known_type_name(_recv_name):
                    if self.resolve(_recv_name).name == "":
                        self.error("[E-1] '" + _recv_name + "' is not a defined type or value, so '" + _recv_name + "." + method + "(...)' cannot be resolved.\n      FIX: check the spelling, import the type, or define it — a call on an unknown name would otherwise emit invalid C.")
                # Callable-field call: obj.f(args) where f is a def(...)-typed
                # FIELD (not a method) -> lower to field access + indirect call.
                if self.classes.contains(hobj_ty.name):
                    mut _cf_cls = self.classes.get(hobj_ty.name)
                    mut _cf_i = 0
                    mut _cf_ty = AstType.init("void")
                    mut _cf_found = false
                    while _cf_i < _cf_cls.fields.len:
                        mut _cf_fld = _cf_cls.fields.get(_cf_i)
                        if _cf_fld.name == method and _cf_fld.ty as usize != 0 as usize:
                            _cf_ty = _cf_fld.ty.read()
