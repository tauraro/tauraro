                                            # Mangle ALL type args (joined by "_", matching the single
                                            # "__MONO_" separator the C backend's mono-scan looks for)
                                            # into the callee name, and substitute the function's OWN
                                            # generics (by position) into its declared return type.
                                            mut _mf_names = Vec[str].init(ftargs.len)
                                            mut _mfi = 0
                                            while _mfi < ftargs.len:
