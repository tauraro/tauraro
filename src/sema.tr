# @trusted: compiler systems module — audited raw-pointer core (like Rust std internals)
# compiler/sema.tr - Semantic analyzer for the Tauraro self-hosted compiler.

from core.vec import Vec
from core.map import Map
from core.alloc import alloc, dealloc
from core.io import _tr_exit, write_file, append_file
from ast import Program, Decl, Expr, Stmt, AstType, Block, MatchArm, Pattern, FunctionDef, ClassDef, EnumDef, InterfaceDef, Param, Decorator, FStringPart, Ownership, CatchClause, Comprehension, ChanSelectArm, GenericConstraint
from hir import HirProgram, HirFunction, HirClass, HirEnum, HirInterface, HirStmt, HirExpr, HirBlock, HirParam, HirField, HirVariant, HirFStringPart, HirComprehension, HirCatchClause, HirMatchArm, box_hirexpr, box_hirstmt, hir_expr_type, HirChanSelectArm
from mir import mir_if_drop_plan, DropSite, mir_proven_borrows, mir_borrow_conflicts, mir_shared_ref_param_violations


pub enum SymbolKind:
    SFunction
    SClass
    SEnum
    SVariable
    SInterface

pub class Symbol:
    pub name: str
    pub kind: SymbolKind
    pub ty: Pointer[AstType]
    pub scope_depth: int
    pub is_mut: bool
    pub is_const: bool
    pub is_shared: bool
    pub is_moved: bool
    pub active_borrows: int
    pub borrowed_by: Vec[str]
    pub is_init: bool
    pub is_param: bool
    pub is_maybe_moved: bool  # moved in SOME but not ALL branches
    pub is_maybe_init: bool   # init in SOME but not ALL branches
    pub ptr_region: int       # 0=LOCAL, 1=HEAP(alloc), 2=PARAM, 3=GLOBAL
    pub is_freed: bool        # [M-6] dealloc() was called on this pointer
    pub decl_block_depth: int # auto-drop: nested-block depth (if/while bodies) at declaration; only depth==0 is droppable by the enclosing scope
    pub decl_block_id: int    # auto-drop: id of the innermost if/while C block open at declaration within the current scope; 0 = scope top-level
    pub str_escaped: bool     # auto-drop: a `str` local passed as a call/method-call ARGUMENT - may be aliased into a legacy List_str/Dict/Set (#52 not yet migrated); excluded from auto-drop to avoid UAF
    pub coll_escaped: bool    # auto-drop: a List/Vec/Dict/Map/Set local that is ever read in a non-receiver position (call/method arg, assigned to another var, returned, stored in a literal) - raw unrefcounted pointer, so any alias must disable auto-free to avoid UAF
    pub borrows_region: str   # [L-3/L-4] region derivation of this str local's CURRENT value: "" = unknown (never flagged), "@owned" = freshly built (concat — owned, not a borrow), "<name>" = shares parameter/local <name>'s region (transitive). Tracks the LAST assignment.

extend Symbol:
    pub def init(name: str, kind: SymbolKind, ty: Pointer[AstType]) -> Symbol:
        mut s = Symbol()
        s.name = name
        s.kind = kind
        s.ty = ty
        s.scope_depth = 0
        s.is_mut = false
        s.is_const = false
        s.is_shared = false
        s.is_moved = false
        s.active_borrows = 0
        s.borrowed_by = Vec[str].init(0)
        s.is_init = true
        s.is_param = false
        s.is_maybe_moved = false
        s.is_maybe_init = false
        s.ptr_region = 0
        s.is_freed = false
        s.decl_block_depth = 0
        s.decl_block_id = 0
        s.str_escaped = false
        s.coll_escaped = false
        s.borrows_region = ""
        return s

pub class Scope:
    pub variables: Map[str, Symbol]
    pub decl_order: Vec[str]

extend Scope:
    pub def init() -> Scope:
        mut s = Scope()
        s.variables = Map[str, Symbol].init(32)
        s.decl_order = Vec[str].init(8)
        return s

# --- Method-mutability inference (for implicit method-receiver borrows, --strict) ---
# A method MUTATES self if it (anywhere in its body, incl. nested blocks) assigns to a
# field of `self`: `self.f = ...`. Used to flag `a.mutate()` while `a` is borrowed.
# Conservative on purpose: only DIRECT field stores count (a transitive `self.list.push()`
# is not flagged) — so the checker never produces a false positive, only misses some.
def _expr_is_self_field(e: Pointer[Expr]) -> bool:
    if e as usize == 0 as usize: return false
    match e.read():
        case Expr.EPropAccess(obj, _):
            if obj as usize == 0 as usize: return false
            match obj.read():
                case Expr.EIdent(nm): return nm == "self"
                case _: return false
        case _: return false

def _binop_is_float_name(n: str) -> bool:
    return n == "float" or n == "f64" or n == "f32"

# True if any argument in a lowered call arg list is float-typed (abs/min/max polymorphism).
def _hl_has_float(hl: Vec[Pointer[HirExpr]]) -> bool:
    mut i = 0
    while i < hl.len:
        if _binop_is_float_name(hir_expr_type(hl.get(i)).name): return true
        i = i + 1
    return false

def _block_mutates_self(b: Block) -> bool:
    mut i = 0
    while i < b.stmts.len:
        if _stmt_mutates_self(b.stmts.get(i)): return true
        i = i + 1
    return false

def _pblock_mutates_self(pb: Pointer[Block]) -> bool:
    if pb as usize == 0 as usize: return false
    return _block_mutates_self(pb.read())

def _stmt_mutates_self(s: Pointer[Stmt]) -> bool:
    if s as usize == 0 as usize: return false
    match s.read():
        case Stmt.SAssign(tgt, _): return _expr_is_self_field(tgt)
        case Stmt.SIf(_, then_b, elifs, else_b):
            if _block_mutates_self(then_b): return true
            mut i = 0
            while i < elifs.len:
                if _pblock_mutates_self(elifs.get(i).body): return true
                i = i + 1
            return _block_mutates_self(else_b)
        case Stmt.SWhile(_, body, _): return _block_mutates_self(body)
        case Stmt.SFor(_, _, body, _, _): return _block_mutates_self(body)
        case Stmt.SForUnpack(_, _, body): return _block_mutates_self(body)
        case Stmt.SUnsafe(body): return _block_mutates_self(body)
        case Stmt.SWith(_, _, body): return _block_mutates_self(body)
        case Stmt.STaskGroup(body): return _block_mutates_self(body)
        case Stmt.SGpuBlock(body): return _block_mutates_self(body)
        case Stmt.SMatch(_, arms):
            mut i = 0
            while i < arms.len:
                if _pblock_mutates_self(arms.get(i).body): return true
                i = i + 1
            return false
        case Stmt.STry(try_body, catches, finally_b):
            if _block_mutates_self(try_body): return true
            mut i = 0
            while i < catches.len:
                if _pblock_mutates_self(catches.get(i).read().body): return true
                i = i + 1
            return _block_mutates_self(finally_b)
        case Stmt.SDefer(inner): return _stmt_mutates_self(inner)
        case _: return false

pub class Sema:
    pub globals:            Map[str, Symbol]
    pub scopes:             Vec[Scope]
    pub errors:             Vec[str]
    pub warnings:           Vec[str]
    pub classes:            Map[str, ClassDef]
    pub enums:              Map[str, EnumDef]
    pub interfaces:         Map[str, InterfaceDef]
    pub type_aliases:        Map[str, str]   # alias_name -> resolved base name
    pub type_alias_elem:     Map[str, str]   # alias_name -> first generic arg name (for List/Map)
    pub current_file:        str             # path of source file currently being analysed
    pub current_func_name:  str
    pub current_class_name: str
    pub current_scope_depth: int
    pub in_async_fn:        bool
    pub assign_froms:       Map[str, int] # block-local last use tracking
    pub fn_sigs:            Map[str, AstType] # top-level fn name -> def(...)->R type, for first-class function references
    pub extern_names:       Map[str, bool]    # [N-3] extern "C" function names (valid bare names not in fn_sigs/globals)
    # Nested declarations (class/def/enum/interface inside main()) hoisted to file scope.
    pub nested_classes:     Vec[HirClass]
    pub nested_functions:   Vec[HirFunction]
    pub nested_enums:       Vec[HirEnum]
    pub nested_interfaces:  Vec[HirInterface]
    pub current_line:       int
    pub current_func_generics: Vec[str]
    pub current_func_constraints: Vec[GenericConstraint]
    pub closure_boundary: int           # scope depth just before entering a closure (-1 = not in closure)
    pub closure_caps:     Vec[HirParam] # captures accumulated for the current innermost closure
    pub closure_cap_set:  Map[str, bool] # dedup set for capture names
    pub in_assign_target: bool          # suppress is_init check on assignment LHS
    pub in_recv_pos: bool               # [N-3] lowering a method/prop/index receiver — skip undefined-name check (module receivers like `OS`/`math` resolve to no symbol)
    pub container_borrows: Map[str, str] # container_var -> borrowing_var
    pub capturing_moves: bool           # Fix 1: branch snapshot - are we tracking move deltas?
    pub branch_moved_buf: Vec[str]      # Fix 1: names moved in current branch
    pub capturing_inits: bool           # Fix 4: branch snapshot for init deltas
    pub branch_init_buf: Vec[str]       # Fix 4: names init'd in current branch
    pub copy_classes: Map[str, bool]    # Fix 3: auto-inferred Copy classes (all-primitive fields)
    pub in_unsafe: bool                 # Gap 6: inside an unsafe: block
    pub cur_fn_is_lib: bool             # currently lowering a trusted std/core function (audited unsafe core) — exempt from [P-2]
    pub current_func_ret_from: str      # Gap 1: 'from' lifetime param of current function return
    pub current_func_ret_borrow_str: bool   # current fn returns `ref str from ...` (a str borrow)
    pub current_func_ret_regions: Vec[str]  # explicit `from a, b` region list (empty if none/auto-inferred)
    pub current_func_outlives_a: Vec[str]   # `where a outlives b` bounds (parallel): a[i] outlives b[i]
    pub current_func_outlives_b: Vec[str]
    pub current_region_params: Vec[str] # region (lifetime) params of the type being lowered
                                        # (class/enum/interface `from r`) — feeds the L-2 check
    pub cur_func_borrowers: Vec[str]   # outlives engine: cross-fn ref-borrow edges (borrowers ...)
    pub cur_func_sources:   Vec[str]   # ... and immediate sources) collected during lower_func
    pub strict_mode: bool               # --strict: alloc outside unsafe -> hard [U-1] error
    pub no_heap: bool                   # --no-heap: reject heap-allocating constructs -> [H-1] error (bare-metal zero-heap guarantee)
    pub heap_boxes_tuples: bool         # true when the selected backend heap-allocates tuples/enums (llvm/native). The C backend keeps them as stack value structs, so under --no-heap it allows them; the other backends must reject them to keep the zero-heap guarantee honest.
    pub mutating_methods: Map[str, bool] # "ClassName.method" -> true if it stores into self.<field> (implicit-borrow check)
    pub fn_ret_owned:    Map[str, bool] # return-ownership inference: fn/method key -> true if it returns an OWNED heap-class ref (see compute_return_ownership)
    pub fn_param_consumes: Map[str, bool] # parameter-ownership inference: "fnkey#i" -> true if the fn CONSUMES (moves/frees/stores/returns) param i; false = PROVEN only-borrowed. Interprocedural monotone fixpoint (compute_param_ownership); the precise per-callee effect the drop heuristics lack.
    pub ptr_aliased:     Map[str, bool] # class names reachable as Pointer[T] (raw, NOT refcounted) — excluded from the [S-2] ownership-cycle graph
    pub decorator_names: Map[str, bool]  # decorator def registry (name -> true)
    pub variadic_fns:    Map[str, str]   # fn name -> index of trailing variadic param (= fixed-arg count, as string)
    pub variadic_elem_ty: Map[str, Pointer[AstType]] # fn name -> element type of the variadic List[T] param
    pub fn_defs:         Map[str, FunctionDef]  # top-level fn name -> full definition, for inspect(T)
    pub loop_scope_base: Vec[int]  # auto-drop: scope-stack depth marking the start of each enclosing loop's scopes
    pub fn_scope_base: Vec[int]    # auto-drop: scope-stack depth marking the start of each enclosing CLOSURE's scopes — a `return` inside a closure must only drop the closure's own locals, NOT the enclosing function's (else they double-free: released when the closure runs AND at the real function exit)
    pub block_depth: int  # auto-drop: nested-C-block depth (if/while bodies sharing a Scope); 0 = directly in the owning scope's top-level block
    pub block_depth_stack: Vec[int]  # auto-drop: saved block_depth per scope, restored on exit_scope
    pub next_block_id: int       # auto-drop: monotonic id, incremented each time an if/while/etc body block opens
    pub block_stack: Vec[int]    # auto-drop: ids of currently-open if/while bodies, innermost last
    pub block_stack_base: Vec[int] # auto-drop: block_stack.len at each enter_scope, restored on exit_scope
    pub do_temp_ctr: int           # `do:` block-expression: monotonic counter for synthetic result-capture temps

extend Sema:
    pub def build_ast_type(self, e: Pointer[Expr]) -> Pointer[AstType]:
        if e as usize == 0 as usize: return Pointer[AstType](0)
        match e.read():
            case Expr.EIdent(n):
                return box_asttype(AstType.init(n))
            case Expr.EIndex(obj, idx):
                match obj.read():
                    case Expr.EIdent(on):
                        mut at = AstType.init(on)
                        at.args = Vec[Pointer[AstType]].init(2)
                        # A multi-arg generic (e.g. Map[K, V]) carries its args as
                        # an ETuple of type-arg exprs; push them all so the value
                        # type V is preserved (single-arg index stays one arg).
                        match idx.read():
                            case Expr.ETuple(_bte):
                                mut _bti = 0
                                while _bti < _bte.len:
                                    at.args.push(self.build_ast_type(_bte.get(_bti)))
                                    _bti = _bti + 1
                            case _:
                                at.args.push(self.build_ast_type(idx))
                        return box_asttype(at)
                    case _: pass
            case _: pass
        return box_asttype(AstType.init("void"))

    # Convert a single type-argument expression (as parsed inside `Name[...]`)
    # to its AstType, mirroring the per-case logic in the EIndex type lowering.
    pub def _targ_of(self, e: Pointer[Expr]) -> Pointer[AstType]:
        if e as usize == 0 as usize: return box_asttype(AstType.init("void"))
        match e.read():
            case Expr.EIdent(n): return box_asttype(AstType.init(n))
            case Expr.EIndex(_, _): return self.build_ast_type(e)
            case _: return box_asttype(AstType.init("void"))

    pub def init() -> Sema:
        mut s = Sema()
        s.globals            = Map[str, Symbol].init(1024)
        s.scopes             = Vec[Scope].init(16)
        s.errors             = Vec[str].init(16)
        s.warnings           = Vec[str].init(8)
        s.classes            = Map[str, ClassDef].init(128)
        s.enums              = Map[str, EnumDef].init(64)
        s.interfaces         = Map[str, InterfaceDef].init(32)
        s.type_aliases    = Map[str, str].init(32)
        s.type_alias_elem = Map[str, str].init(32)
        s.current_file    = ""
        s.current_func_name  = ""
        s.current_class_name = ""
        s.current_scope_depth = 0
        s.in_async_fn        = false
        s.assign_froms       = Map[str, int].init(32)
        s.fn_sigs            = Map[str, AstType].init(64)
        s.extern_names       = Map[str, bool].init(128)
        s.nested_classes     = Vec[HirClass].init(4)
        s.nested_functions   = Vec[HirFunction].init(4)
        s.nested_enums       = Vec[HirEnum].init(4)
        s.nested_interfaces  = Vec[HirInterface].init(4)
        s.current_line       = 0
        s.current_func_generics = Vec[str].init(0)
        s.current_func_constraints = Vec[GenericConstraint].init(0)
        s.closure_boundary  = -1
        s.closure_caps      = Vec[HirParam].init(0)
        s.closure_cap_set   = Map[str, bool].init(0)
        s.in_assign_target  = false
        s.in_recv_pos       = false
        s.container_borrows = Map[str, str].init(16)
        s.capturing_moves   = false
        s.branch_moved_buf  = Vec[str].init(0)
        s.capturing_inits   = false
        s.branch_init_buf   = Vec[str].init(0)
        s.copy_classes           = Map[str, bool].init(32)
        s.in_unsafe              = false
        s.cur_fn_is_lib          = false
        s.current_func_ret_from  = ""
        s.current_func_ret_borrow_str = false
        s.current_func_ret_regions = Vec[str].init(0)
        s.current_func_outlives_a = Vec[str].init(0)
        s.current_func_outlives_b = Vec[str].init(0)
        s.current_region_params  = Vec[str].init(0)
        s.cur_func_borrowers     = Vec[str].init(0)
        s.cur_func_sources       = Vec[str].init(0)
        s.strict_mode            = false
        s.no_heap                = false
        s.heap_boxes_tuples      = false
        s.mutating_methods       = Map[str, bool].init(32)
        s.fn_ret_owned           = Map[str, bool].init(64)
        s.fn_param_consumes      = Map[str, bool].init(64)
        s.ptr_aliased            = Map[str, bool].init(32)
        s.decorator_names        = Map[str, bool].init(16)
        s.variadic_fns           = Map[str, str].init(8)
        s.variadic_elem_ty       = Map[str, Pointer[AstType]].init(8)
        s.fn_defs                = Map[str, FunctionDef].init(32)
        s.loop_scope_base        = Vec[int].init(8)
        s.fn_scope_base          = Vec[int].init(8)
        s.block_depth            = 0
        s.block_depth_stack      = Vec[int].init(8)
        s.next_block_id          = 0
        s.block_stack            = Vec[int].init(8)
        s.block_stack_base       = Vec[int].init(8)
        s.do_temp_ctr            = 0

        # -- Built-in functions -------------------------------------------------
        s.globals.insert("print",    Symbol.init("print",    SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("input",    Symbol.init("input",    SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        s.globals.insert("len",      Symbol.init("len",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("range",    Symbol.init("range",    SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("type",     Symbol.init("type",     SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        s.globals.insert("str",      Symbol.init("str",      SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        s.globals.insert("hex",      Symbol.init("hex",      SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        s.globals.insert("oct",      Symbol.init("oct",      SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        s.globals.insert("bin",      Symbol.init("bin",      SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        # kernel_launch("name", grid, block, args...): type-directed GPU kernel launch.
        # A builtin (like print) so its heterogeneous args pass; the C backend rewrites
        # it into module load + per-arg bind (by the @kernel's signature) + launch.
        s.globals.insert("kernel_launch", Symbol.init("kernel_launch", SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("int",      Symbol.init("int",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("float",    Symbol.init("float",    SymbolKind.SFunction, box_asttype(AstType.init("float"))))
        s.globals.insert("bool",     Symbol.init("bool",     SymbolKind.SFunction, box_asttype(AstType.init("bool"))))
        s.globals.insert("ord",      Symbol.init("ord",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("chr",      Symbol.init("chr",      SymbolKind.SFunction, box_asttype(AstType.init("char"))))
        s.globals.insert("abs",      Symbol.init("abs",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("max",      Symbol.init("max",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("min",      Symbol.init("min",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("sum",      Symbol.init("sum",      SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("round",    Symbol.init("round",    SymbolKind.SFunction, box_asttype(AstType.init("float"))))
        s.globals.insert("sorted",   Symbol.init("sorted",   SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("reversed", Symbol.init("reversed", SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("iter",     Symbol.init("iter",     SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("enumerate",Symbol.init("enumerate",SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("zip",      Symbol.init("zip",      SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("map",      Symbol.init("map",      SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("filter",   Symbol.init("filter",   SymbolKind.SFunction, box_asttype(AstType.init("List"))))
        s.globals.insert("all",      Symbol.init("all",      SymbolKind.SFunction, box_asttype(AstType.init("bool"))))
        s.globals.insert("any",      Symbol.init("any",      SymbolKind.SFunction, box_asttype(AstType.init("bool"))))
        s.globals.insert("assert",    Symbol.init("assert",    SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("assert_eq", Symbol.init("assert_eq", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("assert_ne", Symbol.init("assert_ne", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("assert_lt", Symbol.init("assert_lt", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("assert_le", Symbol.init("assert_le", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("assert_gt", Symbol.init("assert_gt", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("assert_ge", Symbol.init("assert_ge", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("Some",     Symbol.init("Some",     SymbolKind.SFunction, box_asttype(AstType.init("Option"))))
        s.globals.insert("Ok",       Symbol.init("Ok",       SymbolKind.SFunction, box_asttype(AstType.init("Result"))))
        s.globals.insert("Err",      Symbol.init("Err",      SymbolKind.SFunction, box_asttype(AstType.init("Result"))))
        s.globals.insert("_tr_exit",   Symbol.init("_tr_exit",   SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("_tr_strlen", Symbol.init("_tr_strlen", SymbolKind.SFunction, box_asttype(AstType.init("int"))))
        s.globals.insert("read_file",  Symbol.init("read_file",  SymbolKind.SFunction, box_asttype(AstType.init("str"))))
        s.globals.insert("write_file", Symbol.init("write_file", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("file_exists",Symbol.init("file_exists",SymbolKind.SFunction, box_asttype(AstType.init("bool"))))
        s.globals.insert("_tr_system", Symbol.init("_tr_system", SymbolKind.SFunction, box_asttype(AstType.init("int"))))

        # -- Built-in container classes ------------------------------------------
        # Vec is NOT a built-in - it is the OOP class imported from core.vec.
        # List is the only built-in C-backed array type.
        s.globals.insert("List",         Symbol.init("List",         SymbolKind.SClass, box_asttype(AstType.init("List"))))
        s.globals.insert("Pointer",      Symbol.init("Pointer",      SymbolKind.SClass, box_asttype(AstType.init("Pointer"))))
        s.globals.insert("StringBuilder",Symbol.init("StringBuilder",SymbolKind.SClass, box_asttype(AstType.init("StringBuilder"))))
        s.globals.insert("StringObj",    Symbol.init("StringObj",    SymbolKind.SClass, box_asttype(AstType.init("StringObj"))))
        # Map is not a builtin - import from std/core. Dict is the builtin associative type.
        s.globals.insert("Dict",         Symbol.init("Dict",         SymbolKind.SClass, box_asttype(AstType.init("Dict"))))
        s.globals.insert("Set",          Symbol.init("Set",          SymbolKind.SClass, box_asttype(AstType.init("Set"))))
        s.globals.insert("Box",          Symbol.init("Box",          SymbolKind.SClass, box_asttype(AstType.init("Box"))))

        # -- Result / Option enums -----------------------------------------------
        s.globals.insert("Option", Symbol.init("Option", SymbolKind.SEnum, box_asttype(AstType.init("Option"))))
        s.globals.insert("Result", Symbol.init("Result", SymbolKind.SEnum, box_asttype(AstType.init("Result"))))

        # -- Exception hierarchy -------------------------------------------------
        s.globals.insert("Exception",  Symbol.init("Exception",  SymbolKind.SClass, box_asttype(AstType.init("Exception"))))
        s.globals.insert("Error",      Symbol.init("Error",      SymbolKind.SClass, box_asttype(AstType.init("Error"))))
        s.globals.insert("ValueError", Symbol.init("ValueError", SymbolKind.SClass, box_asttype(AstType.init("ValueError"))))
        s.globals.insert("TypeError",  Symbol.init("TypeError",  SymbolKind.SClass, box_asttype(AstType.init("TypeError"))))
        s.globals.insert("IndexError", Symbol.init("IndexError", SymbolKind.SClass, box_asttype(AstType.init("IndexError"))))
        s.globals.insert("IOError",    Symbol.init("IOError",    SymbolKind.SClass, box_asttype(AstType.init("IOError"))))
        s.globals.insert("KeyError",   Symbol.init("KeyError",   SymbolKind.SClass, box_asttype(AstType.init("KeyError"))))

        # -- Concurrency / async types -------------------------------------------
        s.globals.insert("Task",      Symbol.init("Task",      SymbolKind.SClass, box_asttype(AstType.init("Task"))))
        s.globals.insert("Future",    Symbol.init("Future",    SymbolKind.SClass, box_asttype(AstType.init("Future"))))
        s.globals.insert("Channel",   Symbol.init("Channel",   SymbolKind.SClass, box_asttype(AstType.init("Channel"))))
        s.globals.insert("Chan",      Symbol.init("Chan",      SymbolKind.SClass, box_asttype(AstType.init("Chan"))))
        s.globals.insert("Mutex",     Symbol.init("Mutex",     SymbolKind.SClass, box_asttype(AstType.init("Mutex"))))
        s.globals.insert("RwLock",    Symbol.init("RwLock",    SymbolKind.SClass, box_asttype(AstType.init("RwLock"))))
        s.globals.insert("ThreadPool", Symbol.init("ThreadPool", SymbolKind.SClass, box_asttype(AstType.init("ThreadPool"))))
        s.globals.insert("Thread",     Symbol.init("Thread",     SymbolKind.SClass, box_asttype(AstType.init("Thread"))))
        s.globals.insert("Atomic",     Symbol.init("Atomic",     SymbolKind.SClass, box_asttype(AstType.init("Atomic"))))
        s.globals.insert("ThreadLocal", Symbol.init("ThreadLocal", SymbolKind.SClass, box_asttype(AstType.init("ThreadLocal"))))
        s.globals.insert("await_all", Symbol.init("await_all", SymbolKind.SFunction, box_asttype(AstType.init("void"))))
        s.globals.insert("Arc",       Symbol.init("Arc",       SymbolKind.SClass, box_asttype(AstType.init("Arc"))))
        s.globals.insert("Rc",        Symbol.init("Rc",        SymbolKind.SClass, box_asttype(AstType.init("Rc"))))
        s.globals.insert("WaitGroup", Symbol.init("WaitGroup", SymbolKind.SClass, box_asttype(AstType.init("WaitGroup"))))

        # -- Ownership / shared types ---------------------------------
        s.globals.insert("Shared", Symbol.init("Shared", SymbolKind.SClass, box_asttype(AstType.init("Shared"))))
        s.globals.insert("Weak",   Symbol.init("Weak",   SymbolKind.SClass, box_asttype(AstType.init("Weak"))))

        return s

    # -- #9: inspect(T) reflection helper -----------------------------------

    pub def io_ty_str(self, ty: AstType) -> str:
        mut s = ty.name
        if s == "": s = "void"
        if ty.args.len > 0:
            s = s + "["
            mut i = 0
            while i < ty.args.len:
                if i > 0: s = s + ", "
                s = s + self.io_ty_str(ty.args.get(i).read())
                i = i + 1
            s = s + "]"
        return s

    # First non-SLine statement of a body that is a bare string literal is its docstring.
    pub def io_doc_of(self, body: Block) -> str:
        mut i = 0
        while i < body.stmts.len:
            match body.stmts.get(i).read():
                case Stmt.SLine(_): pass
                case Stmt.SExpr(e):
                    if e as usize != 0 as usize:
                        match e.read():
                            case Expr.ELitStr(s): return s
                            case _: pass
                    return ""
                case _: return ""
            i = i + 1
        return ""

    pub def io_func_sig(self, f: FunctionDef) -> str:
        mut s = "def " + f.name + "("
        mut i = 0
        while i < f.params.len:
            if i > 0: s = s + ", "
            mut p = f.params.get(i)
            s = s + p.name
            if p.ty as usize != 0 as usize:
                s = s + ": " + self.io_ty_str(p.ty.read())
            if p.is_variadic: s = s + "..."
            i = i + 1
        s = s + ")"
        if f.ret_ty as usize != 0 as usize:
            mut rt = f.ret_ty.read()
            if rt.name != "" and rt.name != "void" and rt.name != "None":
                s = s + " -> " + self.io_ty_str(rt)
        if f.throws_ty as usize != 0 as usize:
            if f.throws_ty.read().name != "":
                s = s + " throws " + self.io_ty_str(f.throws_ty.read())
        mut doc = self.io_doc_of(f.body)
        if doc != "":
            s = s + "\n        \"\"\"" + doc + "\"\"\""
        return s

    # Builds a Python help()-style description for a class/enum/interface/
    # function name, or a short note for builtin types. Used by inspect(T).
    pub def build_inspect_str(self, name: str) -> str:
        if self.classes.contains(name):
            mut c = self.classes.get(name)
            mut s = "class " + c.name
            if c.base_classes.len > 0:
                s = s + "(extends "
                mut bi = 0
                while bi < c.base_classes.len:
                    if bi > 0: s = s + ", "
                    s = s + c.base_classes.get(bi)
                    bi = bi + 1
                s = s + ")"
            s = s + ":\n"
            if c.docstring != "":
                s = s + "  doc: " + c.docstring + "\n"
            if c.fields.len > 0:
                s = s + "  fields:\n"
                mut fi = 0
                while fi < c.fields.len:
                    mut fld = c.fields.get(fi)
                    s = s + "    " + fld.name
                    if fld.ty as usize != 0 as usize:
                        s = s + ": " + self.io_ty_str(fld.ty.read())
                    s = s + "\n"
                    fi = fi + 1
            if c.methods.len > 0:
                s = s + "  methods:\n"
                mut mi = 0
                while mi < c.methods.len:
                    s = s + "    " + self.io_func_sig(c.methods.get(mi)) + "\n"
                    mi = mi + 1
            return s
        elif self.enums.contains(name):
            mut e = self.enums.get(name)
            mut s = "enum " + e.name + ":\n"
            if e.variants.len > 0:
                s = s + "  variants:\n"
                mut vi = 0
                while vi < e.variants.len:
                    mut v = e.variants.get(vi)
                    s = s + "    " + v.name
                    if v.fields.len > 0:
                        s = s + "("
                        mut vfi = 0
                        while vfi < v.fields.len:
                            if vfi > 0: s = s + ", "
                            mut vf = v.fields.get(vfi)
                            if vf.ty as usize != 0 as usize:
                                s = s + self.io_ty_str(vf.ty.read())
                            vfi = vfi + 1
                        s = s + ")"
                    s = s + "\n"
                    vi = vi + 1
            if e.methods.len > 0:
                s = s + "  methods:\n"
                mut mi = 0
                while mi < e.methods.len:
                    s = s + "    " + self.io_func_sig(e.methods.get(mi)) + "\n"
                    mi = mi + 1
            return s
        elif self.interfaces.contains(name):
            mut iface = self.interfaces.get(name)
            mut s = "interface " + iface.name + ":\n"
            if iface.methods.len > 0:
                s = s + "  methods:\n"
                mut mi = 0
                while mi < iface.methods.len:
                    s = s + "    " + self.io_func_sig(iface.methods.get(mi)) + "\n"
                    mi = mi + 1
            return s
        elif self.fn_defs.contains(name):
            return self.io_func_sig(self.fn_defs.get(name))
        elif name == "int":
            return "int: 64-bit signed integer (C long long)."
        elif name == "float":
            return "float: 64-bit floating point number (C double)."
        elif name == "bool":
            return "bool: true/false (C _Bool)."
        elif name == "str":
            return "str: immutable byte string (C char*)."
        elif name == "char":
            return "char: single byte character (C char)."
        elif name == "List":
            return "List[T]: growable, ordered, indexable sequence of T."
        elif name == "Dict":
            return "Dict[K, V]: hash map from K to V."
        elif name == "Set":
            return "Set[T]: unordered collection of unique T values."
        elif name == "Option":
            return "Option[T]: either Some(T) or None."
        elif name == "Result":
            return "Result[T, E]: either Ok(T) or Err(E)."
        elif name == "Pointer":
            return "Pointer[T]: raw pointer to a T (C T*); use unsafe: for arithmetic."
        else:
            return "No info available for '" + name + "'."

    pub def error(self, msg: str):
        mut loc = ""
        if self.current_file.len() > 0:
            loc = self.current_file + ":"
        if self.current_line > 0:
            self.errors.push(loc + str(self.current_line) + ": " + msg)
        else:
            self.errors.push(msg)

    # -- Thread-safety / Sendable checks --------------------------------------

    pub def is_sendable_type(self, ty_name: str) -> bool:
        if ty_name == "int" or ty_name == "float" or ty_name == "bool" or ty_name == "char" or ty_name == "str": return true
        if ty_name == "void" or ty_name == "" or ty_name == "auto" or ty_name == "usize" or ty_name == "isize": return true
        if ty_name == "Atomic" or ty_name == "Mutex" or ty_name == "RwLock": return true
        if ty_name == "Chan" or ty_name == "Channel" or ty_name == "ThreadPool": return true
        if ty_name == "Thread" or ty_name == "ThreadLocal": return true
        if ty_name == "Shared" or ty_name == "Weak": return true   # ref-counted pointers are Sendable
        # Known non-thread-safe collections
        if ty_name == "List" or ty_name == "Vec" or ty_name == "Dict" or ty_name == "Map": return false
        # User-defined class: allow if it implements Sendable
        if self.classes.contains(ty_name):
            mut cls = self.classes.get(ty_name)
            if not _is_invalid_ptr(cls.iface_names as usize):
                mut ii = 0
                while ii < cls.iface_names.len:
                    if cls.iface_names.get(ii) == "Sendable": return true
                    ii = ii + 1
            # User class without Sendable - hard error (strict mode)
            return false
        # Unknown type - conservative: assume not sendable
        return false

    # Full-type Sendable check (sees generic args), so reachability through a
    # wrapper is enforced. `Shared[T]`/`Weak[T]` give UNSYNCHRONIZED shared access
    # to T across threads, and `Chan[T]` TRANSFERS a T to another thread — so the
    # inner T must itself be Sendable, else non-thread-safe data is reachable on
    # another thread (a data race). `Mutex`/`RwLock`/`Atomic` SERIALIZE access, so
    # their inner type is protected and stays unconditionally Sendable.
    pub def is_sendable_ty(self, ty: AstType) -> bool:
        mut n = ty.name
        if n == "Shared" or n == "Weak" or n == "Chan" or n == "Channel":
            if ty.args.len > 0:
                return self.is_sendable_ty(ty.args.get(0).read())
            return true
        return self.is_sendable_type(n)

    # Recursively checks cls_name and its base classes for a method named `method`.
    pub def class_method_exists(self, cls_name: str, method: str) -> bool:
        if not self.classes.contains(cls_name): return false
        mut cls = self.classes.get(cls_name)
        mut mi = 0
        while mi < cls.methods.len:
            if cls.methods.get(mi).name == method: return true
            mi = mi + 1
        mut bi = 0
        while bi < cls.base_classes.len:
            if self.class_method_exists(cls.base_classes.get(bi), method): return true
            bi = bi + 1
        return false

    # Universal methods dispatched generically by codegen for any type
    # (conversions, dunders, container protocol) - never reported as missing.
    pub def is_universal_method(self, method: str) -> bool:
        if method == "init" or method == "new" or method == "free": return true
        if method == "to_str" or method == "to_string" or method == "as_str": return true
        if method == "len" or method == "length" or method == "__len__": return true
        if method == "clone" or method == "copy": return true
        if method == "__getitem__" or method == "get_index" or method == "__setitem__": return true
        if method == "__eq__" or method == "__ne__": return true
        if method == "__lt__" or method == "__gt__" or method == "__le__" or method == "__ge__": return true
        if method == "__add__" or method == "__sub__" or method == "__mul__" or method == "__div__" or method == "__mod__": return true
        if method == "__hash__" or method == "__iter__" or method == "__next__" or method == "__contains__": return true
        if method == "__str__" or method == "__repr__" or method == "__enter__" or method == "__exit__": return true
        return false

    # True if `e` is a borrow (`ref`/`mut ref`): the type carries is_borrow even
    # after the `ref` wrapper is erased to the inner type name at parse, and a
    # borrow-typed local/param keeps it on its declared type.
    pub def expr_is_borrow(self, e: Pointer[HirExpr]) -> bool:
        if e as usize == 0 as usize: return false
        if _is_invalid_ptr(e as usize): return false
        if hir_expr_type(e).is_borrow: return true
        match e.read():
            case HirExpr.EIdent(nm, _, _):
                mut sym = self.resolve(nm)
                if sym.name != "" and (sym.ty as usize) != 0 as usize:
                    if sym.ty.read().is_borrow: return true
            case _: pass
        return false

    # True if `e` is a `shared` value (a variable bound with `shared`, i.e. a
    # Shared[T]/Arc handle). Such a value has an ATOMIC refcount, so it is exempt
    # from [T-7] — it CAN cross a thread boundary (that is the fix [T-7] points to).
    # A shared var is typed as its inner T (with sym.is_shared), so the type name
    # alone can't tell; resolve the identifier and check the flag.
    pub def _expr_is_shared(self, e: Pointer[HirExpr]) -> bool:
        if _is_invalid_ptr(e as usize): return false
        match e.read():
            case HirExpr.EIdent(nm, _, _):
                mut sym = self.resolve(nm)
                return sym.name != "" and sym.is_shared
            case HirExpr.EMethodCall(recv, meth, _, _):
                # `s.clone()` of a shared value is itself a shared (atomic) handle —
                # the idiomatic way to hand a worker its own cross-thread reference.
                if meth == "clone": return self._expr_is_shared(recv)
            case _: pass
        return false

    pub def check_spawn_sendable(self, e: Pointer[HirExpr]):
        if _is_invalid_ptr(e as usize): return
        match e.read():
            case HirExpr.ECall(_, cs_args, _):
                mut csi = 0
                while csi < cs_args.len:
                    # [T-6] a borrow cannot cross a thread boundary (non-scoped spawn):
                    # the borrowed value may be mutated/freed by another thread or
                    # outlive its source. Rust's thread::spawn requires 'static for
                    # the same reason. T-1 misses this (ref T erases to a Sendable T).
                    if self.expr_is_borrow(cs_args.get(csi)):
                        self.error("[T-6] a borrow (`ref`/`mut ref`) cannot cross a thread boundary: the borrowed value may be mutated or freed by another thread, or outlive its source.\n      FIX: pass an owned value, a `Shared[T]`, or a `Mutex[T]`/`Atomic[T]` handle instead of a borrow.")
                    mut arg_ty = hir_expr_type(cs_args.get(csi))
                    if (arg_ty.name == "Shared" or arg_ty.name == "Weak") and arg_ty.args.len > 0:
                        mut inner_nm = arg_ty.args.get(0).read().name
                        if not self.is_sendable_type(inner_nm):
                            self.error("[T-1] 'Shared[" + inner_nm + "]' cannot safely cross thread boundaries because '" + inner_nm + "' is not Sendable.\n      FIX: Add 'implements Sendable' to '" + inner_nm + "' and ensure all mutable fields use Atomic[T] or Mutex[T].")
                    elif self.strict_mode and self._is_rc_class(arg_ty.name) and not self._expr_is_shared(cs_args.get(csi)) and not self._is_unsafe_sendable(arg_ty.name):
                        self.error("[T-7] '" + arg_ty.name + "' is a plain reference-counted class — its refcount is thread-local (non-atomic), so it is not 'Send' and cannot cross a thread boundary (this is exactly why Rust's 'Rc' is '!Send').\n      FIX: share it as 'Shared[" + arg_ty.name + "]' (atomic refcount, like Rust's 'Arc'), or 'Mutex[" + arg_ty.name + "]' for exclusive access.")
                    elif not self.is_sendable_type(arg_ty.name):
                        self.error("[T-1] Type '" + arg_ty.name + "' is not Sendable and cannot be safely shared across threads.\n      FIX: Wrap in Mutex[" + arg_ty.name + "] for exclusive access, or Atomic[T] for counters/flags.\n      Or add 'implements Sendable' to '" + arg_ty.name + "' to confirm it is thread-safe.")
                    self._check_spawn_nested_rc(cs_args.get(csi))
                    csi = csi + 1
            case HirExpr.EMethodCall(_, _, cs_margs, _):
                mut csmi = 0
                while csmi < cs_margs.len:
                    if self.expr_is_borrow(cs_margs.get(csmi)):
                        self.error("[T-6] a borrow (`ref`/`mut ref`) cannot cross a thread boundary: the borrowed value may be mutated or freed by another thread, or outlive its source.\n      FIX: pass an owned value, a `Shared[T]`, or a `Mutex[T]`/`Atomic[T]` handle instead of a borrow.")
                    mut arg_ty2 = hir_expr_type(cs_margs.get(csmi))
                    if (arg_ty2.name == "Shared" or arg_ty2.name == "Weak") and arg_ty2.args.len > 0:
                        mut inner_nm2 = arg_ty2.args.get(0).read().name
                        if not self.is_sendable_type(inner_nm2):
                            self.error("[T-1] 'Shared[" + inner_nm2 + "]' cannot safely cross thread boundaries because '" + inner_nm2 + "' is not Sendable.\n      FIX: Add 'implements Sendable' to '" + inner_nm2 + "' and protect mutable fields with Atomic[T] or Mutex[T].")
                    elif self.strict_mode and self._is_rc_class(arg_ty2.name) and not self._expr_is_shared(cs_margs.get(csmi)) and not self._is_unsafe_sendable(arg_ty2.name):
                        self.error("[T-7] '" + arg_ty2.name + "' is a plain reference-counted class — its refcount is thread-local (non-atomic), so it is not 'Send' and cannot cross a thread boundary.\n      FIX: share it as 'Shared[" + arg_ty2.name + "]' (atomic refcount) or 'Mutex[" + arg_ty2.name + "]' for exclusive access.")
                    elif not self.is_sendable_type(arg_ty2.name):
                        self.error("[T-1] Type '" + arg_ty2.name + "' is not Sendable and cannot be safely shared across threads.\n      FIX: Wrap in Mutex[" + arg_ty2.name + "].")
                    self._check_spawn_nested_rc(cs_margs.get(csmi))
                    csmi = csmi + 1
            case _: pass

    pub def check_class_sendable_fields(self, c: ClassDef):
        # Does the class carry the explicit unsafe-thread-safety assertion?
        # `implements Sendable, UnsafeSendable` is Tauraro's `unsafe impl Send`:
        # it lets a class hold a raw, opaque `Pointer` handle (whose contents the
        # compiler cannot reason about) while still crossing thread boundaries.
        # It is greppable and deliberate - not a silent blanket exemption.
        mut has_unsafe = false
        mut ui = 0
        while ui < c.iface_names.len:
            if c.iface_names.get(ui) == "UnsafeSendable": has_unsafe = true
            ui = ui + 1
        mut cfi = 0
        while cfi < c.fields.len:
            mut fd = c.fields.get(cfi)
            if fd.ty as usize != 0 as usize:
                mut fty = fd.ty.read()
                if fty.name == "Pointer":
                    # A raw Pointer field is only allowed in a Sendable class when
                    # the author has explicitly opted in via UnsafeSendable.
                    if not has_unsafe:
                        self.error("[T-2] Class '" + c.name + "' declares 'implements Sendable' but holds a raw 'Pointer' field '" + fd.name + "', which the compiler cannot prove thread-safe.\n      FIX: If '" + c.name + "' wraps an internally-synchronized handle, assert it explicitly: 'implements Sendable, UnsafeSendable'.\n      Otherwise wrap the data in Mutex[T]/Atomic[T], or drop 'implements Sendable'.")
                elif not self.is_sendable_ty(fty):
                    # Covers a bare non-Sendable field AND reachability through an
                    # unsynchronized wrapper: `Shared[NonSendable]`/`Chan[NonSendable]`
                    # would expose non-thread-safe data on another thread.
                    mut _t2_inner = fty.name
                    if (fty.name == "Shared" or fty.name == "Weak" or fty.name == "Chan" or fty.name == "Channel") and fty.args.len > 0:
                        _t2_inner = fty.name + "[" + fty.args.get(0).read().name + "]"
                    self.error("[T-2] Class '" + c.name + "' declares 'implements Sendable' but field '" + fd.name + ": " + _t2_inner + "' is not Sendable (non-thread-safe data is reachable across threads).\n      FIX: make the inner type Sendable, wrap it in Mutex[T]/RwLock[T] for guarded access or Atomic[T] for numerics, or drop 'implements Sendable'.")
                elif fty.name == "int" or fty.name == "float" or fty.name == "bool":
                    self.warnings.push("[T-3] Sendable class '" + c.name + "' has primitive field '" + fd.name + ": " + fty.name + "' that may cause data races if mutated from multiple threads.\n      FIX: Use 'Atomic[" + fty.name + "]' for safe concurrent mutation, or ensure this field is written only before the object is shared across threads.")
            cfi = cfi + 1

    # An empty `{}` dict literal carries no key/value expressions to infer a
    # type from, so its lowered EDict keeps an empty-args `Dict` type — codegen's
    # gen_dict_literal then falls back to the generic string-keyed constructor
    # even when the real destination is `Dict[int, V]` (an int-keyed TrIDict),
    # a genuine pointer-type mismatch at the C level (`TrIDict*` field assigned
    # a `TrMap*`). When the assignment/let target's declared type is a concrete
    # `Dict[K, V]`, patch the already-lowered empty literal's type to match, so
    # codegen picks the right backing constructor. No-op for anything that
    # isn't an empty EDict (a non-empty literal already inferred its own type
    # from its first entry, which codegen must not silently override).
    pub def _patch_empty_dict_hint(self, hv: Pointer[HirExpr], hint_ty: AstType) -> Pointer[HirExpr]:
        if hv as usize == 0 as usize: return hv
        if hint_ty.name != "Dict" and hint_ty.name != "Map": return hv
        if hint_ty.args.len < 2: return hv
        match hv.read():
            case HirExpr.EDict(hk, hvv, _):
                if hk.len == 0: return box_hirexpr(HirExpr.EDict(hk, hvv, hint_ty))
                return hv
            case _: return hv

    # -- Ownership / borrow tracking -------------------------------

    pub def mark_moved(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                if not sym.is_moved:
                    sym.is_moved = true
                    self.scopes.get(i).variables.insert(name, sym)
                    if self.capturing_moves:
                        self.branch_moved_buf.push(name)
                return
            i = i - 1
        if self.globals.contains(name):
            mut sym = self.globals.get(name)
            if not sym.is_moved:
                sym.is_moved = true
                self.globals.insert(name, sym)
                if self.capturing_moves:
                    self.branch_moved_buf.push(name)

    pub def mark_freed(self, name: str):
        mut mf_i = self.scopes.len - 1
        while mf_i >= 0:
            if self.scopes.get(mf_i).variables.contains(name):
                mut mf_sym = self.scopes.get(mf_i).variables.get(name)
                mf_sym.is_freed = true
                mf_sym.is_moved = true
                self.scopes.get(mf_i).variables.insert(name, mf_sym)
                if self.capturing_moves:
                    self.branch_moved_buf.push(name)
                return
            mf_i = mf_i - 1
        if self.globals.contains(name):
            mut mf_sym = self.globals.get(name)
            mf_sym.is_freed = true
            mf_sym.is_moved = true
            self.globals.insert(name, mf_sym)
            if self.capturing_moves:
                self.branch_moved_buf.push(name)

    pub def check_not_moved(self, name: str, ty_name: str):
        if self.is_primitive_name(ty_name): return
        mut sym = self.resolve(name)
        if sym.name != "" and sym.is_moved:
            self.error("[M-1] '" + name + "' was moved and cannot be used again.\n      FIX: Use the variable that now owns it, or call .clone() to copy before moving.")

    pub def mark_borrow(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                sym.active_borrows = sym.active_borrows + 1
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1
        if self.globals.contains(name):
            mut sym = self.globals.get(name)
            sym.active_borrows = sym.active_borrows + 1
            self.globals.insert(name, sym)

    pub def unmark_borrow(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                if sym.active_borrows > 0:
                    sym.active_borrows = sym.active_borrows - 1
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1
        if self.globals.contains(name):
            mut sym = self.globals.get(name)
            if sym.active_borrows > 0:
                sym.active_borrows = sym.active_borrows - 1
            self.globals.insert(name, sym)

    pub def check_no_active_borrows(self, name: str, ty_name: str):
        if self.is_primitive_name(ty_name): return
        mut sym = self.resolve(name)
        if sym.name != "" and sym.active_borrows > 0:
            self.error("[M-2] Cannot move '" + name + "' while it is borrowed.\n      FIX: The borrow must end before '" + name + "' can be moved.")

    # mark a variable as initialized (e.g. after assignment)
    pub def mark_init(self, name: str):
        mut mi_i = self.scopes.len - 1
        while mi_i >= 0:
            if self.scopes.get(mi_i).variables.contains(name):
                mut mi_sym = self.scopes.get(mi_i).variables.get(name)
                if not mi_sym.is_init:
                    # Track the transition uninit->init so we can roll it back per-branch
                    mi_sym.is_init = true
                    mi_sym.is_maybe_init = false
                    self.scopes.get(mi_i).variables.insert(name, mi_sym)
                    if self.capturing_inits:
                        self.branch_init_buf.push(name)
                return
            mi_i = mi_i - 1
        if self.globals.contains(name):
            mut mi_sym = self.globals.get(name)
            if not mi_sym.is_init:
                mi_sym.is_init = true
                mi_sym.is_maybe_init = false
                self.globals.insert(name, mi_sym)
                if self.capturing_inits:
                    self.branch_init_buf.push(name)

    # remove any container borrow where var_name is the borrow key
    pub def clear_container_borrow(self, var_name: str):
        if self.container_borrows.contains(var_name):
            self.container_borrows.remove(var_name)

    # Fix 1: reverse of mark_moved - used to roll back per-branch move state
    pub def unmark_moved(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                sym.is_moved = false
                # A branch-local '.free()'/dealloc() also set is_freed; if this
                # branch's effects are being rolled back (the branch did not
                # uniformly take effect), is_freed must roll back too, or the
                # merged maybe-moved state would permanently and incorrectly
                # report [M-6] on later uses along paths that never freed it.
                sym.is_freed = false
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1
        if self.globals.contains(name):
            mut sym = self.globals.get(name)
            sym.is_moved = false
            sym.is_freed = false
            self.globals.insert(name, sym)

    # Fix 1: mark as maybe-moved (moved in some branches, not all) - sticky warning flag
    pub def mark_maybe_moved(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                sym.is_maybe_moved = true
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1
        if self.globals.contains(name):
            mut sym = self.globals.get(name)
            sym.is_maybe_moved = true
            self.globals.insert(name, sym)

    # Fix 4: reverse of mark_init - used to roll back per-branch init state
    pub def unmark_init(self, name: str):
        mut mi_i = self.scopes.len - 1
        while mi_i >= 0:
            if self.scopes.get(mi_i).variables.contains(name):
                mut mi_sym = self.scopes.get(mi_i).variables.get(name)
                mi_sym.is_init = false
                self.scopes.get(mi_i).variables.insert(name, mi_sym)
                return
            mi_i = mi_i - 1
        if self.globals.contains(name):
            mut mi_sym = self.globals.get(name)
            mi_sym.is_init = false
            self.globals.insert(name, mi_sym)

    # Fix 4: mark as maybe-init (init in some branches, not all)
    pub def mark_maybe_init(self, name: str):
        mut mi_i = self.scopes.len - 1
        while mi_i >= 0:
            if self.scopes.get(mi_i).variables.contains(name):
                mut mi_sym = self.scopes.get(mi_i).variables.get(name)
                mi_sym.is_maybe_init = true
                self.scopes.get(mi_i).variables.insert(name, mi_sym)
                return
            mi_i = mi_i - 1
        if self.globals.contains(name):
            mut mi_sym = self.globals.get(name)
            mi_sym.is_maybe_init = true
            self.globals.insert(name, mi_sym)

    # Fix 1/4: linear scan of a Vec[str] for membership (no built-in set)
    pub def vec_str_contains(self, v: Vec[str], s: str) -> bool:
        mut vi = 0
        while vi < v.len:
            if v.get(vi) == s: return true
            vi = vi + 1
        return false

    # Fix 3: lazy recursive check - classes with only primitive/copy fields are Copy
    # Inserts false as a sentinel to break self-referential cycles before recursing
    # True if a decorator list contains @copy (the explicit copy/share opt-in).
    pub def has_copy_decorator(self, decs: Vec[Decorator]) -> bool:
        mut i = 0
        while i < decs.len:
            if decs.get(i).name == "copy": return true
            i = i + 1
        return false

    pub def is_copy_class(self, name: str) -> bool:
        if self.is_primitive_name(name): return true
        if self.copy_classes.contains(name): return self.copy_classes.get(name)
        if not self.classes.contains(name): return false
        # Insert false sentinel to break cycles (self-referential structs are not Copy)
        self.copy_classes.insert(name, false)
        mut cls = self.classes.get(name)
        if cls.fields.len == 0: return false   # empty/opaque class - not Copy
        mut all_copy = true
        mut fi = 0
        while fi < cls.fields.len:
            mut fd = cls.fields.get(fi)
            if fd.ty as usize != 0 as usize:
                mut fty = fd.ty.read()
                # A `ref T` (borrow) field is a POINTER, not an embedded value: it is
                # trivially copyable and must NOT be descended into — for a self-
                # referential type (e.g. `parent: ref Ctx`) recursing on the field's
                # own class name infinitely re-enters is_copy_class. (Raw `Pointer[T]`
                # fields already don't recurse: "Pointer" isn't a user class.)
                if not fty.is_borrow:
                    if not self.is_copy_class(fty.name):
                        all_copy = false
            fi = fi + 1
        self.copy_classes.insert(name, all_copy)
        return all_copy

    pub def enter_scope(self):
        mut s_obj = Scope.init()
        self.scopes.push(s_obj)
        self.current_scope_depth = self.current_scope_depth + 1
        # auto-drop: each new scope starts its own C block, so reset the
        # nested-if/while block-depth counter; restored on exit_scope.
        self.block_depth_stack.push(self.block_depth)
        self.block_depth = 0
        self.block_stack_base.push(self.block_stack.len)

    pub def exit_scope(self):
        self.scopes.pop()
        self.current_scope_depth = self.current_scope_depth - 1
        self.block_depth = self.block_depth_stack.get(self.block_depth_stack.len - 1)
        self.block_depth_stack.pop()
        mut base = self.block_stack_base.get(self.block_stack_base.len - 1)
        while self.block_stack.len > base:
            self.block_stack.pop()
        self.block_stack_base.pop()

    # -- Auto-drop: compiler-inserted .free() for owned class-typed locals -----

    # True for element/key types whose List_<sfx>/Dict free function fully
    # releases the stored values (primitives, or `str` via List_TrStr_free /
    # Dict_free's strdup'd keys). Used to gate collection auto-drop to
    # specializations with a known-correct, fully-releasing free function.
    pub def _coll_elem_droppable(self, n: str) -> bool:
        if n == "str": return true
        if n == "int" or n == "float" or n == "bool" or n == "char": return true
        if n == "i8" or n == "i16" or n == "i32" or n == "i64": return true
        if n == "u8" or n == "u16" or n == "u32" or n == "u64" or n == "usize": return true
        if n == "f32" or n == "f64": return true
        # A refcounted heap-class element: the collection co-owns each element
        # (insert retains), and its typed free releases them (codegen gates the
        # actual release on is_heap_class_tn, so raw pointer-aliased element types
        # like Pointer[T] fall back to a container-only free). Value types / enums
        # are stored inline and need no per-element drop.
        if self.classes.contains(n):
            if not self.classes.get(n).is_class: return false   # @value_type: inline, no drop
            # "Box" excluded intentionally omitted: a builtin Box[T] never lands in
            # self.classes (guarded above), so tn=="Box" here is a user `class Box` whose
            # elements the collection co-owns and must drop (fixes Vec[Box] leak, F-1).
            if n == "Vec" or n == "Map" or n == "List" or n == "Dict" or n == "Set" or n == "Mutex" or n == "RwLock" or n == "Atomic" or n == "Shared" or n == "Option" or n == "Result" or n == "Chan" or n == "StringBuilder" or n == "StringObj": return false
            return true
        return false

    # ===== [S-2] ownership-cycle guarantee (--strict) =====
    # A program that compiles under --strict has NO strong-ownership cycles among
    # refcounted classes, so — with ARC + [U-1] (no raw alloc outside unsafe) — every
    # reference count reaches zero: provably leak-free.
    pub def _scan_ptr_aliased_ty(self, t: AstType):
        if t.name == "Pointer" and t.args.len > 0:
            mut inner = t.args.get(0).read()
            self.ptr_aliased.insert(inner.name, true)
            self._scan_ptr_aliased_ty(inner)
            return
        mut ai = 0
        while ai < t.args.len:
            self._scan_ptr_aliased_ty(t.args.get(ai).read())
            ai = ai + 1

    # True for a refcounted heap class (excludes @value_type, builtins, and any type
    # reachable as Pointer[T] — those are raw-managed, not ARC-refcounted).
    pub def _is_rc_class(self, n: str) -> bool:
        if not self.classes.contains(n): return false
        if not self.classes.get(n).is_class: return false
        if n == "Vec" or n == "Map" or n == "List" or n == "Dict" or n == "Set" or n == "Box" or n == "Mutex" or n == "RwLock" or n == "Atomic" or n == "Shared" or n == "Weak" or n == "Option" or n == "Result" or n == "Chan" or n == "StringBuilder" or n == "StringObj": return false
        if self.ptr_aliased.contains(n): return false
        return true

    # ===== [T-7] TRANSITIVE: does a thread-crossing value REACH a plain rc class? =====
    # A `Sendable`/`Shared` value that transitively holds a plain (non-atomic, thread-
    # local) rc class — directly, or inside Mutex[X]/Vec[X]/Dict[K,X]/… — is NOT
    # actually Send: crossing it lets two threads race that nested class's non-atomic
    # refcount (or dangle its lifetime). `Shared[X]`/`Weak[X]` are atomic (Arc) and
    # stop the recursion; `Pointer[X]` is the user's `unsafe` responsibility. Mirrors
    # Rust: `Mutex<Rc<_>>` is `!Send`.
    pub def _ty_reaches_plain_rc(self, ft: AstType, depth: int) -> bool:
        if depth > 24: return false
        mut n = ft.name
        if n == "Shared" or n == "Weak" or n == "Pointer": return false
        if n == "Mutex" or n == "RwLock" or n == "Box" or n == "Vec" or n == "List" or n == "Set" or n == "Chan" or n == "Option":
            if ft.args.len > 0: return self._ty_reaches_plain_rc(ft.args.get(0).read(), depth + 1)
            return false
        if n == "Dict" or n == "Map":
            if ft.args.len > 1: return self._ty_reaches_plain_rc(ft.args.get(1).read(), depth + 1)
            return false
        if self._is_rc_class(n): return true
        if self.classes.contains(n): return self._sendable_reaches_plain_rc(n, depth + 1)
        return false

    pub def _sendable_reaches_plain_rc(self, tn: str, depth: int) -> bool:
        if depth > 24: return false
        if not self.classes.contains(tn): return false
        mut cls = self.classes.get(tn)
        mut i = 0
        while i < cls.fields.len:
            mut f = cls.fields.get(i)
            if f.ty as usize != 0 as usize:
                if self._ty_reaches_plain_rc(f.ty.read(), depth + 1): return true
            i = i + 1
        return false

    # [T-7] transitive check on a spawn ARG: even when the arg itself is atomic
    # (Shared[T]) or a sync primitive (Mutex[T]), reject it if it transitively
    # reaches a plain rc class. A bare plain-rc-class arg is left to the DIRECT
    # [T-7] check (avoids a duplicate error).
    # `implements Sendable, UnsafeSendable` is Tauraro's `unsafe impl Send/Sync`:
    # the author has AUDITED this class's cross-thread safety (including the atomicity
    # of any refcounts it touches). It is the small, explicit unsafe core a systems
    # framework (like hyper/tokio) needs. Such a class is therefore exempt from the
    # automatic [T-7] rc-safety check — a program that compiles WITHOUT UnsafeSendable
    # still has the full guarantee; UnsafeSendable is the opt-out at the boundary.
    pub def _is_unsafe_sendable(self, n: str) -> bool:
        if not self.classes.contains(n): return false
        mut cls = self.classes.get(n)
        if _is_invalid_ptr(cls.iface_names as usize): return false
        mut i = 0
        while i < cls.iface_names.len:
            if cls.iface_names.get(i) == "UnsafeSendable": return true
            i = i + 1
        return false

    pub def _check_spawn_nested_rc(self, arg_expr: Pointer[HirExpr]):
        if not self.strict_mode: return
        if _is_invalid_ptr(arg_expr as usize): return
        mut at = hir_expr_type(arg_expr)
        mut n = at.name
        # The crossing class the author may have audited (unwrap a Shared handle).
        mut _cross_cls = n
        if (n == "Shared" or n == "Weak") and at.args.len > 0: _cross_cls = at.args.get(0).read().name
        if self._is_unsafe_sendable(_cross_cls): return
        mut reaches = false
        if self._expr_is_shared(arg_expr):
            mut inner = n
            if (n == "Shared" or n == "Weak") and at.args.len > 0: inner = at.args.get(0).read().name
            reaches = self._sendable_reaches_plain_rc(inner, 0)
        elif (n == "Mutex" or n == "RwLock" or n == "Box" or n == "Vec" or n == "List" or n == "Set" or n == "Option" or n == "Chan") and at.args.len > 0:
            reaches = self._ty_reaches_plain_rc(at.args.get(0).read(), 0)
        elif (n == "Dict" or n == "Map") and at.args.len > 1:
            reaches = self._ty_reaches_plain_rc(at.args.get(1).read(), 0)
        if reaches:
            self.error("[T-7] a value crossing the thread boundary transitively holds a plain (non-atomic) reference-counted class inside '" + n + "' (e.g. via a Mutex/Vec/field). Even wrapped in Shared/Sendable, that nested class's refcount is thread-local and would race across threads.\n      FIX: make the nested state 'Shared[T]' (atomic, like Rust's 'Arc'), or restructure so only one thread ever owns it.")

    # Append the refcounted class names that field type `ft` STRONGLY owns. A
    # Pointer[T] or Weak[T] is NOT ownership (breaks a cycle); a collection owns its
    # element/value; Shared[T] is strong shared ownership.
    pub def _collect_strong_edge(self, ft: AstType, out: Vec[str]):
        mut n = ft.name
        # A `ref T` (borrow) field is NON-OWNING — like Pointer[T]/Weak[T], it does
        # not keep its target alive, so it can never form a strong (leaking) cycle.
        # A parent-pointer / back-reference via `ref` (e.g. templa's `Context.parent:
        # ref Context`) is the canonical safe way to break an ownership cycle.
        if ft.is_borrow: return
        if n == "Pointer" or n == "Weak": return
        if n == "Vec" or n == "List" or n == "Set":
            if ft.args.len > 0: self._collect_strong_edge(ft.args.get(0).read(), out)
            return
        if n == "Dict" or n == "Map":
            if ft.args.len > 1: self._collect_strong_edge(ft.args.get(1).read(), out)
            return
        if n == "Shared":
            if ft.args.len > 0:
                mut si = ft.args.get(0).read().name
                if self.classes.contains(si): out.push(si)
            return
        if self._is_rc_class(n): out.push(n)

    pub def _strong_owned(self, cd: ClassDef) -> Vec[str]:
        mut out = Vec[str].init(4)
        mut i = 0
        while i < cd.fields.len:
            mut f = cd.fields.get(i)
            if f.ty as usize != 0 as usize:
                self._collect_strong_edge(f.ty.read(), out)
            i = i + 1
        return out

    # DFS from `start`, following strong-ownership edges; if we come back to a class
    # already on the current path, that path is a leak cycle → report [S-2] once.
    pub def _cycle_dfs(self, cur: str, start: str, on_path: Map[str, bool], reported: Map[str, bool], depth: int):
        if depth > 200: return
        if not self.classes.contains(cur): return
        mut edges = self._strong_owned(self.classes.get(cur))
        mut i = 0
        while i < edges.len:
            mut nxt = edges.get(i)
            if nxt == start:
                # cycle closes back to start.
                if not reported.contains(start):
                    reported.insert(start, true)
                    self.error("[S-2] class '" + start + "' is part of a strong reference CYCLE (via '" + cur + "' -> '" + nxt + "'), which reference counting cannot reclaim — it would leak.\n      FIX: make one back-edge non-owning with 'Weak[" + start + "]' (a weak reference) or 'Pointer[" + start + "]' (raw, manual).")
            elif not on_path.contains(nxt):
                on_path.insert(nxt, true)
                self._cycle_dfs(nxt, start, on_path, reported, depth + 1)
                on_path.insert(nxt, false)
            i = i + 1

    pub def check_ownership_cycles(self, prog: Program):
        # 1) Collect raw Pointer[T] usage across all class fields + method signatures.
        mut di = 0
        while di < prog.decls.len:
            match prog.decls.get(di).read():
                case Decl.DClass(c): self._scan_class_ptrs(c)
                case Decl.DActor(c): self._scan_class_ptrs(c)
                case Decl.DExtend(_, ms):
                    mut mi = 0
                    while mi < ms.len:
                        self._scan_fn_ptrs(ms.get(mi))
                        mi = mi + 1
                case Decl.DFunction(f): self._scan_fn_ptrs(f)
                case _: pass
            di = di + 1
        # 2) DFS each refcounted class for a strong-ownership cycle.
        mut reported = Map[str, bool].init(16)
        di = 0
        while di < prog.decls.len:
            match prog.decls.get(di).read():
                case Decl.DClass(c):
                    if self._is_rc_class(c.name):
                        mut on_path = Map[str, bool].init(16)
                        on_path.insert(c.name, true)
                        self._cycle_dfs(c.name, c.name, on_path, reported, 0)
                case _: pass
            di = di + 1

    pub def _scan_class_ptrs(self, c: ClassDef):
        mut i = 0
        while i < c.fields.len:
            mut f = c.fields.get(i)
            if f.ty as usize != 0 as usize: self._scan_ptr_aliased_ty(f.ty.read())
            i = i + 1
        i = 0
        while i < c.methods.len:
            self._scan_fn_ptrs(c.methods.get(i))
            i = i + 1

    pub def _scan_fn_ptrs(self, f: FunctionDef):
        mut i = 0
        while i < f.params.len:
            mut p = f.params.get(i)
            if p.ty as usize != 0 as usize: self._scan_ptr_aliased_ty(p.ty.read())
            i = i + 1
        if f.ret_ty as usize != 0 as usize: self._scan_ptr_aliased_ty(f.ret_ty.read())

    # A local is auto-dropped at scope exit if it is a user-defined class with a
    # 'free' method, was never moved/returned/borrowed-out, was never freed
    # manually, and was definitely initialized on every path.
    pub def is_droppable_sym(self, sym: Symbol) -> bool:
        if sym.kind != SymbolKind.SVariable: return false
        if sym.is_param: return false
        if sym.ty as usize == 0 as usize: return false
        # A `shared` (Shared[T]/Rc) local owns one strong reference to a control
        # block; auto-drop it (`_tr_shared_drop`) at scope exit so the refcount is
        # released and the payload reclaimed at count 0 (codegen routes SAutoDrop for
        # a shared_vars name to _tr_shared_drop). A `Weak[T]` local likewise releases
        # its weak handle. Both were previously leaked (manual `.drop()` only).
        if sym.is_shared:
            if sym.is_moved or sym.is_maybe_moved or sym.is_freed: return false
            if not sym.is_init or sym.is_maybe_init: return false
            return true
        if sym.ty.read().name == "Weak":
            if sym.is_moved or sym.is_maybe_moved or sym.is_freed: return false
            if not sym.is_init or sym.is_maybe_init: return false
            return true
        # A value BORROWED from a collection element (`x = coll.get(i)`) ALIASES that
        # element — it does NOT own it. Auto-dropping it (releasing its str fields /
        # calling free) would free data the collection still owns: a use-after-free.
        # Marked "@borrowed" at the SLet. Never droppable.
        if sym.borrows_region == "@borrowed": return false
        mut tn = sym.ty.read().name
        # `str` locals get retain/release auto-drop, gated by the same
        # block-id "visible" check compute_scope_drops uses for class-typed
        # locals (sibling if/while branches are correctly disambiguated).
        # str_escaped (passed as a call/method-call argument - may be
        # shallow-aliased into a legacy List_str/Dict/Set, #52 not yet
        # migrated) is excluded to avoid use-after-free.
        if tn == "str":
            if sym.str_escaped: return false
            if sym.is_moved or sym.is_maybe_moved or sym.is_freed: return false
            if sym.active_borrows > 0: return false
            if not sym.is_init or sym.is_maybe_init: return false
            return true
        # List/Vec/Dict/Map/Set locals: raw unrefcounted heap pointers, so only
        # auto-drop when this local NEVER appears in a non-receiver position
        # (coll_escaped) - i.e. no other name can alias the same pointer - and
        # only for "POD" specializations where the runtime free function fully
        # releases all stored elements/keys/values (see _coll_elem_droppable).
        # Dict/Map[*, str] is excluded: boxed TrStr values aren't released by
        # Dict_free (#54, pre-existing gap, not made worse here).
        if tn == "List" or tn == "Vec" or tn == "Dict" or tn == "Map" or tn == "Set":
            if sym.coll_escaped: return false
            if sym.is_moved or sym.is_maybe_moved or sym.is_freed: return false
            if sym.active_borrows > 0: return false
            if not sym.is_init or sym.is_maybe_init: return false
            mut targs = sym.ty.read().args
            if tn == "Dict" or tn == "Map":
                if targs.len < 2: return false
                mut kt = targs.get(0).read().name
                mut vt = targs.get(1).read().name
                if not self._coll_elem_droppable(kt): return false
                # vt == "str": values are _tr_str_box(TrStr)-allocated; the
                # codegen-side Dict_free_strval/_tr_idict_free_strval (#54)
                # unbox+release each value, so this is safe.
                if not self._coll_elem_droppable(vt): return false
                return true
            else:
                if targs.len < 1: return false
                mut et = targs.get(0).read().name
                if not self._coll_elem_droppable(et): return false
                return true
        # A Mutex[T] local owns its box (rc=1): drop it at scope exit. `_tr_mutexbox_drop`
        # unlocks a still-held guard, then — when the box owns a FRESH, unaliased payload
        # (_tr_mutexbox_new_owned) — releases that payload (closes the F-3/F-4 leak). A
        # BORROWED payload (Mutex[App].init(self)) is never owned, so never double-freed.
        # Move/borrow/init guards as for any owned local.
        if tn == "Mutex":
            if sym.is_moved or sym.is_maybe_moved or sym.is_freed: return false
            if sym.active_borrows > 0: return false
            if not sym.is_init or sym.is_maybe_init: return false
            return true
        if not self.classes.contains(tn): return false
        # "Box" omitted: builtin Box[T] is not in self.classes (guarded above), so a
        # tn=="Box" here is a user `class Box` — a droppable owned local, not the builtin.
        if tn == "Vec" or tn == "Map" or tn == "List" or tn == "Dict" or tn == "Mutex" or tn == "RwLock" or tn == "Atomic" or tn == "Shared" or tn == "Option" or tn == "Result" or tn == "Chan": return false
        # StringBuilder/StringObj methods like as_str()/to_str() can return a
        # pointer that aliases the instance's own internal buffer; auto-freeing
        # the instance would dangle that alias. Require an explicit .free().
        if tn == "StringBuilder" or tn == "StringObj": return false
        if sym.is_moved or sym.is_maybe_moved or sym.is_freed: return false
        if sym.active_borrows > 0: return false
        if not sym.is_init or sym.is_maybe_init: return false
        mut cls = self.classes.get(tn)
        mut mi = 0
        mut has_dispose = false
        while mi < cls.methods.len:
            mut mnm = cls.methods.get(mi).name
            if mnm == "free":
                # A user `free()` class is MANUALLY managed (not refcount-balanced).
                # If this instance was passed to a callee in a non-receiver position
                # (mark_coll_arg set coll_escaped), that callee may take ownership and
                # call free() itself — e.g. `c.send_json_writer(200, w)` frees `w`.
                # Auto-dropping here too would call free() twice → double-free/heap
                # corruption. Exclude it (a leak at worst, never a UAF), same as the
                # collection path does. (Refcounted plain classes below are exempt —
                # rc is the safety net there.)
                if sym.coll_escaped: return false
                return true          # user free(): called at scope exit
            if mnm == "dispose": has_dispose = true
            mi = mi + 1
        # A `dispose()` class self-manages its memory — hands off (no double-free).
        if has_dispose: return false
        # Plain heap class: REFCOUNTED. Released at scope exit via _tr_obj_release,
        # which the codegen gates on class_local_names (only OWNING locals enter it).
        # Combined with retain-on-bind/store/return, this is balanced regardless of
        # aliasing (rc is the safety net) — so no @owned/escape gate is needed here.
        # (`@borrowed` collection-element borrows are excluded at the top of this fn.)
        return true

    # Open a new if/while/etc body block, assigning it a fresh monotonic id.
    pub def open_block(self):
        self.next_block_id = self.next_block_id + 1
        self.block_stack.push(self.next_block_id)

    # Close the innermost currently-open if/while/etc body block.
    pub def close_block(self):
        self.block_stack.pop()

    # True if `id` is one of the currently-open if/while body blocks.
    pub def block_stack_contains(self, id: int) -> bool:
        mut i = 0
        while i < self.block_stack.len:
            if self.block_stack.get(i) == id: return true
            i = i + 1
        return false

    # All droppable locals declared directly in scope `scope_idx` whose declaration
    # block is still "open" (i.e. not inside an if/while body that has already
    # closed its C block), as SAutoDrop stmts. `is_innermost` is true only for the
    # current (innermost) scope, where `self.block_stack` reflects open blocks.
    pub def compute_scope_drops(self, scope_idx: int, is_innermost: bool) -> Vec[Pointer[HirStmt]]:
        mut out = Vec[Pointer[HirStmt]].init(2)
        if scope_idx < 0 or scope_idx >= self.scopes.len: return out
        mut scope = self.scopes.get(scope_idx)
        mut ki = 0
        while ki < scope.decl_order.len:
            mut nm = scope.decl_order.get(ki)
            # DEFENSIVE: a name may appear in decl_order without a fully-formed entry
            # in `variables` (e.g. while an enclosing function's scope is still being
            # built and a nested function is lowered through it). Reading such a
            # Symbol — or its null `ty` — is a use of uninitialised memory that
            # segfaults under some build layouts. Skip anything not soundly present.
            if scope.variables.contains(nm):
                mut sym = scope.variables.get(nm)
                if (sym.ty as usize) != 0 as usize:
                    mut visible = sym.decl_block_id == 0
                    if not visible and is_innermost:
                        visible = self.block_stack_contains(sym.decl_block_id)
                    if visible:
                        if self.is_droppable_sym(sym):
                            out.push(box_hirstmt(HirStmt.SAutoDrop(nm, sym.ty.read().name)))
            ki = ki + 1
        return out

    # Append SAutoDrop stmts to `hb` for every droppable local in scopes
    # [from_idx .. self.scopes.len-1], innermost scope first.
    pub def append_drops_from(self, hb: HirBlock, from_idx: int):
        self.append_drops_from_excl(hb, from_idx, "")

    # Same as append_drops_from, but skips a variable named `exclude` (used for
    # `return x` where x is itself the droppable local - ownership transfers to
    # the caller instead of being freed).
    pub def append_drops_from_excl(self, hb: HirBlock, from_idx: int, exclude: str):
        mut excl_list = Vec[str].init(1)
        if exclude != "": excl_list.push(exclude)
        self.append_drops_from_excl_multi(hb, from_idx, excl_list)

    # Same as append_drops_from_excl, but skips every name in `excludes` (used
    # for `return EXPR` where EXPR reads one or more droppable locals - those
    # locals must stay alive until the return value is computed, so they are
    # excluded from THIS exit point's auto-drops; ownership of any local
    # actually returned transfers to the caller, the rest simply leak on this
    # path rather than risk a use-after-free in the return expression).
    pub def append_drops_from_excl_multi(self, hb: HirBlock, from_idx: int, excludes: Vec[str]):
        mut idx = self.scopes.len - 1
        while idx >= from_idx:
            mut is_innermost = idx == self.scopes.len - 1
            mut drops = self.compute_scope_drops(idx, is_innermost)
            mut di = 0
            while di < drops.len:
                mut d = drops.get(di)
                mut skip = false
                match d.read():
                    case HirStmt.SAutoDrop(dn, _):
                        mut ei = 0
                        while ei < excludes.len:
                            if excludes.get(ei) == dn: skip = true
                            ei = ei + 1
                    case _: pass
                if not skip: hb.push(d)
                di = di + 1
            idx = idx - 1

    # Collect the names of every EIdent referenced anywhere inside `e` into
    # `out` (best-effort recursive walk over the common HirExpr shapes). Used
    # to find `str` locals that a `return EXPR` reads, so they aren't
    # auto-dropped before EXPR is evaluated.
    pub def collect_idents(self, e: Pointer[HirExpr], out: Vec[str]):
        if e as usize == 0 as usize: return
        if _is_invalid_ptr(e as usize): return
        match e.read():
            case HirExpr.EIdent(nm, _, _): out.push(nm)
            case HirExpr.EBinOp(_, l, r, _):
                self.collect_idents(l, out)
                self.collect_idents(r, out)
            case HirExpr.EUnaryOp(_, inner, _): self.collect_idents(inner, out)
            case HirExpr.ECall(callee, args, _):
                self.collect_idents(callee, out)
                mut i = 0
                while i < args.len:
                    self.collect_idents(args.get(i), out)
                    i = i + 1
            case HirExpr.EMethodCall(obj, _, args, _):
                self.collect_idents(obj, out)
                mut i = 0
                while i < args.len:
                    self.collect_idents(args.get(i), out)
                    i = i + 1
            case HirExpr.EPropAccess(obj, _, _): self.collect_idents(obj, out)
            case HirExpr.EIndex(obj, idx, _):
                self.collect_idents(obj, out)
                self.collect_idents(idx, out)
            case HirExpr.ECast(inner, _): self.collect_idents(inner, out)
            case HirExpr.ETryExpr(inner, _): self.collect_idents(inner, out)
            case HirExpr.EIfElse(c, t, f, _):
                self.collect_idents(c, out)
                self.collect_idents(t, out)
                self.collect_idents(f, out)
            case HirExpr.EList(items, _):
                mut i = 0
                while i < items.len:
                    self.collect_idents(items.get(i), out)
                    i = i + 1
            case HirExpr.ESet(items, _):
                mut i = 0
                while i < items.len:
                    self.collect_idents(items.get(i), out)
                    i = i + 1
            case HirExpr.ETuple(items, _):
                mut i = 0
                while i < items.len:
                    self.collect_idents(items.get(i), out)
                    i = i + 1
            case HirExpr.EDict(keys, vals, _):
                mut i = 0
                while i < keys.len:
                    self.collect_idents(keys.get(i), out)
                    self.collect_idents(vals.get(i), out)
                    i = i + 1
            case HirExpr.ERange(s, en, _, _):
                self.collect_idents(s, out)
                self.collect_idents(en, out)
            case HirExpr.EAwait(inner, _): self.collect_idents(inner, out)
            case HirExpr.EAwaitTimeout(inner, to, _):
                self.collect_idents(inner, out)
                self.collect_idents(to, out)
            case HirExpr.EYield(inner, _): self.collect_idents(inner, out)
            case _: pass

    # True if `name` is a declared local/param variable in any open scope.
    pub def is_local_var(self, name: str) -> bool:
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name): return true
            i = i - 1
        return false

    pub def mark_str_escaped(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                sym.str_escaped = true
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1

    # [L-3/L-4] region derivation: record which region `name`'s CURRENT value derives
    # from. Updated on each assignment so it always reflects the latest binding.
    pub def set_borrows_region(self, name: str, region: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                sym.borrows_region = region
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1

    # The region a value `e` derives from (see Symbol.borrows_region for the encoding):
    #   "@owned" = a `+` concat (freshly built, owned, never a borrow);
    #   "<param>"/"<region>" = shares a parameter (directly) or another local's region
    #     (transitively — `mut x = w` inherits w's region);
    #   "" = unknown (slices, calls, anything we can't prove — NEVER flagged → sound).
    pub def compute_region(self, e: Pointer[Expr]) -> str:
        if e as usize == 0 as usize: return ""
        match e.read():
            case Expr.EBinOp(cr_op, _, _):
                if cr_op == "+": return "@owned"
                return ""
            case Expr.EIdent(cr_nm):
                mut cr_sym = self.resolve(cr_nm)
                if cr_sym.name == "": return ""
                if cr_sym.is_param: return cr_nm
                return cr_sym.borrows_region
            case Expr.ECall(cr_callee, cr_args):
                if cr_callee as usize != 0 as usize:
                    match cr_callee.read():
                        case Expr.EIdent(cr_fn):
                            # Constructor call `T()` → a freshly-OWNED instance.
                            if self.classes.contains(cr_fn): return "@owned"
                            mut cr_fsym = self.resolve(cr_fn)
                            if cr_fsym.name != "" and cr_fsym.ty as usize != 0 as usize:
                                mut cr_ret = cr_fsym.ty.read()
                                if cr_ret.is_borrow:
                                    # [cross-fn] `f -> ref .. from p` borrows arg p's region.
                                    if cr_ret.from_index >= 0 and cr_ret.from_index < cr_args.len:
                                        return self.compute_region(cr_args.get(cr_ret.from_index))
                                    return ""   # borrow of an unknown region
                                # Non-`ref` function returning by value → caller OWNS it.
                                return "@owned"
                        case _: pass
                return ""
            case _: return ""

    # `where` enforcement: true if region `longer` is declared (via a `where … outlives …`
    # bound on the current function, possibly one level transitively) to outlive `shorter`.
    # A longer-lived region's borrow is valid wherever the shorter one is needed.
    pub def region_outlives(self, longer: str, shorter: str) -> bool:
        mut i = 0
        while i < self.current_func_outlives_a.len:
            if self.current_func_outlives_a.get(i) == longer and self.current_func_outlives_b.get(i) == shorter:
                return true
            i = i + 1
        mut j = 0
        while j < self.current_func_outlives_a.len:
            if self.current_func_outlives_a.get(j) == longer:
                mut mid = self.current_func_outlives_b.get(j)
                mut kk = 0
                while kk < self.current_func_outlives_a.len:
                    if self.current_func_outlives_a.get(kk) == mid and self.current_func_outlives_b.get(kk) == shorter:
                        return true
                    kk = kk + 1
            j = j + 1
        return false

    # [L-5] True iff `obj.field` names a `ref` (borrow) field. Sound: returns false
    # whenever the object's class or the field can't be resolved (never over-flags).
    pub def field_is_borrow(self, obj: Pointer[Expr], field: str) -> bool:
        if obj as usize == 0 as usize: return false
        mut cls_name = ""
        match obj.read():
            case Expr.EIdent(fb_obj):
                if fb_obj == "self":
                    cls_name = self.current_class_name
                else:
                    mut fb_sym = self.resolve(fb_obj)
                    if fb_sym.name != "" and fb_sym.ty as usize != 0 as usize:
                        cls_name = fb_sym.ty.read().name
            case _: pass
        if cls_name == "": return false
        if not self.classes.contains(cls_name): return false
        mut fb_cls = self.classes.get(cls_name)
        mut fb_i = 0
        while fb_i < fb_cls.fields.len:
            mut fb_fld = fb_cls.fields.get(fb_i)
            if fb_fld.name == field:
                if fb_fld.ty as usize != 0 as usize:
                    return fb_fld.ty.read().is_borrow
            fb_i = fb_i + 1
        return false

    # If `e` is a bare `str`-typed identifier, mark its symbol as escaped (it
    # is being passed as a call/method-call ARGUMENT, so a copy of it may be
    # stored - shallow-aliased - inside a legacy List_str/Dict/Set element,
    # which doesn't retain; #52 not yet migrated). Excluding it from auto-drop
    # turns a potential use-after-free into a leak.
    pub def mark_str_arg(self, e: Pointer[HirExpr]):
        if e as usize == 0 as usize: return
        if _is_invalid_ptr(e as usize): return
        match e.read():
            case HirExpr.EIdent(nm, _, _):
                if hir_expr_type(e).name == "str": self.mark_str_escaped(nm)
            case _: pass

    # Recursively scan a lowered expression for ECall/EMethodCall argument
    # lists and mark any bare `str` identifier arguments as escaped.
    pub def mark_escaped_str_args(self, e: Pointer[HirExpr]):
        if e as usize == 0 as usize: return
        if _is_invalid_ptr(e as usize): return
        match e.read():
            case HirExpr.EBinOp(_, l, r, _):
                self.mark_escaped_str_args(l)
                self.mark_escaped_str_args(r)
            case HirExpr.EUnaryOp(_, inner, _): self.mark_escaped_str_args(inner)
            case HirExpr.ECall(callee, args, _):
                self.mark_escaped_str_args(callee)
                # A str local passed to a function / constructor / static method
                # stays auto-drop-eligible (same reasoning as the EMethodCall
                # branch below): a constructor that stores the arg into a field
                # retains it (str_retain_wrap on the `self.f = arg` assignment),
                # and plain/static calls only READ their str params (params are
                # never auto-dropped). So the caller is never the sole owner of
                # storage the callee keeps. The ONE exception is the
                # `unsafe: _tr_c_free(x as Pointer[char])` idiom, which manually
                # frees x's TrStr.data; x must stay escaped there so auto-drop
                # doesn't ALSO release it (double-free).
                mut _call_is_c_free = false
                match callee.read():
                    case HirExpr.EIdent(_cnm, _, _):
                        if _cnm == "_tr_c_free": _call_is_c_free = true
                    case _: pass
                mut i = 0
                while i < args.len:
                    if _call_is_c_free:
                        # `unsafe: _tr_c_free(x as Pointer[char])` manually frees
                        # x's underlying TrStr.data - the std-lib idiom for
                        # releasing strings returned by Str.slice/to_lower/
                        # to_owned/etc, predating #53's auto-drop. If `x` is a
                        # bare str-typed local, mark it escaped so #53 doesn't
                        # ALSO insert a scope-exit _tr_str_release(x), which
                        # would double-free x.data (and x.rc).
                        match args.get(i).read():
                            case HirExpr.ECast(_cf_inner, _):
                                self.mark_str_arg(_cf_inner)
                            case _: pass
                    self.mark_escaped_str_args(args.get(i))
                    i = i + 1
            case HirExpr.EMethodCall(obj, mname, args, _):
                self.mark_escaped_str_args(obj)
                # A `str` local passed as a METHOD argument stays eligible for
                # auto-drop. Every way a callee can STORE a str arg with an
                # extended lifetime takes its OWN reference:
                #   - field assignment retains (str_retain_wrap wraps the RHS of
                #     `self.field = arg` - an EPropAccess target - in c.tr),
                #   - List/Vec/Set/Map/Dict inserts retain (#52 List_TrStr, #54
                #     Dict str values, Tier2b Dict value boxing),
                #   - enum/tuple/box payloads retain on construction.
                # So the caller is never left as the sole owner of storage the
                # callee keeps; the scope-exit `_tr_str_release` just drops the
                # CALLER's own reference (the stored copy's refcount keeps it
                # alive). Marking these args escaped (the old behaviour) instead
                # LEAKED every str handed to a user-class instance method, e.g.
                # `w.field_str(k, name)`, `c.send_text(200, body)` - the
                # get_param / response-body leak. The only genuine alias risk is
                # raw-pointer storage in `unsafe` code, which is the author's
                # responsibility (and `_tr_c_free(x ...)` is still special-cased
                # in the ECall branch above to avoid a double-free).
                mut i = 0
                while i < args.len:
                    self.mark_escaped_str_args(args.get(i))
                    i = i + 1
            case HirExpr.EPropAccess(obj, _, _): self.mark_escaped_str_args(obj)
            case HirExpr.EIndex(obj, idx, _):
                self.mark_escaped_str_args(obj)
                self.mark_escaped_str_args(idx)
            case HirExpr.ECast(inner, _): self.mark_escaped_str_args(inner)
            case HirExpr.ETryExpr(inner, _): self.mark_escaped_str_args(inner)
            case HirExpr.EIfElse(c, t, f, _):
                self.mark_escaped_str_args(c)
                self.mark_escaped_str_args(t)
                self.mark_escaped_str_args(f)
            case HirExpr.EList(items, _):
                mut i = 0
                while i < items.len:
                    self.mark_escaped_str_args(items.get(i))
                    i = i + 1
            case HirExpr.ESet(items, _):
                mut i = 0
                while i < items.len:
                    self.mark_escaped_str_args(items.get(i))
                    i = i + 1
            case HirExpr.ETuple(items, _):
                mut i = 0
                while i < items.len:
                    self.mark_escaped_str_args(items.get(i))
                    i = i + 1
            case HirExpr.EDict(keys, vals, _):
                mut i = 0
                while i < keys.len:
                    self.mark_escaped_str_args(keys.get(i))
                    self.mark_escaped_str_args(vals.get(i))
                    i = i + 1
            case HirExpr.ERange(s, en, _, _):
                self.mark_escaped_str_args(s)
                self.mark_escaped_str_args(en)
            case HirExpr.EAwait(inner, _): self.mark_escaped_str_args(inner)
            case HirExpr.EAwaitTimeout(inner, to, _):
                self.mark_escaped_str_args(inner)
                self.mark_escaped_str_args(to)
            case HirExpr.EYield(inner, _): self.mark_escaped_str_args(inner)
            # f-string interpolations only read/format their operands (no
            # storage), so just recurse for nested escapes.
            case HirExpr.EFString(parts, _):
                mut i = 0
                while i < parts.len:
                    mut part = parts.get(i)
                    if part.is_expr: self.mark_escaped_str_args(part.expr)
                    i = i + 1
            # A closure capturing a `str` local holds a reference that may
            # outlive the enclosing scope (the closure itself may be stored
            # or returned), so captured str locals are excluded from
            # auto-drop. The closure body's own statements are independently
            # walked by lower_block when the body is lowered.
            case HirExpr.EClosure(_, _, _, _, captures):
                mut i = 0
                while i < captures.len:
                    mut cap = captures.get(i)
                    if cap.ty.name == "str": self.mark_str_escaped(cap.name)
                    i = i + 1
            # `super.method(args)` may stash a str arg into a base-class
            # field, same reasoning as constructor calls in ECall.
            case HirExpr.ESuperMethodCall(_, _, args, _):
                mut i = 0
                while i < args.len:
                    self.mark_str_arg(args.get(i))
                    self.mark_escaped_str_args(args.get(i))
                    i = i + 1
            case HirExpr.ESuperPropAccess(_, _, _): pass
            # The comprehension element may be a bare str identifier stored
            # into the resulting List[str]/Set[str] - mark it escaped, same
            # as EList items. Source/filter exprs are only read.
            case HirExpr.EListComp(element, generators, _):
                self.mark_str_arg(element)
                self.mark_escaped_str_args(element)
                mut i = 0
                while i < generators.len:
                    mut gen = generators.get(i).read()
                    self.mark_escaped_str_args(gen.iter)
                    mut j = 0
                    while j < gen.ifs.len:
                        self.mark_escaped_str_args(gen.ifs.get(j))
                        j = j + 1
                    i = i + 1
            case HirExpr.EGeneratorExpr(element, generators, _):
                self.mark_str_arg(element)
                self.mark_escaped_str_args(element)
                mut i = 0
                while i < generators.len:
                    mut gen = generators.get(i).read()
                    self.mark_escaped_str_args(gen.iter)
                    mut j = 0
                    while j < gen.ifs.len:
                        self.mark_escaped_str_args(gen.ifs.get(j))
                        j = j + 1
                    i = i + 1
            case HirExpr.ESlice(start, stop, step, _):
                self.mark_escaped_str_args(start)
                self.mark_escaped_str_args(stop)
                self.mark_escaped_str_args(step)
            # ETry's try/catch/finally blocks are walked statement-by-statement
            # by lower_block when each block is lowered, so no recursion is
            # needed here.
            case HirExpr.ETry(_, _, _, _): pass
            # `do:` block-expression. Inner statements are escape-marked during
            # lowering; the trailing value is RETAINED (copied) into the block's
            # result temp by codegen, not moved, so nothing here escapes.
            case HirExpr.EDo(_do_b, _): pass
            # match-EXPRESSION: arm bodies are escape-marked during lowering; each
            # arm's value is captured (retained) into the result temp, not moved.
            case HirExpr.EMatchExpr(_, _, _): pass
            # loop/while EXPRESSIONS: bodies are escape-marked during lowering; the
            # break value is captured (retained) into the result temp, not moved.
            case HirExpr.ELoop(_, _): pass
            case HirExpr.EWhileExpr(_, _, _, _): pass
            # Leaf/literal variants - nothing to recurse into or mark.
            case HirExpr.ELitInt(_, _): pass
            case HirExpr.ELitFloat(_, _): pass
            case HirExpr.ELitStr(_, _): pass
            case HirExpr.ELitBytes(_, _): pass
            case HirExpr.ERawStr(_, _): pass
            case HirExpr.ELitChar(_, _): pass
            case HirExpr.ELitBool(_, _): pass
            case HirExpr.ELitNone(_): pass
            case HirExpr.ESizeOf(_, _): pass
            case HirExpr.EIdent(_, _, _): pass

    pub def mark_coll_escaped(self, name: str):
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name):
                mut sym = self.scopes.get(i).variables.get(name)
                sym.coll_escaped = true
                self.scopes.get(i).variables.insert(name, sym)
                return
            i = i - 1

    # If `e` is a bare List/Vec/Dict/Map/Set-typed identifier, mark its symbol
    # as escaped: it is being read in a non-receiver position (call/method
    # arg, assignment/let RHS, return value, literal element), so another
    # name may now hold/alias the same raw pointer. Auto-freeing it would
    # risk a use-after-free or double-free, so it's excluded from auto-drop
    # entirely (becomes a leak instead, same trade-off as str_escaped).
    pub def mark_coll_arg(self, e: Pointer[HirExpr]):
        if e as usize == 0 as usize: return
        if _is_invalid_ptr(e as usize): return
        match e.read():
            case HirExpr.EIdent(nm, _, _):
                mut tn = hir_expr_type(e).name
                if tn == "List" or tn == "Vec" or tn == "Dict" or tn == "Map" or tn == "Set":
                    self.mark_coll_escaped(nm)
                elif self.classes.contains(tn):
                    # A class instance passed in a NON-RECEIVER position (call/method arg,
                    # RHS, return, literal element) may be stored by the callee (pushed into
                    # a collection, kept in a field). The implicit field-destructor must not
                    # then free its str fields — the new owner still holds them (UAF). Reuse
                    # coll_escaped to exclude it from auto-drop (a leak, never a UAF).
                    self.mark_coll_escaped(nm)
            case _: pass

    # Recursively scan a lowered expression for any bare List/Vec/Dict/Map/Set
    # identifier appearing in a non-receiver position and mark it escaped.
    # Unlike mark_escaped_str_args, there are NO retain-on-insert exceptions:
    # collections are raw unrefcounted pointers, so passing one as an argument
    # (even append/insert) may store/capture the pointer itself.
    pub def mark_escaped_coll_args(self, e: Pointer[HirExpr]):
        if e as usize == 0 as usize: return
        if _is_invalid_ptr(e as usize): return
        match e.read():
            case HirExpr.EBinOp(_, l, r, _):
                self.mark_coll_arg(l)
                self.mark_escaped_coll_args(l)
                self.mark_coll_arg(r)
                self.mark_escaped_coll_args(r)
            case HirExpr.EUnaryOp(_, inner, _):
                self.mark_coll_arg(inner)
                self.mark_escaped_coll_args(inner)
            case HirExpr.ECall(callee, args, _):
                self.mark_escaped_coll_args(callee)
                mut i = 0
                while i < args.len:
                    self.mark_coll_arg(args.get(i))
                    self.mark_escaped_coll_args(args.get(i))
                    i = i + 1
            case HirExpr.EMethodCall(obj, method, args, _):
                # `obj` is the receiver (e.g. `l.append(...)`) - reading it to
                # invoke a method on it doesn't alias the pointer elsewhere,
                # so it is NOT marked here (only recursed into, for nested
                # exprs). Every argument, however, IS marked.
                #
                # EXCEPTION (#54): for Dict[K,str]/Map[K,str], .get()/.get_or()/
                # .values()/.items() return TrStr(s) via _tr_str_unbox() that
                # SHARE the refcount/data pointer with the boxed value still
                # stored in the dict (non-destructive unbox, no retain). If the
                # dict were auto-dropped (Dict_free_strval/_tr_idict_free_strval
                # releases each boxed value), and the unboxed TrStr also gets
                # released via its own str-local auto-drop, that's a double
                # release. So reading a str value out of such a dict marks the
                # dict itself escaped (leak instead of double-free).
                if method == "get" or method == "get_or" or method == "values" or method == "items":
                    match obj.read():
                        case HirExpr.EIdent(_, _, _):
                            mut obj_ty = hir_expr_type(obj)
                            if obj_ty.name == "Dict" or obj_ty.name == "Map":
                                if obj_ty.args.len > 1:
                                    mut obj_vt = obj_ty.args.get(1).read().name
                                    if obj_vt == "str" or obj_vt == "String":
                                        self.mark_coll_arg(obj)
                        case _: pass
                # Static-method call on a class name (e.g. `Str.join(parts, sep)`):
                # `obj` is the class identifier itself, not an instance, so the
                # callee has no `self` to stash a List/Vec/Dict/Map/Set argument
                # into - it can only read from it (e.g. _tr_trstr_join memcpy's
                # each element's bytes out). Safe to leave such args eligible
                # for auto-drop, same reasoning as the str_escaped exception
                # for static calls above.
                mut _coll_static_call = false
                match obj.read():
                    case HirExpr.EIdent(_ocnm2, _, _):
                        if self.classes.contains(_ocnm2) and not self.is_local_var(_ocnm2): _coll_static_call = true
                    case _: pass
                self.mark_escaped_coll_args(obj)
                mut i = 0
                while i < args.len:
                    if not _coll_static_call: self.mark_coll_arg(args.get(i))
                    self.mark_escaped_coll_args(args.get(i))
                    i = i + 1
            case HirExpr.EPropAccess(obj, _, _): self.mark_escaped_coll_args(obj)
            case HirExpr.EIndex(obj, idx, _):
                self.mark_escaped_coll_args(obj)
                self.mark_coll_arg(idx)
                self.mark_escaped_coll_args(idx)
            case HirExpr.ECast(inner, _):
                self.mark_coll_arg(inner)
                self.mark_escaped_coll_args(inner)
            case HirExpr.ETryExpr(inner, _):
                self.mark_coll_arg(inner)
                self.mark_escaped_coll_args(inner)
            case HirExpr.EIfElse(c, t, f, _):
                self.mark_escaped_coll_args(c)
                self.mark_coll_arg(t)
                self.mark_escaped_coll_args(t)
                self.mark_coll_arg(f)
                self.mark_escaped_coll_args(f)
            case HirExpr.EList(items, _):
                mut i = 0
                while i < items.len:
                    self.mark_coll_arg(items.get(i))
                    self.mark_escaped_coll_args(items.get(i))
                    i = i + 1
            case HirExpr.ESet(items, _):
                mut i = 0
                while i < items.len:
                    self.mark_coll_arg(items.get(i))
                    self.mark_escaped_coll_args(items.get(i))
                    i = i + 1
            case HirExpr.ETuple(items, _):
                mut i = 0
                while i < items.len:
                    self.mark_coll_arg(items.get(i))
                    self.mark_escaped_coll_args(items.get(i))
                    i = i + 1
            case HirExpr.EDict(keys, vals, _):
                mut i = 0
                while i < keys.len:
                    self.mark_coll_arg(keys.get(i))
                    self.mark_escaped_coll_args(keys.get(i))
                    self.mark_coll_arg(vals.get(i))
                    self.mark_escaped_coll_args(vals.get(i))
                    i = i + 1
            case HirExpr.ERange(s, en, _, _):
                self.mark_escaped_coll_args(s)
                self.mark_escaped_coll_args(en)
            case HirExpr.EAwait(inner, _):
                self.mark_coll_arg(inner)
                self.mark_escaped_coll_args(inner)
            case HirExpr.EAwaitTimeout(inner, to, _):
                self.mark_coll_arg(inner)
                self.mark_escaped_coll_args(inner)
                self.mark_escaped_coll_args(to)
            case HirExpr.EYield(inner, _):
                self.mark_coll_arg(inner)
                self.mark_escaped_coll_args(inner)
            # f-string interpolations only read/format their operands (no
            # storage of the collection pointer itself), so just recurse.
            case HirExpr.EFString(parts, _):
                mut i = 0
                while i < parts.len:
                    mut part = parts.get(i)
                    if part.is_expr: self.mark_escaped_coll_args(part.expr)
                    i = i + 1
            # A closure capturing a List/Vec/Dict/Map/Set local holds an
            # aliasing reference that may outlive the enclosing scope, so
            # the captured collection is excluded from auto-drop. The
            # closure body's own statements are independently walked by
            # lower_block when the body is lowered.
            case HirExpr.EClosure(_, _, _, _, captures):
                mut i = 0
                while i < captures.len:
                    mut cap = captures.get(i)
                    mut ctn = cap.ty.name
                    if ctn == "List" or ctn == "Vec" or ctn == "Dict" or ctn == "Map" or ctn == "Set":
                        self.mark_coll_escaped(cap.name)
                    i = i + 1
            # `super.method(args)` may stash a collection arg into a
            # base-class field, same reasoning as ECall args.
            case HirExpr.ESuperMethodCall(_, _, args, _):
                mut i = 0
                while i < args.len:
                    self.mark_coll_arg(args.get(i))
                    self.mark_escaped_coll_args(args.get(i))
                    i = i + 1
            case HirExpr.ESuperPropAccess(_, _, _): pass
            # The comprehension element may be a bare List/Dict/etc.
            # identifier stored into the resulting collection - mark it
            # escaped, same as EList items. Source/filter exprs are only
            # iterated/read.
            case HirExpr.EListComp(element, generators, _):
                self.mark_coll_arg(element)
                self.mark_escaped_coll_args(element)
                mut i = 0
                while i < generators.len:
                    mut gen = generators.get(i).read()
                    self.mark_escaped_coll_args(gen.iter)
                    mut j = 0
                    while j < gen.ifs.len:
                        self.mark_escaped_coll_args(gen.ifs.get(j))
                        j = j + 1
                    i = i + 1
            case HirExpr.EGeneratorExpr(element, generators, _):
                self.mark_coll_arg(element)
                self.mark_escaped_coll_args(element)
                mut i = 0
                while i < generators.len:
                    mut gen = generators.get(i).read()
                    self.mark_escaped_coll_args(gen.iter)
                    mut j = 0
                    while j < gen.ifs.len:
                        self.mark_escaped_coll_args(gen.ifs.get(j))
                        j = j + 1
                    i = i + 1
            case HirExpr.ESlice(start, stop, step, _):
                self.mark_coll_arg(start)
                self.mark_escaped_coll_args(start)
                self.mark_coll_arg(stop)
                self.mark_escaped_coll_args(stop)
                self.mark_coll_arg(step)
                self.mark_escaped_coll_args(step)
            # ETry's try/catch/finally blocks are walked statement-by-statement
            # by lower_block when each block is lowered, so no recursion is
            # needed here.
            case HirExpr.ETry(_, _, _, _): pass
            # `do:` block-expression. Inner statements are escape-marked during
            # lowering; the trailing value is RETAINED (copied) into the block's
            # result temp by codegen, not moved, so nothing here escapes.
            case HirExpr.EDo(_do_b, _): pass
            # match-EXPRESSION: arm bodies are escape-marked during lowering; each
            # arm's value is captured (retained) into the result temp, not moved.
            case HirExpr.EMatchExpr(_, _, _): pass
            # loop/while EXPRESSIONS: bodies are escape-marked during lowering; the
            # break value is captured (retained) into the result temp, not moved.
            case HirExpr.ELoop(_, _): pass
            case HirExpr.EWhileExpr(_, _, _, _): pass
            # Leaf/literal variants - nothing to recurse into or mark.
            case HirExpr.ELitInt(_, _): pass
            case HirExpr.ELitFloat(_, _): pass
            case HirExpr.ELitStr(_, _): pass
            case HirExpr.ELitBytes(_, _): pass
            case HirExpr.ERawStr(_, _): pass
            case HirExpr.ELitChar(_, _): pass
            case HirExpr.ELitBool(_, _): pass
            case HirExpr.ELitNone(_): pass
            case HirExpr.ESizeOf(_, _): pass
            case HirExpr.EIdent(_, _, _): pass

    # True if `b`'s last statement already transfers control (return/break/continue),
    # meaning any needed auto-drops were already injected by lower_block at that point.
    pub def block_ends_in_jump(self, b: HirBlock) -> bool:
        if b.stmts.len == 0: return false
        mut last = b.stmts.get(b.stmts.len - 1)
        if last as usize == 0 as usize: return false
        match last.read():
            case HirStmt.SReturn(_): return true
            case HirStmt.SBreak(_): return true
            case HirStmt.SContinue: return true
            case _: return false

    # Append SAutoDrop stmts to `hb` for droppable locals of the current
    # (innermost) scope that were declared directly inside the if/while body
    # block `block_id` (e.g. a `mut s = ...` re-declared each loop iteration
    # in an SWhile body that shares its enclosing scope). Skipped if `hb`
    # already ends in a jump (return/break/continue already drained drops).
    pub def append_block_local_drops(self, hb: HirBlock, block_id: int):
        if self.block_ends_in_jump(hb): return
        if self.scopes.len == 0: return
        mut scope = self.scopes.get(self.scopes.len - 1)
        mut ki = 0
        while ki < scope.decl_order.len:
            mut nm = scope.decl_order.get(ki)
            mut sym = scope.variables.get(nm)
            if sym.decl_block_id == block_id and self.is_droppable_sym(sym):
                hb.push(box_hirstmt(HirStmt.SAutoDrop(nm, sym.ty.read().name)))
            ki = ki + 1

    # Append end-of-scope drops for the current top scope to `hb`, unless its
    # last statement already jumped out (and thus already drained this scope).
    pub def finalize_scope_drops(self, hb: HirBlock):
        if not self.block_ends_in_jump(hb):
            self.append_drops_from(hb, self.scopes.len - 1)

    # #53 HYBRID: true if `hb` directly declares `nm` as a `str` local.
    pub def block_str_decl(self, hb: HirBlock, nm: str) -> bool:
        mut i = 0
        while i < hb.stmts.len:
            match hb.stmts.get(i).read():
                case HirStmt.SLet(sn, _, _, _, _, sty, _):
                    if sn == nm and sty.name == "str": return true
                case _: pass
            i = i + 1
        return false

    # #53 HYBRID: true if `hb` already contains an SAutoDrop for `nm`.
    pub def block_has_autodrop(self, hb: HirBlock, nm: str) -> bool:
        mut i = 0
        while i < hb.stmts.len:
            match hb.stmts.get(i).read():
                case HirStmt.SAutoDrop(dn, _):
                    if dn == nm: return true
                case _: pass
            i = i + 1
        return false

    # #53 HYBRID: returns the collection type name (List/Vec/Dict/Map/Set) if `hb`
    # directly declares `nm` as that collection, else "".
    pub def block_coll_decl(self, hb: HirBlock, nm: str) -> str:
        mut i = 0
        while i < hb.stmts.len:
            match hb.stmts.get(i).read():
                case HirStmt.SLet(sn, _, _, _, _, sty, _):
                    if sn == nm:
                        mut tn = sty.name
                        if tn == "List" or tn == "Vec" or tn == "Dict" or tn == "Map" or tn == "Set":
                            return tn
                case _: pass
            i = i + 1
        return ""

    # #53 HYBRID: a collection local is safe to MIR-drop only if sema's own
    # collection-droppability predicate clears it (not coll_escaped, POD/str-value
    # elements, not moved/borrowed). Collections are raw pointers (unlike
    # refcounted str), so this escape gate is REQUIRED for soundness.
    pub def coll_droppable_by_sema(self, nm: str) -> bool:
        mut sym = self.resolve(nm)
        if sym.name == "": return false
        return self.is_droppable_sym(sym)

    # #53 HYBRID: drive if-body fall-through drops from the MIR drop schedule.
    # The MIR (built from the just-lowered `hf`) computes, for complete functions,
    # which locals are owned-but-dead at an if/else/match/try body's fall-through
    # end — exactly the leak the HIR scope/jump machinery misses. We release a name
    # the MIR proved dead that is DECLARED in that body block and not already
    # dropped. `str` (refcounted) needs no escape gate; COLLECTIONS (raw ptrs) are
    # gated on sema's is_droppable_sym (coll_escaped etc.). Must run while the
    # function scope is still open so coll_droppable_by_sema sees live symbols.
    pub def apply_mir_if_drops(self, hf: HirFunction):
        mut plan = mir_if_drop_plan(hf)
        mut psi = 0
        while psi < plan.len:
            mut site = plan.get(psi)
            # If the body ends in return/break/continue, the existing jump-drainage
            # already released its locals — don't double-drop (or emit dead code).
            if not self.block_ends_in_jump(site.hir_block):
                mut ppi = 0
                while ppi < site.places.len:
                    mut nm = site.places.get(ppi)
                    if (not self.block_has_autodrop(site.hir_block, nm)):
                        if self.block_str_decl(site.hir_block, nm):
                            site.hir_block.push(box_hirstmt(HirStmt.SAutoDrop(nm, "str")))
                        else:
                            mut ctn = self.block_coll_decl(site.hir_block, nm)
                            if ctn != "" and self.coll_droppable_by_sema(nm):
                                site.hir_block.push(box_hirstmt(HirStmt.SAutoDrop(nm, ctn)))
                    ppi = ppi + 1
            psi = psi + 1

    pub def declare(self, name: str, kind: SymbolKind, ty: Pointer[AstType], is_mut: bool):
        # Rule N-1: Reserved name protection (skip 'self', internal '_*' names, short generics)
        if name != "self" and name != "_" and _tr_strlen(name) > 1:
            mut cat = self.is_reserved_error(name)
            if cat != "":
                self.error("[N-1] '" + name + "' is a " + cat + " and cannot be used as a name. Choose a different name (e.g. 'my_" + name + "').")
            else:
                # Class members (fields and methods) are exempt - names are scoped to the class.
                # Local variables (SVariable) are also exempt - local shadowing is intentional.
                # Only top-level function/type declarations are checked.
                mut is_toplevel_decl = self.current_class_name == "" and kind != SymbolKind.SVariable
                if is_toplevel_decl:
                    mut kcat = self.is_reserved_keyword(name)
                    if kcat != "":
                        self.error("[N-1] '" + name + "' is a " + kcat + " and is reserved. Choose a different name (e.g. 'my_" + name + "').")
        mut sym = Symbol.init(name, kind, ty)
        sym.scope_depth = self.current_scope_depth
        sym.is_mut = is_mut
        sym.decl_block_depth = self.block_depth
        mut bsbase = 0
        if self.block_stack_base.len > 0: bsbase = self.block_stack_base.get(self.block_stack_base.len - 1)
        if self.block_stack.len > bsbase:
            sym.decl_block_id = self.block_stack.get(self.block_stack.len - 1)
        else:
            sym.decl_block_id = 0

        if self.scopes.len > 0:
            mut decl_scope = self.scopes.get(self.scopes.len - 1)
            if not decl_scope.variables.contains(name): decl_scope.decl_order.push(name)
            decl_scope.variables.insert(name, sym)
        else:
            self.globals.insert(name, sym)

    pub def resolve(self, name: str) -> Symbol:
        mut i = self.scopes.len - 1
        while i >= 0:
            mut scope = self.scopes.get(i)
            if scope.variables.contains(name):
                return scope.variables.get(name)
            i = i - 1

        if self.globals.contains(name):
            return self.globals.get(name)

        return Symbol.init("", SymbolKind.SVariable, box_asttype(AstType.init("void")))

    # [N-3] True if `name` is a known top-level entity even when it is not a
    # scope/global symbol: a user function, class, enum, interface, type alias, or
    # built-in type name. Used to avoid false "undefined name" errors.
    pub def is_known_name(self, name: str) -> bool:
        if self.fn_sigs.contains(name): return true
        if self.extern_names.contains(name): return true
        if self.classes.contains(name): return true
        if self.enums.contains(name): return true
        if self.interfaces.contains(name): return true
        if self.type_aliases.contains(name): return true
        if self.is_type_name(name): return true
        # Memory builtins + reflection (not in the globals table).
        if name == "alloc" or name == "dealloc" or name == "realloc" or name == "sizeof" or name == "repr": return true
        if name == "c_callback": return true
        # Runtime intrinsics are reserved to the `_tr_` prefix and always available.
        if name.len() >= 4 and name.slice(0, 4) == "_tr_": return true
        return false

    # #10: True if `nm` names a type (class/enum/interface/builtin primitive).
    pub def is_type_name(self, nm: str) -> bool:
        if self.classes.contains(nm) or self.enums.contains(nm) or self.interfaces.contains(nm): return true
        if nm == "int" or nm == "float" or nm == "bool" or nm == "char" or nm == "str" or nm == "void": return true
        if nm == "i8" or nm == "i16" or nm == "i32" or nm == "i64" or nm == "isize": return true
        if nm == "u8" or nm == "u16" or nm == "u32" or nm == "u64" or nm == "usize": return true
        if nm == "f32" or nm == "f64": return true
        return false

    # #10: If `raw` is a bare identifier naming a TYPE (not a variable), return
    # that type's name; else "". Used by `==`/`!=` for runtime type comparison.
    pub def type_ref_name(self, raw: Pointer[Expr]) -> str:
        if raw as usize == 0 as usize: return ""
        match raw.read():
            case Expr.EIdent(nm):
                if not self.is_type_name(nm): return ""
                # A real local/global VARIABLE named like a type shadows it
                # (e.g. `mut int = 5`); only then is this not a type reference.
                # Builtin cast names (int/float/...) are SFunction, and class
                # names are SClass - both are valid type refs in `==` position.
                mut s = self.resolve(nm)
                if s.name != "" and s.kind == SymbolKind.SVariable: return ""
                return nm
            case _: return ""

    # True when `name` is NOT bound in any function-local scope but IS a
    # file-scope global. Used to let a bare `name = expr` inside a function
    # introduce a fresh local that shadows the global (Python-like), instead
    # of erroring on an immutable global.
    pub def is_global_not_local(self, name: str) -> bool:
        mut i = self.scopes.len - 1
        while i >= 0:
            if self.scopes.get(i).variables.contains(name): return false
            i = i - 1
        return self.globals.contains(name)

    pub def analyze(self, prog: Program) -> HirProgram:
        mut hp = HirProgram.init()

        # Pre-register every class/actor name so `extend T:` blocks attach their
        # methods regardless of declaration/import order. Without this, an
        # `extend T` processed before T's own `class T` decl (e.g. T lives in a
        # module the entry file imports *after* the extending module) silently
        # drops its methods, because register_decl only attaches when
        # self.classes already contains the target. Inserting the same ClassDef
        # objects up front makes attachment order-independent.
        mut ppi = 0
        while ppi < prog.decls.len:
            match prog.decls.get(ppi).read():
                case Decl.DClass(c):
                    if not self.classes.contains(c.name): self.classes.insert(c.name, c)
                case Decl.DActor(c):
                    if not self.classes.contains(c.name): self.classes.insert(c.name, c)
                case _: pass
            ppi = ppi + 1

        # Pre-register module-level `mut`/`let` globals (parsed as DTopLevelStmt
        # wrapping an SLet) so a function TEXTUALLY BEFORE the global in the same
        # file can still resolve it. Without this, name resolution is a single
        # sequential pass over prog.decls that both registers a global's symbol
        # AND lowers function bodies in file order — a function reads a global
        # declared later in the same file and self.declare(name, ...) for that
        # global hasn't run yet, so resolve() reports "not defined" (misattributed
        # to whichever call site happens to trigger it, e.g. an importing file's
        # line, since the error is raised lazily at first use). Only registers
        # the NAME+TYPE (an explicit annotation, or a plain-literal inference that
        # can't have side effects) — never lowers the initializer expression here,
        # so no analysis (move-tracking, borrow-region derivation, ...) runs twice;
        # the real lowering still happens in its natural position below.
        mut gpi = 0
        while gpi < prog.decls.len:
            match prog.decls.get(gpi).read():
                case Decl.DTopLevelStmt(gs):
                    match gs.read():
                        case Stmt.SLet(g_name, _, g_is_mut, _, _, g_ty_ptr, g_val_ptr):
                            mut g_ty = 0 as Pointer[AstType]
                            if g_ty_ptr as usize != 0 as usize:
                                g_ty = g_ty_ptr
                            elif g_val_ptr as usize != 0 as usize:
                                match g_val_ptr.read():
                                    case Expr.ELitInt(_): g_ty = box_asttype(AstType.init("int"))
                                    case Expr.ELitFloat(_): g_ty = box_asttype(AstType.init("float"))
                                    case Expr.ELitStr(_): g_ty = box_asttype(AstType.init("str"))
                                    case Expr.ELitBool(_): g_ty = box_asttype(AstType.init("bool"))
                                    case _: pass
                            if g_ty as usize != 0 as usize:
                                self.declare(g_name, SymbolKind.SVariable, g_ty, g_is_mut)
                        case _: pass
                case _: pass
            gpi = gpi + 1

        mut i = 0
        while i < prog.decls.len:
            self.register_decl(prog.decls.get(i))
            i = i + 1

        # [S-2] (--strict): the leak-freedom GUARANTEE. Reject strong-ownership CYCLES
        # among refcounted classes (the one thing plain ARC cannot reclaim). Combined
        # with [U-1] (no raw allocation outside `unsafe:`), a program that compiles
        # under --strict is provably leak-free: every heap value is refcounted and the
        # ownership graph is acyclic, so every count reaches zero.
        if self.strict_mode:
            self.check_ownership_cycles(prog)

        # Implicit-borrow support (--strict only, additive): pre-compute which methods
        # mutate self, so the borrow checker can flag `a.mutate()` while `a` is borrowed.
        # Runs AFTER register_decl so `extend T` methods are included; keyed "Type.method".
        if self.strict_mode:
            i = 0
            while i < prog.decls.len:
                match prog.decls.get(i).read():
                    case Decl.DClass(mc):
                        mut mmi = 0
                        while mmi < mc.methods.len:
                            mut mm = mc.methods.get(mmi)
                            if _block_mutates_self(mm.body): self.mutating_methods.insert(mc.name + "." + mm.name, true)
                            mmi = mmi + 1
                    case Decl.DActor(ac):
                        mut ami = 0
                        while ami < ac.methods.len:
                            mut am = ac.methods.get(ami)
                            if _block_mutates_self(am.body): self.mutating_methods.insert(ac.name + "." + am.name, true)
                            ami = ami + 1
                    case Decl.DExtend(mtarget, mmethods):
                        mut emi = 0
                        while emi < mmethods.len:
                            mut em = mmethods.get(emi)
                            if _block_mutates_self(em.body): self.mutating_methods.insert(mtarget + "." + em.name, true)
                            emi = emi + 1
                    case _: pass
                i = i + 1

        i = 0
        while i < prog.decls.len:
            mut d = prog.decls.get(i)
            match d.read():
                case Decl.DFunction(f):
                    hp.functions.push(self.lower_func(f))
                case Decl.DClass(c):
                    hp.classes.push(self.lower_class(c))
                case Decl.DActor(c):
                    hp.classes.push(self.lower_class(c))
                case Decl.DEnum(e):
                    hp.enums.push(self.lower_enum(e))
                case Decl.DInterface(i_def):
                    hp.interfaces.push(self.lower_interface(i_def))
                case Decl.DExtend(target, methods):
                    self.current_class_name = target
                    if self.classes.contains(target):
                        self.current_region_params = self.classes.get(target).region_params
                    mut hi = 0
                    while hi < methods.len:
                        mut f = methods.get(hi)
                        hp.functions.push(self.lower_func(f))
                        hi = hi + 1
                    self.current_class_name = ""
                    self.current_region_params = Vec[str].init(0)
                case Decl.DTopLevelStmt(s):
                    hp.top_level_stmts.push(self.lower_stmt(s))
                case Decl.DExtern(_, functions):
                    mut ei = 0
                    while ei < functions.len:
                        mut ef = functions.get(ei)
                        mut hef = self.lower_func(ef)
                        hef.is_extern = true
                        hp.extern_funcs.push(hef)
                        ei = ei + 1
                case Decl.DDecoratorDef(f):
                    mut hdf = self.lower_func(f)
                    hdf.is_decorator = true
                    hp.decorator_defs.push(hdf)
                case Decl.DTypeAlias(alias_name, target_ty):
                    # Emit type alias info into HirProgram so codegen can emit a typedef.
                    hp.type_alias_names.push(alias_name)
                    mut ta_ty_ptr = box_asttype(AstType.init("void"))
                    if target_ty as usize != 0 as usize: ta_ty_ptr = target_ty
                    hp.type_alias_types.push(ta_ty_ptr)
                case _: pass
            i = i + 1

        # Hoist nested declarations (class/def/enum/interface inside main()) to
        # file scope so codegen emits them as ordinary top-level definitions.
        mut nci = 0
        while nci < self.nested_classes.len:
            hp.classes.push(self.nested_classes.get(nci))
            nci = nci + 1
        mut nfi = 0
        while nfi < self.nested_functions.len:
            hp.functions.push(self.nested_functions.get(nfi))
            nfi = nfi + 1
        mut nei = 0
        while nei < self.nested_enums.len:
            hp.enums.push(self.nested_enums.get(nei))
            nei = nei + 1
        mut nii = 0
        while nii < self.nested_interfaces.len:
            hp.interfaces.push(self.nested_interfaces.get(nii))
            nii = nii + 1
        # Return-ownership inference: classify every heap-class-returning function
        # as OWNED (caller receives+owns a reference → must release) or BORROWED
        # (a return may alias a collection element / another borrow → caller must
        # NOT release). Consumed by codegen `_obj_expr_owns_ref` to decide whether
        # a call-result local is auto-dropped — enabling reclamation of owned
        # factory/free-function results without ever over-releasing a borrow.
        self.compute_return_ownership(hp)
        # Parameter-ownership summary (consumes(fn,i)): the interprocedural monotone
        # fixpoint the drop heuristics lack, over the fully-lowered program.
        self.compute_param_ownership(hp)
        # F-2: apply it — add the auto-drops the conservative class-arg escape wrongly
        # suppressed for locals that are only BORROWED (never consumed) by their callees.
        self.apply_borrow_drops(hp)
        return hp

    # ---- Return-ownership inference (whole-program monotone fixpoint) ----
    # A function returns an OWNED heap-class reference iff EVERY return path yields
    # one. Base cases that yield owned (codegen's obj_retain_wrap guarantees it):
    #   * a bare ident (retained at return, or an owned tracked-local transfer)
    #   * a field read `self.f` / `obj.f` (retained at return)
    #   * a constructor `ClassName(...)`
    # Transitive: a call to an OWNED function/method. Forced BORROWED by: a
    # collection `.get/.first/.last` or `[]` (raw element alias, not retained), an
    # index, or a call to a BORROWED/unknown function. Fixpoint starts optimistic
    # (all true) and only flips true→false, so it converges.
    pub def compute_return_ownership(self, hp: HirProgram):
        # Collect (key, HirFunction) for every heap-class-returning function.
        mut keys = Vec[str].init(64)
        mut fns  = Vec[HirFunction].init(64)
        mut fi = 0
        while fi < hp.functions.len:
            mut f = hp.functions.get(fi)
            if self._fn_ret_is_heap_class(f):
                keys.push(f.name)
                fns.push(f)
            fi = fi + 1
        mut ci = 0
        while ci < hp.classes.len:
            mut c = hp.classes.get(ci)
            mut mi = 0
            while mi < c.methods.len:
                mut m = c.methods.get(mi)
                if self._fn_ret_is_heap_class(m):
                    keys.push(c.name + "." + m.name)
                    fns.push(m)
                mi = mi + 1
            ci = ci + 1
        mut ei = 0
        while ei < hp.enums.len:
            mut en = hp.enums.get(ei)
            mut emi = 0
            while emi < en.methods.len:
                mut em = en.methods.get(emi)
                if self._fn_ret_is_heap_class(em):
                    keys.push(en.name + "." + em.name)
                    fns.push(em)
                emi = emi + 1
            ei = ei + 1
        # Start optimistic — EXCEPT a `-> ref T` / `-> T from r` function returns a
        # BORROW (zero-copy: the return path does NOT retain), so it is owned=false
        # from the start (and stays false under the monotone fixpoint). Missing this
        # would classify `return self.field` in a borrow-returning fn as OWNED → the
        # caller drops an un-retained alias → use-after-free.
        mut ki = 0
        while ki < keys.len:
            mut kf = fns.get(ki)
            mut kf_owned = true
            if kf.ret_ty as usize != 0 as usize:
                if kf.ret_ty.is_borrow or kf.ret_ty.from_param != "" or kf.ret_ty.from_regions.len > 0:
                    kf_owned = false
            self.fn_ret_owned.insert(keys.get(ki), kf_owned)
            ki = ki + 1
        # Monotone fixpoint (only true→false).
        mut changed = true
        while changed:
            changed = false
            mut xi = 0
            while xi < fns.len:
                mut k = keys.get(xi)
                if self.fn_ret_owned.get(k):
                    mut rets = Vec[Pointer[HirExpr]].init(4)
                    self._collect_returns(fns.get(xi).body, rets)
                    mut all_owned = true
                    mut ri = 0
                    while ri < rets.len:
                        if not self._ret_yields_owned(rets.get(ri)):
                            all_owned = false
                        ri = ri + 1
                    if not all_owned:
                        self.fn_ret_owned.insert(k, false)
                        changed = true
                xi = xi + 1
        # Publish onto each HirFunction for codegen.
        mut wi = 0
        while wi < fns.len:
            mut hf2 = fns.get(wi)
            hf2.returns_owned = self.fn_ret_owned.get(keys.get(wi))
            wi = wi + 1

    # ---- Parameter-ownership inference (whole-program monotone fixpoint) ----
    # consumes(fn, i): the fn moves/frees/stores/returns parameter i, or passes it to
    # some callee at a position that consumes it. Starts optimistic (all borrowed) and
    # only flips false->true, so a fixed-point `false` PROVES param i is only borrowed —
    # the precise per-callee effect the drop/escape heuristics only approximate.
    # STAGING: this pass only COMPUTES the summary into fn_param_consumes; codegen does
    # not consult it yet, so emitted C is unchanged (validated byte-identical).
    pub def compute_param_ownership(self, hp: HirProgram):
        mut keys = Vec[str].init(64)
        mut fns  = Vec[HirFunction].init(64)
        mut fi = 0
        while fi < hp.functions.len:
            keys.push(hp.functions.get(fi).name)
            fns.push(hp.functions.get(fi))
            fi = fi + 1
        mut ci = 0
        while ci < hp.classes.len:
            mut c = hp.classes.get(ci)
            mut mi = 0
            while mi < c.methods.len:
                keys.push(c.name + "." + c.methods.get(mi).name)
                fns.push(c.methods.get(mi))
                mi = mi + 1
            ci = ci + 1
        mut eni = 0
        while eni < hp.enums.len:
            mut en = hp.enums.get(eni)
            mut emi = 0
            while emi < en.methods.len:
                keys.push(en.name + "." + en.methods.get(emi).name)
                fns.push(en.methods.get(emi))
                emi = emi + 1
            eni = eni + 1
        # Init every non-self parameter optimistic (borrowed = false).
        mut ii = 0
        while ii < fns.len:
            mut f = fns.get(ii)
            mut pi = 0
            while pi < f.params.len:
                if f.params.get(pi).name != "self":
                    self.fn_param_consumes.insert(keys.get(ii) + "#" + pi.to_str(), false)
                pi = pi + 1
            ii = ii + 1
        # Monotone fixpoint (false -> true only).
        mut changed = true
        while changed:
            changed = false
            mut xi = 0
            while xi < fns.len:
                mut f = fns.get(xi)
                mut pi = 0
                while pi < f.params.len:
                    mut pn = f.params.get(pi).name
                    mut pk = keys.get(xi) + "#" + pi.to_str()
                    if pn != "self" and self.fn_param_consumes.contains(pk):
                        if not self.fn_param_consumes.get(pk):
                            if self._param_consumed_in_block(pn, f.body):
                                self.fn_param_consumes.insert(pk, true)
                                changed = true
                    pi = pi + 1
                xi = xi + 1

    # A pure scalar type: a by-value primitive that CANNOT hold a pointer, so a
    # value of this type can never own or alias a heap object. (NB: excludes `str`
    # and the c_* family — a str aliases its buffer, a c_ptr may be a pointer.)
    pub def _is_pure_scalar(self, tn: str) -> bool:
        if tn == "int" or tn == "float" or tn == "bool" or tn == "char" or tn == "void": return true
        if tn == "i8" or tn == "i16" or tn == "i32" or tn == "i64": return true
        if tn == "u8" or tn == "u16" or tn == "u32" or tn == "u64" or tn == "usize": return true
        if tn == "f32" or tn == "f64": return true
        return false

    # True if a `return E` / `raise E` could transfer OR alias a heap value (so a
    # heap param appearing in E may be consumed). A pure-scalar E cannot — false.
    pub def _pc_owns_return(self, e: Pointer[HirExpr]) -> bool:
        if e as usize == 0 as usize: return true
        if _is_invalid_ptr(e as usize): return true
        return not self._is_pure_scalar(hir_expr_type(e).name)

    # ── F-2: reclaim borrow-only owned locals (additive; safe-direction) ──────────
    # docs/dev/07 Stage 2, applied as a POST-PASS (after compute_param_ownership).
    # The conservative class-arg escape (`mark_coll_arg`) excludes ANY class instance
    # passed as a non-receiver arg from auto-drop — even when the callee only BORROWS
    # it — so a fresh owned local passed to a borrowing function leaks (F-2). Here we
    # ADD BACK exactly those drops: for a local whose initializer is a fresh
    # constructor/owned-factory of a droppable class, that is NOT consumed anywhere in
    # its block (`_param_consumed_in_block`, which consults the now-correct
    # `consumes(fn,i)` fixpoint), and that is NOT already dropped/reassigned.
    #
    # Soundness: ADDITIVE and STRICTLY CONSERVATIVE. `_param_consumed_in_block` returns
    # true on ANY uncertainty (unknown/extern/indirect callee, method-arg, store,
    # return, free, spawn), so a drop is added ONLY when the local is PROVEN borrow-only
    # and locally owned. Missing a case → a leak (unchanged), never a double-free/UAF.
    pub def apply_borrow_drops(self, hp: HirProgram):
        mut fi = 0
        while fi < hp.functions.len:
            self._borrow_drops_block(hp.functions.get(fi).body)
            fi = fi + 1
        mut ci = 0
        while ci < hp.classes.len:
            mut c = hp.classes.get(ci)
            mut mi = 0
            while mi < c.methods.len:
                self._borrow_drops_block(c.methods.get(mi).body)
                mi = mi + 1
            ci = ci + 1
        mut eni = 0
        while eni < hp.enums.len:
            mut en = hp.enums.get(eni)
            mut emi = 0
            while emi < en.methods.len:
                self._borrow_drops_block(en.methods.get(emi).body)
                emi = emi + 1
            eni = eni + 1

    pub def _borrow_drops_block(self, b: HirBlock):
        if b as usize == 0 as usize: return
        mut i = 0
        while i < b.stmts.len:
            self._borrow_drops_recurse_stmt(b.stmts.get(i))
            i = i + 1
        mut add_names = Vec[str].init(2)
        mut add_cls   = Vec[str].init(2)
        i = 0
        while i < b.stmts.len:
            match b.stmts.get(i).read():
                case HirStmt.SLet(nm, _own, _mut2, _cst, _shr, _ty, val):
                    mut cn = _ty.name
                    if self._is_owned_droppable_class(cn) and self._is_fresh_owned_producer(val, cn):
                        if not self._block_has_drop_or_reassign(b, nm):
                            if not self._param_consumed_in_block(nm, b):
                                add_names.push(nm)
                                add_cls.push(cn)
                case _: pass
            i = i + 1
        mut ai = 0
        while ai < add_names.len:
            self._insert_drop_before_terminator(b, add_names.get(ai), add_cls.get(ai))
            ai = ai + 1

    pub def _borrow_drops_recurse_stmt(self, sp: Pointer[HirStmt]):
        if sp as usize == 0 as usize: return
        match sp.read():
            case HirStmt.SIf(_, tb, eb):
                self._borrow_drops_block(tb)
                self._borrow_drops_block(eb)
            case HirStmt.SWhile(_, wb): self._borrow_drops_block(wb)
            case HirStmt.SFor(_, _, fb): self._borrow_drops_block(fb)
            case HirStmt.SForUnpack(_, _, fub): self._borrow_drops_block(fub)
            case HirStmt.SMatch(_, arms):
                mut ai = 0
                while ai < arms.len:
                    self._borrow_drops_block(arms.get(ai).body)
                    ai = ai + 1
            case HirStmt.SUnsafe(ub): self._borrow_drops_block(ub)
            case HirStmt.SWith(_, _, wb): self._borrow_drops_block(wb)
            case HirStmt.STaskGroup(tb): self._borrow_drops_block(tb)
            case HirStmt.STry(tb, catches, fb):
                self._borrow_drops_block(tb)
                self._borrow_drops_block(fb)
                mut ci = 0
                while ci < catches.len:
                    self._borrow_drops_block(catches.get(ci).read().body)
                    ci = ci + 1
            case _: pass

    # True iff `val` produces a FRESH, unaliased, locally-OWNED value of class `cn`:
    # a direct constructor `cn(...)`/`cn.init(...)`/`cn.new(...)`, or a call to an
    # OWNED-returning function/method (`fn_ret_owned`) — a factory like `make_named`.
    pub def _is_fresh_owned_producer(self, val: Pointer[HirExpr], cn: str) -> bool:
        if val as usize == 0 as usize: return false
        if _is_invalid_ptr(val as usize): return false
        match val.read():
            case HirExpr.ECall(callee, _, _):
                match callee.read():
                    case HirExpr.EIdent(fnm, _, _):
                        if fnm == cn: return true
                        if self.fn_ret_owned.contains(fnm) and self.fn_ret_owned.get(fnm): return true
                    case _: pass
            case HirExpr.EMethodCall(obj, m, _, _):
                if m == "init" or m == "new": return true
                mut mkey = hir_expr_type(obj).name + "." + m
                if self.fn_ret_owned.contains(mkey) and self.fn_ret_owned.get(mkey): return true
            case _: pass
        return false

    pub def _is_owned_droppable_class(self, cn: str) -> bool:
        if not self.classes.contains(cn): return false
        if self.classes.get(cn).generics.len > 0: return false
        if self.class_method_exists(cn, "free"): return true
        return self._is_rc_class(cn)

    pub def _block_has_drop_or_reassign(self, b: HirBlock, nm: str) -> bool:
        mut i = 0
        while i < b.stmts.len:
            match b.stmts.get(i).read():
                case HirStmt.SAutoDrop(dn, _):
                    if dn == nm: return true
                case HirStmt.SFree(dn):
                    if dn == nm: return true
                case HirStmt.SAssign(tgt, _):
                    match tgt.read():
                        case HirExpr.EIdent(tn2, _, _):
                            if tn2 == nm: return true
                        case _: pass
                case _: pass
            i = i + 1
        return false

    pub def _insert_drop_before_terminator(self, b: HirBlock, nm: str, cn: str):
        mut drop = box_hirstmt(HirStmt.SAutoDrop(nm, cn))
        mut n = b.stmts.len
        if n == 0:
            b.stmts.push(drop)
            return
        mut last = b.stmts.get(n - 1)
        mut is_term = false
        match last.read():
            case HirStmt.SReturn(_): is_term = true
            case HirStmt.SRaise(_): is_term = true
            case HirStmt.SBreak(_): is_term = true
            case HirStmt.SContinue: is_term = true
            case _: pass
        if is_term:
            b.stmts.remove(n - 1)
            b.stmts.push(drop)
            b.stmts.push(last)
        else:
            b.stmts.push(drop)

    pub def _pc_is_ident(self, ep: Pointer[HirExpr], name: str) -> bool:
        if ep as usize == 0 as usize: return false
        match ep.read():
            case HirExpr.EIdent(n, _, _): return n == name
            case _: return false

    pub def _pc_callee_name(self, callee: Pointer[HirExpr]) -> str:
        if callee as usize == 0 as usize: return ""
        match callee.read():
            case HirExpr.EIdent(n, _, _): return n
            case _: return ""

    pub def _pc_stores_method(self, m: str) -> bool:
        return m == "push" or m == "append" or m == "insert" or m == "set" or m == "add"

    pub def _pc_is_store_target(self, tgt: Pointer[HirExpr]) -> bool:
        if tgt as usize == 0 as usize: return false
        match tgt.read():
            case HirExpr.EPropAccess(_, _, _): return true
            case HirExpr.EIndex(_, _, _): return true
            case _: return false

    # Does `name` appear anywhere in the expression tree (a use, not necessarily a consume)?
    pub def _pc_refs(self, ep: Pointer[HirExpr], name: str) -> bool:
        if ep as usize == 0 as usize: return false
        match ep.read():
            case HirExpr.EIdent(n, _, _): return n == name
            case HirExpr.EBinOp(_, l, r, _): return self._pc_refs(l, name) or self._pc_refs(r, name)
            case HirExpr.EUnaryOp(_, e, _): return self._pc_refs(e, name)
            case HirExpr.ECast(e, _): return self._pc_refs(e, name)
            case HirExpr.EPropAccess(o, _, _): return self._pc_refs(o, name)
            case HirExpr.EIndex(o, ix, _): return self._pc_refs(o, name) or self._pc_refs(ix, name)
            case HirExpr.ECall(cl, args, _): return self._pc_refs(cl, name) or self._pc_anyrefs(args, name)
            case HirExpr.EMethodCall(o, _, args, _): return self._pc_refs(o, name) or self._pc_anyrefs(args, name)
            case HirExpr.EList(items, _): return self._pc_anyrefs(items, name)
            case HirExpr.ESet(items, _): return self._pc_anyrefs(items, name)
            case HirExpr.ETuple(items, _): return self._pc_anyrefs(items, name)
            case HirExpr.EDict(dks, dvs, _): return self._pc_anyrefs(dks, name) or self._pc_anyrefs(dvs, name)
            case HirExpr.ETryExpr(e, _): return self._pc_refs(e, name)
            case HirExpr.EAwait(e, _): return self._pc_refs(e, name)
            case HirExpr.EIfElse(cnd, te, ee, _): return self._pc_refs(cnd, name) or self._pc_refs(te, name) or self._pc_refs(ee, name)
            case HirExpr.ESlice(sa, sb, sc, _): return self._pc_refs(sa, name) or self._pc_refs(sb, name) or self._pc_refs(sc, name)
            case HirExpr.ERange(ra, rb, _, _): return self._pc_refs(ra, name) or self._pc_refs(rb, name)
            case _: return false

    pub def _pc_anyrefs(self, args: Vec[Pointer[HirExpr]], name: str) -> bool:
        mut i = 0
        while i < args.len:
            if self._pc_refs(args.get(i), name): return true
            i = i + 1
        return false

    pub def _param_consumed_in_block(self, pname: str, b: HirBlock) -> bool:
        if b as usize == 0 as usize: return false
        mut i = 0
        while i < b.stmts.len:
            if self._param_consumed_in_stmt(pname, b.stmts.get(i)): return true
            i = i + 1
        return false

    pub def _param_consumed_in_stmt(self, pname: str, sp: Pointer[HirStmt]) -> bool:
        if sp as usize == 0 as usize: return false
        match sp.read():
            case HirStmt.SReturn(e):
                # A PURE-SCALAR return value (int/float/bool/…) cannot own or alias a
                # heap param, so the param was only BORROWED to compute it (e.g.
                # `return x.score()` returns an int — x is not transferred). Only a
                # return that could carry a pointer (str/class/collection) transfers or
                # aliases the param. Actual consumption elsewhere in the body
                # (free/store/consuming-call) is still caught by the other cases.
                if not self._pc_owns_return(e): return false
                return self._pc_refs(e, pname)
            case HirStmt.SRaise(e):
                if not self._pc_owns_return(e): return false
                return self._pc_refs(e, pname)
            case HirStmt.SFree(nm): return nm == pname                       # freed -> consumed
            case HirStmt.SSpawn(e): return self._pc_refs(e, pname)           # crosses a thread -> consumed
            case HirStmt.SAssign(tgt, val):
                if self._pc_is_store_target(tgt) and self._pc_refs(val, pname): return true   # store into field/index
                return self._param_consumed_in_expr(pname, val)
            case HirStmt.SLet(_, _, _, _, _, _, val): return self._param_consumed_in_expr(pname, val)
            case HirStmt.SMultiLet(_, _, val): return self._param_consumed_in_expr(pname, val)
            case HirStmt.SExpr(e): return self._param_consumed_in_expr(pname, e)
            case HirStmt.SIf(_, tb, eb): return self._param_consumed_in_block(pname, tb) or self._param_consumed_in_block(pname, eb)
            case HirStmt.SWhile(_, wb): return self._param_consumed_in_block(pname, wb)
            case HirStmt.SFor(_, _, fb): return self._param_consumed_in_block(pname, fb)
            case HirStmt.SForUnpack(_, _, fub): return self._param_consumed_in_block(pname, fub)
            case HirStmt.SMatch(_, arms):
                mut ai = 0
                while ai < arms.len:
                    if self._param_consumed_in_block(pname, arms.get(ai).body): return true
                    ai = ai + 1
                return false
            case HirStmt.SUnsafe(ub): return self._param_consumed_in_block(pname, ub)
            case HirStmt.SWith(_, _, wb): return self._param_consumed_in_block(pname, wb)
            case HirStmt.STaskGroup(tb): return self._param_consumed_in_block(pname, tb)
            case HirStmt.SDefer(ds): return self._param_consumed_in_stmt(pname, ds)
            case HirStmt.STry(tb, catches, fb):
                if self._param_consumed_in_block(pname, tb): return true
                if self._param_consumed_in_block(pname, fb): return true
                mut ci = 0
                while ci < catches.len:
                    if self._param_consumed_in_block(pname, catches.get(ci).read().body): return true
                    ci = ci + 1
                return false
            case _: return false

    # True if the expression consumes `pname` — stores it in a container, captures it,
    # or passes it to a consuming/unknown callee position. A bare read does not consume.
    pub def _param_consumed_in_expr(self, pname: str, ep: Pointer[HirExpr]) -> bool:
        if ep as usize == 0 as usize: return false
        match ep.read():
            case HirExpr.ECall(callee, args, _):
                mut gname = self._pc_callee_name(callee)
                mut j = 0
                while j < args.len:
                    if self._pc_is_ident(args.get(j), pname):
                        if gname == "": return true                                  # indirect callee -> conservative
                        mut ck = gname + "#" + j.to_str()
                        if not self.fn_param_consumes.contains(ck): return true       # extern/unknown -> conservative
                        if self.fn_param_consumes.get(ck): return true               # known consuming position
                    else:
                        if self._param_consumed_in_expr(pname, args.get(j)): return true
                    j = j + 1
                return self._param_consumed_in_expr(pname, callee)
            case HirExpr.EMethodCall(obj, method, args, _):
                # `pname.free()` DESTROYS the receiver (class-with-free destructor
                # convention) — treat it as CONSUMING pname, so a caller that hands its
                # owned value to a function whose body frees it is not ALSO auto-dropped
                # (would double-free). Any other method leaves the receiver borrowed.
                if method == "free" and self._pc_is_ident(obj, pname): return true
                mut j2 = 0
                while j2 < args.len:
                    if self._pc_is_ident(args.get(j2), pname): return true            # receiver-type deferred -> conservative
                    if self._param_consumed_in_expr(pname, args.get(j2)): return true
                    j2 = j2 + 1
                return self._param_consumed_in_expr(pname, obj)
            case HirExpr.EList(items, _): return self._pc_anyrefs(items, pname)        # collection literal stores it
            case HirExpr.ESet(items, _): return self._pc_anyrefs(items, pname)
            case HirExpr.ETuple(items, _): return self._pc_anyrefs(items, pname)
            case HirExpr.EDict(dks, dvs, _): return self._pc_anyrefs(dks, pname) or self._pc_anyrefs(dvs, pname)
            case HirExpr.EClosure(_, _, _, _, caps):
                mut cj = 0
                while cj < caps.len:
                    if caps.get(cj).name == pname: return true                        # captured by a closure
                    cj = cj + 1
                return false
            case HirExpr.EBinOp(_, l, r, _): return self._param_consumed_in_expr(pname, l) or self._param_consumed_in_expr(pname, r)
            case HirExpr.EUnaryOp(_, e, _): return self._param_consumed_in_expr(pname, e)
            case HirExpr.ECast(e, _): return self._param_consumed_in_expr(pname, e)
            case HirExpr.EPropAccess(o, _, _): return self._param_consumed_in_expr(pname, o)
            case HirExpr.EIndex(o, ix, _): return self._param_consumed_in_expr(pname, o) or self._param_consumed_in_expr(pname, ix)
            case HirExpr.EIfElse(cnd, te, ee, _): return self._param_consumed_in_expr(pname, cnd) or self._param_consumed_in_expr(pname, te) or self._param_consumed_in_expr(pname, ee)
            case HirExpr.EAwait(e, _): return self._param_consumed_in_expr(pname, e)
            case HirExpr.ETryExpr(e, _): return self._param_consumed_in_expr(pname, e)
            case _: return false

    pub def _fn_ret_is_heap_class(self, f: HirFunction) -> bool:
        if f.ret_ty as usize == 0 as usize: return false
        mut rn = f.ret_ty.name
        if not self.classes.contains(rn): return false
        if rn == "Vec" or rn == "Map" or rn == "List" or rn == "Dict" or rn == "Set" or rn == "Box" or rn == "Mutex" or rn == "RwLock" or rn == "Atomic" or rn == "Shared" or rn == "Option" or rn == "Result" or rn == "Chan" or rn == "StringBuilder" or rn == "StringObj": return false
        # value types are copied by value, not refcounted
        mut cinfo = self.classes.get(rn)
        if not cinfo.is_class: return false
        return true

    # Collect every SReturn expression reachable in `b` (recurses into EVERY
    # nested block form — missing one would leave a borrow-return unseen and
    # wrongly classify the function OWNED, risking a UAF at the call site).
    pub def _collect_returns(self, b: HirBlock, out: Vec[Pointer[HirExpr]]):
        if b as usize == 0 as usize: return
        mut i = 0
        while i < b.stmts.len:
            self._collect_returns_stmt(b.stmts.get(i), out)
            i = i + 1

    pub def _collect_returns_stmt(self, sp: Pointer[HirStmt], out: Vec[Pointer[HirExpr]]):
        if sp as usize == 0 as usize: return
        match sp.read():
            case HirStmt.SReturn(re):
                if re as usize != 0 as usize: out.push(re)
            case HirStmt.SIf(_, tb, eb):
                self._collect_returns(tb, out)
                self._collect_returns(eb, out)
            case HirStmt.SWhile(_, wb): self._collect_returns(wb, out)
            case HirStmt.SFor(_, _, fb): self._collect_returns(fb, out)
            case HirStmt.SForUnpack(_, _, fub): self._collect_returns(fub, out)
            case HirStmt.SMatch(_, marms):
                mut ai = 0
                while ai < marms.len:
                    self._collect_returns(marms.get(ai).body, out)
                    ai = ai + 1
            case HirStmt.SUnsafe(ub): self._collect_returns(ub, out)
            case HirStmt.SWith(_, _, wb2): self._collect_returns(wb2, out)
            case HirStmt.STaskGroup(tgb): self._collect_returns(tgb, out)
            case HirStmt.SGpuBlock(gb): self._collect_returns(gb, out)
            case HirStmt.SDefer(ds): self._collect_returns_stmt(ds, out)
            case HirStmt.STry(tb2, catches, fb2):
                self._collect_returns(tb2, out)
                mut ci = 0
                while ci < catches.len:
                    mut cc = catches.get(ci)
                    if cc as usize != 0 as usize: self._collect_returns(cc.read().body, out)
                    ci = ci + 1
                self._collect_returns(fb2, out)
            case _: pass

    # Current fixpoint estimate for a fn/method key (missing → conservatively BORROWED).
    pub def _owned_of(self, key: str) -> bool:
        if self.fn_ret_owned.contains(key): return self.fn_ret_owned.get(key)
        return false

    pub def _ret_yields_owned(self, e: Pointer[HirExpr]) -> bool:
        if e as usize == 0 as usize: return false
        match e.read():
            case HirExpr.EIdent(_, _, _): return true
            case HirExpr.EPropAccess(_, _, _): return true
            case HirExpr.ECall(callee, _, _):
                if callee as usize == 0 as usize: return false
                match callee.read():
                    case HirExpr.EIdent(cn, _, _):
                        if self.classes.contains(cn): return true   # constructor
                        return self._owned_of(cn)                    # free fn (missing→borrow)
                    case _: return false
            case HirExpr.EMethodCall(recv, m, _, _):
                mut rt = hir_expr_type(recv).name
                # A collection element read is a raw alias (not retained) → borrow.
                if (rt == "Vec" or rt == "List" or rt == "Dict" or rt == "Map" or rt == "Set") and (m == "get" or m == "first" or m == "last"):
                    return false
                # ClassName.factory(...) — receiver names a class → key on it directly.
                match recv.read():
                    case HirExpr.EIdent(rn, _, _):
                        if self.classes.contains(rn): rt = rn
                    case _: pass
                return self._owned_of(rt + "." + m)
            case HirExpr.EIndex(_, _, _): return false
            case HirExpr.EIfElse(_, a, b2, _):
                return self._ret_yields_owned(a) and self._ret_yields_owned(b2)
            case _: return false

    # A concrete type satisfies a generic bound `T: Iface` if it is a class that
    # either explicitly `implements Iface` OR structurally has all of the interface's
    # methods (Tauraro's monomorphized generics dispatch by method, so structural
    # satisfaction is exactly what makes the body compile). Unknown bound names are
    # accepted (lenient — could be a non-interface marker); primitives never satisfy.
    # A name is an abstract type parameter in the current scope (not a concrete type)
    # if it's a single-letter param (T/K/V/…) or appears in the enclosing function's
    # generics — bounds on such a name can't be checked yet, so we don't false-error.
    pub def _is_type_param_in_scope(self, name: str) -> bool:
        if _tr_strlen(name) == 1: return true
        mut i = 0
        while i < self.current_func_generics.len:
            if self.current_func_generics.get(i) == name: return true
            i = i + 1
        # A multi-character name can ALSO be an in-scope type parameter of the
        # ENCLOSING CLASS (e.g. `RS` in `class Engine[C: DbConnection[RS], RS:
        # DbResultSet]:`), not just the current function's own generics --
        # `wrap`/other methods on Engine aren't independently generic
        # themselves, they inherit Engine's type params, so
        # current_func_generics alone never contains them. Without this, a
        # multi-character class-level type parameter used in a
        # self-referencing recursive site (`Engine[C, RS]()` inside Engine's
        # own `extend` block) was only ever accepted by the strlen==1
        # shortcut above -- confirmed a real bug: renaming a class's own
        # second type parameter from `RS` to `R` alone made an otherwise
        # identical bound check pass instead of falsely failing with "Type
        # 'RS' does not satisfy the bound 'DbResultSet'" (RS being checked
        # against its own bound as if it were a real concrete type, not the
        # already-constrained abstract parameter it is).
        if self.current_class_name != "" and self.classes.contains(self.current_class_name):
            mut ccls = self.classes.get(self.current_class_name)
            mut ci = 0
            while ci < ccls.generics.len:
                if ccls.generics.get(ci) == name: return true
                ci = ci + 1
        return false

    pub def _type_satisfies_bound(self, type_name: str, iface_name: str) -> bool:
        if not self.interfaces.contains(iface_name): return true
        # An unresolved type parameter (Box[T] inside a generic body) is checked when
        # the OUTER generic is instantiated with a concrete type — accept it here.
        if self._is_type_param_in_scope(type_name): return true
        if not self.classes.contains(type_name): return false
        mut cls = self.classes.get(type_name)
        mut ii = 0
        while ii < cls.iface_names.len:
            if cls.iface_names.get(ii) == iface_name: return true
            ii = ii + 1
        mut idef = self.interfaces.get(iface_name)
        mut mi = 0
        while mi < idef.methods.len:
            mut imeth_nm = idef.methods.get(mi).name
            mut found = false
            mut cmi = 0
            while cmi < cls.methods.len:
                if cls.methods.get(cmi).name == imeth_nm: found = true
                cmi = cmi + 1
            if not found: return false
            mi = mi + 1
        return true

    # Resolve a method call's return type when the receiver's static type is a generic
    # type PARAMETER of the current function (e.g. `conn: C` inside `do_thing[C:
    # DbConnection](conn: C)`), not the interface name directly. Without this, `C` matches
    # neither `self.interfaces.contains` nor `self.classes.contains` below, so the call's
    # return type falls back to `void` and codegen (which keys method-dispatch prefixing
    # off the HIR return type) emits a bare, unqualified C call instead of `Class_method`.
    # Returns a null pointer (0 as Pointer[AstType]) when no bound of `pname` declares
    # `method`, so callers can tell "not applicable" apart from a genuine `void` return.
    pub def _resolve_generic_bound_method_ret(self, pname: str, method: str) -> Pointer[AstType]:
        mut ci = 0
        while ci < self.current_func_constraints.len:
            mut gc = self.current_func_constraints.get(ci)
            if gc.target == pname:
                mut bi = 0
                while bi < gc.bounds.len:
                    mut bound_ty = gc.bounds.get(bi).read()
                    if self.interfaces.contains(bound_ty.name):
                        mut idef = self.interfaces.get(bound_ty.name)
                        mut mi = 0
                        while mi < idef.methods.len:
                            mut imdef = idef.methods.get(mi)
                            if imdef.name == method and imdef.ret_ty as usize != 0 as usize:
                                mut found_ty = imdef.ret_ty.read()
                                # Substitute the bound interface's OWN generic param (e.g.
                                # `DbConnection[RS]`'s `RS`) with whatever type name this
                                # bound supplies as its argument at the constraint site.
                                if idef.generics.len > 0 and bound_ty.args.len > 0:
                                    mut gi = 0
                                    while gi < idef.generics.len:
                                        if idef.generics.get(gi) == found_ty.name and gi < bound_ty.args.len:
                                            found_ty = bound_ty.args.get(gi).read()
                                        gi = gi + 1
                                return box_asttype(found_ty)
                            mi = mi + 1
                    bi = bi + 1
            ci = ci + 1
        return 0 as Pointer[AstType]

    # [G-1] Enforce generic bounds at a call site: for each `T: Iface` constraint on
    # the callee, infer T's concrete type from an argument whose parameter is declared
    # as T, and require it to satisfy every bound interface.
    pub def check_call_bounds(self, fname: str, hargs: Vec[Pointer[HirExpr]]):
        if not self.fn_defs.contains(fname): return
        mut fd = self.fn_defs.get(fname)
        if fd.constraints.len == 0: return
        mut sk = 0
        if fd.params.len > 0 and fd.params.get(0).name == "self": sk = 1
        mut ci = 0
        while ci < fd.constraints.len:
            mut gc = fd.constraints.get(ci)
            mut pi = 0
            while pi < fd.params.len:
                mut _pty = fd.params.get(pi).ty
                if _pty as usize != 0 as usize and _pty.read().name == gc.target:
                    mut aidx = pi - sk
                    if aidx >= 0 and aidx < hargs.len:
                        mut concrete_n: str = hir_expr_type(hargs.get(aidx)).name
                        mut bi = 0
                        while bi < gc.bounds.len:
                            mut iface_n = gc.bounds.get(bi).read().name
                            if not self._type_satisfies_bound(concrete_n, iface_n):
                                self.error("[G-1] Type '" + concrete_n + "' does not satisfy the bound '" + iface_n + "' required by type parameter '" + gc.target + "' of '" + fname + "'.\n      FIX: implement all methods of interface '" + iface_n + "' on '" + concrete_n + "', or add 'implements " + iface_n + "'.")
                            bi = bi + 1
                pi = pi + 1
            ci = ci + 1

    # Substitute a generic class's type params for their concrete args throughout a
    # type — including NESTED positions. `of() -> Box[T]` called on Box[Cat] yields
    # Box[Cat], not just when the whole return type is a bare `T`. Rebuilds only when
    # a param is present; preserves array_size.
    pub def _subst_ret_generics(self, ty: AstType, generics: Vec[str], concrete: Vec[Pointer[AstType]]) -> AstType:
        mut gi = 0
        while gi < generics.len:
            if generics.get(gi) == ty.name and gi < concrete.len:
                return concrete.get(gi).read()
            gi = gi + 1
        if ty.args.len == 0: return ty
        mut nt = AstType.init(ty.name)
        nt.array_size = ty.array_size
        nt.args = Vec[Pointer[AstType]].init(ty.args.len)
        mut ai = 0
        while ai < ty.args.len:
            nt.args.push(box_asttype(self._subst_ret_generics(ty.args.get(ai).read(), generics, concrete)))
            ai = ai + 1
        return nt

    # [G-1] Enforce generic bounds when a generic CLASS is instantiated with concrete
    # type args (Box[Cat]): each `T: Iface` constraint requires the arg bound to T to
    # satisfy the interface. arg_tys are positional, aligned with the class's generics.
    pub def check_class_bounds(self, cls_name: str, arg_tys: Vec[Pointer[AstType]]):
        if not self.classes.contains(cls_name): return
        mut cd = self.classes.get(cls_name)
        if cd.constraints.len == 0: return
        mut ci = 0
        while ci < cd.constraints.len:
            mut gc = cd.constraints.get(ci)
            mut gpi = 0
            while gpi < cd.generics.len:
                if cd.generics.get(gpi) == gc.target and gpi < arg_tys.len:
                    mut concrete_n: str = arg_tys.get(gpi).read().name
                    mut bi = 0
                    while bi < gc.bounds.len:
                        mut iface_n = gc.bounds.get(bi).read().name
                        if not self._type_satisfies_bound(concrete_n, iface_n):
                            self.error("[G-1] Type '" + concrete_n + "' does not satisfy the bound '" + iface_n + "' required by type parameter '" + gc.target + "' of class '" + cls_name + "'.\n      FIX: implement all methods of interface '" + iface_n + "' on '" + concrete_n + "', or add 'implements " + iface_n + "'.")
                        bi = bi + 1
                gpi = gpi + 1
            ci = ci + 1

    pub def register_decl(self, d: Pointer[Decl]):
        match d.read():
            case Decl.DFunction(f):
                mut _f_ret = box_asttype(AstType.init("void"))
                if f.ret_ty as usize != 0 as usize: _f_ret = f.ret_ty
                # [cross-fn region] for a single-region borrow return (`-> ref str from a`),
                # record the index of the `from` parameter so a call site can map the
                # result's region to the matching argument.
                if f.ret_ty as usize != 0 as usize:
                    mut _frt = f.ret_ty.read()
                    # A single-region `from a` return — whether it's `ref T from a` (a
                    # borrow) OR a borrow-HOLDING struct `T from a` (Gap 3, e.g. a StrView
                    # that borrows its source) — records the index of the `from` parameter
                    # so a call site maps the result's region to the matching argument.
                    if _frt.from_regions.len == 1:
                        mut _fi = 0
                        while _fi < f.params.len:
                            if f.params.get(_fi).name == _frt.from_regions.get(0):
                                _frt.from_index = _fi
                            _fi = _fi + 1
                        _f_ret = box_asttype(_frt)
                # A 'throws' function's call-site type is Result[V, Err], so that
                # `mut r = throwing_fn(...)` infers `r: Result[V, Err]` and
                # r.is_ok / r.unwrap() / r.unwrap_err() dispatch correctly.
                mut _decl_ret = _f_ret
                if f.throws_ty as usize != 0 as usize:
                    if f.throws_ty.read().name != "":
                        mut _result_ty = AstType.init("Result")
                        _result_ty.args.push(_f_ret)
                        _result_ty.args.push(f.throws_ty)
                        _decl_ret = box_asttype(_result_ty)
                self.declare(f.name, SymbolKind.SFunction, _decl_ret, false)
                # Record the full signature so the function can be used as a
                # first-class value (def(...)->R): EIdent yields this type, and
                # calling such a value recovers the return type (last arg).
                mut _fnty = AstType.init("def")
                mut _pi = 0
                while _pi < f.params.len:
                    _fnty.args.push(f.params.get(_pi).ty)
                    _pi = _pi + 1
                _fnty.args.push(_f_ret)
                self.fn_sigs.insert(f.name, _fnty)
                self.fn_defs.insert(f.name, f)
                # #14: trailing variadic param `def f(args...)` / `def f(args: T...)`
                # collects trailing call args into a List[T] literal at call sites.
                if f.params.len > 0:
                    mut _vp = f.params.get(f.params.len - 1)
                    if _vp.is_variadic:
                        mut _velem_ty = AstType.init("int")
                        if _vp.ty as usize != 0 as usize: _velem_ty = _vp.ty.read()
                        self.variadic_fns.insert(f.name, (f.params.len - 1).to_str())
                        self.variadic_elem_ty.insert(f.name, box_asttype(_velem_ty))
            case Decl.DClass(c):
                self.declare(c.name, SymbolKind.SClass, box_asttype(AstType.init(c.name)), false)
                self.classes.insert(c.name, c)
                # @copy opt-in: treat as a freely-shareable value (exempt from move tracking)
                if self.has_copy_decorator(c.decorators): self.copy_classes.insert(c.name, true)
            case Decl.DActor(c):
                self.declare(c.name, SymbolKind.SClass, box_asttype(AstType.init(c.name)), false)
                self.classes.insert(c.name, c)
                if self.has_copy_decorator(c.decorators): self.copy_classes.insert(c.name, true)
            case Decl.DEnum(e):
                self.declare(e.name, SymbolKind.SEnum, box_asttype(AstType.init(e.name)), false)
                self.enums.insert(e.name, e)
                if self.has_copy_decorator(e.decorators): self.copy_classes.insert(e.name, true)
            case Decl.DInterface(i):
                self.declare(i.name, SymbolKind.SInterface, box_asttype(AstType.init(i.name)), false)
                self.interfaces.insert(i.name, i)
                if self.has_copy_decorator(i.decorators): self.copy_classes.insert(i.name, true)
            case Decl.DExtend(target, methods):
                mut hi = 0
                while hi < methods.len:
                    mut f = methods.get(hi)
                    mut _m_ret = box_asttype(AstType.init("void"))
                    if f.ret_ty as usize != 0 as usize: _m_ret = f.ret_ty
                    # For overloaded methods, register with a param-count suffix so each
                    # overload gets a distinct symbol in the global scope.
                    mut _decl_key = target + "_" + f.name
                    if self.globals.contains(_decl_key):
                        # Count non-self params to build unique overload key.
                        mut _pc = 0
                        mut _pci = 0
                        while _pci < f.params.len:
                            if f.params.get(_pci).name != "self": _pc = _pc + 1
                            _pci = _pci + 1
                        _decl_key = _decl_key + "_" + _pc.to_str() + "arg"
                    self.declare(_decl_key, SymbolKind.SFunction, _m_ret, false)
                    if self.classes.contains(target):
                        self.classes.get(target).methods.push(f)
                    hi = hi + 1
            case Decl.DExtern(abi, functions):
                mut ei = 0
                while ei < functions.len:
                    mut f = functions.get(ei)
                    mut _e_ret = box_asttype(AstType.init("void"))
                    if f.ret_ty as usize != 0 as usize: _e_ret = f.ret_ty
                    self.declare(f.name, SymbolKind.SFunction, _e_ret, false)
                    self.extern_names.insert(f.name, true)   # [N-3] allowlist
                    ei = ei + 1
            case Decl.DDecoratorDef(f):
                self.decorator_names.insert(f.name, true)
                self.declare(f.name, SymbolKind.SFunction, box_asttype(AstType.init("void")), false)
            case Decl.DTypeAlias(alias_name, target_ty):
                # Register type alias: `type Name = ExistingType`
                # The alias name becomes a valid type name resolving to the target.
                mut alias_ty = box_asttype(AstType.init("void"))
                if target_ty as usize != 0 as usize: alias_ty = target_ty
                self.declare(alias_name, SymbolKind.SClass, alias_ty, false)
                # Also register as a type alias mapping so type_to_c can resolve it.
                mut resolved_name = ""
                if target_ty as usize != 0 as usize: resolved_name = target_ty.read().name
                if resolved_name.len() > 0:
                    self.type_aliases.insert(alias_name, resolved_name)
                    # Store first generic arg (element type) for List/Map aliases.
                    if target_ty as usize != 0 as usize:
                        mut ta_t = target_ty.read()
                        if ta_t.args.len > 0:
                            self.type_alias_elem.insert(alias_name, ta_t.args.get(0).read().name)
            case _: pass

    pub def lower_func(self, f: FunctionDef) -> HirFunction:
        self.current_line = f.line
        mut _saved_fn_is_lib = self.cur_fn_is_lib
        self.cur_fn_is_lib = f.is_lib
        # Rule N-1: Function name check
        # Top-level functions cannot shadow reserved built-ins.
        # Methods (current_class_name != "") are exempt - len/abs/etc. are valid method names.
        if f.name != "main" and f.name != "" and _tr_strlen(f.name) > 1:
            mut fn_cat = self.is_reserved_error(f.name)
            if fn_cat != "":
                self.error("[N-1] '" + f.name + "' is a " + fn_cat + " and cannot be used as a function name.")
            elif self.current_class_name == "":
                mut fn_kcat = self.is_reserved_keyword(f.name)
                if fn_kcat != "":
                    self.error("[N-1] '" + f.name + "' is a " + fn_kcat + " and is reserved. Choose a different function name.")
        # Save async context, set function context
        mut saved_async = self.in_async_fn
        self.in_async_fn = f.is_async
        self.current_func_name = f.name
        mut saved_func_generics = self.current_func_generics
        self.current_func_generics = f.generics
        mut saved_func_constraints = self.current_func_constraints
        self.current_func_constraints = f.constraints
        # clear container-borrow state - it must not leak between functions
        self.container_borrows = Map[str, str].init(16)
        # Gap 1: capture 'from' lifetime param for escape-analysis check in SReturn
        mut saved_ret_from = self.current_func_ret_from
        mut saved_ret_borrow_str = self.current_func_ret_borrow_str
        mut saved_ret_regions = self.current_func_ret_regions
        mut saved_outlives_a = self.current_func_outlives_a
        mut saved_outlives_b = self.current_func_outlives_b
        self.current_func_ret_from = ""
        self.current_func_ret_borrow_str = false
        self.current_func_ret_regions = Vec[str].init(0)
        self.current_func_outlives_a = f.outlives_a
        self.current_func_outlives_b = f.outlives_b
        # `where` enforcement (--strict): each region named in a bound must be a parameter.
        if self.strict_mode and f.outlives_a.len > 0:
            mut wbi = 0
            while wbi < f.outlives_a.len:
                mut w_ok_a = false
                mut w_ok_b = false
                mut wpi = 0
                while wpi < f.params.len:
                    if f.params.get(wpi).name == f.outlives_a.get(wbi): w_ok_a = true
                    if f.params.get(wpi).name == f.outlives_b.get(wbi): w_ok_b = true
                    wpi = wpi + 1
                if not w_ok_a:
                    self.error("[L-2] region '" + f.outlives_a.get(wbi) + "' in the `where ... outlives ...` clause is not a parameter of this function.")
                if not w_ok_b:
                    self.error("[L-2] region '" + f.outlives_b.get(wbi) + "' in the `where ... outlives ...` clause is not a parameter of this function.")
                wbi = wbi + 1
        if f.ret_ty as usize != 0 as usize:
            self.current_func_ret_from = f.ret_ty.read().from_param
            self.current_func_ret_regions = f.ret_ty.read().from_regions
            if f.ret_ty.read().is_borrow and f.ret_ty.read().name == "str":
                self.current_func_ret_borrow_str = true
        # Auto-infer 'from' when no explicit annotation: if return is Pointer/ref and there is
        # exactly one non-primitive parameter, that parameter is the inferred lifetime source.
        # This covers the common single-param borrow pattern without requiring any annotation.
        if self.current_func_ret_from == "" and f.ret_ty as usize != 0 as usize:
            mut infer_ret_nm = f.ret_ty.read().name
            mut infer_is_borrow = f.ret_ty.read().is_borrow
            if infer_ret_nm == "Pointer" or infer_ret_nm == "ref" or infer_ret_nm == "mut_ref" or infer_is_borrow:
                mut infer_from = ""
                mut infer_count = 0
                mut infer_i = 0
                while infer_i < f.params.len:
                    mut infer_p = f.params.get(infer_i)
                    if infer_p.name != "self" and infer_p.ty as usize != 0 as usize:
                        mut infer_pty = infer_p.ty.read()
                        if not self.is_primitive_name(infer_pty.name):
                            infer_from = infer_p.name
                            infer_count = infer_count + 1
                    infer_i = infer_i + 1
                if infer_count == 1:
                    self.current_func_ret_from = infer_from
        # [L-2] Validate explicit region sources (the names in `from a, b`): each must
        # be a parameter or a region parameter of the enclosing type. Rejects a typo'd
        # / nonexistent region — a MALFORMED annotation, never safe code: the ARC floor
        # keeps every real borrow safe, so lifetimes stay fully optional.
        if f.ret_ty as usize != 0 as usize:
            mut rregs = f.ret_ty.read().from_regions
            mut rri = 0
            while rri < rregs.len:
                mut rnm = rregs.get(rri)
                mut rok = false
                mut rpi = 0
                while rpi < f.params.len:
                    if f.params.get(rpi).name == rnm:
                        rok = true
                    rpi = rpi + 1
                if not rok:
                    # Region params of the enclosing type (class/enum/interface `from r`).
                    mut rci = 0
                    while rci < self.current_region_params.len:
                        if self.current_region_params.get(rci) == rnm:
                            rok = true
                        rci = rci + 1
                if not rok:
                    self.error("[L-2] region source '" + rnm + "' named in 'from' is not a parameter or a region parameter of the enclosing type.\n      FIX: name a parameter the borrow comes from, or declare 'class/enum/interface <T> from " + rnm + ":'.")
                rri = rri + 1
        self.enter_scope()

        mut hparams = Vec[HirParam].init(4)
        mut j = 0
        while j < f.params.len:
            mut p = f.params.get(j)
            mut p_ty = AstType.init("int")
            if p.ty as usize != 0 as usize:
                p_ty = p.ty.read()
            elif p.name == "self" and self.current_class_name != "":
                p_ty = AstType.init(self.current_class_name)
            if p.is_variadic:
                # `args...` / `args: T...` -> the parameter itself is a List[T]
                # built from the trailing call args.
                mut _vp_ty = AstType.init("List")
                _vp_ty.args.push(box_asttype(p_ty))
                p_ty = _vp_ty

            self.declare(p.name, SymbolKind.SVariable, box_asttype(p_ty), false)
            # mark as parameter so return-of-local-pointer check is skipped
            if self.scopes.len > 0:
                mut pb_scope = self.scopes.get(self.scopes.len - 1)
                if pb_scope.variables.contains(p.name):
                    mut pb_sym = pb_scope.variables.get(p.name)
                    pb_sym.is_param = true
                    pb_sym.ptr_region = 2  # PARAM region
                    pb_scope.variables.insert(p.name, pb_sym)

            mut hp = HirParam()
            hp.name = p.name
            hp.ty = p_ty
            hparams.push(hp)
            j = j + 1

        mut hf = HirFunction()
        hf.name = f.name
        hf.class_name = self.current_class_name
        hf.generics = f.generics
        hf.constraints = f.constraints
        hf.params = hparams
        hf.ret_ty = AstType.init("None")
        if f.ret_ty as usize != 0 as usize: hf.ret_ty = f.ret_ty.read()
        hf.throws_ty = AstType.init("")
        if f.throws_ty as usize != 0 as usize: hf.throws_ty = f.throws_ty.read()
        # outlives engine: collect cross-fn ref-borrow edges while lowering the body.
        self.cur_func_borrowers = Vec[str].init(2)
        self.cur_func_sources   = Vec[str].init(2)
        hf.body = self.lower_block(f.body)
        hf.borrow_borrowers = self.cur_func_borrowers
        hf.borrow_sources   = self.cur_func_sources
        # Outlives engine result: which ref-borrow locals are PROVEN-safe to elide.
        hf.proven_borrows   = mir_proven_borrows(hf)
        # [B-1] Aliasing-XOR-mutability (opt-in --strict, Rust-model): reject overlapping
        # borrows of the same place where one is exclusive (`mut x: ref T`). ARC keeps the
        # program safe without this; --strict enforces the borrow discipline.
        if self.strict_mode:
            mut _bconf = mir_borrow_conflicts(hf, self.mutating_methods)
            mut _bci = 0
            while _bci < _bconf.len:
                self.error("[B-1] " + _bconf.get(_bci) + ".\n      A place may have MANY shared `ref` borrows, OR exactly ONE exclusive `mut` borrow — never both. End one borrow's last use before the other begins.")
                _bci = _bci + 1
            # [B-3] Shared `ref` params are read-only; mutation needs `mut ref`.
            mut _b3 = mir_shared_ref_param_violations(hf, self.mutating_methods)
            mut _b3i = 0
            while _b3i < _b3.len:
                self.error("[B-3] " + _b3.get(_b3i) + ".\n      A shared `ref T` parameter cannot be mutated — declare it `mut ref T` for an exclusive (mutable) borrow.")
                _b3i = _b3i + 1
        hf.decorators = f.decorators
        hf.is_async = f.is_async
        hf.is_extern = f.is_extern
        hf.is_public = f.is_public
        hf.is_export = f.is_export
        mut _has_self = false
        mut _si = 0
        while _si < hparams.len:
            if hparams.get(_si).name == "self": _has_self = true
            _si = _si + 1
        hf.is_static = self.current_class_name != "" and not _has_self
        hf.is_variadic = f.is_variadic
        hf.is_decorator = false

        # Rule F-3: Definite return check for non-void, non-extern functions.
        # Skip interface method signatures (empty body), constructors, and the
        # program entry point `main` — `main` is the entry point whose return is
        # always optional (C's main implicitly returns 0), so it needs no
        # explicit `return` even when written `-> int`.
        mut _is_entry_main = f.name == "main" and self.current_class_name == ""
        if not f.is_extern and f.body.stmts.len > 0 and f.ret_ty as usize != 0 as usize:
            mut ret_nm = f.ret_ty.read().name
            if ret_nm != "void" and ret_nm != "None" and ret_nm != "" and f.name != "init" and f.name != "new" and not _is_entry_main:
                if not self.block_returns(f.body):
                    self.current_line = f.line
                    self.error("[F-3] Function '" + f.name + "' returns '" + ret_nm + "' but is missing a return statement on at least one code path. FIX: Add a return at the end, or ensure all if/elif/else branches return.")

        self.finalize_scope_drops(hf.body)
        # #53 HYBRID: fill the if-body fall-through leak from the MIR drop schedule
        # (HIR machinery handled top-level/while/jump drops above). BEFORE
        # exit_scope so the collection escape gate (coll_droppable_by_sema) can read
        # live symbols.
        self.apply_mir_if_drops(hf)
        self.exit_scope()
        # Restore async context and lifetime context
        self.in_async_fn = saved_async
        self.current_func_name = ""
        self.current_func_generics = saved_func_generics
        self.current_func_constraints = saved_func_constraints
        self.current_func_ret_from = saved_ret_from
        self.current_func_ret_borrow_str = saved_ret_borrow_str
        self.current_func_ret_regions = saved_ret_regions
        self.current_func_outlives_a = saved_outlives_a
        self.current_func_outlives_b = saved_outlives_b
        self.cur_fn_is_lib = _saved_fn_is_lib
        return hf

    pub def lower_class(self, c: ClassDef) -> HirClass:
        self.current_line = c.line
        self.current_class_name = c.name
        self.current_region_params = c.region_params
        mut hfields = Vec[HirField].init(4)
        mut i = 0
        while i < c.fields.len:
            mut f = c.fields.get(i)
            mut hf = HirField()
            hf.name = f.name
            mut f_ty = AstType.init("int")
            if f.ty as usize != 0 as usize: f_ty = f.ty.read()
            hf.ty = f_ty
            hfields.push(hf)
            i = i + 1

        # detect self-referential Shared[ClassName] fields (creates ref cycle -> leak)
        mut pf_i = 0
        while pf_i < c.fields.len:
            mut pf_f = c.fields.get(pf_i)
            if pf_f.ty as usize != 0 as usize:
                mut pf_ty = pf_f.ty.read()
                if pf_ty.name == "Shared" and pf_ty.args.len > 0:
                    mut pf_inner = pf_ty.args.get(0).read()
                    if pf_inner.name == c.name:
                        self.error("[S-1] '" + c.name + "' has a 'Shared[" + c.name + "]' field '" + pf_f.name + "' - this creates a reference cycle that leaks memory.\n      FIX: Use 'Weak[" + c.name + "]' for back-references to break the cycle.")
            pf_i = pf_i + 1

        mut hmethods = Vec[HirFunction].init(4)
        i = 0
        while i < c.methods.len:
            mut hm = self.lower_func(c.methods.get(i))
            hmethods.push(hm)
            i = i + 1
            
        # -- Interface completeness + signature checks -------------------------
        mut _ifc_i = 0
        while _ifc_i < c.iface_names.len:
            mut _ifc_nm = c.iface_names.get(_ifc_i)
            if _ifc_nm == "Sendable":
                # Validate all fields are Sendable; pass generics (T fields allowed)
                if c.generics.len == 0:
                    self.check_class_sendable_fields(c)
            elif _ifc_nm == "UnsafeSendable":
                # Marker (Tauraro's `unsafe impl Send/Sync`): the author asserts this
                # class is thread-safe. No compiler field check — the assertion is the
                # audited unsafe core; it opts out of [T-2] (fields) and [T-7] (rc).
                pass
            elif not self.interfaces.contains(_ifc_nm):
                self.error("[I-1] Class '" + c.name + "' declares 'implements " + _ifc_nm + "' but interface '" + _ifc_nm + "' is not defined.\n      FIX: Define 'interface " + _ifc_nm + ":' before this class, or check for typos.")
            else:
                mut _idef = self.interfaces.get(_ifc_nm)
                mut _im_i = 0
                while _im_i < _idef.methods.len:
                    mut _imeth = _idef.methods.get(_im_i)
                    mut _found = false
                    mut _cm_i = 0
                    while _cm_i < c.methods.len:
                        mut _cmeth = c.methods.get(_cm_i)
                        if _cmeth.name == _imeth.name:
                            _found = true
                            # Return type check
                            mut _iret = "void"
                            if _imeth.ret_ty as usize != 0 as usize:
                                _iret = _imeth.ret_ty.read().name
                            mut _cret = "void"
                            if _cmeth.ret_ty as usize != 0 as usize:
                                _cret = _cmeth.ret_ty.read().name
                            # Allow generics (single-letter type param) to match anything
                            mut _iret_is_generic = _ifc_i >= 0 and _idef.generics.len > 0 and _iret != "void" and _iret != ""
                            mut _gi = 0
                            while _gi < _idef.generics.len:
                                if _idef.generics.get(_gi) == _iret: _iret_is_generic = true
                                _gi = _gi + 1
                            if not _iret_is_generic and _iret != "void" and _iret != "" and _cret != _iret:
                                self.error("[I-3] Class '" + c.name + "': method '" + _cmeth.name + "' returns '" + _cret + "' but interface '" + _ifc_nm + "' declares '-> " + _iret + "'.\n      FIX: Change return type to '-> " + _iret + "'.")
                            # Non-self param count check
                            mut _ip_cnt = 0
                            mut _ip_i = 0
                            while _ip_i < _imeth.params.len:
                                if _imeth.params.get(_ip_i).name != "self": _ip_cnt = _ip_cnt + 1
                                _ip_i = _ip_i + 1
                            mut _cp_cnt = 0
                            mut _cp_i = 0
                            while _cp_i < _cmeth.params.len:
                                if _cmeth.params.get(_cp_i).name != "self": _cp_cnt = _cp_cnt + 1
                                _cp_i = _cp_i + 1
                            if _ip_cnt != _cp_cnt:
                                self.error("[I-3] Class '" + c.name + "': method '" + _cmeth.name + "' has " + str(_cp_cnt) + " parameter(s) but interface '" + _ifc_nm + "' requires " + str(_ip_cnt) + ".\n      FIX: Match the parameter list in '" + _ifc_nm + "' exactly.")
                        _cm_i = _cm_i + 1
                    if not _found:
                        mut _sig = "pub def " + _imeth.name + "(self"
                        mut _pi = 0
                        while _pi < _imeth.params.len:
                            mut _p = _imeth.params.get(_pi)
                            if _p.name != "self":
                                mut _pty = "int"
                                if _p.ty as usize != 0 as usize: _pty = _p.ty.read().name
                                _sig = _sig + ", " + _p.name + ": " + _pty
                            _pi = _pi + 1
                        mut _iret2 = "void"
                        if _imeth.ret_ty as usize != 0 as usize: _iret2 = _imeth.ret_ty.read().name
                        _sig = _sig + ") -> " + _iret2 + ":"
                        self.error("[I-2] Class '" + c.name + "' implements '" + _ifc_nm + "' but is missing method '" + _imeth.name + "'.\n      FIX: Add to 'extend " + c.name + ":'  " + _sig)
                    _im_i = _im_i + 1
            _ifc_i = _ifc_i + 1

        mut hc = HirClass()
        hc.name = c.name
        hc.generics = c.generics
        hc.fields = hfields
        hc.methods = hmethods
        hc.base_classes = c.base_classes
        hc.iface_names = c.iface_names
        hc.iface_targs = c.iface_targs
        hc.decorators = c.decorators
        hc.is_public = c.is_public
        hc.is_class = c.is_class

        self.current_class_name = ""
        self.current_region_params = Vec[str].init(0)
        return hc

    pub def lower_enum(self, e: EnumDef) -> HirEnum:
        self.current_class_name = e.name
        self.current_region_params = e.region_params
        mut hvariants = Vec[HirVariant].init(4)
        mut i = 0
        while i < e.variants.len:
            mut v = e.variants.get(i)
            mut hfields = Vec[HirParam].init(4)
            mut j = 0
            while j < v.fields.len:
                mut p = v.fields.get(j)
                # [L-2] A variant payload written `ref T from r` may only name a
                # region declared on the enum (`enum E from r`). Rejects a typo'd
                # region — never safe code; ARC keeps real borrows safe regardless.
                if self.strict_mode and p.ty as usize != 0 as usize:
                    mut _vty = p.ty.read()
                    mut _vri = 0
                    while _vri < _vty.from_regions.len:
                        mut _vrn = _vty.from_regions.get(_vri)
                        mut _vrok = false
                        mut _vrk = 0
                        while _vrk < e.region_params.len:
                            if e.region_params.get(_vrk) == _vrn: _vrok = true
                            _vrk = _vrk + 1
                        if not _vrok:
                            self.current_line = e.line
                            self.error("[L-2] region source '" + _vrn + "' in variant '" + v.name + "' of enum '" + e.name + "' is not a region parameter.\n      FIX: declare 'enum " + e.name + " from " + _vrn + ":'.")
                        _vri = _vri + 1
                mut hp = HirParam()
                hp.name = p.name
                # Tuple-variant fields written as a bare type (e.g. `Err(str)`)
                # parse as an unnamed param: `p.name` holds the type name and
                # `p.ty` is null. Recover the real type from `p.name` instead
                # of defaulting to "int" (which silently broke str/bool/etc).
                mut p_ty = AstType.init(p.name)
                if p.ty as usize != 0 as usize: p_ty = p.ty.read()
                hp.ty = p_ty
                hfields.push(hp)
                j = j + 1
                
            mut hv = HirVariant()
            hv.name = v.name
            hv.fields = hfields
            hvariants.push(hv)
            i = i + 1
            
        mut hmethods = Vec[HirFunction].init(4)
        i = 0
        while i < e.methods.len:
            mut hm = self.lower_func(e.methods.get(i))
            hmethods.push(hm)
            i = i + 1
            
        mut he = HirEnum()
        he.name = e.name
        he.generics = e.generics       # was never set -> NULL vec (crashed .len readers)
        he.variants = hvariants
        he.methods = hmethods
        he.iface_names = e.iface_names
        he.decorators = e.decorators
        he.is_public = e.is_public

        self.current_class_name = ""
        self.current_region_params = Vec[str].init(0)
        return he

    pub def lower_interface(self, i_def: InterfaceDef) -> HirInterface:
        self.current_region_params = i_def.region_params
        mut hmethods = Vec[HirFunction].init(4)
        mut i = 0
        while i < i_def.methods.len:
            mut hm = self.lower_func(i_def.methods.get(i))
            hmethods.push(hm)
            i = i + 1

        mut hi = HirInterface()
        hi.name = i_def.name
        hi.generics = i_def.generics
        hi.methods = hmethods
        self.current_region_params = Vec[str].init(0)
        return hi

    # Mark any `str`/collection local passed as a call/method-call argument in
    # this (lowered) statement as "escaped" (excluded from auto-drop) - see
    # mark_escaped_str_args. Shared by lower_block and the `do:` lowering.
    pub def apply_escape_marks(self, _hs: Pointer[HirStmt]):
        match _hs.read():
            case HirStmt.SExpr(_es_e):
                self.mark_escaped_str_args(_es_e)
                self.mark_escaped_coll_args(_es_e)
            case HirStmt.SLet(_, _, _, _, _, _, _sl_v):
                self.mark_escaped_str_args(_sl_v)
                self.mark_coll_arg(_sl_v)
                self.mark_escaped_coll_args(_sl_v)
            case HirStmt.SAssign(_sa_t, _sa_v):
                self.mark_escaped_str_args(_sa_t)
                self.mark_escaped_str_args(_sa_v)
                self.mark_escaped_coll_args(_sa_t)
                self.mark_coll_arg(_sa_v)
                self.mark_escaped_coll_args(_sa_v)
            case HirStmt.SReturn(_sr_e):
                self.mark_escaped_str_args(_sr_e)
                self.mark_coll_arg(_sr_e)
                self.mark_escaped_coll_args(_sr_e)
            case HirStmt.SIf(_si_c, _, _):
                self.mark_escaped_str_args(_si_c)
                self.mark_escaped_coll_args(_si_c)
            case HirStmt.SWhile(_sw_c, _):
                self.mark_escaped_str_args(_sw_c)
                self.mark_escaped_coll_args(_sw_c)
            case HirStmt.SFor(_, _sf_iter, _):
                self.mark_escaped_coll_args(_sf_iter)
            case HirStmt.SForUnpack(_, _sfu_iter, _):
                self.mark_escaped_coll_args(_sfu_iter)
            case _: pass

    pub def lower_block(self, b: Block) -> HirBlock:
        mut hb = HirBlock.init()
        mut i = 0
        while i < b.stmts.len:
            mut orig_ptr = b.stmts.get(i)
            mut _hs = self.lower_stmt(orig_ptr)
            self.apply_escape_marks(_hs)
            # Auto-drop: inject SAutoDrop stmts for all currently-open scopes
            # right before a control-transfer statement, so owned locals are
            # freed on every exit path (not just normal fall-through).
            if orig_ptr as usize != 0 as usize:
                match orig_ptr.read():
                    case Stmt.SReturn(_):
                        # `return EXPR` transfers ownership of any directly-returned
                        # local to the caller, and may also READ other droppable
                        # locals (e.g. `return a + b`). Exclude every local
                        # referenced by the (lowered) return expression from this
                        # exit point's auto-drops, so a buffer isn't released
                        # before it's read; such locals simply leak on this path
                        # instead of risking a use-after-free.
                        mut ret_excl = Vec[str].init(2)
                        match _hs.read():
                            case HirStmt.SReturn(lowered_ret):
                                self.collect_idents(lowered_ret, ret_excl)
                            case _: pass
                        # Inside a closure, only drop the closure's own scopes (from its
                        # base up), never the enclosing function's locals — those are
                        # dropped at the real function exit and would otherwise double-free.
                        mut ret_from = 0
                        if self.fn_scope_base.len > 0:
                            ret_from = self.fn_scope_base.get(self.fn_scope_base.len - 1)
                        self.append_drops_from_excl_multi(hb, ret_from, ret_excl)
                    case Stmt.SBreak(_):
                        if self.loop_scope_base.len > 0:
                            self.append_drops_from(hb, self.loop_scope_base.get(self.loop_scope_base.len - 1))
                    case Stmt.SContinue:
                        if self.loop_scope_base.len > 0:
                            self.append_drops_from(hb, self.loop_scope_base.get(self.loop_scope_base.len - 1))
                    case _: pass
            hb.push(_hs)
            i = i + 1
        return hb

    pub def lower_stmt(self, s_ptr: Pointer[Stmt]) -> Pointer[HirStmt]:
        if s_ptr as usize == 0 as usize: return Pointer[HirStmt](0)
        s = s_ptr.read()
        match s:
            case Stmt.SExpr(e):
                mut h_s_expr = box_hirstmt(HirStmt.SExpr(self.lower_expr(e)))
                # Rule T-4: Result returned by throws-function must be handled
                if e as usize != 0 as usize:
                    match e.read():
                        case Expr.ECall(callee, args):
                            if callee as usize != 0 as usize:
                                match callee.read():
                                    case Expr.EIdent(fn_name):
                                        mut fn_sym = self.resolve(fn_name)
                                        if fn_sym.kind == SymbolKind.SFunction and fn_sym.ty.read().name == "Result":
                                            self.error("[T-4] '" + fn_name + "()' returns a Result and its error must be handled. FIX: Assign the result and match on it, use '?' to propagate, or '_ = " + fn_name + "(...)' to explicitly discard.")
                                    case _: pass
                        case _: pass
                return h_s_expr
            case Stmt.SReturn(e):
                # [L-3] (outlives, opt-in --strict): a borrow-returning function
                # `-> ref str from r` that returns a freshly-built concat is returning
                # OWNED data, not a borrow of region r — under zero-copy elision that
                # would dangle. Sound (a `+` concat is unambiguously fresh heap, never
                # a borrow). Off by default (ARC keeps it safe → lifetimes stay
                # optional); only flagged under --strict for Rust-model checking.
                if self.strict_mode and self.current_func_ret_borrow_str and e as usize != 0 as usize:
                    match e.read():
                        case Expr.EBinOp(l3_op, _, _):
                            if l3_op == "+":
                                self.error("[L-3] borrow-returning function returns a freshly-built string (owned), not a borrow of region '" + self.current_func_ret_from + "'.\n      FIX: return a slice/view of the region source, or change the return type to a plain owned 'str'.")
                        case Expr.EIdent(l3_nm):
                            mut l3_sym = self.resolve(l3_nm)
                            if l3_sym.name != "":
                                # Effective region of the returned value: a parameter
                                # shares its own region; a local inherits its tracked one.
                                mut l3_eff = ""
                                if l3_sym.is_param:
                                    l3_eff = l3_nm
                                else:
                                    l3_eff = l3_sym.borrows_region
                                if l3_eff == "@owned":
                                    self.error("[L-3] borrow-returning function returns '" + l3_nm + "', a freshly-built string (owned), not a borrow of region '" + self.current_func_ret_from + "'.\n      FIX: return a slice/view of the region source, or change the return type to a plain owned 'str'.")
                                elif l3_eff != "" and self.current_func_ret_regions.len > 0:
                                    # [L-4] wrong region: returns a borrow of region `l3_eff`,
                                    # but the return is declared `from <other>`. Covers direct
                                    # params AND via-local (`mut w = b; return w`).
                                    mut l3_in = false
                                    mut l3ri = 0
                                    while l3ri < self.current_func_ret_regions.len:
                                        if self.current_func_ret_regions.get(l3ri) == l3_eff:
                                            l3_in = true
                                        l3ri = l3ri + 1
                                    # `where` enforcement: a `where l3_eff outlives D` bound for
                                    # a declared region D means l3_eff is longer-lived, so its
                                    # borrow is valid for D's scope — accept the return.
                                    if not l3_in:
                                        mut l3di = 0
                                        while l3di < self.current_func_ret_regions.len:
                                            if self.region_outlives(l3_eff, self.current_func_ret_regions.get(l3di)):
                                                l3_in = true
                                            l3di = l3di + 1
                                    if not l3_in:
                                        self.error("[L-4] borrow-returning function returns a borrow of region '" + l3_eff + "', but its return is declared 'from " + self.current_func_ret_from + "'.\n      FIX: add '" + l3_eff + "' to the 'from' list, declare 'where " + l3_eff + " outlives " + self.current_func_ret_from + "', or return a borrow of a declared region.")
                        case _: pass
                # Gap 1: [L-1] escape check - returning a LOCAL-region Pointer without 'from' annotation
                if e as usize != 0 as usize and not self.in_unsafe and self.current_func_ret_from == "":
                    match e.read():
                        case Expr.EIdent(ret_name):
                            mut ret_sym = self.resolve(ret_name)
                            if ret_sym.name != "" and ret_sym.ptr_region == 0:
                                if ret_sym.ty as usize != 0 as usize:
                                    if ret_sym.ty.read().name == "Pointer":
                                        self.error("[L-1] '" + ret_name + "' is a local Pointer that may not outlive this function call. Returning it is unsafe.\n      FIX: Annotate the return type with 'from <param>' if the pointer borrows from a parameter, or wrap the allocation in 'unsafe:' if it is heap-allocated.")
                        case _: pass
                return box_hirstmt(HirStmt.SReturn(self.lower_expr(e)))
            case Stmt.SLet(name, ownership, is_mut, is_const, is_shared, ty_ptr, val_ptr):
                # Rule M-7: none must not be assigned to a non-Optional type
                if ty_ptr as usize != 0 as usize and val_ptr as usize != 0 as usize:
                    match val_ptr.read():
                        case Expr.ELitNone:
                            mut m7_ty_name = ty_ptr.read().name
                            if m7_ty_name != "Option" and m7_ty_name != "None" and m7_ty_name != "void" and m7_ty_name != "" and m7_ty_name != "Pointer":
                                self.error("[M-7] Cannot assign 'none' to '" + name + "' which has type '" + m7_ty_name + "'. Only Option[T] can hold 'none'. FIX: Use 'Option[" + m7_ty_name + "]' as the type, or give '" + name + "' a real initial value.")
                        case _: pass
                mut ty = AstType.init("void")
                if ty_ptr as usize != 0 as usize: ty = ty_ptr.read()
                mut hval = self.lower_expr(val_ptr)
                if ty.name != "void" and ty.name != "None": hval = self._patch_empty_dict_hint(hval, ty)
                if ty.name == "void" or ty.name == "None": ty = hir_expr_type(hval)
                # plain-identifier RHS of non-primitive type = ownership move
                # Skip for shared lets (shared = clone via refcount, not a move)
                # plain variable-to-variable move (mut newvar = old_obj)
                # Field/index access is NOT a move in Tauraro (C value semantics copy fields)
                if val_ptr as usize != 0 as usize and not is_shared:
                    match val_ptr.read():
                        case Expr.EIdent(m1_src):
                            mut m1_sym = self.resolve(m1_src)
                            mut m1_ty = m1_sym.ty.read()
                            # Shared + primitive + Copy-class sources are exempt from move tracking
                            if not self.is_primitive(m1_ty) and not self.is_copy_class(m1_ty.name) and m1_sym.name != "" and not m1_sym.is_shared:
                                self.check_not_moved(m1_src, m1_ty.name)
                                self.check_no_active_borrows(m1_src, m1_ty.name)
                                self.mark_moved(m1_src)
                        case _: pass
                self.declare(name, SymbolKind.SVariable, box_asttype(ty), is_mut)
                # A `shared` local: record is_shared on the symbol so the Shared[T]
                # control methods (clone/downgrade/drop) resolve on it and its drop is
                # routed to _tr_shared_drop.
                if is_shared and self.scopes.len > 0:
                    mut _sh_scope = self.scopes.get(self.scopes.len - 1)
                    if _sh_scope.variables.contains(name):
                        mut _sh_sym = _sh_scope.variables.get(name)
                        _sh_sym.is_shared = true
                        _sh_scope.variables.insert(name, _sh_sym)
                # [L-3/L-4] region derivation: record which region this local derives
                # from (its initial value).
                if val_ptr as usize != 0 as usize:
                    self.set_borrows_region(name, self.compute_region(val_ptr))
                # Outlives engine (cross-fn edge): `mut r = f(args)` where f returns
                # `ref .. from p` (a borrow) OR a borrow-HOLDING struct `T from p` (Gap 3 —
                # e.g. `mut v = str_view(text, ..)` returning `StrView from text`) makes r
                # borrow args[p_index]. Record (r, that-arg) so the MIR liveness check
                # covers it (so mutating the source while r is live is rejected).
                if val_ptr as usize != 0 as usize:
                    match val_ptr.read():
                        case Expr.ECall(ce_callee, ce_args):
                            if ce_callee as usize != 0 as usize:
                                match ce_callee.read():
                                    case Expr.EIdent(ce_fn):
                                        mut ce_sym = self.resolve(ce_fn)
                                        if ce_sym.name != "" and ce_sym.ty as usize != 0 as usize:
                                            mut ce_ret = ce_sym.ty.read()
                                            if (ce_ret.is_borrow or ce_ret.from_regions.len > 0) and ce_ret.from_index >= 0 and ce_ret.from_index < ce_args.len:
                                                match ce_args.get(ce_ret.from_index).read():
                                                    case Expr.EIdent(ce_src):
                                                        self.cur_func_borrowers.push(name)
                                                        self.cur_func_sources.push(ce_src)
                                                    case _: pass
                                    case _: pass
                        case _: pass
                # Gap 1: infer ptr_region for Pointer-typed variables.
                # Conservative rule: any call-expression RHS is assumed HEAP (functions may alloc).
                # Only a variable without initializer OR initialized with Pointer[T](0) is LOCAL.
                if val_ptr as usize != 0 as usize and ty.name == "Pointer":
                    mut heap_rhs = false
                    match val_ptr.read():
                        case Expr.ECall(_, _): heap_rhs = true
                        case Expr.EMethodCall(_, _, _): heap_rhs = true
                        case _: pass
                    if heap_rhs:
                        if self.scopes.len > 0:
                            mut alloc_scope = self.scopes.get(self.scopes.len - 1)
                            if alloc_scope.variables.contains(name):
                                mut alloc_sym = alloc_scope.variables.get(name)
                                alloc_sym.ptr_region = 1  # HEAP (function call result)
                                alloc_scope.variables.insert(name, alloc_sym)
                # variable declared without a value - mark as uninitialised, UNLESS it
                # is a fixed-size array `[T; N]`, which zero-initializes on declaration.
                mut _decl_fixed_arr = false
                if ty_ptr as usize != 0 as usize:
                    if ty_ptr.read().name == "Array" and ty_ptr.read().array_size > 0: _decl_fixed_arr = true
                if val_ptr as usize == 0 as usize and not _decl_fixed_arr:
                    if self.scopes.len > 0:
                        mut pd_scope = self.scopes.get(self.scopes.len - 1)
                        if pd_scope.variables.contains(name):
                            mut pd_sym = pd_scope.variables.get(name)
                            pd_sym.is_init = false
                            pd_scope.variables.insert(name, pd_sym)
                # a local that BORROWS a collection element ALIASES it and does
                # NOT own it. RHS forms: `coll.get(i)` / `.first()` / `.last()`, or `coll[i]`.
                # For a CLASS-instance element this is critical for auto-drop soundness: the
                # element's str fields belong to the collection, so dropping the borrow would
                # free live data (UAF — this is what corrupted f-string format specs read from
                # `parts.get(i)`). Mark the local "@borrowed" so is_droppable_sym skips it.
                if val_ptr as usize != 0 as usize:
                    mut pc_cont_nm = ""
                    mut pc_meth = ""
                    match val_ptr.read():
                        case Expr.EMethodCall(pc_obj, pc_m, _):
                            pc_meth = pc_m
                            match pc_obj.read():
                                case Expr.EIdent(pc_src): pc_cont_nm = pc_src
                                case _: pass
                        case Expr.EIndex(pc_iobj, _):
                            pc_meth = "get"
                            match pc_iobj.read():
                                case Expr.EIdent(pc_isrc): pc_cont_nm = pc_isrc
                                case _: pass
                        case _: pass
                    if pc_cont_nm != "" and (pc_meth == "get" or pc_meth == "first" or pc_meth == "last"):
                        mut pc_cont_sym = self.resolve(pc_cont_nm)
                        mut pc_cont_ty = pc_cont_sym.ty.read()
                        mut pc_ctn = pc_cont_ty.name
                        if pc_ctn == "Mutex" or pc_ctn == "RwLock":
                            # `mut x = mutex.get()` / `rwlock.get()` BORROWS the guarded
                            # value — the lock OWNS it. Auto-dropping x would free the
                            # guarded content (e.g. Dict_free_objval on a Mutex[Map]'s Map,
                            # or _tr_obj_release on a Mutex[Class]'s instance) → UAF on the
                            # next .get(). Mark it @borrowed so is_droppable_sym skips it.
                            self.set_borrows_region(name, "@borrowed")
                        elif pc_ctn == "Vec" or pc_ctn == "List" or pc_ctn == "Dict" or pc_ctn == "Map" or pc_ctn == "Set":
                            mut pc_elem_ty = hir_expr_type(hval).name
                            # A @value_type element is returned BY VALUE (a copy), so
                            # `x = d.get(k)` is NOT a borrow into the container.
                            mut pc_is_vt = self.classes.contains(pc_elem_ty) and not self.classes.get(pc_elem_ty).is_class
                            if (not self.is_primitive(hir_expr_type(hval))) and not pc_is_vt:
                                self.container_borrows.insert(pc_cont_nm, name)
                                # Class-instance element borrow: must NOT be auto-dropped.
                                # (str/collection elements are returned retained by .get, so
                                # they remain owned and droppable as usual.)
                                if pc_elem_ty != "str" and pc_elem_ty != "Vec" and pc_elem_ty != "List" and pc_elem_ty != "Dict" and pc_elem_ty != "Map" and pc_elem_ty != "Set":
                                    self.set_borrows_region(name, "@borrowed")
                return box_hirstmt(HirStmt.SLet(name, ownership, is_mut, is_const, is_shared, ty, hval))
            case Stmt.SAssign(target, val):
                self.in_assign_target = true
                mut htgt = self.lower_expr(target)
                self.in_assign_target = false
                mut hv = self.lower_expr(val)
                hv = self._patch_empty_dict_hint(hv, hir_expr_type(htgt))
                # [L-5] (--strict): storing freshly-built (owned) data into a `ref`
                # (borrow) field — the field is meant to hold a borrow, not own.
                if self.strict_mode and target as usize != 0 as usize:
                    match target.read():
                        case Expr.EPropAccess(l5_obj, l5_field):
                            if self.compute_region(val) == "@owned" and self.field_is_borrow(l5_obj, l5_field):
                                self.error("[L-5] storing a freshly-built (owned) string into the borrow field '" + l5_field + "' (declared 'ref').\n      FIX: store a borrow of the field's region, or make the field a plain owned 'str'.")
                        case _: pass
                # First assignment to an undeclared name (bare `name = expr`, no
                # `mut`): implicitly declare it with the inferred type so its
                # methods/fields resolve (e.g. `obj = Foo(); obj.bar()`).
                if target as usize != 0 as usize:
                    match target.read():
                        case Expr.EIdent(sa_decl_name):
                            # [L-3/L-4] region derivation: a reassignment refreshes the
                            # region — `w = a + b` → @owned, `w = b` → region b. Keeps the
                            # tag sound across reassignment.
                            self.set_borrows_region(sa_decl_name, self.compute_region(val))
                            mut sa_existing = self.resolve(sa_decl_name)
                            if sa_existing.name == "":
                                # Bare `name = expr` with no prior declaration and no `mut`:
                                # declares an IMMUTABLE binding (Rust-like default).
                                self.declare(sa_decl_name, SymbolKind.SVariable, box_asttype(hir_expr_type(hv)), false)
                            elif self.scopes.len > 0 and self.is_global_not_local(sa_decl_name) and not sa_existing.is_mut:
                                # Inside a function, assigning to a name that only
                                # exists as an IMMUTABLE global introduces a fresh
                                # LOCAL that shadows the global (Python-like).
                                # (A `mut` global stays mutable from functions and
                                # falls through to the normal-assignment path.)
                                # Emitted as SLet so codegen declares a new C local;
                                # C scoping makes earlier reads see the global.
                                self.declare(sa_decl_name, SymbolKind.SVariable, box_asttype(hir_expr_type(hv)), true)
                                self.mark_init(sa_decl_name)
                                return box_hirstmt(HirStmt.SLet(sa_decl_name, Ownership.Own, true, false, false, hir_expr_type(hv), hv))
                            elif sa_existing.kind == SymbolKind.SVariable and not sa_existing.is_mut:
                                self.error("[M-8] Cannot assign to '" + sa_decl_name + "' a second time because it is immutable.\n      FIX: Declare it as 'mut " + sa_decl_name + " = ...' if it needs to change.")
                        case _: pass
                # SAssign: plain-variable RHS of non-primitive non-Copy type = ownership move
                # Lower first (EIdent checks current is_moved), then mark moved for subsequent uses.
                # SAssign is guarded by branch snapshots (Fix 1) so sibling else-branches correctly
                # roll back and re-check - no false positives across if/else chains.
                # Skip for generic type parameters (unknown type = possibly Copy; conservative).
                if val as usize != 0 as usize:
                    match val.read():
                        case Expr.EIdent(sa_src):
                            mut sa_sym = self.resolve(sa_src)
                            mut sa_ty = sa_sym.ty.read()
                            mut sa_is_known = self.classes.contains(sa_ty.name) or self.enums.contains(sa_ty.name)
                            if sa_is_known and not self.is_primitive(sa_ty) and not self.is_copy_class(sa_ty.name) and sa_sym.name != "" and not sa_sym.is_shared:
                                self.check_no_active_borrows(sa_src, sa_ty.name)
                                self.mark_moved(sa_src)
                        case _: pass
                # mark assignment target as initialised after any assignment
                if target as usize != 0 as usize:
                    match target.read():
                        case Expr.EIdent(pd_tgt): self.mark_init(pd_tgt)
                        case _: pass
                # clear container borrow when the borrowing variable is reassigned
                if target as usize != 0 as usize:
                    match target.read():
                        case Expr.EIdent(pc_tgt): self.clear_container_borrow(pc_tgt)
                        case _: pass
                return box_hirstmt(HirStmt.SAssign(htgt, hv))
            case Stmt.SIf(cond, then_b, elifs, else_b):
                # Rule T-5: numeric variable used directly as boolean condition
                if cond as usize != 0 as usize:
                    match cond.read():
                        case Expr.EIdent(t5_name):
                            mut t5_sym = self.resolve(t5_name)
                            mut t5_ty = t5_sym.ty.read().name
                            if t5_ty == "int" or t5_ty == "i64" or t5_ty == "i32" or t5_ty == "float" or t5_ty == "f64":
                                self.error("[T-5] '" + t5_name + "' is a number (" + t5_ty + ") and cannot be used as an 'if' condition. FIX: Write 'if " + t5_name + " != 0:' to explicitly check for non-zero.")
                        case _: pass
                # Fix 1+4: branch-scoped snapshot - save parent capturing state
                mut si_outer_cap_m = self.capturing_moves
                mut si_outer_buf_m = self.branch_moved_buf
                mut si_outer_cap_i = self.capturing_inits
                mut si_outer_buf_i = self.branch_init_buf
                # -- Then branch (with fresh capture buffers) --
                self.capturing_moves = true
                self.capturing_inits = true
                self.branch_moved_buf = Vec[str].init(4)
                self.branch_init_buf = Vec[str].init(4)
                mut hcond = self.lower_expr(cond)
                self.block_depth = self.block_depth + 1
                self.open_block()
                mut hthen = self.lower_block(then_b)
                self.block_depth = self.block_depth - 1
                self.close_block()
                mut si_then_moved = self.branch_moved_buf
                mut si_then_inited = self.branch_init_buf
                # Roll back then-branch moves/inits so else-branch sees clean slate
                mut si_uti = 0
                while si_uti < si_then_moved.len:
                    self.unmark_moved(si_then_moved.get(si_uti))
                    si_uti = si_uti + 1
                mut si_uii = 0
                while si_uii < si_then_inited.len:
                    self.unmark_init(si_then_inited.get(si_uii))
                    si_uii = si_uii + 1
                # -- Else/elif branch (fresh capture buffers, same capturing=true) --
                self.branch_moved_buf = Vec[str].init(4)
                self.branch_init_buf = Vec[str].init(4)
                mut helse = HirBlock.init()
                self.block_depth = self.block_depth + 1
                self.open_block()
                if elifs.len > 0:
                    # Each elif/else body must get its OWN block id, not share
                    # the chain's outer one: sibling branches reuse local names
                    # (the lexer's three `mut inner = ...` arms), and the scope's
                    # variables map is keyed by NAME, so a shared id makes a str
                    # local declared in one arm look "visible" (block_stack
                    # still holds the shared id) at another arm's early return -
                    # emitting a _tr_str_release of a C variable not in that
                    # arm's scope. Per-branch open/close blocks keep each arm's
                    # decl_block_id distinct so it's only dropped within its arm.
                    self.open_block()
                    mut base_else = self.lower_block(else_b)
                    self.close_block()
                    mut chain = base_else
                    mut k = elifs.len - 1
                    while k >= 0:
                        mut elif_c = elifs.get(k)
                        mut elif_cond = self.lower_expr(elif_c.cond)
                        self.open_block()
                        mut elif_body = self.lower_block(elif_c.body.read())
                        self.close_block()
                        mut nested = HirBlock.init()
                        nested.push(box_hirstmt(HirStmt.SIf(elif_cond, elif_body, chain)))
                        chain = nested
                        k = k - 1
                    helse = chain
                else:
                    helse = self.lower_block(else_b)
                self.block_depth = self.block_depth - 1
                self.close_block()
                mut si_else_moved = self.branch_moved_buf
                mut si_else_inited = self.branch_init_buf
                # Roll back else-branch moves/inits
                mut si_uei = 0
                while si_uei < si_else_moved.len:
                    self.unmark_moved(si_else_moved.get(si_uei))
                    si_uei = si_uei + 1
                mut si_uei2 = 0
                while si_uei2 < si_else_inited.len:
                    self.unmark_init(si_else_inited.get(si_uei2))
                    si_uei2 = si_uei2 + 1
                # Restore parent capturing state before applying merged results
                self.capturing_moves = si_outer_cap_m
                self.branch_moved_buf = si_outer_buf_m
                self.capturing_inits = si_outer_cap_i
                self.branch_init_buf = si_outer_buf_i
                # A branch that ends in return/break/continue never reaches the
                # fall-through code after this 'if', so its moves/inits/frees
                # must not be merged into the continuation state at all - only
                # the surviving (non-jumping) branch's effects apply, and they
                # apply definitively (not "maybe") since it's the only path left.
                mut si_then_jumps = self.block_ends_in_jump(hthen)
                mut si_else_jumps = self.block_ends_in_jump(helse)
                if si_then_jumps and not si_else_jumps:
                    mut si_ei0 = 0
                    while si_ei0 < si_else_moved.len:
                        self.mark_moved(si_else_moved.get(si_ei0))
                        si_ei0 = si_ei0 + 1
                    mut si_ini0 = 0
                    while si_ini0 < si_else_inited.len:
                        self.mark_init(si_else_inited.get(si_ini0))
                        si_ini0 = si_ini0 + 1
                elif si_else_jumps and not si_then_jumps:
                    mut si_mi0 = 0
                    while si_mi0 < si_then_moved.len:
                        self.mark_moved(si_then_moved.get(si_mi0))
                        si_mi0 = si_mi0 + 1
                    mut si_ti0 = 0
                    while si_ti0 < si_then_inited.len:
                        self.mark_init(si_then_inited.get(si_ti0))
                        si_ti0 = si_ti0 + 1
                elif si_then_jumps and si_else_jumps:
                    pass # no fall-through; nothing to merge
                else:
                    # -- Merge move state: both->definitive, one-only->maybe --
                    mut si_mi = 0
                    while si_mi < si_then_moved.len:
                        mut si_mn = si_then_moved.get(si_mi)
                        if self.vec_str_contains(si_else_moved, si_mn):
                            self.mark_moved(si_mn)
                        else:
                            self.mark_maybe_moved(si_mn)
                        si_mi = si_mi + 1
                    mut si_ei = 0
                    while si_ei < si_else_moved.len:
                        mut si_en = si_else_moved.get(si_ei)
                        if not self.vec_str_contains(si_then_moved, si_en):
                            self.mark_maybe_moved(si_en)
                        si_ei = si_ei + 1
                    # -- Merge init state: both->definitive, one-only->maybe --
                    mut si_ini = 0
                    while si_ini < si_then_inited.len:
                        mut si_inn = si_then_inited.get(si_ini)
                        if self.vec_str_contains(si_else_inited, si_inn):
                            self.mark_init(si_inn)
                        else:
                            self.mark_maybe_init(si_inn)
                        si_ini = si_ini + 1
                return box_hirstmt(HirStmt.SIf(hcond, hthen, helse))
            case Stmt.SWhile(cond, body, decorators):
                mut sw_cond = self.lower_expr(cond)
                # Fix 1+4: loop body might not run -> all moves/inits are "maybe"
                mut sw_outer_cap_m = self.capturing_moves
                mut sw_outer_buf_m = self.branch_moved_buf
                mut sw_outer_cap_i = self.capturing_inits
                mut sw_outer_buf_i = self.branch_init_buf
                self.capturing_moves = true
                self.capturing_inits = true
                self.branch_moved_buf = Vec[str].init(4)
                self.branch_init_buf = Vec[str].init(4)
                # SWhile bodies share the enclosing scope (no enter_scope/exit_scope),
                # so push a base equal to the current depth: break/continue inside
                # the loop drain nothing extra (no per-iteration scope to drain).
                self.loop_scope_base.push(self.scopes.len)
                self.block_depth = self.block_depth + 1
                self.open_block()
                mut sw_block_id = self.block_stack.get(self.block_stack.len - 1)
                mut sw_body = self.lower_block(body)
                self.append_block_local_drops(sw_body, sw_block_id)
                self.block_depth = self.block_depth - 1
                self.close_block()
                self.loop_scope_base.pop()
                mut sw_loop_moved = self.branch_moved_buf
                mut sw_loop_inited = self.branch_init_buf
                self.capturing_moves = sw_outer_cap_m
                self.branch_moved_buf = sw_outer_buf_m
                self.capturing_inits = sw_outer_cap_i
                self.branch_init_buf = sw_outer_buf_i
                mut sw_mi = 0
                while sw_mi < sw_loop_moved.len:
                    self.unmark_moved(sw_loop_moved.get(sw_mi))
                    self.mark_maybe_moved(sw_loop_moved.get(sw_mi))
                    sw_mi = sw_mi + 1
                mut sw_ii = 0
                while sw_ii < sw_loop_inited.len:
                    self.unmark_init(sw_loop_inited.get(sw_ii))
                    self.mark_maybe_init(sw_loop_inited.get(sw_ii))
                    sw_ii = sw_ii + 1
                return box_hirstmt(HirStmt.SWhile(sw_cond, sw_body))
            case Stmt.SFor(var, iter, body, decorators, for_is_ref):
                self.enter_scope()
                mut h_iter_for = self.lower_expr(iter)
                mut var_ty_for = AstType.init("int")
                mut iter_hn = hir_expr_type(h_iter_for).name
                mut iter_hal = hir_expr_type(h_iter_for).args.len
                if (iter_hn == "List" or iter_hn == "Vec") and iter_hal > 0:
                    var_ty_for = hir_expr_type(h_iter_for).args.get(0).read()
                elif iter_hn == "Chan" and iter_hal > 0:
                    var_ty_for = hir_expr_type(h_iter_for).args.get(0).read()
                elif iter_hn == "str":
                    var_ty_for = AstType.init("char")
                self.declare(var, SymbolKind.SVariable, box_asttype(var_ty_for), false)
                # Gap 2: `for ref x in items` — x borrows each element, so the body borrows
                # the collection. Record the edge so the borrow checker (B-2) rejects
                # mutating `items` inside the loop (e.g. `items.push(..)` while iterating).
                if for_is_ref:
                    match iter.read():
                        case Expr.EIdent(for_coll):
                            self.cur_func_borrowers.push(var)
                            self.cur_func_sources.push(for_coll)
                        case _: pass
                # Fix 1+4: for-loop body might not run -> moves/inits are "maybe"
                mut sf_outer_cap_m = self.capturing_moves
                mut sf_outer_buf_m = self.branch_moved_buf
                mut sf_outer_cap_i = self.capturing_inits
                mut sf_outer_buf_i = self.branch_init_buf
                self.capturing_moves = true
                self.capturing_inits = true
                self.branch_moved_buf = Vec[str].init(4)
                self.branch_init_buf = Vec[str].init(4)
                self.loop_scope_base.push(self.scopes.len - 1)
                mut sf_body = self.lower_block(body)
                self.loop_scope_base.pop()
                mut sf_loop_moved = self.branch_moved_buf
                mut sf_loop_inited = self.branch_init_buf
                self.capturing_moves = sf_outer_cap_m
                self.branch_moved_buf = sf_outer_buf_m
                self.capturing_inits = sf_outer_cap_i
                self.branch_init_buf = sf_outer_buf_i
                mut sf_mi = 0
                while sf_mi < sf_loop_moved.len:
                    self.unmark_moved(sf_loop_moved.get(sf_mi))
                    self.mark_maybe_moved(sf_loop_moved.get(sf_mi))
                    sf_mi = sf_mi + 1
                mut sf_ii = 0
                while sf_ii < sf_loop_inited.len:
                    self.unmark_init(sf_loop_inited.get(sf_ii))
                    self.mark_maybe_init(sf_loop_inited.get(sf_ii))
                    sf_ii = sf_ii + 1
                self.finalize_scope_drops(sf_body)
                mut hstmt = box_hirstmt(HirStmt.SFor(var, h_iter_for, sf_body))
                self.exit_scope()
                return hstmt
            case Stmt.SForUnpack(vars, iter, body):
                self.enter_scope()
                mut h_iter_fu = self.lower_expr(iter)
                # Infer per-variable types from the iterator kind
                mut fu_tys = Vec[AstType].init(vars.len)
                mut fu_ti = 0
                while fu_ti < vars.len:
                    fu_tys.push(AstType.init("int"))
                    fu_ti = fu_ti + 1
                match h_iter_fu.read():
                    case HirExpr.ECall(fu_callee, fu_args, _):
                        match fu_callee.read():
                            case HirExpr.EIdent(fu_fn, _, _):
                                if fu_fn == "enumerate" and fu_args.len == 1 and vars.len >= 2:
                                    # var0=index(int), var1=element type of collection
                                    mut fu_col_ty_n = hir_expr_type(fu_args.get(0)).name
                                    mut fu_col_al = hir_expr_type(fu_args.get(0)).args.len
                                    if (fu_col_ty_n == "List" or fu_col_ty_n == "Vec") and fu_col_al > 0:
                                        fu_tys.set(1, hir_expr_type(fu_args.get(0)).args.get(0).read())
                                elif fu_fn == "zip" and fu_args.len == 2 and vars.len >= 2:
                                    # var0=elem type of a, var1=elem type of b
                                    mut fu_a_n = hir_expr_type(fu_args.get(0)).name
                                    mut fu_a_al = hir_expr_type(fu_args.get(0)).args.len
                                    mut fu_b_n = hir_expr_type(fu_args.get(1)).name
                                    mut fu_b_al = hir_expr_type(fu_args.get(1)).args.len
                                    if (fu_a_n == "List" or fu_a_n == "Vec") and fu_a_al > 0:
                                        fu_tys.set(0, hir_expr_type(fu_args.get(0)).args.get(0).read())
                                    if (fu_b_n == "List" or fu_b_n == "Vec") and fu_b_al > 0:
                                        fu_tys.set(1, hir_expr_type(fu_args.get(1)).args.get(0).read())
                            case _: pass
                    case HirExpr.EMethodCall(fu_obj, fu_meth, _, _):
                        if fu_meth == "items" and vars.len >= 2:
                            mut fu_dty_n = hir_expr_type(fu_obj).name
                            mut fu_dty_al = hir_expr_type(fu_obj).args.len
                            if (fu_dty_n == "Dict" or fu_dty_n == "Map") and fu_dty_al >= 2:
                                fu_tys.set(0, hir_expr_type(fu_obj).args.get(0).read())
                                fu_tys.set(1, hir_expr_type(fu_obj).args.get(1).read())
                    case _: pass
                mut vi_fu = 0
                while vi_fu < vars.len:
                    self.declare(vars.get(vi_fu), SymbolKind.SVariable, box_asttype(fu_tys.get(vi_fu)), false)
                    vi_fu = vi_fu + 1
                mut hblk_fu = self.lower_block(body)
                self.finalize_scope_drops(hblk_fu)
                self.exit_scope()
                return box_hirstmt(HirStmt.SForUnpack(vars, h_iter_fu, hblk_fu))
            case Stmt.SMatch(subj, arms):
                mut hsubj = self.lower_expr(subj)
                mut ex_ty_name = hir_expr_type(hsubj).name
                mut h_arms = Vec[HirMatchArm].init(4)
                mut ex_has_wild = false
                mut ex_covered = Vec[str].init(8)
                mut k = 0
                while k < arms.len:
                    mut arm = arms.get(k)
                    # Collect exhaustiveness info from the pattern
                    match arm.pat:
                        case Pattern.PWild: ex_has_wild = true
                        case Pattern.PBind(_): ex_has_wild = true
                        case Pattern.PVariant(_, ex_vn): ex_covered.push(ex_vn)
                        case Pattern.PVariantBind(_, ex_vn2, _): ex_covered.push(ex_vn2)
                        case Pattern.PVariantBindMany(_, ex_vn3, _): ex_covered.push(ex_vn3)
                        case Pattern.POr(ex_orpats):
                            # [E-3] A payload BIND inside an or-pattern is unsound: only one
                            # alternative matches, so the binder may be uninitialized.
                            mut ex_oi = 0
                            while ex_oi < ex_orpats.len:
                                match ex_orpats.get(ex_oi):
                                    case Pattern.PVariant(_, ex_ovn): ex_covered.push(ex_ovn)
                                    case Pattern.PVariantBind(_, ex_bvn, _):
                                        ex_covered.push(ex_bvn)
                                        self.error("[E-3] Payload binding '" + ex_ty_name + "." + ex_bvn + "(..)' is not allowed inside an or-pattern ('|').\n      FIX: Split the alternatives into separate 'case' arms, or match the variant without binding: 'case " + ex_ty_name + "." + ex_bvn + " | ...:'.")
                                    case Pattern.PVariantBindMany(_, ex_mvn, _):
                                        ex_covered.push(ex_mvn)
                                        self.error("[E-3] Payload binding '" + ex_ty_name + "." + ex_mvn + "(..)' is not allowed inside an or-pattern ('|').\n      FIX: Split the alternatives into separate 'case' arms, or match the variant without binding: 'case " + ex_ty_name + "." + ex_mvn + " | ...:'.")
                                    case _: pass
                                ex_oi = ex_oi + 1
                        case _: pass
                    self.enter_scope()
                    # Use the subject's type for PBind so `case x if x.method():` works.
                    mut _subj_ty = hir_expr_type(hsubj)
                    self.declare_pattern_binds_typed(arm.pat, _subj_ty)
                    mut h_arm = HirMatchArm.init(arm.pat, self.lower_block(arm.body.read()))
                    # Lower guard expression if present
                    if arm.guard as usize != 0 as usize:
                        h_arm.guard = self.lower_expr(arm.guard)
                    self.finalize_scope_drops(h_arm.body)
                    h_arms.push(h_arm)
                    self.exit_scope()
                    k = k + 1
                # [E-1] Exhaustiveness check - only for known enum types
                if not ex_has_wild and self.enums.contains(ex_ty_name):
                    mut ex_edef = self.enums.get(ex_ty_name)
                    mut ex_missing = Vec[str].init(4)
                    mut ex_vi = 0
                    while ex_vi < ex_edef.variants.len:
                        mut ex_vname = ex_edef.variants.get(ex_vi).name
                        if not ex_covered.contains(ex_vname):
                            ex_missing.push(ex_vname)
                        ex_vi = ex_vi + 1
                    if ex_missing.len > 0:
                        mut ex_msg = "[E-1] Non-exhaustive match on '" + ex_ty_name + "': missing variant"
                        if ex_missing.len > 1: ex_msg = ex_msg + "s"
                        ex_msg = ex_msg + ": "
                        mut ex_mi = 0
                        while ex_mi < ex_missing.len:
                            if ex_mi > 0: ex_msg = ex_msg + ", "
                            ex_msg = ex_msg + ex_missing.get(ex_mi)
                            ex_mi = ex_mi + 1
                        ex_msg = ex_msg + ".\n      FIX: Add a 'case " + ex_ty_name + ".VariantName:' arm for each missing variant, or add 'case _:' to handle all remaining cases."
                        self.error(ex_msg)
                return box_hirstmt(HirStmt.SMatch(hsubj, h_arms))
            case Stmt.STry(try_body, catches, finally_b):
                self.block_depth = self.block_depth + 1
                self.open_block()
                mut h_try_body = self.lower_block(try_body)
                mut h_catches = Vec[Pointer[HirCatchClause]].init(catches.len)
                mut k = 0
                while k < catches.len:
                    mut cc = catches.get(k).read()
                    mut hcc_val = HirCatchClause()
                    hcc_val.err_name = cc.err_name
                    hcc_val.err_type = AstType.init("str")
                    if cc.err_type as usize != 0 as usize: hcc_val.err_type = cc.err_type.read()
                    # Bind the `except E as e` variable so the catch body can use it
                    # (otherwise the [N-3] check would flag `e` as undefined).
                    if cc.err_name != "":
                        self.declare(cc.err_name, SymbolKind.SVariable, box_asttype(hcc_val.err_type), true)
                    hcc_val.body = self.lower_block(cc.body.read())
                    unsafe:
                        mut hcc = alloc[HirCatchClause](1)
                        hcc.write(hcc_val)
                        h_catches.push(hcc)
                    k = k + 1
                mut h_finally_b = self.lower_block(finally_b)
                self.block_depth = self.block_depth - 1
                self.close_block()
                return box_hirstmt(HirStmt.STry(h_try_body, h_catches, h_finally_b))
            case Stmt.SRaise(e): return box_hirstmt(HirStmt.SRaise(self.lower_expr(e)))
            case Stmt.SAssert(cond, msg): return box_hirstmt(HirStmt.SAssert(self.lower_expr(cond), self.lower_expr(msg)))
            case Stmt.SDefer(inner):
                return box_hirstmt(HirStmt.SDefer(self.lower_stmt(inner)))
            case Stmt.SWith(items, aliases, body):
                self.enter_scope()
                mut h_items = Vec[Pointer[HirExpr]].init(items.len)
                mut k = 0
                while k < items.len:
                    mut h_wi = self.lower_expr(items.get(k))
                    h_items.push(h_wi)
                    # Declare the alias so body can reference it
                    if k < aliases.len and aliases.get(k) != "":
                        mut wi_ty = hir_expr_type(h_wi)
                        self.declare(aliases.get(k), SymbolKind.SVariable, box_asttype(wi_ty), true)
                    k = k + 1
                mut h_with_body = self.lower_block(body)
                self.finalize_scope_drops(h_with_body)
                self.exit_scope()
                return box_hirstmt(HirStmt.SWith(h_items, aliases, h_with_body))
            case Stmt.SAsm(code, outputs, inputs, clobbers):
                return box_hirstmt(HirStmt.SAsm(code, outputs, inputs, clobbers))
            case Stmt.SSpawn(e):
                if not self.in_async_fn:
                    self.error("[C-5] 'spawn:' used outside an async function. FIX: Declare '" + self.current_func_name + "' as 'async def " + self.current_func_name + "(...)' to use spawn inside it.")
                mut spawn_lowered = self.lower_expr(e)
                self.check_spawn_sendable(spawn_lowered)
                return box_hirstmt(HirStmt.SSpawn(spawn_lowered))
            case Stmt.STaskGroup(body):
                if not self.in_async_fn:
                    self.error("[C-6] 'taskgroup:' used outside an async function. FIX: Declare '" + self.current_func_name + "' as 'async def " + self.current_func_name + "(...)' to use taskgroup inside it.")
                self.block_depth = self.block_depth + 1
                self.open_block()
                mut h_tg_body = self.lower_block(body)
                self.block_depth = self.block_depth - 1
                self.close_block()
                return box_hirstmt(HirStmt.STaskGroup(h_tg_body))
            case Stmt.SChanSelect(cs_cases):
                mut hcs_cases = Vec[Pointer[HirChanSelectArm]].init(cs_cases.len)
                mut csi2 = 0
                while csi2 < cs_cases.len:
                    mut arm = cs_cases.get(csi2).read()
                    mut harm = Pointer[HirChanSelectArm](0)
                    unsafe: harm = alloc[HirChanSelectArm](1)
                    mut harm_v = HirChanSelectArm()
                    harm_v.kind = arm.kind
                    harm_v.var_name = arm.var_name
                    if arm.chan_expr as usize != 0 as usize:
                        harm_v.chan_expr = self.lower_expr(arm.chan_expr)
                    else:
                        harm_v.chan_expr = Pointer[HirExpr](0)
                    if arm.val_expr as usize != 0 as usize:
                        harm_v.val_expr = self.lower_expr(arm.val_expr)
                    else:
                        harm_v.val_expr = Pointer[HirExpr](0)
                    if arm.timeout_ms as usize != 0 as usize:
                        harm_v.timeout_ms = self.lower_expr(arm.timeout_ms)
                    else:
                        harm_v.timeout_ms = Pointer[HirExpr](0)
                    # For recv arms, declare the binding variable
                    self.enter_scope()
                    if arm.kind == 0 and arm.var_name != "":
                        mut recv_ty = AstType.init("int")
                        if arm.chan_expr as usize != 0 as usize:
                            mut chan_hir = harm_v.chan_expr
                            mut chan_ty = hir_expr_type(chan_hir)
                            if not _is_invalid_ptr(chan_ty.args as usize) and chan_ty.args.len > 0:
                                recv_ty = chan_ty.args.get(0).read()
                        self.declare(arm.var_name, SymbolKind.SVariable, box_asttype(recv_ty), true)
                    harm_v.body = self.lower_block(arm.body)
                    self.finalize_scope_drops(harm_v.body)
                    self.exit_scope()
                    unsafe: harm.write(harm_v)
                    hcs_cases.push(harm)
                    csi2 = csi2 + 1
                return box_hirstmt(HirStmt.SChanSelect(hcs_cases))
            case Stmt.SGpuBlock(body):
                self.block_depth = self.block_depth + 1
                self.open_block()
                mut h_gpu_body = self.lower_block(body)
                self.block_depth = self.block_depth - 1
                self.close_block()
                return box_hirstmt(HirStmt.SGpuBlock(h_gpu_body))
            case Stmt.SBreak(bv):
                mut hbv = Pointer[HirExpr](0)
                if bv as usize != 0 as usize: hbv = self.lower_expr(bv)
                return box_hirstmt(HirStmt.SBreak(hbv))
            case Stmt.SContinue: return box_hirstmt(HirStmt.SContinue)
            case Stmt.SPass: return box_hirstmt(HirStmt.SPass)
            case Stmt.SLocalDecl(ldecl):
                if self.current_func_name != "main":
                    self.error("[E-2] Nested class/def/enum/interface declarations are only supported inside main().\n      FIX: Move this declaration to module (top-level) scope, or declare it inside main().")
                    return box_hirstmt(HirStmt.SPass)
                self.register_decl(ldecl)
                # lower_func/lower_class reset current_func_name/current_class_name
                # to "" on exit; save+restore so main's own context survives the
                # nested-decl lowering that happens mid-way through main's body.
                mut saved_ld_func_name = self.current_func_name
                mut saved_ld_class_name = self.current_class_name
                match ldecl.read():
                    case Decl.DFunction(ld_f):
                        self.nested_functions.push(self.lower_func(ld_f))
                    case Decl.DClass(ld_c):
                        self.nested_classes.push(self.lower_class(ld_c))
                    case Decl.DActor(ld_c):
                        self.nested_classes.push(self.lower_class(ld_c))
                    case Decl.DEnum(ld_e):
                        self.nested_enums.push(self.lower_enum(ld_e))
                    case Decl.DInterface(ld_i):
                        self.nested_interfaces.push(self.lower_interface(ld_i))
                    case Decl.DExtend(ld_target, ld_methods):
                        # Methods added via 'extend' on a nested class must land in
                        # that class's HirClass.methods (codegen emits method bodies
                        # from there, not from hp.functions) - find the already-lowered
                        # nested HirClass and append to it in place.
                        self.current_class_name = ld_target
                        if self.classes.contains(ld_target):
                            self.current_region_params = self.classes.get(ld_target).region_params
                        mut ld_ci = 0
                        mut ld_found = false
                        while ld_ci < self.nested_classes.len:
                            mut ld_nc = self.nested_classes.get(ld_ci)
                            if ld_nc.name == ld_target:
                                mut ld_hi = 0
                                while ld_hi < ld_methods.len:
                                    ld_nc.methods.push(self.lower_func(ld_methods.get(ld_hi)))
                                    ld_hi = ld_hi + 1
                                self.nested_classes.set(ld_ci, ld_nc)
                                ld_found = true
                            ld_ci = ld_ci + 1
                        if not ld_found:
                            mut ld_hi2 = 0
                            while ld_hi2 < ld_methods.len:
                                self.nested_functions.push(self.lower_func(ld_methods.get(ld_hi2)))
                                ld_hi2 = ld_hi2 + 1
                    case _: pass
                self.current_func_name = saved_ld_func_name
                self.current_class_name = saved_ld_class_name
                self.current_region_params = Vec[str].init(0)
                return box_hirstmt(HirStmt.SPass)
            case Stmt.SUnsafe(body):
                # Gap 6: track unsafe boundary
                mut saved_unsafe = self.in_unsafe
                self.in_unsafe = true
                mut unsafe_hir = self.lower_block(body)
                self.in_unsafe = saved_unsafe
                return box_hirstmt(HirStmt.SUnsafe(unsafe_hir))
            case Stmt.SMultiLet(names, is_mut, val_ptr):
                mut hval = self.lower_expr(val_ptr)
                mut val_ty = hir_expr_type(hval)
                mut i = 0
                while i < names.len:
                    mut nty = AstType.init("int")
                    if val_ty.args.len > i: nty = val_ty.args.get(i).read()
                    self.declare(names.get(i), SymbolKind.SVariable, box_asttype(nty), is_mut)
                    i = i + 1
                return box_hirstmt(HirStmt.SMultiLet(names, is_mut, hval))
            case Stmt.SLine(n):
                self.current_line = n
                # Preserve the line number into HIR so codegen can emit a
                # `#line` directive (debug builds). With line directives off
                # it renders as the same no-op comment SPass used to produce,
                # keeping non-debug output byte-identical.
                return box_hirstmt(HirStmt.SLineMarker(n))
            case _: return box_hirstmt(HirStmt.SPass)

    pub def variant_field_ty(self, type_name: str, variant_name: str, field_idx: int) -> AstType:
        if self.enums.contains(type_name):
            mut enm = self.enums.get(type_name)
            mut vi = 0
            while vi < enm.variants.len:
                mut v = enm.variants.get(vi)
                if v.name == variant_name:
                    if field_idx < v.fields.len:
                        mut fp = v.fields.get(field_idx)
                        if fp.ty as usize != 0 as usize: return fp.ty.read()
                    return AstType.init("void")
                vi = vi + 1
        return AstType.init("void")

    pub def declare_pattern_binds(self, pat: Pattern):
        self.declare_pattern_binds_typed(pat, AstType.init("int"))

    # Like declare_pattern_binds but uses subj_ty for PBind so `case x if x.method():` works.
    pub def declare_pattern_binds_typed(self, pat: Pattern, subj_ty: AstType):
        match pat:
            case Pattern.PBind(name): self.declare(name, SymbolKind.SVariable, box_asttype(subj_ty), false)
            case Pattern.PVariantBind(type_name, variant_name, field):
                mut fty = self.variant_field_ty(type_name, variant_name, 0)
                # Builtin generic enums: the payload's type is the SUBJECT's type argument
                # (Option[float].Some(v) binds v: float, Result[T,E].Err(e) binds e: E).
                if type_name == "Option" and variant_name == "Some" and subj_ty.args.len > 0:
                    fty = subj_ty.args.get(0).read()
                elif type_name == "Result" and variant_name == "Ok" and subj_ty.args.len > 0:
                    fty = subj_ty.args.get(0).read()
                elif type_name == "Result" and variant_name == "Err" and subj_ty.args.len > 1:
                    fty = subj_ty.args.get(1).read()
                if fty.name == "void": fty = AstType.init("int")
                self.declare(field, SymbolKind.SVariable, box_asttype(fty), false)
            case Pattern.PVariantBindMany(type_name, variant_name, fields):
                mut _pi = 0
                while _pi < fields.len:
                    mut _pf = fields.get(_pi)
                    if _pf != "_":
                        mut fty = self.variant_field_ty(type_name, variant_name, _pi)
                        if fty.name == "void": fty = AstType.init("int")
                        self.declare(_pf, SymbolKind.SVariable, box_asttype(fty), false)
                    _pi = _pi + 1
            case Pattern.PTuple(first, second):
                self.declare(first, SymbolKind.SVariable, box_asttype(AstType.init("int")), false)
                self.declare(second, SymbolKind.SVariable, box_asttype(AstType.init("int")), false)
            case Pattern.POr(pats):
                mut i = 0
                while i < pats.len:
                    self.declare_pattern_binds_typed(pats.get(i), subj_ty)
                    i = i + 1
            case _: pass

    pub def str_method_ret_ty(self, method: str) -> AstType:
        if method == "split" or method == "split_to_vec" or method == "split_once":
            return AstType.init_generic("Vec", box_asttype(AstType.init("str")))
        if method == "strip": return AstType.init("str")
        if method == "trim": return AstType.init("str")
        if method == "trim_left": return AstType.init("str")
        if method == "trim_right": return AstType.init("str")
        if method == "to_upper": return AstType.init("str")
        if method == "to_lower": return AstType.init("str")
        if method == "upper": return AstType.init("str")
        if method == "lower": return AstType.init("str")
        if method == "lstrip": return AstType.init("str")
        if method == "rstrip": return AstType.init("str")
        if method == "center": return AstType.init("str")
        if method == "pad_left": return AstType.init("str")
        if method == "pad_right": return AstType.init("str")
        if method == "zfill": return AstType.init("str")
        if method == "format": return AstType.init("str")
        if method == "chars": return AstType.init_generic("Vec", box_asttype(AstType.init("str")))
        if method == "capitalize": return AstType.init("str")
        if method == "title": return AstType.init("str")
        if method == "reverse": return AstType.init("str")
        if method == "repeat": return AstType.init("str")
        if method == "replace": return AstType.init("str")
        if method == "replace_first": return AstType.init("str")
        if method == "slice": return AstType.init("str")
        if method == "strip_prefix": return AstType.init("str")
        if method == "strip_suffix": return AstType.init("str")
        if method == "remove_char": return AstType.init("str")
        if method == "join": return AstType.init("str")
        if method == "len": return AstType.init("int")
        if method == "index_of": return AstType.init("int")
        if method == "last_index_of": return AstType.init("int")
        if method == "count": return AstType.init("int")
        if method == "char_at": return AstType.init("int")
        if method == "parse_int": return AstType.init("int")
        if method == "to_int" or method == "to_i64": return AstType.init("int")
        if method == "to_float" or method == "to_f64": return AstType.init("float")
        if method == "starts_with": return AstType.init("bool")
        if method == "ends_with": return AstType.init("bool")
        if method == "is_empty": return AstType.init("bool")
        if method == "parse_bool": return AstType.init("bool")
        if method == "contains": return AstType.init("bool")
        if method == "contains_char": return AstType.init("bool")
        if method == "eq": return AstType.init("bool")
        if method == "is_digit": return AstType.init("bool")
        if method == "is_alpha": return AstType.init("bool")
        if method == "is_alnum": return AstType.init("bool")
        if method == "is_space": return AstType.init("bool")
        if method == "is_upper": return AstType.init("bool")
        if method == "is_lower": return AstType.init("bool")
        if method == "parse_bool": return AstType.init("bool")
        if method == "parse_float": return AstType.init("float")
        if method == "lines": return AstType.init("Vec")
        if method == "words": return AstType.init("Vec")
        return AstType.init("void")

    # Collect every identifier referenced anywhere in a HIR block — used for
    # closure free-variable / capture analysis.
    pub def collect_block_refs(self, b: HirBlock, out: Vec[str]):
        mut i = 0
        while i < b.stmts.len:
            self.collect_stmt_refs(b.stmts.get(i), out)
            i = i + 1

    pub def collect_stmt_refs(self, s: Pointer[HirStmt], out: Vec[str]):
        if s as usize == 0 as usize: return
        match s.read():
            case HirStmt.SExpr(e): self.collect_idents(e, out)
            case HirStmt.SLet(_, _, _, _, _, _, v): self.collect_idents(v, out)
            case HirStmt.SAssign(t, v):
                self.collect_idents(t, out)
                self.collect_idents(v, out)
            case HirStmt.SReturn(v):
                if v as usize != 0 as usize: self.collect_idents(v, out)
            case HirStmt.SBreak(v):
                if v as usize != 0 as usize: self.collect_idents(v, out)
            case HirStmt.SRaise(v): self.collect_idents(v, out)
            case HirStmt.SIf(c, tb, eb):
                self.collect_idents(c, out)
                self.collect_block_refs(tb, out)
                self.collect_block_refs(eb, out)
            case HirStmt.SWhile(c, b2):
                self.collect_idents(c, out)
                self.collect_block_refs(b2, out)
            case HirStmt.SFor(_, it, b2):
                self.collect_idents(it, out)
                self.collect_block_refs(b2, out)
            case HirStmt.SForUnpack(_, it, b2):
                self.collect_idents(it, out)
                self.collect_block_refs(b2, out)
            case HirStmt.SMatch(subj, arms):
                self.collect_idents(subj, out)
                mut i = 0
                while i < arms.len:
                    self.collect_block_refs(arms.get(i).body, out)
                    i = i + 1
            case HirStmt.SUnsafe(b2): self.collect_block_refs(b2, out)
            case _: pass

    # Lower a block into a `do:` value (HirExpr.EDo): runs the body in its own
    # scope; the LAST bare expression is the value. Scope-exit drops run NORMALLY
    # (no exclusion) for `str`/refcounted values — codegen captures + retains the
    # yielded value into a result temp BEFORE these drops run. Owned non-refcounted
    # values (List/Dict/Set/Vec/Map) cannot be retained, so they are TRANSFERRED:
    # the yielded value's idents are excluded from the block's drops (mirroring
    # `return EXPR`). Shared by the `do:`, `if`, and `match` block-expressions.
    pub def lower_do_value(self, do_body: Block) -> Pointer[HirExpr]:
        self.enter_scope()
        mut do_hb = HirBlock.init()
        mut do_n = do_body.stmts.len
        mut do_i = 0
        mut do_val = Pointer[HirExpr](0)
        mut do_ty = AstType.init("void")
        while do_i < do_n:
            mut do_s = do_body.stmts.get(do_i)
            if do_i == do_n - 1:
                match do_s.read():
                    case Stmt.SExpr(de):
                        do_val = self.lower_expr(de)
                        do_ty = hir_expr_type(do_val)
                    case _:
                        mut do_hs = self.lower_stmt(do_s)
                        if do_hs as usize != 0 as usize:
                            self.apply_escape_marks(do_hs)
                            do_hb.push(do_hs)
            else:
                mut do_hs2 = self.lower_stmt(do_s)
                if do_hs2 as usize != 0 as usize:
                    self.apply_escape_marks(do_hs2)
                    do_hb.push(do_hs2)
            do_i = do_i + 1
        mut do_excl = Vec[str].init(2)
        if do_val as usize != 0 as usize and do_ty.name != "str":
            self.collect_idents(do_val, do_excl)
        self.append_drops_from_excl_multi(do_hb, self.scopes.len - 1, do_excl)
        if do_val as usize != 0 as usize: do_hb.push(box_hirstmt(HirStmt.SExpr(do_val)))
        self.exit_scope()
        return box_hirexpr(HirExpr.EDo(do_hb, do_ty))

    # Infer a loop/while EXPRESSION's result type from the FIRST `break <value>`
    # in its (lowered) body. Recurses into if/match/try arms but NOT into nested
    # loops (their breaks belong to them). Returns "void" if no value-break found.
    pub def infer_break_type(self, hb: HirBlock) -> AstType:
        mut i = 0
        while i < hb.stmts.len:
            mut t = self.infer_break_type_stmt(hb.stmts.get(i))
            if t.name != "void": return t
            i = i + 1
        return AstType.init("void")

    pub def infer_break_type_stmt(self, s: Pointer[HirStmt]) -> AstType:
        match s.read():
            case HirStmt.SBreak(bv):
                if bv as usize != 0 as usize: return hir_expr_type(bv)
                return AstType.init("void")
            case HirStmt.SIf(_, then_b, else_b):
                mut t = self.infer_break_type(then_b)
                if t.name != "void": return t
                return self.infer_break_type(else_b)
            case HirStmt.SMatch(_, m_arms):
                mut ai = 0
                while ai < m_arms.len:
                    mut t2 = self.infer_break_type(m_arms.get(ai).body)
                    if t2.name != "void": return t2
                    ai = ai + 1
                return AstType.init("void")
            case HirStmt.STry(tb, _, fb):
                mut t3 = self.infer_break_type(tb)
                if t3.name != "void": return t3
                return self.infer_break_type(fb)
            case _: return AstType.init("void")

    # [H-1] --no-heap: reject a construct that would allocate on the heap, turning the
    # bare-metal "stay off the heap" discipline into a compile-time guarantee (Zig-like).
    # The value-type / fixed-array [T;N] / Pointer[T] / StrView / string-literal subset is
    # untouched — only DYNAMIC allocation (collections, heap class instances, string ops that
    # build a new string) is refused. No-op unless --no-heap is set.
    pub def check_no_heap(self, what: str, fix: str):
        if self.no_heap:
            self.error("[H-1] " + what + " allocates on the heap, which --no-heap forbids (bare-metal zero-heap build).\n      FIX: " + fix)

    pub def lower_expr(self, e_ptr: Pointer[Expr]) -> Pointer[HirExpr]:
        if e_ptr as usize == 0 as usize: return Pointer[HirExpr](0)
        e = e_ptr.read()
        match e:
            case Expr.ELitInt(v): return box_hirexpr(HirExpr.ELitInt(v, AstType.init("int")))
            case Expr.ELitFloat(v): return box_hirexpr(HirExpr.ELitFloat(v, AstType.init("float")))
            case Expr.ELitStr(v): return box_hirexpr(HirExpr.ELitStr(v, AstType.init("str")))
            case Expr.ERawStr(v): return box_hirexpr(HirExpr.ERawStr(v, AstType.init("str")))
            case Expr.ELitBytes(v): return box_hirexpr(HirExpr.ELitBytes(v, AstType.init("Bytes")))
            case Expr.ELitBool(v): return box_hirexpr(HirExpr.ELitBool(v, AstType.init("bool")))
            case Expr.ELitChar(v): return box_hirexpr(HirExpr.ELitChar(v, AstType.init("char")))
            case Expr.ELitNone: return box_hirexpr(HirExpr.ELitNone(AstType.init("None")))
            case Expr.EIdent(name):
                mut sym = self.resolve(name)
                mut ty = sym.ty.read()
                # [N-3] Undefined name: not a scope/global symbol, not a function/
                # class/enum/interface/type, and not an assignment target or a
                # method/property receiver (module receivers like OS/File resolve to
                # no symbol). Catch it here so it never reaches the C backend.
                if sym.name == "" and name != "" and not self.in_assign_target and not self.in_recv_pos and not self.is_known_name(name):
                    self.error("[N-3] name '" + name + "' is not defined.\n      FIX: check the spelling, declare it with 'mut " + name + " = ...', or import it before use.")
                # First-class function reference: a top-level function used as a
                # value carries its def(...)->R signature (not its return type).
                if self.fn_sigs.contains(name) and sym.kind == SymbolKind.SFunction:
                    return box_hirexpr(HirExpr.EIdent(name, self.fn_sigs.get(name), false))
                # [M-6] use-after-free: dealloc() was called on this pointer
                if sym.is_freed and sym.name != "":
                    self.error("[M-6] '" + name + "' was freed by 'dealloc()' and can no longer be used.\n      FIX: Remove all uses of '" + name + "' after 'dealloc()', or restructure so the pointer is freed only when no longer needed.")
                # use-after-definite-move (hard error)
                elif sym.is_moved and not self.is_primitive(ty) and not self.is_copy_class(ty.name) and sym.name != "" and not sym.is_shared:
                    self.error("[M-1] '" + name + "' was moved and cannot be used again.\n      FIX: Use the variable that now owns it, or call .clone() to copy before moving.")
                # Fix 1: use-after-maybe-move - hard error (moved in some branch = definitely unsafe to use)
                elif sym.is_maybe_moved and not self.is_primitive(ty) and not self.is_copy_class(ty.name) and sym.name != "" and not sym.is_shared:
                    self.error("[M-5] '" + name + "' may have been moved on some code paths, making this use unsafe.\n      FIX: Ensure '" + name + "' is not moved before this point on any branch, or restructure so the use is inside the branch where it's still valid.")
                # use-before-definite-init (hard error)
                if not sym.is_init and not sym.is_maybe_init and sym.name != "" and sym.kind == SymbolKind.SVariable and not self.in_assign_target:
                    self.error("[I-1] Variable '" + name + "' is used before being assigned a value.\n      FIX: Assign a value before use, e.g. 'mut " + name + " = <default>'.")
                # Fix 4: use-before-maybe-init - hard error (uninitialized on some path = unsafe)
                elif sym.is_maybe_init and not sym.is_init and sym.name != "" and sym.kind == SymbolKind.SVariable and not self.in_assign_target:
                    self.error("[I-2] '" + name + "' is not initialized on all code paths before this use.\n      FIX: Initialize '" + name + "' before the if/loop, or ensure every branch assigns a value.")
                mut is_move = false
                if self.assign_froms.contains(name) and not self.is_primitive(ty): is_move = true
                return box_hirexpr(HirExpr.EIdent(name, ty, is_move))
            case Expr.EBinOp(op, left, right):
                mut hleft = self.lower_expr(left)
                mut hright = self.lower_expr(right)
                # [H-1] str `+` (concat) and str `*` (repeat) build a NEW heap string.
                if self.no_heap and (op == "+" or op == "*"):
                    mut _nh_l = hir_expr_type(hleft).name
                    mut _nh_r = hir_expr_type(hright).name
                    if _nh_l == "str" or _nh_l == "String" or _nh_r == "str" or _nh_r == "String":
                        mut _nh_what = "string concatenation (+)"
                        if op == "*": _nh_what = "string repetition (*)"
                        self.check_no_heap(_nh_what, "keep string literals (they live in rodata) or use a StrView / fixed byte buffer; do not build new strings")
                # #10 runtime type comparison: `T == U`, `obj == T`, `5 == int`,
                # etc. When either side is a bare type name (class/enum/interface/
                # primitive that isn't a variable), compare the TYPE NAMES. A value
                # operand contributes its static type name (so `5 == int` is True,
                # `obj == MyClass` is True for a MyClass instance). Lowered to a
                # str comparison of the two names.
                if op == "==" or op == "!=":
                    mut lref = self.type_ref_name(left)
                    mut rref = self.type_ref_name(right)
                    if lref != "" or rref != "":
                        mut lname = lref
                        if lname == "": lname = hir_expr_type(hleft).name
                        mut rname = rref
                        if rname == "": rname = hir_expr_type(hright).name
                        return box_hirexpr(HirExpr.EBinOp(op, box_hirexpr(HirExpr.ELitStr(lname, AstType.init("str"))), box_hirexpr(HirExpr.ELitStr(rname, AstType.init("str"))), AstType.init("bool")))
                mut bin_ty = hir_expr_type(hleft)
                if bin_ty.name == "void": bin_ty = hir_expr_type(hright)
                if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or" or op == "&&" or op == "||" or op == "in" or op == "not in":
                    bin_ty = AstType.init("bool")
                elif op == "*" and (hir_expr_type(hleft).name == "str" or hir_expr_type(hleft).name == "String" or hir_expr_type(hright).name == "str" or hir_expr_type(hright).name == "String"):
                    bin_ty = AstType.init("str")
                elif (op == "+" or op == "-" or op == "*" or op == "/") and (_binop_is_float_name(hir_expr_type(hleft).name) or _binop_is_float_name(hir_expr_type(hright).name)):
                    bin_ty = AstType.init("float")   # int+float etc. promotes to float
                return box_hirexpr(HirExpr.EBinOp(op, hleft, hright, bin_ty))
            case Expr.EUnaryOp(op, expr):
                mut hexpr_inner = self.lower_expr(expr)
                mut inner_ty = hir_expr_type(hexpr_inner)
                mut un_ty = inner_ty
                if op == "&":
                    mut addr_ty = AstType.init("Pointer")
                    addr_ty.args.push(box_asttype(inner_ty))
                    un_ty = addr_ty
                elif op == "*":
                    if inner_ty.name == "Pointer" and inner_ty.args.len > 0:
                        un_ty = inner_ty.args.get(0).read()
                return box_hirexpr(HirExpr.EUnaryOp(op, hexpr_inner, un_ty))
            case Expr.ECall(callee, args):
                # Special built-in: await_timeout(async_expr, ms) -> EAwaitTimeout
                if callee as usize != 0 as usize:
                    match callee.read():
                        case Expr.EIdent(ato_n):
                            # [H-1] `ClassName(...)` on a refcounted heap class allocates + ARC-tracks it.
                            if self.no_heap and self._is_rc_class(ato_n):
                                self.check_no_heap("constructing heap class '" + ato_n + "'", "mark the class '@value_type' (stack; all-scalar fields), or place the instance in caller-owned memory via a Pointer[T]")
                            if ato_n == "await_timeout":
                                if not self.in_async_fn:
                                    self.error("[C-4] 'await_timeout' used outside an async function.")
                                if args.len < 2:
                                    self.error("await_timeout requires 2 arguments: await_timeout(expr, timeout_ms)")
                                    return box_hirexpr(HirExpr.ELitInt(0, AstType.init("int")))
                                mut ato_inner = self.lower_expr(args.get(0))
                                mut ato_ms = self.lower_expr(args.get(1))
                                mut ato_ty = hir_expr_type(ato_inner)
                                return box_hirexpr(HirExpr.EAwaitTimeout(ato_inner, ato_ms, ato_ty))
                            # #10: instanceOf(obj, T) - compile-time type check.
                            # Compares obj's static type name against T (a class/
                            # enum/primitive type name), evaluating to a bool literal.
                            if ato_n == "instanceOf":
                                if args.len < 2:
                                    self.error("instanceOf requires 2 arguments: instanceOf(obj, T)")
                                    return box_hirexpr(HirExpr.ELitBool(false, AstType.init("bool")))
                                mut io_obj = self.lower_expr(args.get(0))
                                mut io_obj_ty_n: str = hir_expr_type(io_obj).name
                                mut io_target_n = ""
                                match args.get(1).read():
                                    case Expr.EIdent(io_tn): io_target_n = io_tn
                                    case Expr.EIndex(io_base, _):
                                        match io_base.read():
                                            case Expr.EIdent(io_tn2): io_target_n = io_tn2
                                            case _: pass
                                    case _: pass
                                return box_hirexpr(HirExpr.ELitBool(io_obj_ty_n == io_target_n, AstType.init("bool")))
                            # #9: inspect(T) - returns a help()-style description
                            # of a class/enum/interface/function/builtin type as
                            # a string literal, computed entirely at compile time.
                            if ato_n == "inspect":
                                if args.len < 1:
                                    self.error("inspect requires 1 argument: inspect(T)")
                                    return box_hirexpr(HirExpr.ELitStr("", AstType.init("str")))
                                mut isp_target_n = ""
                                match args.get(0).read():
                                    case Expr.EIdent(isp_tn): isp_target_n = isp_tn
                                    case Expr.EIndex(isp_base, _):
                                        match isp_base.read():
                                            case Expr.EIdent(isp_tn2): isp_target_n = isp_tn2
                                            case _: pass
                                    case _: pass
                                if isp_target_n == "":
                                    mut isp_obj = self.lower_expr(args.get(0))
                                    isp_target_n = hir_expr_type(isp_obj).name
                                return box_hirexpr(HirExpr.ELitStr(self.build_inspect_str(isp_target_n), AstType.init("str")))
                        case _: pass
                # iterate AST args - mark borrows and detect aliasing
                mut p23_borrow_names = Vec[str].init(4)
                mut p23_seen = Map[str, bool].init(4)
                mut p23_k = 0
                while p23_k < args.len:
                    mut p23_arg = args.get(p23_k)
                    mut p23_nm = ""
                    if p23_arg as usize != 0 as usize:
                        match p23_arg.read():
                            case Expr.EIdent(p23_n): p23_nm = p23_n
                            case _: pass
                    if p23_nm != "":
                        mut p23_sym = self.resolve(p23_nm)
                        if not self.is_primitive(p23_sym.ty.read()) and p23_sym.name != "":
                            self.mark_borrow(p23_nm)
                            p23_borrow_names.push(p23_nm)
                            if p23_seen.contains(p23_nm):
                                self.error("[M-3] '" + p23_nm + "' appears twice in the same call, creating aliased mutable access.\n      FIX: Clone one of the arguments: " + p23_nm + ".clone()")
                            p23_seen.insert(p23_nm, true)
                    p23_k = p23_k + 1
                mut hl = Vec[Pointer[HirExpr]].init(4)
                mut k = 0
                while k < args.len:
                    hl.push(self.lower_expr(args.get(k)))
                    k = k + 1
                # release borrows after call
                mut p23_ui = 0
                while p23_ui < p23_borrow_names.len:
                    self.unmark_borrow(p23_borrow_names.get(p23_ui))
                    p23_ui = p23_ui + 1
                # #14: trailing variadic param - collect trailing call args into
                # a single List[T] literal matching the callee's variadic param.
                if callee as usize != 0 as usize:
                    match callee.read():
                        case Expr.EIdent(vfn_n):
                            if self.variadic_fns.contains(vfn_n):
                                mut vfixed = self.variadic_fns.get(vfn_n).to_int()
                                mut velem_ty = AstType.init("int")
                                if self.variadic_elem_ty.contains(vfn_n):
                                    velem_ty = self.variadic_elem_ty.get(vfn_n).read()
                                if hl.len >= vfixed:
                                    mut vargs = Vec[Pointer[HirExpr]].init(4)
                                    mut vi = vfixed
                                    while vi < hl.len:
                                        vargs.push(hl.get(vi))
                                        vi = vi + 1
                                    mut vlist_ty = AstType.init("List")
                                    vlist_ty.args.push(box_asttype(velem_ty))
                                    mut vnew_hl = Vec[Pointer[HirExpr]].init(vfixed + 1)
                                    mut vk = 0
                                    while vk < vfixed:
                                        vnew_hl.push(hl.get(vk))
                                        vk = vk + 1
                                    vnew_hl.push(box_hirexpr(HirExpr.EList(vargs, vlist_ty)))
                                    hl = vnew_hl
