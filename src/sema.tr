                                    # name and resolve the RESULT type. The result is the
                                    # function's declared return type with its type param
                                    # substituted by T (so `id[int](x)`->int, `describe[Cat](x)`
                                    # -> str, not Cat).
                                    match idx.read():
                                        case Expr.EIdent(farg_c):
                                            mut fret = AstType.init(farg_c)
                                            ret_ty = fret
                                            hcallee = box_hirexpr(HirExpr.EIdent(gn + "__MONO_" + farg_c, fret, false))
                                        case Expr.ETuple(ftargs):
