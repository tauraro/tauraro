                    # call using that literal name (`C_execute`) instead of the
                    # resolved concrete class's (`MyConn_execute`), an undefined-
                    # reference compile error. Confirmed with a minimal repro.
                    if _cls.generics.len > 0 and hobj_ty_full.args.len > 0:
                        ret_ty = self._subst_ret_generics(ret_ty, _cls.generics, hobj_ty_full.args)
                elif self.enums.contains(hobj_ty_n):
                    # `EnumType.Variant` (no call) - the value's type is the enum itself.
                    ret_ty = AstType.init(hobj_ty_n)
                if ret_ty.name == "void" and (prop == "len" or prop == "length" or prop == "capacity"):
                    ret_ty = AstType.init("int")
                return box_hirexpr(HirExpr.EPropAccess(hobj, prop, ret_ty))
            case Expr.EIndex(obj, idx_inner):
                mut hexpr_obj = self.lower_expr(obj)
                mut obj_ty_n: str = hir_expr_type(hexpr_obj).name
                mut obj_name = ""
                match obj.read():
                    case Expr.EIdent(n): obj_name = n
                    case _: pass
                mut is_generic = false
                mut generic_arg_n: str = ""
                mut generic_arg_ty: Pointer[AstType] = 0 as Pointer[AstType]
                # All type args (for multi-arg generics like Map[K, V]); the
                # single-arg cases below leave this empty and the container build
                # falls back to generic_arg_n/ty.
                mut generic_args: Vec[Pointer[AstType]] = Vec[Pointer[AstType]].init(2)
                if idx_inner as usize == 0 as usize:
                    return hexpr_obj
                match idx_inner.read():
                    case Expr.ETuple(_tup_targs):
                        # Multi-arg generic, e.g. Map[str, str] -> ETuple([str,str]).
                        is_generic = true
                        mut _tti = 0
                        while _tti < _tup_targs.len:
                            generic_args.push(self._targ_of(_tup_targs.get(_tti)))
                            _tti = _tti + 1
                        if generic_args.len > 0:
                            generic_arg_ty = generic_args.get(0)
                            generic_arg_n = generic_args.get(0).read().name
                    case Expr.ETypeArg(targ_ty):
                        is_generic = true
                        generic_arg_ty = targ_ty
                        generic_arg_n = targ_ty.read().name
                    case Expr.EIdent(iname):
                        mut is_param = false
                        if self.current_class_name != "":
                            if self.classes.contains(self.current_class_name):
                                mut cc = self.classes.get(self.current_class_name)
                                mut ci = 0
                                while ci < cc.generics.len:
                                    if cc.generics.get(ci) == iname: is_param = true
                                    ci = ci + 1
                        mut fi = 0
                        while fi < self.current_func_generics.len:
                            if self.current_func_generics.get(fi) == iname: is_param = true
                            fi = fi + 1

                        if self.is_primitive_name(iname) or iname == "str" or iname == "Str" or is_param or _tr_strlen(iname) == 1 or self.classes.contains(iname) or iname == "StringObj" or iname == "StringBuilder" or self.enums.contains(iname) or iname == "Vec" or iname == "List" or iname == "Map" or iname == "Tuple" or iname == "tuple":
                            is_generic = true
                            generic_arg_n = iname
                    case Expr.EIndex(_, _):
                        # A nested generic type arg, e.g. the `Box[int]` in Box[Box[int]].
                        # Keep the FULL nested type (with its own args) so the outer
                        # monomorphization suffix recurses (Box[int] -> Box_i64) instead
                        # of collapsing to a bare `Box`.
                        is_generic = true
                        mut nested_ty = self.build_ast_type(idx_inner)
                        if nested_ty as usize != 0 as usize:
                            generic_arg_n = nested_ty.read().name
                            generic_arg_ty = nested_ty
                    case _: pass
                # The generic interpretation (obj[T] is a type application like
                # List[int]) only applies when `obj` is a TYPE NAME - a builtin
                # container, generic allocator, class, or enum. When `obj` is a
                # value variable (e.g. `foo[i]` on a List), it is an index, even
                # if the index name is a single letter (which is otherwise read
                # as a generic type parameter).
                mut obj_is_type = obj_name == "Vec" or obj_name == "List" or obj_name == "Map" or obj_name == "Dict" or obj_name == "Set" or obj_name == "Pointer" or obj_name == "alloc" or obj_name == "dealloc" or obj_name == "resize" or obj_name == "copy" or self.classes.contains(obj_name) or self.enums.contains(obj_name)
                if is_generic and obj_is_type:
                    # For Vec[T] or List[T] - return base expr annotated with the generic arg.
                    # When obj_ty_n is "void" (e.g. Vec not in globals but used as generic syntax),
                    # fall back to obj_name from the AST so Vec[int].init() still works.
                    mut eff_ty_n = obj_ty_n
                    if (eff_ty_n == "void" or eff_ty_n == "") and (obj_name == "Vec" or obj_name == "List" or obj_name == "Map" or obj_name == "Dict" or obj_name == "Set" or obj_name == "Pointer"):
                        eff_ty_n = obj_name
                    if (eff_ty_n == "Vec" or eff_ty_n == "List" or eff_ty_n == "Map" or eff_ty_n == "Dict" or eff_ty_n == "Set" or eff_ty_n == "Pointer") and generic_arg_n != "":
                        mut container_ty = AstType.init(eff_ty_n)
                        container_ty.args = Vec[Pointer[AstType]].init(2)
                        # Multi-arg generics (Map[K, V]) push ALL collected args so
                        # the value type is preserved; single-arg fall back to the
                        # one generic_arg_ty/n.
                        if generic_args.len > 0:
                            mut _gci = 0
                            while _gci < generic_args.len:
                                container_ty.args.push(generic_args.get(_gci))
                                _gci = _gci + 1
                        elif generic_arg_ty as usize != 0 as usize:
                            container_ty.args.push(generic_arg_ty)
                        else:
                            container_ty.args.push(box_asttype(AstType.init(generic_arg_n)))
                        if obj_name == "alloc" or obj_name == "dealloc" or obj_name == "resize" or obj_name == "copy":
                             return box_hirexpr(HirExpr.EIndex(hexpr_obj, self.lower_expr(idx_inner), container_ty))
                        return box_hirexpr(HirExpr.EIdent(eff_ty_n, container_ty, false))
                    # User-defined generic class or enum: preserve the concrete type args
                    if (self.classes.contains(obj_name) or self.enums.contains(obj_name)) and generic_arg_n != "":
                        mut cls_ty = AstType.init(obj_name)
                        cls_ty.args = Vec[Pointer[AstType]].init(2)
                        if generic_args.len > 0:
                            mut _cgi = 0
                            while _cgi < generic_args.len:
                                cls_ty.args.push(generic_args.get(_cgi))
                                _cgi = _cgi + 1
                        elif generic_arg_ty as usize != 0 as usize:
                            # Nested generic arg (Box[Box[int]]): keep its inner args.
                            cls_ty.args.push(generic_arg_ty)
                        else:
                            cls_ty.args.push(box_asttype(AstType.init(generic_arg_n)))
                        # [G-1] generic class bounds (Box[T: Show] used as Box[Cat]).
                        self.check_class_bounds(obj_name, cls_ty.args)
                        return box_hirexpr(HirExpr.EIdent(obj_name, cls_ty, false))
                    return hexpr_obj
                # Dict/Map index access d[key]: lower to get_index carrying the
                # VALUE type so the read path unboxes str values and the write
                # path (SAssign) dispatches to dict-set. (Handled for both read
                # and write in codegen's EMethodCall "get_index" branches.)
                if obj_ty_n == "Map" or obj_ty_n == "Dict":
                    mut dval_ty = AstType.init("void")
                    mut dobj_full = hir_expr_type(hexpr_obj)
                    if dobj_full.args.len > 1: dval_ty = dobj_full.args.get(1).read()
                    mut didx_args = Vec[Pointer[HirExpr]].init(1)
                    didx_args.push(self.lower_expr(idx_inner))
                    return box_hirexpr(HirExpr.EMethodCall(hexpr_obj, "get_index", didx_args, dval_ty))
                # Tuple index t[i]: a CONSTANT index types the read as element #i's type
                # (tuples are heterogeneous, so only literal indices are well-typed).
                if obj_ty_n == "Tuple":
                    mut tup_full = hir_expr_type(hexpr_obj)
                    mut telem_ty = AstType.init("void")
                    match idx_inner.read():
                        case Expr.ELitInt(tup_ci):
                            if tup_ci >= 0 and tup_ci < tup_full.args.len:
                                telem_ty = tup_full.args.get(tup_ci).read()
                        case _: pass
                    mut tup_args = Vec[Pointer[HirExpr]].init(1)
                    tup_args.push(self.lower_expr(idx_inner))
                    return box_hirexpr(HirExpr.EMethodCall(hexpr_obj, "get_index", tup_args, telem_ty))
                if not self.is_primitive_name(obj_ty_n) and obj_ty_n != "str" and obj_ty_n != "Pointer" and obj_ty_n != "List" and obj_ty_n != "Vec":
                    mut call_args = Vec[Pointer[HirExpr]].init(1)
                    call_args.push(self.lower_expr(idx_inner))
                    return box_hirexpr(HirExpr.EMethodCall(hexpr_obj, "get_index", call_args, AstType.init("void")))
                # EIndex type is the element type, not the container type
                mut elem_ty = AstType.init("void")
                if obj_ty_n == "List" or obj_ty_n == "Vec":
                    if hir_expr_type(hexpr_obj).args.len > 0:
                        elem_ty = hir_expr_type(hexpr_obj).args.get(0).read()
                elif obj_ty_n == "Pointer":
                    if hir_expr_type(hexpr_obj).args.len > 0:
                        elem_ty = hir_expr_type(hexpr_obj).args.get(0).read()
                elif obj_ty_n == "str": elem_ty = AstType.init("char")
                return box_hirexpr(HirExpr.EIndex(hexpr_obj, self.lower_expr(idx_inner), elem_ty))
            case Expr.ESizeOf(ty):
                if ty as usize == 0 as usize: return box_hirexpr(HirExpr.ESizeOf(AstType.init("void"), AstType.init("int")))
                return box_hirexpr(HirExpr.ESizeOf(ty.read(), AstType.init("int")))
            case Expr.ECast(expr, ty):
                if ty as usize == 0 as usize: return self.lower_expr(expr)
                return box_hirexpr(HirExpr.ECast(self.lower_expr(expr), ty.read()))
            case Expr.EFString(parts):
                self.check_no_heap("an f-string", "build output in a fixed byte buffer, or print the parts separately; plain string literals are fine (they live in rodata)")
                mut hparts = Vec[HirFStringPart].init(4)
                mut m = 0
                while m < parts.len:
                    mut p_ast = parts.get(m)
                    mut hp = HirFStringPart.init()
                    hp.is_expr  = p_ast.is_expr
                    hp.text     = p_ast.text
                    hp.fmt_spec = p_ast.fmt_spec
                    hp.expr     = self.lower_expr(p_ast.expr)
                    hparts.push(hp)
                    m = m + 1
                return box_hirexpr(HirExpr.EFString(hparts, AstType.init("str")))
            case Expr.ETuple(items):
                # [H-1] under --no-heap: a tuple literal heap-allocates on the LLVM/native
                # backends (the C backend keeps it as a stack `TrTuple` value, so it's allowed
                # there). Reject it on the heap-boxing backends so the zero-heap guarantee holds.
                if self.no_heap and self.heap_boxes_tuples:
                    self.check_no_heap("a tuple literal (heap-boxed on the LLVM/native backend)", "use the C backend (stack tuples) for --no-heap, or return values via out-params / a @value_type struct")
                mut hitems = Vec[Pointer[HirExpr]].init(items.len)
                mut n = 0
                while n < items.len:
                    hitems.push(self.lower_expr(items.get(n)))
                    n = n + 1
                # Record each element's type in `args` so SMultiLet destructuring
                # (gen_multi_let in c.tr) can recover str/non-str element types
                # instead of defaulting every binding to `long long`.
                mut tup_ty = AstType.init("Tuple")
                mut m = 0
                while m < hitems.len:
                    tup_ty.args.push(box_asttype(hir_expr_type(hitems.get(m))))
                    m = m + 1
                return box_hirexpr(HirExpr.ETuple(hitems, tup_ty))
            case Expr.EList(items):
                self.check_no_heap("a list literal []", "use a fixed-size array [T; N] (stack, zero-heap) instead")
                mut hitems = Vec[Pointer[HirExpr]].init(items.len)
                mut n = 0
                while n < items.len:
                    hitems.push(self.lower_expr(items.get(n)))
                    n = n + 1
                mut list_ty = AstType.init("List")
                if hitems.len > 0:
                    list_ty.args = Vec[Pointer[AstType]].init(1)
                    list_ty.args.push(box_asttype(hir_expr_type(hitems.get(0))))
                return box_hirexpr(HirExpr.EList(hitems, list_ty))
            case Expr.ESet(items):
                self.check_no_heap("a set literal", "use a fixed-size array [T; N] + linear scan, or a bitset over a fixed word")
                mut sitems = Vec[Pointer[HirExpr]].init(items.len)
                mut sn = 0
                while sn < items.len:
                    sitems.push(self.lower_expr(items.get(sn)))
                    sn = sn + 1
                # Infer the element type from the first entry so `.len`/`in`/`.add`
                # resolve to the right runtime (int-keyed _TrISet vs str _TrSet).
                mut set_ty = AstType.init("Set")
                if sitems.len > 0:
                    set_ty.args = Vec[Pointer[AstType]].init(1)
                    set_ty.args.push(box_asttype(hir_expr_type(sitems.get(0))))
                return box_hirexpr(HirExpr.ESet(sitems, set_ty))
            case Expr.EClosure(params, ret_ty, body, is_async):
                self.enter_scope()
                mut cap_idx = self.scopes.len - 1   # the closure's OWN scope
                mut hparams = Vec[HirParam].init(params.len)
                mut l = 0
                while l < params.len:
                    mut pa = params.get(l)
                    mut pa_ty = AstType.init("int")
                    if pa.ty as usize != 0 as usize: pa_ty = pa.ty.read()
                    self.declare(pa.name, SymbolKind.SVariable, box_asttype(pa_ty), false)
                    mut hpa = HirParam()
                    hpa.name = pa.name
                    hpa.ty = pa_ty
                    hparams.push(hpa)
                    l = l + 1
                mut r_ty = AstType.init("void")
                if ret_ty as usize != 0 as usize: r_ty = ret_ty.read()
                # A closure is a separate function: a `return` inside it must drop only
                # the closure's own scopes, never the enclosing function's locals.
                self.fn_scope_base.push(self.scopes.len - 1)
                mut clo_body = self.lower_block(body)
                self.fn_scope_base.pop()
                self.finalize_scope_drops(clo_body)
                # Capture analysis: the outlined closure (a top-level function) can
                # no longer see the enclosing frame, so compute the FREE variables —
                # names it references that resolve to an ENCLOSING local variable
                # (not its own params/locals, not a global/function) — and record
                # them as by-reference captures for codegen's env.
                mut clo_refs = Vec[str].init(8)
                self.collect_block_refs(clo_body, clo_refs)
                mut clo_caps = Vec[HirParam].init(4)
                mut clo_seen = Map[str, bool].init(8)
                mut cri = 0
                while cri < clo_refs.len:
                    mut rn = clo_refs.get(cri)
                    if not clo_seen.contains(rn):
                        clo_seen.insert(rn, true)
                        if not self.scopes.get(cap_idx).variables.contains(rn):
                            mut si = cap_idx - 1
                            mut cty_p = Pointer[AstType](0)
                            while si >= 0:
                                if self.scopes.get(si).variables.contains(rn):
                                    cty_p = self.scopes.get(si).variables.get(rn).ty
                                    si = 0 - 1
                                else:
                                    si = si - 1
                            if cty_p as usize != 0 as usize:
                                mut ccp = HirParam()
                                ccp.name = rn
                                ccp.ty = cty_p.read()
                                clo_caps.push(ccp)
                    cri = cri + 1
                mut hexpr = HirExpr.EClosure(hparams, r_ty, clo_body, is_async, clo_caps)
                self.exit_scope()
                return box_hirexpr(hexpr)
            case Expr.EIfElse(cond, then_e, else_e):
                mut hcond = self.lower_expr(cond)
                mut hthen = self.lower_expr(then_e)
                mut helse = self.lower_expr(else_e)
                mut ite_ty = hir_expr_type(hthen)
                return box_hirexpr(HirExpr.EIfElse(hcond, hthen, helse, ite_ty))
            case Expr.EDo(do_body):
                # `do:` block-expression. Lower the body in its own scope; the
                # LAST bare expression is the value. Scope-exit drops run NORMALLY
                # (no exclusion): the codegen captures the yielded value into a
                # result temp — retaining it iff it is not already fresh-owned —
                # BEFORE these drops run, so a block-local that produced the value
                # is retained (then balanced by its own drop) while a borrowed /
                # outer / field value is retained into an independent rc=1 owned
                # result. Codegen wraps the whole thing in a statement-expression
                # `({ … _dores; })` whose trailing temp is the block's value.
                return self.lower_do_value(do_body)
            case Expr.EMatch(m_subj, m_arms):
                # match-EXPRESSION: lower the subject, then lower EACH arm body as
                # a `do:` value (its last bare expression is the arm's result).
                # Pattern bindings are declared in the arm's scope (visible to the
                # nested do-block). Codegen dispatches `_mres = ({arm-do})` per arm.
                mut hm_subj = self.lower_expr(m_subj)
                mut hm_subj_ty = hir_expr_type(hm_subj)
                mut hm_arms = Vec[HirMatchArm].init(4)
                mut hm_ty = AstType.init("void")
                mut hm_k = 0
                while hm_k < m_arms.len:
                    mut hm_arm = m_arms.get(hm_k)
                    self.enter_scope()
                    self.declare_pattern_binds_typed(hm_arm.pat, hm_subj_ty)
                    mut hm_edo = self.lower_do_value(hm_arm.body.read())
                    if hir_expr_type(hm_edo).name != "void": hm_ty = hir_expr_type(hm_edo)
                    mut hm_body = HirBlock.init()
                    hm_body.push(box_hirstmt(HirStmt.SExpr(hm_edo)))
                    mut h_marm = HirMatchArm.init(hm_arm.pat, hm_body)
                    if hm_arm.guard as usize != 0 as usize:
                        h_marm.guard = self.lower_expr(hm_arm.guard)
                    hm_arms.push(h_marm)
                    self.exit_scope()
                    hm_k = hm_k + 1
                return box_hirexpr(HirExpr.EMatchExpr(hm_subj, hm_arms, hm_ty))
            case Expr.ELoop(loop_body):
                # `loop:` expression — infinite loop; value comes from `break v`.
                self.enter_scope()
                self.loop_scope_base.push(self.scopes.len - 1)
                mut h_loop_body = self.lower_block(loop_body)
                self.loop_scope_base.pop()
                self.finalize_scope_drops(h_loop_body)
                self.exit_scope()
                mut loop_ty = self.infer_break_type(h_loop_body)
                return box_hirexpr(HirExpr.ELoop(h_loop_body, loop_ty))
            case Expr.EWhileExpr(we_cond, we_body, we_else):
                # `while c:` expression — value from `break v`, else the `else:`
                # block's last bare expression on normal exit.
                mut h_we_cond = self.lower_expr(we_cond)
                self.enter_scope()
                self.loop_scope_base.push(self.scopes.len - 1)
                mut h_we_body = self.lower_block(we_body)
                self.loop_scope_base.pop()
                self.finalize_scope_drops(h_we_body)
                self.exit_scope()
                # The else block yields a do-style value on normal exit.
                mut h_we_else = self.lower_do_value(we_else)
                mut we_ty = self.infer_break_type(h_we_body)
                if we_ty.name == "void": we_ty = hir_expr_type(h_we_else)
                # Wrap the else value-expr in a block so codegen can emit it.
                mut h_we_else_b = HirBlock.init()
                h_we_else_b.push(box_hirstmt(HirStmt.SExpr(h_we_else)))
                return box_hirexpr(HirExpr.EWhileExpr(h_we_cond, h_we_body, h_we_else_b, we_ty))
            case Expr.ETryExpr(inner):
                mut hinner = self.lower_expr(inner)
                mut inner_ty = hir_expr_type(hinner)
                # ? extracts the Ok type from a Result[T,E]
                mut ok_ty = AstType.init("void")
                if inner_ty.name == "Result" and inner_ty.args.len > 0:
                    ok_ty = inner_ty.args.get(0).read()
                elif inner_ty.name != "void":
                    ok_ty = inner_ty
                return box_hirexpr(HirExpr.ETryExpr(hinner, ok_ty))
            case Expr.EAwait(inner_await):
                # Rule C-4: await only valid inside async def
                if not self.in_async_fn:
                    self.error("[C-4] 'await' used outside an async function. FIX: Declare '" + self.current_func_name + "' as 'async def " + self.current_func_name + "(...)' to use await inside it.")
                mut hinner_await = self.lower_expr(inner_await)
                mut await_ty = hir_expr_type(hinner_await)
                return box_hirexpr(HirExpr.EAwait(hinner_await, await_ty))
            case Expr.EDict(keys, vals):
                self.check_no_heap("a dict/map literal", "use parallel fixed-size arrays [K; N]/[V; N], or a static lookup table")
                mut h_keys = Vec[Pointer[HirExpr]].init(keys.len)
                mut h_vals = Vec[Pointer[HirExpr]].init(vals.len)
                mut di = 0
                while di < keys.len:
                    h_keys.push(self.lower_expr(keys.get(di)))
                    h_vals.push(self.lower_expr(vals.get(di)))
                    di = di + 1
                # Infer key/value types from the first entry so `.get`/`[]`/print
                # resolve correctly (otherwise the dict's K,V are lost and str
                # values come back as raw void* garbage).
                mut dict_ty = AstType.init("Dict")
                if h_keys.len > 0:
                    dict_ty.args.push(box_asttype(hir_expr_type(h_keys.get(0))))
                    dict_ty.args.push(box_asttype(hir_expr_type(h_vals.get(0))))
                return box_hirexpr(HirExpr.EDict(h_keys, h_vals, dict_ty))
            case Expr.EListComp(element, generators):
                self.check_no_heap("a list comprehension", "loop over a fixed-size array [T; N] and write into another")
                self.enter_scope()
                mut hgens = Vec[Pointer[HirComprehension]].init(generators.len)
                mut gc: int = 0
                while gc < generators.len:
                    mut gen_ast: Comprehension = generators.get(gc).read()
                    mut hgen_ptr = Pointer[HirComprehension](0)
                    unsafe: hgen_ptr = alloc[HirComprehension](1)
                    mut hgen_val = HirComprehension()
                    hgen_val.target = gen_ast.target
                    mut h_iter_lc = self.lower_expr(gen_ast.iter)
                    hgen_val.iter = h_iter_lc
                    mut lc_itn = hir_expr_type(h_iter_lc).name
                    mut lc_ial = hir_expr_type(h_iter_lc).args.len
                    mut lc_elem_ty = AstType.init("int")
                    if (lc_itn == "List" or lc_itn == "Vec") and lc_ial > 0:
                        lc_elem_ty = hir_expr_type(h_iter_lc).args.get(0).read()
                    elif lc_itn == "str":
                        lc_elem_ty = AstType.init("char")
                    self.declare(gen_ast.target, SymbolKind.SVariable, box_asttype(lc_elem_ty), false)
                    mut hifs = Vec[Pointer[HirExpr]].init(gen_ast.ifs.len)
                    mut lc_fi = 0
                    while lc_fi < gen_ast.ifs.len:
                        hifs.push(self.lower_expr(gen_ast.ifs.get(lc_fi)))
                        lc_fi = lc_fi + 1
                    hgen_val.ifs = hifs
                    hgen_val.is_async = gen_ast.is_async
                    unsafe: hgen_ptr.write(hgen_val)
                    hgens.push(hgen_ptr)
                    gc = gc + 1
                mut h_lc_elem = self.lower_expr(element)
                mut lc_elem_hty = hir_expr_type(h_lc_elem)
                mut comp_ty = AstType.init("List")
                comp_ty.args = Vec[Pointer[AstType]].init(1)
                comp_ty.args.push(box_asttype(lc_elem_hty))
                self.exit_scope()
                return box_hirexpr(HirExpr.EListComp(h_lc_elem, hgens, comp_ty))
            case Expr.EGeneratorExpr(element, generators):
                self.enter_scope()
                mut hgens2 = Vec[Pointer[HirComprehension]].init(generators.len)
                mut gc2: int = 0
                while gc2 < generators.len:
                    mut gen_ast2: Comprehension = generators.get(gc2).read()
                    mut hgen_ptr2 = Pointer[HirComprehension](0)
                    unsafe: hgen_ptr2 = alloc[HirComprehension](1)
                    mut hgen_val2 = HirComprehension()
                    hgen_val2.target = gen_ast2.target
                    mut h_iter_ge = self.lower_expr(gen_ast2.iter)
                    hgen_val2.iter = h_iter_ge
                    mut ge_itn = hir_expr_type(h_iter_ge).name
                    mut ge_ial = hir_expr_type(h_iter_ge).args.len
                    mut ge_elem_ty = AstType.init("int")
                    if (ge_itn == "List" or ge_itn == "Vec") and ge_ial > 0:
                        ge_elem_ty = hir_expr_type(h_iter_ge).args.get(0).read()
                    elif ge_itn == "str":
                        ge_elem_ty = AstType.init("char")
                    self.declare(gen_ast2.target, SymbolKind.SVariable, box_asttype(ge_elem_ty), false)
                    mut hifs2 = Vec[Pointer[HirExpr]].init(gen_ast2.ifs.len)
                    mut ge_fi = 0
                    while ge_fi < gen_ast2.ifs.len:
                        hifs2.push(self.lower_expr(gen_ast2.ifs.get(ge_fi)))
                        ge_fi = ge_fi + 1
                    hgen_val2.ifs = hifs2
                    hgen_val2.is_async = gen_ast2.is_async
                    unsafe: hgen_ptr2.write(hgen_val2)
                    hgens2.push(hgen_ptr2)
                    gc2 = gc2 + 1
                mut h_ge_elem = self.lower_expr(element)
                mut ge_elem_hty = hir_expr_type(h_ge_elem)
                mut gen_ty = AstType.init("List")
                gen_ty.args = Vec[Pointer[AstType]].init(1)
                gen_ty.args.push(box_asttype(ge_elem_hty))
                self.exit_scope()
                return box_hirexpr(HirExpr.EGeneratorExpr(h_ge_elem, hgens2, gen_ty))
            case Expr.ESuperMethodCall(base_class, method, args):
                mut h_super_args = Vec[Pointer[HirExpr]].init(4)
                mut k_smc: int = 0
                while k_smc < args.len:
                    h_super_args.push(self.lower_expr(args.get(k_smc)))
                    k_smc = k_smc + 1
                # Infer base class from current class if not explicit
                mut resolved_base: str = base_class
                if resolved_base == "" and self.current_class_name != "":
                    if self.classes.contains(self.current_class_name):
                        mut cur_cls: ClassDef = self.classes.get(self.current_class_name)
                        if cur_cls.base_classes.len > 0:
                            resolved_base = cur_cls.base_classes.get(0)
                mut super_ret_ty = AstType.init("void")
                if self.classes.contains(resolved_base):
                    mut bc_def: ClassDef = self.classes.get(resolved_base)
                    mut k_smc2: int = 0
                    while k_smc2 < bc_def.methods.len:
                        if bc_def.methods.get(k_smc2).name == method:
                            if bc_def.methods.get(k_smc2).ret_ty as usize != 0 as usize:
                                super_ret_ty = bc_def.methods.get(k_smc2).ret_ty.read()
                        k_smc2 = k_smc2 + 1
                return box_hirexpr(HirExpr.ESuperMethodCall(resolved_base, method, h_super_args, super_ret_ty))
            case Expr.ESuperPropAccess(base_class, prop):
                mut resolved_base2: str = base_class
                if resolved_base2 == "" and self.current_class_name != "":
                    if self.classes.contains(self.current_class_name):
                        mut cur_cls2: ClassDef = self.classes.get(self.current_class_name)
                        if cur_cls2.base_classes.len > 0:
                            resolved_base2 = cur_cls2.base_classes.get(0)
                mut super_field_ty = AstType.init("void")
                if self.classes.contains(resolved_base2):
                    mut bc_def2: ClassDef = self.classes.get(resolved_base2)
                    mut k_spa: int = 0
                    while k_spa < bc_def2.fields.len:
                        if bc_def2.fields.get(k_spa).name == prop:
                            if bc_def2.fields.get(k_spa).ty as usize != 0 as usize:
                                super_field_ty = bc_def2.fields.get(k_spa).ty.read()
                        k_spa = k_spa + 1
                return box_hirexpr(HirExpr.ESuperPropAccess(resolved_base2, prop, super_field_ty))
            case _: return box_hirexpr(HirExpr.ELitNone(AstType.init("None")))

    # -- Rule N-1: Reserved name helpers ---------------------------------------
    pub def is_reserved_error(self, name: str) -> str:
        if name == "true" or name == "True": return "built-in boolean constant 'true'"
        if name == "false" or name == "False": return "built-in boolean constant 'false'"
        if name == "none" or name == "None": return "built-in null constant 'none'"
        if name == "Some": return "built-in Option constructor 'Some'"
        if name == "Ok": return "built-in Result constructor 'Ok'"
        if name == "Err": return "built-in Result constructor 'Err'"
        return ""

    # Reserved built-in names that cannot be shadowed at the top level.
    # Methods are EXEMPT - a method named 'len' or 'abs' is namespaced to its
    # class and does not shadow the global built-in.  Vec is intentionally absent:
    # it is the OOP class imported from core.vec, not a built-in.
    pub def is_reserved_keyword(self, name: str) -> str:
        if name == "print" or name == "input": return "built-in I/O function"
        if name == "range": return "built-in range function"
        if name == "len": return "built-in len function"
        if name == "type": return "built-in type function"
        if name == "abs" or name == "max" or name == "min" or name == "sum": return "built-in math function"
        if name == "str" or name == "int" or name == "float" or name == "bool": return "built-in primitive type"
        if name == "List" or name == "Dict": return "built-in container type"
        if name == "Option" or name == "Result": return "built-in enum type"
        if name == "Exception" or name == "Error": return "built-in exception type"
        return ""

    # -- Rule F-3: Definite return check ---------------------------------------
    pub def block_returns(self, b: Block) -> bool:
        if b.stmts.len == 0: return false
        # Skip trailing SLine markers so that `return x` followed by a
        # line-number marker is still recognised as a definite return.
        mut last_idx = b.stmts.len - 1
        mut sl_going = true
        while last_idx > 0:
            if not sl_going: break
            mut sl_s = b.stmts.get(last_idx)
            if sl_s as usize == 0 as usize:
                last_idx = last_idx - 1
            else:
                mut is_sline = false
                match sl_s.read():
                    case Stmt.SLine(_): is_sline = true
                    case _: pass
                if is_sline:
                    last_idx = last_idx - 1
                else:
                    sl_going = false
        mut last_s = b.stmts.get(last_idx)
        if last_s as usize == 0 as usize: return false
        match last_s.read():
            case Stmt.SReturn(_): return true
            case Stmt.SRaise(_): return true
            case Stmt.SUnsafe(body): return self.block_returns(body)
            case Stmt.SIf(cond, then_b, elifs, else_b):
                if else_b.stmts.len == 0: return false
                return self.block_returns(then_b) and self.block_returns(else_b)
            case Stmt.SMatch(subj, arms):
                # Exhaustive if there is a wildcard/bind arm and every arm body returns,
                # OR (no wildcard) every arm's pattern names a variant of the SAME known
                # enum and together they cover ALL of its declared variants -- [F-3]
                # otherwise false-flags a match that already lists every variant, forcing
                # a redundant/unreachable `case _:` just to satisfy this checker.
                mut has_wild = false
                mut all_ret = true
                mut _fr_tnames = Vec[str].init(4)
                mut _fr_vnames = Vec[str].init(4)
                mut mi = 0
                while mi < arms.len:
                    mut arm = arms.get(mi)
                    match arm.pat:
                        case Pattern.PWild: has_wild = true
                        case Pattern.PBind(_): has_wild = true
                        case _: self.pattern_covers(arm.pat, _fr_tnames, _fr_vnames)
                    if arm.body as usize != 0 as usize:
                        if not self.block_returns(arm.body.read()):
                            all_ret = false
                    mi = mi + 1
                if has_wild: return all_ret
                if not all_ret: return false
                if _fr_vnames.len == 0: return false
                mut _fr_ety = _fr_tnames.get(0)
                mut _fr_same_ty = true
                mut _fr_ti = 1
                while _fr_ti < _fr_tnames.len:
                    if _fr_tnames.get(_fr_ti) != _fr_ety: _fr_same_ty = false
                    _fr_ti = _fr_ti + 1
                if not _fr_same_ty: return false
                if not self.enums.contains(_fr_ety): return false
                mut _fr_edef = self.enums.get(_fr_ety)
                mut _fr_ei = 0
                while _fr_ei < _fr_edef.variants.len:
                    mut _fr_vn = _fr_edef.variants.get(_fr_ei).name
                    mut _fr_found = false
                    mut _fr_vi = 0
                    while _fr_vi < _fr_vnames.len:
                        if _fr_vnames.get(_fr_vi) == _fr_vn: _fr_found = true
                        _fr_vi = _fr_vi + 1
                    if not _fr_found: return false
                    _fr_ei = _fr_ei + 1
                return true
            case _: return false

    # Variant names a pattern covers, for [F-3] enum-match exhaustiveness (no
    # wildcard needed if every declared variant is otherwise listed). Recurses
    # into `POr` sub-patterns; appends (type_name, variant) pairs positionally
    # into the two out-accumulators (Tauraro has no `&` out-params, so a Vec
    # passed in and mutated by the callee is the idiom here).
    pub def pattern_covers(self, p: Pattern, tnames: Vec[str], vnames: Vec[str]):
        match p:
            case Pattern.PVariant(tn, vn):
                tnames.push(tn)
                vnames.push(vn)
            case Pattern.PVariantBind(tn, vn, _):
                tnames.push(tn)
                vnames.push(vn)
            case Pattern.PVariantBindMany(tn, vn, _):
                tnames.push(tn)
                vnames.push(vn)
            case Pattern.POr(pats):
                mut oi = 0
                while oi < pats.len:
                    self.pattern_covers(pats.get(oi), tnames, vnames)
                    oi = oi + 1
            case _: pass

    pub def is_primitive(self, ty: AstType) -> bool: return self.is_primitive_name(ty.name)
    # True if `name` denotes SOME resolvable type: a primitive, a string type, a
    # 1-char generic parameter (T/K/V/E), a user class/enum/interface, or a builtin
    # generic/collection/concurrency/module-static type. Used to detect a method
    # call whose receiver is a bare identifier naming NO known type (a
    # silent-miscompile hazard — codegen would emit a bogus free call).
    pub def _is_known_type_name(self, name: str) -> bool:
        if name == "": return true
        if self.is_primitive_name(name): return true
        if name == "str" or name == "Str" or name == "StringObj" or name == "StringBuilder" or name == "ptr" or name == "object": return true
        if _tr_strlen(name) == 1: return true   # generic type parameter (T, K, V, E, U, ...)
        if self.classes.contains(name): return true
        if self.enums.contains(name): return true
        if self.interfaces as usize != 0 as usize and self.interfaces.contains(name): return true
        if name == "Vec" or name == "List" or name == "Map" or name == "Dict" or name == "Set" or name == "Box" or name == "Tuple" or name == "tuple" or name == "Pointer": return true
        if name == "Mutex" or name == "RwLock" or name == "Atomic" or name == "Shared" or name == "Weak" or name == "Option" or name == "Result" or name == "Chan" or name == "Channel": return true
        if name == "Thread" or name == "ThreadPool" or name == "ThreadLocal" or name == "Coro": return true
        # Builtin module-static receivers: recognized by NAME (the compiler special-cases
        # `OS.is_windows()`, `Process.system()`, `Env.get_var()`, etc.). Some are std
        # `pub class`es whose def isn't registered in self.classes for a given unit and
        # don't bind a resolvable symbol, so they must be listed here or the [E-1]
        # unknown-receiver guard false-flags valid code (e.g. taupkg).
        if name == "OS" or name == "Process" or name == "Env" or name == "Hash" or name == "File": return true
        if name == "Math" or name == "Clock" or name == "Time" or name == "Random" or name == "Hmac": return true
        if name == "Json" or name == "JsonDoc" or name == "JsonWriter" or name == "JsonReader": return true
        return false

    pub def is_primitive_name(self, name: str) -> bool:
        if name == "int" or name == "float" or name == "bool" or name == "char" or name == "void" or name == "None": return true
        if name == "i64" or name == "i32" or name == "i16" or name == "i8": return true
        if name == "u64" or name == "u32" or name == "u16" or name == "u8" or name == "usize": return true
        if name == "f64" or name == "f32" or name == "lambda": return true
        # The FFI `c_*` scalar family (integers, floats, chars, size/ptr, stdint) — value types with
        # copy semantics, exempt from ownership-move tracking, so C/C++ bindings pass them freely.
        if name.starts_with("c_") and name != "c_void_ptr" and name != "c_FILE": return true
        # Built-in reference-counted / shared types - exempt from ownership-move tracking.
        # These types carry their own reference counting or atomic synchronisation;
        # passing them to multiple functions or spawned threads is always safe.
        if name == "str" or name == "Str" or name == "StringObj" or name == "Bytes": return true
        if name == "Chan" or name == "Channel": return true
        if name == "Mutex" or name == "RwLock" or name == "Atomic": return true
        if name == "Thread" or name == "ThreadPool" or name == "ThreadLocal": return true
        if name == "Pointer": return true
        # Gap 4: 'ref T' and 'mut ref T' params are borrow annotations, not owning values
        if name == "ref" or name == "mut_ref": return true
        return false

pub def box_asttype(t: AstType) -> Pointer[AstType]:
    unsafe:
        mut p = alloc[AstType](1)
        p.write(t)
        return p

pub def box_symbol(s: Symbol) -> Pointer[Symbol]:
    unsafe:
        mut p = alloc[Symbol](1)
        p.write(s)
        return p
