                # the call's return type via the bound interface before anything else below,
                # since `C` itself is neither a registered interface nor class name.
                mut _gpb_ret = 0 as Pointer[AstType]
                if self.current_func_constraints.len > 0 and self._is_type_param_in_scope(hobj_ty.name):
                    _gpb_ret = self._resolve_generic_bound_method_ret(hobj_ty.name, method)
                # Built-in module static type inference: OS, Process, Env, Hash, File
                if _gpb_ret as usize != 0 as usize:
                    ret_ty = _gpb_ret.read()
