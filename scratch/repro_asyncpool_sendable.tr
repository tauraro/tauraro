from std.async.pool import AsyncPool, AsyncTask

class NotSendable:
    pub n: int

async def use_it(x: NotSendable) -> int:
    return x.n

def main():
    mut pool = AsyncPool.auto()
    mut obj = NotSendable()
    obj.n = 5
    mut t = pool.spawn(use_it, obj)
    t.join()
    print("should not compile")
